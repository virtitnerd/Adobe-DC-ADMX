<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  revision="3.5" schemaVersion="1.0"
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Adobe Acrobat DC / Reader DC (Machine + User v3.5)</displayName>
  <description>ADMX v3.5 - Combined machine (HKLM) and user (HKCU) policies for Acrobat and Reader DC.</description>
  <resources>
    <stringTable>
      <string id="SupportedAcrobatReaderPolicies">Adobe Acrobat and Reader DC</string>
      <string id="SupportedReaderPolicies">Adobe Reader DC (32-bit)</string>
      <string id="SupportedAcrobatX64">Adobe Acrobat and Reader DC (64-bit)</string>
      <string id="SupportedAcrobatX86">Adobe Acrobat DC (32-bit)</string>
      <string id="SupportedReaderX86">Adobe Reader DC (32-bit)</string>

      <string id="AdobeCategory">Adobe DC</string>
      <string id="AcrobatReaderPolicies">Acrobat &amp; Reader DC</string>
      <string id="ReaderPoliciesBranch">Reader DC (32-bit)</string>
      <string id="NonPolicySettings">Non-Policy Settings</string>
      <string id="NonPol_AcrobatX64">Acrobat &amp; Reader DC (64-bit)</string>
      <string id="NonPol_AcrobatX86">Acrobat DC (32-bit)</string>
      <string id="NonPol_ReaderX86">Reader DC (32-bit)</string>

      <string id="Cat_CloudConnectors">Cloud &amp; Connectors</string>
      <string id="Cat_ContextToolsSearch">Context, Tools &amp; Search</string>
      <string id="Cat_DocsEditAccess">Documents, Editing &amp; Accessibility</string>
      <string id="Cat_MicrosoftPurviewMIP">Microsoft Purview (MIP)</string>
      <string id="Cat_SecurityExec">Security: Execution &amp; Protection</string>
      <string id="Cat_SecurityTrust">Security: Trust &amp; Permissions</string>
      <string id="Cat_SharingFeatures">Sharing &amp; Features</string>
      <string id="Cat_StartupExperience">Startup &amp; Experience</string>
      <string id="Cat_UpdatesDesktop">Updates &amp; Desktop Integration</string>
      <string id="Cat_Upsell">Upsell</string>

      <string id="SupportedAcrobatDC_User">Adobe Acrobat DC</string>
      <string id="SupportedReaderDC_User">Adobe Reader DC</string>
      <string id="AcrobatDCCategory_User">Acrobat DC</string>
      <string id="ReaderDCCategory_User">Reader DC</string>
      <string id="Cat_ContextToolsSearch_User">Context, Tools &amp; Search</string>
      <string id="Cat_DocsEditAccess_User">Documents, Editing &amp; Accessibility</string>
      <string id="Cat_MicrosoftPurviewMIP_User">Microsoft Purview (MIP)</string>
      <string id="Cat_SecurityExec_User">Security: Execution &amp; Protection</string>
      <string id="Cat_SecurityTrust_User">Security: Trust &amp; Permissions</string>
      <string id="Cat_SharingFeatures_User">Sharing &amp; Features</string>
      <string id="Cat_StartupExperience_User">Startup &amp; Experience</string>
      <string id="Cat_UpdatesDesktop_User">Updates &amp; Desktop Integration</string>
      <string id="Cat_Upsell_User">Upsell</string>

      <!-- ======================================== -->
      <!--                                          -->
      <!--  Acrobat and Reader DC - policy strings  -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--           Cloud and Connectors           -->
      <!-- ======================================== -->

      <string id="bToggleFillSign_Acrobat">Adobe Fill &amp; Sign</string>
      <string id="bToggleFillSign_Acrobat_Explain">Disables Adobe Fill and Sign.&#10;&#10;Possible values include:&#10;0: Enable Adobe Fill and Sign&#10;1: Disable Adobe Fill and Sign</string>
      <string id="bBoxConnectorEnabled_Acrobat">Box Cloud Connector</string>
      <string id="bBoxConnectorEnabled_Acrobat_Explain">Specifies whether to enable connection to the Box cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to Box&#10;1: Enable connection to Box</string>
      <string id="bToggleAdobeDocumentServices_Acrobat">Document Cloud Services</string>
      <string id="bToggleAdobeDocumentServices_Acrobat_Explain">Enable Document Cloud services (except those controlled by other prefs).&#10;&#10;Does not affect Sign, prefs sync, or third-party connectors. Reader removes Create/Export/Organize/Combine without subscription. Use bUpdater to disable all services.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bToggleDocumentCloud_Acrobat">Document Cloud Storage</string>
      <string id="bToggleDocumentCloud_Acrobat_Explain">Specifies whether to enable Document Cloud storage.&#10;&#10;DC storage is enabled by default.&#10;&#10;Possible values include:&#10;0: Enable Document Cloud storage&#10;1: Disable Document Cloud storage</string>
      <string id="bDropboxConnectorEnabled_Acrobat">Dropbox Cloud Connector</string>
      <string id="bDropboxConnectorEnabled_Acrobat_Explain">Specifies whether to enable connection to the Dropbox cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to Dropbox&#10;1: Enable connection to Dropbox</string>
      <string id="bEnableGentech_Acrobat">Generative AI Technology</string>
      <string id="bEnableGentech_Acrobat_Explain">Specifies whether to enable generative AI features in Acrobat and Reader.&#10;&#10;Possible values include:&#10;0: Disable generative AI features&#10;1: Enable generative AI features. Generative AI capabilities may rely on cloud services; verify organizational policies and Adobe documentation for data handling</string>
      <string id="bGoogleDriveConnectorEnabled_Acrobat">Google Drive Connector</string>
      <string id="bGoogleDriveConnectorEnabled_Acrobat_Explain">Specifies whether to enable connection to the Google Drive cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to Google Drive&#10;1: Enable connection to Google Drive</string>
      <string id="bToggleSendACopy_Acrobat">Hide Fill &amp; Sign Send a Copy Button</string>
      <string id="bToggleSendACopy_Acrobat_Explain">Specifies whether to hide the Send a Copy button from the Fill &amp; Sign tool in Acrobat and Reader.&#10;&#10;Possible values include:&#10;0: Hide the button&#10;1: Show the button</string>
      <string id="bSuppressSignOut_Acrobat">Hide Sign Out Menu Item</string>
      <string id="bSuppressSignOut_Acrobat_Explain">Specifies whether the sign-in and sign-out Help menu item should be enabled.&#10;&#10;Possible values include:&#10;0 or null: Don't disable the menu item&#10;1: Disable the Help menu item</string>
      <string id="bOneDriveConnectorEnabled_Acrobat">OneDrive Connector</string>
      <string id="bOneDriveConnectorEnabled_Acrobat_Explain">Specifies whether to enable connection to the OneDrive cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to OneDrive&#10;1: Enable connection to OneDrive</string>
      <string id="bTogglePrefsSync_Acrobat">Preferences Synchronization</string>
      <string id="bTogglePrefsSync_Acrobat_Explain">Sync desktop preferences across signed-in devices.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled and locked</string>
      <string id="bUpdater_Updates_Acrobat">Services &amp; Web-Plugin Updates</string>
      <string id="bUpdater_Updates_Acrobat_Explain">Web-plugin updates and cloud services.&#10;&#10;Disables all services including sign-in. Not the same as FeatureLockDown\bUpdater (product updates).&#10;&#10;Values:&#10;0 = disable services and component updates&#10;1 = enable</string>
      <string id="bToggleWebConnectors_Acrobat">Third-Party Cloud Connectors</string>
      <string id="bToggleWebConnectors_Acrobat_Explain">Third-party cloud storage connectors (Continuous track).&#10;&#10;Controls Box, OneDrive, and Dropbox (not SharePoint). Disables Home, Add Account, and custom Open/Save entry points.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="bUIDensityAutoDetectionEnabled_Acrobat">Auto UI Density Detection</string>
      <string id="bUIDensityAutoDetectionEnabled_Acrobat_Explain">Specifies whether to disable the auto detection logic and bezel for changing Acrobat's display size.&#10;&#10;By default, the UI is enabled so that a user may change the display size based on device screen size, resolution, and monitor scaling. 0: Disable the UI. 1: Show the UI.</string>
      <string id="bEnableCloudPoweredSearchTokenCaching_Acrobat">Cloud Search Token Caching</string>
      <string id="bEnableCloudPoweredSearchTokenCaching_Acrobat_Explain">Specifies whether to cache locally cloud-based search service suggestions.&#10;&#10;Possible values include:&#10;0 or null: Don't cache cloud search service suggestions&#10;1: Cache suggestions</string>
      <string id="bEnableCloudPoweredSearch_Acrobat">Cloud-Powered Search</string>
      <string id="bEnableCloudPoweredSearch_Acrobat_Explain">Specifies whether to enable the cloud-based search service in the Find Tool.&#10;&#10;Interacts with bEnableCloudPoweredSearchTokenCaching. Data sent to the cloud is not stored and is encrypted.&#10;&#10;Possible values include:&#10;0 or null: Don't enable the cloud search service&#10;1: Enable the cloud search service</string>
      <string id="bEnableContextualTips_Acrobat">Contextual Help Tips</string>
      <string id="bEnableContextualTips_Acrobat_Explain">Controls whether to automatically display help tips based on the current context.&#10;&#10;Possible values include:&#10;0: Disable contextual tips&#10;1: Enable tips</string>
      <string id="bEnableContextualToolbar_Acrobat">Contextual Toolbar</string>
      <string id="bEnableContextualToolbar_Acrobat_Explain">Specifies whether to show the context toolbar (popup) when selecting a PDF object.&#10;&#10;When enabled, a popup, floating toolbar appears when a user interacts with a PDF. For example, selecting text displays text markup tools. Selecting an image displays sticky note and editing tools.&#10;&#10;Possible values include:&#10;0: Don't show context toolbars&#10;1: Show toolbars</string>
      <string id="bEnableExtractPageRange_Acrobat">Extract Page Range UI</string>
      <string id="bEnableExtractPageRange_Acrobat_Explain">Specifies whether to show the page range UI in the Extract Page dialog.&#10;&#10;0: Don't show the page range UI. 1: Show the page range UI.</string>
      <string id="bDisableAcrobatShortcutCustomization_Acrobat">Lock Tool Shortcut Customization</string>
      <string id="bDisableAcrobatShortcutCustomization_Acrobat_Explain">Prevents end users from modifying the tool shortcuts in the right hand pane.&#10;&#10;Possible values include:&#10;0: Don't disable shortcuts&#10;1: Disable shortcuts</string>
      <string id="bEnableAV2Enterprise_Acrobat">Modern Viewer</string>
      <string id="bEnableAV2Enterprise_Acrobat_Explain">Specifies whether to enable the Modern Viewer.&#10;&#10;The new app UI is rolling out in phases over 2023. As of June, 25% of users will see the updated user interface. This preference may interact with bShownViewerOnboarding and bEnableAV2 .&#10;&#10;Possible values include:&#10;0: Don't show the Modern Viewer&#10;1: Show the Modern Viewer</string>
      <string id="bEnableRCMNewPOPUp_Acrobat">New Right-Click Context Menu</string>
      <string id="bEnableRCMNewPOPUp_Acrobat_Explain">Specifies whether to disable the new context menu and use the legacy version.&#10;&#10;A new right-click context menu displays icons and additional menu options. 0: Disable the new context menu. 1: Enable the new menu.</string>
      <string id="bFindMoreWorkflowsOnline_Acrobat">Online Actions Library Link</string>
      <string id="bFindMoreWorkflowsOnline_Acrobat_Explain">Specifies whether to show the menu item that opens the online Actions file library.&#10;&#10;Possible values include: 0: Disable the menu item. 1 or null: Don't disable the menu item.</string>
      <string id="bFindMoreCustomizationsOnline_Acrobat">Online Tool Set Exchange Link</string>
      <string id="bFindMoreCustomizationsOnline_Acrobat_Explain">Specifies whether to show the menu item that opens the online Acrobat Tool Set Exchange.&#10;&#10;Possible values include: 0: Disable the menu item. 1 or null: Don't disable the menu item.</string>
      <string id="bOrganizePagesFromThumbnails_Acrobat">Organize Pages Thumbnail Shortcut</string>
      <string id="bOrganizePagesFromThumbnails_Acrobat_Explain">Specifies whether to show shortcut UI for the Organize tool from thumbnails.&#10;&#10;Possible values include:&#10;0: Don't show Organize Pages tool shortcut from thumbnails&#10;1: Show the Organize Pages tool shortcut</string>
      <string id="bRCMCombineFeatureKey_Acrobat">Show Combine Files Context Menu</string>
      <string id="bRCMCombineFeatureKey_Acrobat_Explain">Specifies whether to display the Combine Files item in a document's right-click context menu.&#10;&#10;This preference only applies to machines that display the Modern Viewer (a phased rollout over 2023). When the Modern Viewer is disabled, admins can toggle the Combine Files UI off/on.&#10;&#10;Possible values include:&#10;0: Don't show the Combine Files UI&#10;1: Do show the Combine Files UI</string>
      <string id="bEnableAutoCompleteExactMatchLoader_Acrobat">Show Search Loading Message</string>
      <string id="bEnableAutoCompleteExactMatchLoader_Acrobat_Explain">Specifies whether to show a &quot;Working on it&quot; message when using the cloud-based search service.&#10;&#10;The message appears in the Suggestions section of the Find tool's autocomplete list.&#10;&#10;Possible values include:&#10;0 or null: Don't show the message&#10;1: Show the message</string>
      <string id="bEnableAutoCompleteNoInternetConnectionHeader_Acrobat">Show Search No Internet Message</string>
      <string id="bEnableAutoCompleteNoInternetConnectionHeader_Acrobat_Explain">Specifies whether to show a &quot;Requires internet connection&quot; message when using the cloud-based search service.&#10;&#10;The message appears in the Suggestions section of the Find tool's autocomplete list.&#10;&#10;Possible values include:&#10;0 or null: Don't show the message&#10;1: Show the message</string>
      <string id="bEnableAutoCompleteNoExactMatchHeader_Acrobat">Show Search No Match Message</string>
      <string id="bEnableAutoCompleteNoExactMatchHeader_Acrobat_Explain">Specifies whether to show a &quot;No exact match&quot; message when using the cloud-based search service.&#10;&#10;The message appears in the Suggestions section of the Find tool's autocomplete list.&#10;&#10;Possible values include:&#10;0 or null: Don't show the message&#10;1: Show the message</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="bCloudATFeatureEnable_Acrobat">Accessibility Auto Tagging</string>
      <string id="bCloudATFeatureEnable_Acrobat_Explain">Specifies whether to show the new auto tagging experience or revert to the old experience.&#10;&#10;Possible values include:&#10;0: Disable the new auto tagging feature in the accessibility UI&#10;1: Enable the new auto tagging feature in the accessibility UI</string>
      <string id="bBatesLogOriginalFileName_Acrobat">Bates Log Original File Name</string>
      <string id="bBatesLogOriginalFileName_Acrobat_Explain">Use original filename in Bates numbering log output.&#10;&#10;When users choose Bates-based output filenames.&#10;&#10;Values:&#10;0 = Bates numbers in log&#10;1 = original filename</string>
      <string id="bGlobalBarMenuFeatureKey_Acrobat">Create PDF Split Menu</string>
      <string id="bGlobalBarMenuFeatureKey_Acrobat_Explain">Specifies whether to show the Create Split Menu under Create a PDF menu item.&#10;&#10;Possible values include:&#10;0: Don't show the Create Split menu&#10;1: Show the Create Split menu</string>
      <string id="bEnableReflowEditing_Acrobat">Reflow Editing</string>
      <string id="bEnableReflowEditing_Acrobat_Explain">Specifies whether to lock ReflowEditing and the reflow feature.&#10;&#10;See ReflowEditing for feature details.&#10;&#10;Possible values include:&#10;0: Disable and lock the feature&#10;1: Don't lock the feature and allow the user to toggle it off and on from the Preferences UI</string>
      <string id="bIgnoreDataSchema_Acrobat">Restrict Form Data to Schema</string>
      <string id="bIgnoreDataSchema_Acrobat_Explain">Specifies whether all data in a form is saved rather than only data related to the form's schema.&#10;&#10;Possible values include:&#10;null: Save form data even when it's not part of a schema&#10;1: Save only form data that's part of the schema</string>

      <!-- ======================================== -->
      <!--         Microsoft Purview (MIP)          -->
      <!-- ======================================== -->

      <string id="bMIPCheckPolicyOnDocSave_Acrobat">Check MIP Policy on Save</string>
      <string id="bMIPCheckPolicyOnDocSave_Acrobat_Explain">Lock MIP labeling checks on save (admin).&#10;&#10;Requires default or mandatory labeling in the Purview portal. Grays out related Preferences UI. HKLM lockdown, not per-user MicrosoftAIP prefs.&#10;&#10;Values:&#10;0 = do not lock&#10;1 = lock enabled</string>
      <string id="bMIPLabelling_Acrobat">Enable MIP Labelling</string>
      <string id="bMIPLabelling_Acrobat_Explain">Lock Enable MIP labeling in Preferences ) Security.&#10;&#10;Machine-level lockdown; complements per-user MicrosoftAIP prefs.&#10;&#10;Values:&#10;0 = do not lock&#10;1 = lock enabled</string>
      <string id="bEnableDKEAdmin_Acrobat">MIP Double Key Encryption</string>
      <string id="bEnableDKEAdmin_Acrobat_Explain">Locks double key encryption (DKE) label support for Microsoft Purview Information Protection.&#10;&#10;Machine-level FeatureLockDown lockdown for MIP DKE workflows.&#10;&#10;Possible values include:&#10;0: Lock DKE disabled&#10;1: Lock DKE enabled</string>
      <string id="bMIPExternalAuthAdmin_Acrobat">MIP External Browser Auth</string>
      <string id="bMIPExternalAuthAdmin_Acrobat_Explain">Locks browser-based authentication for Microsoft Purview Information Protection operations.&#10;&#10;Machine-level FeatureLockDown lockdown.&#10;&#10;Possible values include:&#10;0: Lock external browser auth disabled&#10;1: Lock external browser auth enabled</string>
      <string id="iMIPCloud_Acrobat">MIP Sovereign Cloud</string>
      <string id="iMIPCloud_Acrobat_Explain">Locks which Microsoft cloud instance Acrobat and Reader use for MIP SDK operations.&#10;&#10;Machine-level FeatureLockDown lockdown. Relevant for sovereign and government tenants. MIP SDK Cloud enum values: 0: Unknown. 1: Custom. 2: Test. 3: Commercial (default/global). 4: Germany. 5: US DoD. 6: US GCC. 7: US GCC High. 8: US Sec. 9: US Nat. 10: China.</string>
      <string id="iMIPCloud_Acrobat_opt0">Unknown</string>
      <string id="iMIPCloud_Acrobat_opt1">Custom</string>
      <string id="iMIPCloud_Acrobat_opt2">Test</string>
      <string id="iMIPCloud_Acrobat_opt3">Commercial</string>
      <string id="iMIPCloud_Acrobat_opt4">Germany</string>
      <string id="iMIPCloud_Acrobat_opt5">US DoD</string>
      <string id="iMIPCloud_Acrobat_opt6">US GCC</string>
      <string id="iMIPCloud_Acrobat_opt7">US GCC High</string>
      <string id="iMIPCloud_Acrobat_opt8">US Sec</string>
      <string id="iMIPCloud_Acrobat_opt9">US Nat</string>
      <string id="iMIPCloud_Acrobat_opt10">China</string>
      <string id="bSilentAuth_Acrobat">Suppress OS Auth Prompts (MIP)</string>
      <string id="bSilentAuth_Acrobat_Explain">Locks whether operating-system authentication prompts are suppressed during MIP operations.&#10;&#10;By default, OS-driven auth prompts for MIP are suppressed. Set policy Disabled to write DWORD 0 and allow OS auth prompts (useful when troubleshooting AADSTS50020-type errors).&#10;&#10;Possible values include:&#10;0: Allow OS auth prompts&#10;1: Suppress OS auth prompts</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="bEnable3D_Acrobat">3D Content in PDFs</string>
      <string id="bEnable3D_Acrobat_Explain">Specifies whether to trust and render 3D content in PDFs.&#10;&#10;This setting can override b3DEnableContent.&#10;&#10;Possible values include:&#10;0: Don't render 3D content&#10;1: Trust and render 3D files</string>
      <string id="bEnableProtectedModeAppContainer_Acrobat">AppContainer Sandbox</string>
      <string id="bEnableProtectedModeAppContainer_Acrobat_Explain">Specifies whether to enable the AppContainer sandbox.&#10;&#10;Possible values include:&#10;0: Disable Microsoft's AppContainer sandbox&#10;1: Enable Microsoft's AppContainer sandbox</string>
      <string id="bEnableBlacklistForOpenSave_Acrobat">Attachment Extension Blocklist in Dialogs</string>
      <string id="bEnableBlacklistForOpenSave_Acrobat_Explain">Hide tBuiltInPermList level-3 extensions from Open/Save dialogs.&#10;&#10;New behavior since build 21.011.20029; enabled by default.&#10;&#10;Values:&#10;0 = legacy behavior (extensions visible)&#10;1 = retain new behavior (hidden)</string>
      <string id="bDisableJavaScript_Acrobat">Block JavaScript Execution</string>
      <string id="bDisableJavaScript_Acrobat_Explain">Blocks and locks JavaScript execution in PDF documents, preventing users from bypassing via privileged locations.&#10;&#10;This lockable setting overrides bEnableJS and prevents users from re-enabling JavaScript through the Yellow Message Bar or Trusted Locations.&#10;&#10;Possible values include:&#10;0 or null: Don't disable JS&#10;1: Disable and lock JS</string>
      <string id="iFileAttachmentPerms_Acrobat">Block non-PDF file attachments</string>
      <string id="iFileAttachmentPerms_Acrobat_Explain">Block opening non-PDF/FDF file attachments.&#10;&#10;Values:&#10;0 = allow&#10;1 = block</string>
      <string id="bDisablePDFRedirectionActions_Acrobat">Block PDF Link Actions</string>
      <string id="bDisablePDFRedirectionActions_Acrobat_Explain">Specifies whether to block specific PDF actions (listed below) which result in opening a link.&#10;&#10;This preference does not block regular web links. Enabling this feature blocks PDF actions that open links, including GoToE, GoToR, Launch, Thread, Import Data, Export Form Data, Submit Form, and Reset Form.&#10;&#10;Possible values include:&#10;0 or null: Don't block these opening links&#10;1: Block links</string>
      <string id="bEnablePVCertificateBasedTrust_Acrobat">Certification Status in Protected View</string>
      <string id="bEnablePVCertificateBasedTrust_Acrobat_Explain">Specifies whether a document's certification status should appear in the Protected View document message bar.&#10;&#10;Possible values include:&#10;0: Don't show the document's certification status&#10;1: Do show the document's certification status</string>
      <string id="bEnhancedSecurityInBrowser_Acrobat">Enhanced Security in Browser</string>
      <string id="bEnhancedSecurityInBrowser_Acrobat_Explain">Enhanced security when running in the browser.&#10;&#10;GUI checkbox sets this with bEnhancedSecurityStandalone. On 8.x, use bEnhancedSecurityStandalone for both.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled</string>
      <string id="bEnhancedSecurityStandalone_Acrobat">Enhanced Security Standalone</string>
      <string id="bEnhancedSecurityStandalone_Acrobat_Explain">Enhanced security in the standalone application.&#10;&#10;GUI checkbox sets this with bEnhancedSecurityInBrowser. On 8.x, this controls both browser and standalone.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled</string>
      <string id="bEnableFlash_Acrobat">Flash Content in PDFs</string>
      <string id="bEnableFlash_Acrobat_Explain">Render Flash content in PDFs.&#10;&#10;Privileged locations do not override this setting.&#10;&#10;Values:&#10;0 = empty box and security warning&#10;1 = play if Flash player present</string>
      <string id="bProtectedMode_Acrobat">Protected Mode Sandbox</string>
      <string id="bProtectedMode_Acrobat_Explain">Enables Protected Mode which sandboxes Acrobat and Reader processes.&#10;&#10;Protected Mode should be enabled to protect user systems and data.&#10;&#10;Possible values include:&#10;0: Don't enable protected mode&#10;1: Do enable protected mode</string>
      <string id="iProtectedView_Acrobat">Protected View Mode</string>
      <string id="iProtectedView_Acrobat_Explain">Protected View mode.&#10;&#10;Values:&#10;0 = off (default)&#10;1 = untrusted locations only (recommended)&#10;2 = all files</string>
      <string id="iProtectedView_Acrobat_opt0">Disable Protected View</string>
      <string id="iProtectedView_Acrobat_opt1">Enable Protected View for unsafe locations only</string>
      <string id="iProtectedView_Acrobat_opt2">Enable Protected View for all files</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat">Unlisted Attachment Type Permissions</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_Explain">Specifies the default permissions for file types that aren't listed in the default or user-specified lists.&#10;&#10;Possible values include:&#10;0: Prompt user without ability to set file type as Allowed (two choices: Open File, Never Allow). 1 (default): Prompt user with ability to Allow or Prohibit (three choices)&#10;2: Always open unlisted file types&#10;3: Never open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt0">Prompt without ability to allow (most restrictive prompt)</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt1">Prompt with ability to allow or prohibit (default)</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt2">Always open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt3">Never open unlisted file types (most restrictive)</string>

      <!-- ======================================== -->
      <!--     Security: Trust and Permissions      -->
      <!-- ======================================== -->

      <string id="bMSStoreTrusted_Acrobat">Allow Changes to Windows Certificate Store Trust</string>
      <string id="bMSStoreTrusted_Acrobat_Explain">Locks the UI so that end users cannot change the value set by iMSStoreTrusted.&#10;&#10;Set iMSStoreTrusted first, then use this preference to lock it. Allowable values include: 0: Lock the UI. 1: Same as null. Don't lock the UI.</string>
      <string id="bAllowInvisibleSig_Acrobat">Allow Invisible Signatures</string>
      <string id="bAllowInvisibleSig_Acrobat_Explain">Specifies whether to allow invisible certification signatures.&#10;&#10;False disables the menu option, prevents signing and certifying with invisible signatures, and limits JavaScript support by signature fields.</string>
      <string id="bAllowPasswordSaving_Acrobat">Allow Password Caching</string>
      <string id="bAllowPasswordSaving_Acrobat_Explain">Controls whether certain passwords can be cached to disk; for example, passwords for digital IDs.&#10;&#10;If false, users are prompted to enter a password every time one is required. Not all passwords are affected by this setting.</string>
      <string id="bEnableSignatureClear_Acrobat">Allow Signature Clearing</string>
      <string id="bEnableSignatureClear_Acrobat_Explain">Specifies whether to disable and lock the ability for a signer to clear their own signature.&#10;&#10;Possible values include:&#10;0: Disable signature clearing&#10;1: Enable signature clearing</string>
      <string id="bVerifyUseAlways_Acrobat">Always Use Specified Verify Handler</string>
      <string id="bVerifyUseAlways_Acrobat_Explain">Qualifies the use of aVerify.&#10;&#10;If true and aVerify is set to a handler name, then this handler is used to verify all signatures. If false, then the aVerify handler is used only to verify signatures when the handler specified by the signature dictionary Filter attribute is not present.</string>
      <string id="bDisableExpandEnvironmentVariables_Acrobat">Block User Library Trust in Protected View</string>
      <string id="bDisableExpandEnvironmentVariables_Acrobat_Explain">Allow user-specific paths as trusted locations in Protected View.&#10;&#10;When off, only static org-wide trusted locations apply. Paths like C:\Users\%username%\Desktop can be trusted when enabled.&#10;&#10;Values:&#10;0 = trust user locations&#10;1 = do not trust user locations</string>
      <string id="bWinCacheSessionHandles_Acrobat">Cache Digital ID Session Handles</string>
      <string id="bWinCacheSessionHandles_Acrobat_Explain">Specifies whether to retain cryptographic service provider (CSP) handles when a user authenticates to a digital ID.&#10;&#10;If true, a user does not have to re-authenticate to use the ID unless they log out or the session ends. The impact of this preference will vary based on the CSP in use; however, the setting does not affect the Windows CSPs.</string>
      <string id="bDisableADCFileStore_Acrobat">Disable Acrobat.com File Storage</string>
      <string id="bDisableADCFileStore_Acrobat_Explain">Disables Acrobat.com file storage integration.&#10;&#10;When enabled, disables storage of files on Acrobat.com (Adobe Document Cloud).&#10;&#10;Possible values include:&#10;0: Allow Acrobat.com file storage&#10;1: Disable Acrobat.com file storage</string>
      <string id="bDisableOSTrustedSites_Acrobat">Disable IE Trusted Sites as Privileged Locations</string>
      <string id="bDisableOSTrustedSites_Acrobat_Explain">Locks the ability to treat IE trusted sites as privileged locations either on or off so the users can't change the bTrustOSTrustedSites value via the user interface.&#10;&#10;If set, bTrustOSTrustedSites is simply ignored.&#10;&#10;Possible values include:&#10;0 or null: Enables and locks trusting sites from IE&#10;1: Disables and locks trusting sites from IE</string>
      <string id="bAllowAPSConfig_Acrobat">LiveCycle RMS Server Config</string>
      <string id="bAllowAPSConfig_Acrobat_Explain">Prevents a LiveCycle Right Management Server from being configured by disabling the menu option in the Security Settings Console.&#10;&#10;By default, configuration is allowed.</string>
      <string id="bReqRevCheck_Acrobat">Lock Revocation Check Setting</string>
      <string id="bReqRevCheck_Acrobat_Explain">Locks Security\cASPKI\cASPKI\cVerify\iReqRevCheck and disables the user interface item.</string>
      <string id="bReasons_Acrobat">Lock Signing Reasons Settings</string>
      <string id="bReasons_Acrobat_Explain">Prevents users from modifying reason settings.&#10;&#10;v8.1: If locked and cReasons is empty, bAllowSigningReasons is 0 and read only. If locked and cReasons has values, then bAllowSigningReasons is true and read only.</string>
      <string id="bDisableTrustedFolders_Acrobat">Lock Trusted Folders and Files</string>
      <string id="bDisableTrustedFolders_Acrobat_Explain">Disable and lock trusted folders and files.&#10;&#10;Prevents users from adding folder or file privileged locations.&#10;&#10;Values:&#10;0 or null = allowed&#10;1 = disabled and locked</string>
      <string id="bDisableTrustedSites_Acrobat">Lock Trusted Host Sites</string>
      <string id="bDisableTrustedSites_Acrobat_Explain">Disable and lock host-based privileged locations.&#10;&#10;Values:&#10;0 or null = enable and lock host-based locations&#10;1 = disable and lock host-based locations</string>
      <string id="bEnableCEFBasedUI_Acrobat">Modern Digital Signature UI</string>
      <string id="bEnableCEFBasedUI_Acrobat_Explain">Modern CEF-based digital signature UI.&#10;&#10;All values disable the user preference toggle. Block self-signed ID creation (post-June 2016) with bSelfSignCertGen=0 and bEnableCEFBasedUI=0.&#10;&#10;Values:&#10;0 = legacy UI&#10;1 = modern UI</string>
      <string id="bUseTSAsSigningTime_Acrobat">Show Timestamp in Signature</string>
      <string id="bUseTSAsSigningTime_Acrobat_Explain">Show timestamp server time in signature appearance.&#10;&#10;Default uses local clock. Requires bReqSigPropRetrieval=1 (HKCU). Verify time against iMaxClockSkew (default 65 min).&#10;&#10;Values:&#10;0 = hide timestamp&#10;1 = show timestamp</string>
      <string id="bShowSignMenu_Acrobat">Sign Menu in Menu Bar</string>
      <string id="bShowSignMenu_Acrobat_Explain">Specifies whether to show the Sign menu in Acrobat's top level menu bar.&#10;&#10;Possible values include:&#10;0 or null: Disable the Sign menu item&#10;1: Enable the menu item</string>
      <string id="bAllowReasonWhenSigning_Acrobat">Signing Reason UI</string>
      <string id="bAllowReasonWhenSigning_Acrobat_Explain">Specifies whether the reason UI will appear during signing.&#10;&#10;The preference can be overridden by a document seed value set on a field. For 8.1 and later, if cReasons is locked and is empty, bAllowSigningReasons is 0 and read only (The UI is turned off). If cReasons is locked and has values, then bAllowSigningReasons is true and read only.</string>
      <string id="bEnableCertificateBasedTrust_Acrobat">Trust Certified Documents</string>
      <string id="bEnableCertificateBasedTrust_Acrobat_Explain">Trust certified documents as privileged locations (admin lock).&#10;&#10;Lockable counterpart to bTrustCertifiedDocuments. Does not apply in Protected View.&#10;&#10;Values:&#10;0 or null = not trusted&#10;1 = trusted</string>
      <string id="iUnknownURLPerms_Acrobat">Unknown URL Access Policy</string>
      <string id="iUnknownURLPerms_Acrobat_Explain">Access policy for URLs not in the user list.&#10;&#10;Overrides privileged location host settings in some versions.&#10;&#10;Values:&#10;1 = ask&#10;2 = allow&#10;3 = block</string>
      <string id="iUnknownURLPerms_Acrobat_opt0">Always ask</string>
      <string id="iUnknownURLPerms_Acrobat_opt1">Always allow</string>
      <string id="iUnknownURLPerms_Acrobat_opt2">Always block</string>
      <string id="iURLPerms_Acrobat">URL Access Permissions</string>
      <string id="iURLPerms_Acrobat_Explain">Allow, block, or custom website access from PDF files.&#10;&#10;This Computer-scope policy writes to HKLM FeatureLockDown and is the correct enforcement path. Setting this policy locks the Trust Manager dialog for all users and satisfies the DISA STIG automated scan (V-213121 / AADC-CN-000285). Allow or Block resets tHostPerms; Custom uses tHostPerms.&#10;&#10;Possible values include:&#10;0: Custom Setting (uses tHostPerms URL list)&#10;1: Block all websites&#10;2: Allow all websites</string>
      <string id="iURLPerms_Acrobat_opt0">Custom Setting (uses tHostPerms URL list)</string>
      <string id="iURLPerms_Acrobat_opt1">Block all websites</string>
      <string id="iURLPerms_Acrobat_opt2">Allow all websites</string>
      <string id="bValidateOnOpen_Acrobat">Validate Signatures on Open</string>
      <string id="bValidateOnOpen_Acrobat_Explain">Specifies whether to automatically validate all signatures on document open.&#10;&#10;Note that the lockable setting does not configure the feature; instead, it locks what is set in HKCU and the user interface. 0: Don't validate signatures on document open. 1: Validate signatures on document open.</string>

      <!-- ======================================== -->
      <!--           Sharing and Features           -->
      <!-- ======================================== -->

      <string id="bToggleAdobeSign_Acrobat">Adobe Acrobat Sign</string>
      <string id="bToggleAdobeSign_Acrobat_Explain">Adobe Acrobat Sign (Send for Signature).&#10;&#10;On Continuous track, also set bToggleManageSign.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bToggleSendAndTrack_Acrobat">Adobe Send &amp; Track</string>
      <string id="bToggleSendAndTrack_Acrobat_Explain">Disables Adobe Send and Track (some UI is renamed to &quot;Share&quot; since October, 2018)&#10;&#10;Possible values include:&#10;0: Enable Adobe Send and Track&#10;1: Disable Adobe Send and Track</string>
      <string id="bEnableRecipientMention_Acrobat">Allow @Mention Non-Reviewers</string>
      <string id="bEnableRecipientMention_Acrobat_Explain">Specifies whether to allow participants in a shared review to @mention people who are not review collaborators.&#10;&#10;Prior to this release, reviewers could only @mention other reviewers in the review comments.&#10;&#10;Possible values include:&#10;0: Don't allow mentioning non-reviewers&#10;1: Allow mentioning non-reviewers</string>
      <string id="bDisableSharePointFeatures_Acrobat">Disable SharePoint &amp; Office 365 Integration</string>
      <string id="bDisableSharePointFeatures_Acrobat_Explain">Disable SharePoint and Office 365 integration.&#10;&#10;Disables SharePoint detection, check-out prompt, and SharePoint menu items.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bDisableWebmail_Acrobat">Disable WebMail Integration</string>
      <string id="bDisableWebmail_Acrobat_Explain">Disable WebMail integration.&#10;&#10;Values:&#10;0 = enable WebMail profiles&#10;1 = disable. With bSendMailShareRedirection=1, the email icon attaches the PDF directly</string>
      <string id="bToggleAdobeReview_Acrobat">Document Cloud Review Service</string>
      <string id="bToggleAdobeReview_Acrobat_Explain">Document Cloud Review service UI.&#10;&#10;When disabled, removes cloud review UI and legacy review types are used.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bSendMailShareRedirection_Acrobat">Email Icon Attach to Email Behavior</string>
      <string id="bSendMailShareRedirection_Acrobat_Explain">Email icon attaches document instead of opening the share pane.&#10;&#10;Values:&#10;0 or null = open share pane&#10;1 = attach to email</string>
      <string id="bMixRecentFilesFeatureLockDown_Acrobat">Hide Shared Files from Recent List</string>
      <string id="bMixRecentFilesFeatureLockDown_Acrobat_Explain">Show shared files in the Recent list.&#10;&#10;Covers shares, reviews, signing, and Send and Track workflows.&#10;&#10;Values:&#10;0 = add to Recent&#10;1 = do not add</string>
      <string id="bToggleFSSSignatureSaving_Acrobat">Save Signature to Cloud</string>
      <string id="bToggleFSSSignatureSaving_Acrobat_Explain">Specifies whether to save a newly created signature in the cloud.&#10;&#10;When a user creates a new signature, the dialog offers the option to store the signature in the cloud for later use. This preference also controls saving user initials.&#10;&#10;Possible values include:&#10;0: Show the Save Signature UI&#10;1: Hide the Save Signature UI</string>
      <string id="bAdobeSendPluginToggle_Acrobat">Send &amp; Track Outlook Plugin</string>
      <string id="bAdobeSendPluginToggle_Acrobat_Explain">Adobe Send and Track button in Outlook.&#10;&#10;Uploads attachments to Document Cloud and inserts public preview/download links in email.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bEnableReviewPromote_Acrobat">Share and Review Reminder Tip</string>
      <string id="bEnableReviewPromote_Acrobat_Explain">Specifies whether to display a Share/Review feature reminder message when users have used those features in the past.&#10;&#10;If the user has not used the review service for 30 days AND has previously opened a PDF with review comments, Acrobat displays a tip reminding the user the review/share service is available.&#10;&#10;Possible values include:&#10;0: Don't show a tip&#10;1: Show tip</string>
      <string id="bPreviouslyEnabledSharePointInChromeExtn_Acrobat">SharePoint Chrome Extension Previous State</string>
      <string id="bPreviouslyEnabledSharePointInChromeExtn_Acrobat_Explain">Stores the previous state of the SharePoint FeatureLockDown settings.&#10;&#10;Possible values include: Same as bEnableSharePointInChromeExtn in FeatureLockDown.</string>
      <string id="bEnableSharePointInChromeExtn_Acrobat">SharePoint in Chrome Extension</string>
      <string id="bEnableSharePointInChromeExtn_Acrobat_Explain">Specifies whether to integrate SharePoint into the Acrobat's Chrome extension.&#10;&#10;Possible values include:&#10;0: Don't enable SharePoint integration&#10;1: Enable</string>
      <string id="bToggleManageSign_Acrobat">Show Acrobat Sign Tracking Tab</string>
      <string id="bToggleManageSign_Acrobat_Explain">Signature tab on Home, notifications, and sign tracking.&#10;&#10;Hides agreements, notifications, and To Do sign cards when disabled.&#10;&#10;Values:&#10;0 = show&#10;1 = hide</string>
      <string id="bDisableOnBehalfOfText_Acrobat">Show Comment Author in Shared Review</string>
      <string id="bDisableOnBehalfOfText_Acrobat_Explain">If false, the string &quot;On behalf of&quot; does not append the author's name in the comment when another person opens the document in a shared-review workflow.&#10;&#10;This preference is only used in shared review workflows.&#10;&#10;Possible values include:&#10;0: Don't display the comment author's name&#10;1: Do display the comment author's name</string>
      <string id="iClientType_Gmail_Acrobat">WebMail Client Type (Gmail)</string>
      <string id="iClientType_Gmail_Acrobat_Explain">Identifies the Gmail Mail client type for WebMail.&#10;&#10;The value can only be: 1</string>
      <string id="iClientType_Gmail_Acrobat_opt0">Locked value: 1 (per Adobe PrefRef)</string>
      <string id="iClientType_Yahoo_Acrobat">WebMail Client Type (Yahoo)</string>
      <string id="iClientType_Yahoo_Acrobat_Explain">Identifies the Yahoo Mail client type for WebMail.&#10;&#10;The value can only be: 2</string>
      <string id="iClientType_Yahoo_Acrobat_opt0">Locked value: 2 (per Adobe PrefRef)</string>
      <string id="iIMAPPort_Acrobat">WebMail IMAP Port</string>
      <string id="iIMAPPort_Acrobat_Explain">Identifies the My Profile Mail IMAP server port number for WebMail.&#10;&#10;The value can be: Any valid port number.</string>
      <string id="iIMAPPort_Acrobat_opt0">143 (Standard IMAP)</string>
      <string id="iIMAPPort_Acrobat_opt1">993 (IMAP over SSL/TLS)</string>
      <string id="iIMAPSecurity_Acrobat">WebMail IMAP Security</string>
      <string id="iIMAPSecurity_Acrobat_Explain">Specifies whether to enable the My Profile Mail IMAP security for WebMail.&#10;&#10;The value can be: 0: Don't enable security. 1: Enable security.</string>
      <string id="iSMTPPort_Acrobat">WebMail SMTP Port</string>
      <string id="iSMTPPort_Acrobat_Explain">Identifies the My Profile Mail SMTP server port number for WebMail.&#10;&#10;The value can be: Any valid server port number.</string>
      <string id="iSMTPPort_Acrobat_opt0">25 (Standard SMTP)</string>
      <string id="iSMTPPort_Acrobat_opt1">465 (SMTP over SSL)</string>
      <string id="iSMTPPort_Acrobat_opt2">587 (SMTP Submission / TLS)</string>
      <string id="iSMTPSecurity_Acrobat">WebMail SMTP Security</string>
      <string id="iSMTPSecurity_Acrobat_Explain">Specifies whether to enable the My Profile Mail SMTP security for WebMail.&#10;&#10;The value can be: 0: Don't enable security. 1: Enable security.</string>

      <!-- ======================================== -->
      <!--          Startup and Experience          -->
      <!-- ======================================== -->

      <string id="bShowMsgAtLaunch_Acrobat">Adobe Messages at Launch</string>
      <string id="bShowMsgAtLaunch_Acrobat_Explain">Show Adobe messages at product launch.&#10;&#10;Also hides Share Feedback, EOL warnings, profile prompts, and the Home banner.&#10;&#10;Values:&#10;0 = hide&#10;1 = show</string>
      <string id="bAllowUserToChangeMsgPrefs_Acrobat">Allow Users to Change Message Preferences</string>
      <string id="bAllowUserToChangeMsgPrefs_Acrobat_Explain">Locks the features associated with bShowMsgAtLaunch and bDontShowMsgWhenViewingDoc so that end users can't change the settings.&#10;&#10;Possible values include:&#10;0: Locks the feature so end users can't change the settings&#10;1: Allows users to change the settings. A value of 1 has the same effect as this key not existing at all</string>
      <string id="bToggleNotifications_Acrobat">Desktop Notifications</string>
      <string id="bToggleNotifications_Acrobat_Explain">Specifies whether to disable all in-product and desktop notifications.&#10;&#10;When 0 (or null), feature-specific notifications are managed via the related service preference. When set to 1, this preference disables all notifications irrespective of the values of all other keys.&#10;&#10;Possible values include:&#10;0: Enable desktop notifications&#10;1: Disable all desktop notifications</string>
      <string id="bShowWelcomeScreen_Acrobat">Disable Welcome Screen</string>
      <string id="bShowWelcomeScreen_Acrobat_Explain">Specifies whether to show the Welcome screen at product launch.&#10;&#10;When enabled (DWORD 0), the Welcome screen is disabled.&#10;&#10;Possible values include:&#10;0: Do not show Welcome screen&#10;1: Show Welcome screen</string>
      <string id="bToggleFTE_Acrobat">First Time Experience</string>
      <string id="bToggleFTE_Acrobat_Explain">First Time Experience (welcome tour and page).&#10;&#10;Also disabled when bUpdater, bToggleAdobeDocumentServices, bToggleAdobeSign, bTogglePrefsSync, or bToggleWebConnectors is set.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bDontShowMsgWhenViewingDoc_Acrobat">Hide Adobe Messages on Document Open</string>
      <string id="bDontShowMsgWhenViewingDoc_Acrobat_Explain">Specifies whether to show messages from Adobe when a document opens.&#10;&#10;This preference also controls messages in the right-hand pane for 12.x and later products as well as the &quot;Learn More&quot; link, including the &quot;Start Free Trial&quot; message promoting Acrobat.&#10;&#10;Possible values include:&#10;0: Don't show messages from Adobe when a document opens&#10;1: Show messages from Adobe when a document opens</string>
      <string id="bEnableBellButton_Acrobat">Hide In-Product Notifications Bell</string>
      <string id="bEnableBellButton_Acrobat_Explain">Specifies whether to hide in-product messages.&#10;&#10;A value of 1 hides notifications, but the product still fetches and caches them.&#10;&#10;Possible values include:&#10;0: Show in-product notifications&#10;1: Hide in-product notifications</string>
      <string id="bToggleShareFeedback_Acrobat">Hide Send Feedback Icon</string>
      <string id="bToggleShareFeedback_Acrobat_Explain">Specifies whether to show the Send Feedback icon.&#10;&#10;By default, the UI displays a feedback icon so that users can easily send feedback to Adobe with one click. This preference replaces bUsageMeasurement for 12.x and later products. Setting bShowMsgAtLaunch to 0 also hides the icon.&#10;&#10;Possible values include:&#10;0: Hide the icon&#10;1: Show the icon</string>
      <string id="bToggleToDoList_Acrobat">Home Screen To Do List</string>
      <string id="bToggleToDoList_Acrobat_Explain">Specifies whether to show a &quot;to do&quot; list on the Home screen.&#10;&#10;By default, the Home screen displays a list of action items such as Take a Tour, Export PDF, and so on. For details, see the What's New .&#10;&#10;Possible values include:&#10;0: Enable the feature&#10;1: Disable the feature</string>
      <string id="bIsSCReducedModeEnforcedEx_Acrobat">Reader mode on Acrobat (Unified x64)</string>
      <string id="bIsSCReducedModeEnforcedEx_Acrobat_Explain">Enforce Reader-like reduced mode on Unified Acrobat (64-bit MUI).&#10;&#10;Opens PDFs without Adobe ID sign-in.&#10;&#10;Values:&#10;0 = not enforced&#10;1 = enforced. May require additional cIPM values per Adobe enterprise KB</string>
      <string id="bShowScanTabInHomeView_Acrobat">Scan Tab in Home View</string>
      <string id="bShowScanTabInHomeView_Acrobat_Explain">Specifies whether to disable the Scan tab in Home view.&#10;&#10;When enabled, links to scans appear under the Scan tab in the Home view.&#10;&#10;Possible values include:&#10;0: Hide the scan tab&#10;1: Show the Scan tab</string>
      <string id="bToggleNotificationToasts_Acrobat">Show Desktop Notification Toasts</string>
      <string id="bToggleNotificationToasts_Acrobat_Explain">Specifies whether to hide desktop notifications.&#10;&#10;A value of 1 hides notifications, but the product still fetches and caches them.&#10;&#10;Possible values include:&#10;0: Show desktop notifications&#10;1: Hide desktop notifications</string>
      <string id="bTogglePDFOwnershipToasts_Acrobat">Show PDF Ownership Notification</string>
      <string id="bTogglePDFOwnershipToasts_Acrobat_Explain">Specifies whether to show a notification on machine startup that allows the user to make Acrobat the default PDF viewer.&#10;&#10;When enabled and both Acrobat and Reader are installed, the user can click on the notification to change the default PDF viewer.&#10;&#10;Possible values include:&#10;0: Show PDF ownership notification on application startup&#10;1: Don't show ownership notification</string>
      <string id="bToggleToDoTiles_Acrobat">Show To Do Cards in Recent Tab</string>
      <string id="bToggleToDoTiles_Acrobat_Explain">Specifies whether to show To Do Cards in the Recent Tab view&#10;&#10;To Do cards list potential action items for members of certain workflows (for example, collaborative reviews). When set to 1, To Do cards do not appear in the Recent tab.&#10;&#10;Possible values include:&#10;0 or null: Show cards for unaccepted workflows (reviews, views and sign)&#10;1: Hide cards for unaccepted workflows (reviews, views and sign)</string>
      <string id="bUsageMeasurement_Acrobat">Usage Measurement (legacy)</string>
      <string id="bUsageMeasurement_Acrobat_Explain">Legacy master switch for usage measurement and analytics.&#10;&#10;Superseded by bToggleShareFeedback in 12.x and later, but still honored on some builds. When disabled (DWORD 0), usage measurement is off.&#10;&#10;Possible values include:&#10;0: Disable usage measurement&#10;1: Enable usage measurement</string>
      <string id="bWhatsNewExp_Acrobat">What's New Experience</string>
      <string id="bWhatsNewExp_Acrobat_Explain">Specifies whether to disable the What's New experience.&#10;&#10;This feature was phased in incrementally over 2022. When enabled, the default user on first launch will see a What's New screen as well as a See new features notification. These UI items appear once.&#10;&#10;Possible values include:&#10;0: Enable the What's New experience&#10;1: Disable</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="bDisableThirdPartyPluginNotif_Acrobat">32-Bit Plugin Upgrade Notification</string>
      <string id="bDisableThirdPartyPluginNotif_Acrobat_Explain">Specifies whether to notify users with 32 bit plugins that the app will soon update to 64 bit.&#10;&#10;32 bit plugins will not work in the 64 bit app. The notification provides a &quot;Learn more&quot; link that provides additional details about how to upgrade their plugin.&#10;&#10;Possible values include:&#10;0: Do not warn the user about 32 bit plugins&#10;1: Do warn the user</string>
      <string id="bEnableAutoDockUndockHUD_Acrobat">Auto Dock HUD Bar</string>
      <string id="bEnableAutoDockUndockHUD_Acrobat_Explain">Specifies whether to automatically dock and undock the HUD bar based on the window size.&#10;&#10;Possible values include:&#10;0: Disable automatic behavior&#10;1: Enable auto docking and undocking</string>
      <string id="bHasAcrobatConsent_Acrobat">Auto Open Acrobat from Reader</string>
      <string id="bHasAcrobatConsent_Acrobat_Explain">Specifies whether the Reader process should automatically open Acrobat for the current file.&#10;&#10;PDF ownership does not change. Reader will continue as the default PDF viewer on this machine.&#10;&#10;Possible values include:&#10;0: Don't automatically use Acrobat&#10;1: Use Acrobat</string>
      <string id="bCrashReporterEnabled_Acrobat">Crash Reporter Dialog</string>
      <string id="bCrashReporterEnabled_Acrobat_Explain">Specifies whether to show the crash reporter dialog on application crash (Windows only).&#10;&#10;This feature is part of the CrashReporter integration on Windows. The dialog allows users to send crash logs to the CrashReporter team.&#10;&#10;Possible values include:&#10;0: Don't show the dialog&#10;1: Show the dialog</string>
      <string id="bAcroSuppressOpenInReader_Acrobat">Disable Chrome PDF Extension</string>
      <string id="bAcroSuppressOpenInReader_Acrobat_Explain">Specifies whether to disable and lock the PDF viewer Chrome extension.&#10;&#10;See also ENABLE_CHROMEEXT .&#10;&#10;Possible values include:&#10;0 or null: Extension is enabled; users can open PDFs in a browser with Acrobat Reader&#10;1: Disable the browser-based PDF viewer. A tooltip says &quot;The Acrobat Reader extension is currently disabled. Please contact your IT admin.&quot;</string>
      <string id="bSuppressMessageBar_Acrobat">Hide Document Message Bar</string>
      <string id="bSuppressMessageBar_Acrobat_Explain">Prevents the appearance of the document message bar.&#10;&#10;Adversely affects signing when preview mode is used.</string>
      <string id="bDisablePDFHandlerSwitching_Acrobat">Lock Default PDF Viewer</string>
      <string id="bDisablePDFHandlerSwitching_Acrobat_Explain">Lock the default PDF viewer handler.&#10;&#10;Adobe PDF handler only; does not switch to or from non-Adobe products. UI changes invoke the installer (HKLM), not HKCU.&#10;&#10;Values:&#10;0 or null = allow change&#10;1 = block change</string>
      <string id="bDisableThumbnailPreviewHandler_Acrobat">Lock PDF Thumbnails in Explorer</string>
      <string id="bDisableThumbnailPreviewHandler_Acrobat_Explain">Lock Explorer PDF thumbnail preview checkbox.&#10;&#10;Values:&#10;0 = users can enable via installer&#10;1 = disable and lock</string>
      <string id="PatchCleanFlag_Acrobat">Patch Cache Cleanup</string>
      <string id="PatchCleanFlag_Acrobat_Explain">Clean cached MSI/MSP patches on next update.&#10;&#10;Patches accumulate under ProgramData\Adobe\ARM and Windows\Installer.&#10;&#10;Values:&#10;0 = no cleanup&#10;1 = cleanup on next update</string>
      <string id="bUpdater_Updater_Acrobat">Product Updater</string>
      <string id="bUpdater_Updater_Acrobat_Explain">Controls Adobe Acrobat/Reader product updates.&#10;&#10;Disables or enables automatic product updates (distinct from cloud services in FeatureLockDown\cServices).&#10;&#10;Values:&#10;0 = disable product updates&#10;1 = enable product updates</string>
      <string id="bShouldUseScalableCursor_Acrobat">Scalable Cursor</string>
      <string id="bShouldUseScalableCursor_Acrobat_Explain">Specifies whether to disable the scalable cursor.&#10;&#10;Because Citrix does not provide support for scalable cursors (32-bit cursors with an alpha channel) in legacy graphics mode, scalable cursor performance may be impaired on Citrix. Use this setting to improve performance on Citrix by using a non-scalable cursor.&#10;&#10;Possible values include:&#10;0: Don't use a scalable cursor&#10;1: Use a scalable cursor</string>
      <string id="dSplitBySizeMaxSize_Acrobat">Split by Size Maximum (MB)</string>
      <string id="dSplitBySizeMaxSize_Acrobat_Explain">Maximum MB per split file.&#10;&#10;Allowed range 50-1024; out-of-range values default to 50.</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt0">50 MB (minimum)</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt1">100 MB</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt2">250 MB</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt3">500 MB</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt4">1024 MB (maximum)</string>
      <string id="bFavoritesFeaturesLockDown_Acrobat">Starred Files Feature</string>
      <string id="bFavoritesFeaturesLockDown_Acrobat_Explain">Specifies whether to disable and lock the starred file feature.&#10;&#10;A starred file is somewhat similar to a &quot;favorited&quot; file. This preference overrides bFavoritesStripInRFL.&#10;&#10;Possible values include:&#10;0: Disable and lock starred files in the recent files list&#10;1: Use bFavoritesStripInRFL to control this feature</string>

      <!-- ======================================== -->
      <!--                  Upsell                  -->
      <!-- ======================================== -->

      <string id="bToggleBillingIssue_Acrobat">Disable Billing Issue Call to Action</string>
      <string id="bToggleBillingIssue_Acrobat_Explain">Specifies whether to show a Call to Action UI item in the top bar if a billing issue is detected.&#10;&#10;Possible values include:&#10;0 or null: Disable the CTA UI&#10;1: Show the CTA UI</string>
      <string id="bToggleSophiaWebInfra_Acrobat">Disable Promotional Campaign Messages</string>
      <string id="bToggleSophiaWebInfra_Acrobat_Explain">Specifies whether to show users messages which promote (Trials, Acrobat, PDF Pack etc.)&#10;&#10;Subscription users may be prompted to download Acrobat. Theoretically, this preference does not interact with any other upsell preferences.&#10;&#10;Possible values include:&#10;0 or null: Disable campaigns in Reader's right-hand pane bottom banner&#10;1: Enable campaigns</string>
      <string id="bMerchandizingEnabled_Acrobat">Express Templates in Create PDF</string>
      <string id="bMerchandizingEnabled_Acrobat_Explain">Specifies whether to show the Express Templates options in Acrobat's Create PDF UI.&#10;&#10;This feature is an experiment not shown to all users.&#10;&#10;Possible values include:&#10;0: Do not show the templates&#10;1: Show the templates</string>
      <string id="bLimitPromptsFeatureKey_Acrobat">Limit Informational Prompts</string>
      <string id="bLimitPromptsFeatureKey_Acrobat_Explain">Specifies whether to limit the number of prompts a user will see in a 24 hour period.&#10;&#10;Prompts include items like tips, calls-to-action, and feature walk throughs. These are not necessarily upsell items.&#10;&#10;Possible values include:&#10;0: Don't restrict informational prompts&#10;1: Limit prompts to 1 per day and 3 per week</string>
      <string id="bToggleDCAppCenter_Acrobat">Show App Center UI</string>
      <string id="bToggleDCAppCenter_Acrobat_Explain">App Center and get-apps banner on Home.&#10;&#10;Values:&#10;0 or null = show&#10;1 = hide</string>
      <string id="bAcroSuppressUpsell_Acrobat">Show Upgrade Prompts</string>
      <string id="bAcroSuppressUpsell_Acrobat_Explain">Disable upgrade and upsell messages (12.x+).&#10;&#10;Controls Reader tool purchase and Standard-to-Professional prompts.&#10;&#10;Values:&#10;0 or null = show upsell&#10;1 = disable upsell</string>
      <string id="bEnableTrialistLaunchCard_Acrobat">Trial Purchase Prompt</string>
      <string id="bEnableTrialistLaunchCard_Acrobat_Explain">Specifies whether to prompt Acrobat trial users to complete the purchase.&#10;&#10;Possible values include:&#10;0: Disable the purchase Acrobat prompt&#10;1: Don't disable the prompt</string>
      <!-- ======================================== -->
      <!--                                          -->
      <!--   Reader DC (32-bit) - policy strings    -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--           Cloud and Connectors           -->
      <!-- ======================================== -->

      <string id="bToggleFillSign_Reader">Adobe Fill &amp; Sign</string>
      <string id="bToggleFillSign_Reader_Explain">Disables Adobe Fill and Sign.&#10;&#10;Possible values include:&#10;0: Enable Adobe Fill and Sign&#10;1: Disable Adobe Fill and Sign</string>
      <string id="bBoxConnectorEnabled_Reader">Box Cloud Connector</string>
      <string id="bBoxConnectorEnabled_Reader_Explain">Specifies whether to enable connection to the Box cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to Box&#10;1: Enable connection to Box</string>
      <string id="bToggleAdobeDocumentServices_Reader">Document Cloud Services</string>
      <string id="bToggleAdobeDocumentServices_Reader_Explain">Enable Document Cloud services (except those controlled by other prefs).&#10;&#10;Does not affect Sign, prefs sync, or third-party connectors. Reader removes Create/Export/Organize/Combine without subscription. Use bUpdater to disable all services.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bToggleDocumentCloud_Reader">Document Cloud Storage</string>
      <string id="bToggleDocumentCloud_Reader_Explain">Specifies whether to enable Document Cloud storage.&#10;&#10;DC storage is enabled by default.&#10;&#10;Possible values include:&#10;0: Enable Document Cloud storage&#10;1: Disable Document Cloud storage</string>
      <string id="bDropboxConnectorEnabled_Reader">Dropbox Cloud Connector</string>
      <string id="bDropboxConnectorEnabled_Reader_Explain">Specifies whether to enable connection to the Dropbox cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to Dropbox&#10;1: Enable connection to Dropbox</string>
      <string id="bEnableGentech_Reader">Generative AI Technology</string>
      <string id="bEnableGentech_Reader_Explain">Specifies whether to enable generative AI features in Acrobat and Reader.&#10;&#10;Possible values include:&#10;0: Disable generative AI features&#10;1: Enable generative AI features. Generative AI capabilities may rely on cloud services; verify organizational policies and Adobe documentation for data handling</string>
      <string id="bGoogleDriveConnectorEnabled_Reader">Google Drive Connector</string>
      <string id="bGoogleDriveConnectorEnabled_Reader_Explain">Specifies whether to enable connection to the Google Drive cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to Google Drive&#10;1: Enable connection to Google Drive</string>
      <string id="bToggleSendACopy_Reader">Hide Fill &amp; Sign Send a Copy Button</string>
      <string id="bToggleSendACopy_Reader_Explain">Specifies whether to hide the Send a Copy button from the Fill &amp; Sign tool in Acrobat and Reader.&#10;&#10;Possible values include:&#10;0: Hide the button&#10;1: Show the button</string>
      <string id="bSuppressSignOut_Reader">Hide Sign Out Menu Item</string>
      <string id="bSuppressSignOut_Reader_Explain">Specifies whether the sign-in and sign-out Help menu item should be enabled.&#10;&#10;Possible values include:&#10;0 or null: Don't disable the menu item&#10;1: Disable the Help menu item</string>
      <string id="bOneDriveConnectorEnabled_Reader">OneDrive Connector</string>
      <string id="bOneDriveConnectorEnabled_Reader_Explain">Specifies whether to enable connection to the OneDrive cloud when bToggleWebConnectors is set to 1.&#10;&#10;Overrides a bToggleWebConnectors value of 1. Only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable connection to OneDrive&#10;1: Enable connection to OneDrive</string>
      <string id="bTogglePrefsSync_Reader">Preferences Synchronization</string>
      <string id="bTogglePrefsSync_Reader_Explain">Sync desktop preferences across signed-in devices.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled and locked</string>
      <string id="bUpdater_Updates_Reader">Services &amp; Web-Plugin Updates</string>
      <string id="bUpdater_Updates_Reader_Explain">Web-plugin updates and cloud services.&#10;&#10;Disables all services including sign-in. Not the same as FeatureLockDown\bUpdater (product updates).&#10;&#10;Values:&#10;0 = disable services and component updates&#10;1 = enable</string>
      <string id="bToggleWebConnectors_Reader">Third-Party Cloud Connectors</string>
      <string id="bToggleWebConnectors_Reader_Explain">Third-party cloud storage connectors (Continuous track).&#10;&#10;Controls Box, OneDrive, and Dropbox (not SharePoint). Disables Home, Add Account, and custom Open/Save entry points.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="bUIDensityAutoDetectionEnabled_Reader">Auto UI Density Detection</string>
      <string id="bUIDensityAutoDetectionEnabled_Reader_Explain">Specifies whether to disable the auto detection logic and bezel for changing Acrobat's display size.&#10;&#10;By default, the UI is enabled so that a user may change the display size based on device screen size, resolution, and monitor scaling. 0: Disable the UI. 1: Show the UI.</string>
      <string id="bEnableContextualTips_Reader">Contextual Help Tips</string>
      <string id="bEnableContextualTips_Reader_Explain">Controls whether to automatically display help tips based on the current context.&#10;&#10;Possible values include:&#10;0: Disable contextual tips&#10;1: Enable tips</string>
      <string id="bEnableContextualToolbar_Reader">Contextual Toolbar</string>
      <string id="bEnableContextualToolbar_Reader_Explain">Specifies whether to show the context toolbar (popup) when selecting a PDF object.&#10;&#10;When enabled, a popup, floating toolbar appears when a user interacts with a PDF. For example, selecting text displays text markup tools. Selecting an image displays sticky note and editing tools.&#10;&#10;Possible values include:&#10;0: Don't show context toolbars&#10;1: Show toolbars</string>
      <string id="bEnableExtractPageRange_Reader">Extract Page Range UI</string>
      <string id="bEnableExtractPageRange_Reader_Explain">Specifies whether to show the page range UI in the Extract Page dialog.&#10;&#10;0: Don't show the page range UI. 1: Show the page range UI.</string>
      <string id="bDisableAcrobatShortcutCustomization_Reader">Lock Tool Shortcut Customization</string>
      <string id="bDisableAcrobatShortcutCustomization_Reader_Explain">Prevents end users from modifying the tool shortcuts in the right hand pane.&#10;&#10;Possible values include:&#10;0: Don't disable shortcuts&#10;1: Disable shortcuts</string>
      <string id="bEnableAV2Enterprise_Reader">Modern Viewer</string>
      <string id="bEnableAV2Enterprise_Reader_Explain">Specifies whether to enable the Modern Viewer.&#10;&#10;The new app UI is rolling out in phases over 2023. As of June, 25% of users will see the updated user interface. This preference may interact with bShownViewerOnboarding and bEnableAV2 .&#10;&#10;Possible values include:&#10;0: Don't show the Modern Viewer&#10;1: Show the Modern Viewer</string>
      <string id="bEnableRCMNewPOPUp_Reader">New Right-Click Context Menu</string>
      <string id="bEnableRCMNewPOPUp_Reader_Explain">Specifies whether to disable the new context menu and use the legacy version.&#10;&#10;A new right-click context menu displays icons and additional menu options. 0: Disable the new context menu. 1: Enable the new menu.</string>
      <string id="bFindMoreWorkflowsOnline_Reader">Online Actions Library Link</string>
      <string id="bFindMoreWorkflowsOnline_Reader_Explain">Specifies whether to show the menu item that opens the online Actions file library.&#10;&#10;Possible values include: 0: Disable the menu item. 1 or null: Don't disable the menu item.</string>
      <string id="bFindMoreCustomizationsOnline_Reader">Online Tool Set Exchange Link</string>
      <string id="bFindMoreCustomizationsOnline_Reader_Explain">Specifies whether to show the menu item that opens the online Acrobat Tool Set Exchange.&#10;&#10;Possible values include: 0: Disable the menu item. 1 or null: Don't disable the menu item.</string>
      <string id="bRCMCombineFeatureKey_Reader">Show Combine Files Context Menu</string>
      <string id="bRCMCombineFeatureKey_Reader_Explain">Specifies whether to display the Combine Files item in a document's right-click context menu.&#10;&#10;This preference only applies to machines that display the Modern Viewer (a phased rollout over 2023). When the Modern Viewer is disabled, admins can toggle the Combine Files UI off/on.&#10;&#10;Possible values include:&#10;0: Don't show the Combine Files UI&#10;1: Do show the Combine Files UI</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="bGlobalBarMenuFeatureKey_Reader">Create PDF Split Menu</string>
      <string id="bGlobalBarMenuFeatureKey_Reader_Explain">Specifies whether to show the Create Split Menu under Create a PDF menu item.&#10;&#10;Possible values include:&#10;0: Don't show the Create Split menu&#10;1: Show the Create Split menu</string>
      <string id="bEnableFrictionlessInChromeExtn_Reader">Online Create PDF in Reader</string>
      <string id="bEnableFrictionlessInChromeExtn_Reader_Explain">Specifies whether to show Reader users the online Create PDF service option.&#10;&#10;Possible values include:&#10;0 or null: Don't show the Create PDF UI&#10;1: Show the convert web content to PDF UI</string>
      <string id="bIgnoreDataSchema_Reader">Restrict Form Data to Schema</string>
      <string id="bIgnoreDataSchema_Reader_Explain">Specifies whether all data in a form is saved rather than only data related to the form's schema.&#10;&#10;Possible values include:&#10;null: Save form data even when it's not part of a schema&#10;1: Save only form data that's part of the schema</string>

      <!-- ======================================== -->
      <!--         Microsoft Purview (MIP)          -->
      <!-- ======================================== -->

      <string id="bMIPCheckPolicyOnDocSave_Reader">Check MIP Policy on Save</string>
      <string id="bMIPCheckPolicyOnDocSave_Reader_Explain">Lock MIP labeling checks on save (admin).&#10;&#10;Requires default or mandatory labeling in the Purview portal. Grays out related Preferences UI. HKLM lockdown, not per-user MicrosoftAIP prefs.&#10;&#10;Values:&#10;0 = do not lock&#10;1 = lock enabled</string>
      <string id="bMIPLabelling_Reader">Enable MIP Labelling</string>
      <string id="bMIPLabelling_Reader_Explain">Lock Enable MIP labeling in Preferences ) Security.&#10;&#10;Machine-level lockdown; complements per-user MicrosoftAIP prefs.&#10;&#10;Values:&#10;0 = do not lock&#10;1 = lock enabled</string>
      <string id="bEnableDKEAdmin_Reader">MIP Double Key Encryption</string>
      <string id="bEnableDKEAdmin_Reader_Explain">Locks double key encryption (DKE) label support for Microsoft Purview Information Protection.&#10;&#10;Machine-level FeatureLockDown lockdown for MIP DKE workflows.&#10;&#10;Possible values include:&#10;0: Lock DKE disabled&#10;1: Lock DKE enabled</string>
      <string id="bMIPExternalAuthAdmin_Reader">MIP External Browser Auth</string>
      <string id="bMIPExternalAuthAdmin_Reader_Explain">Locks browser-based authentication for Microsoft Purview Information Protection operations.&#10;&#10;Machine-level FeatureLockDown lockdown.&#10;&#10;Possible values include:&#10;0: Lock external browser auth disabled&#10;1: Lock external browser auth enabled</string>
      <string id="iMIPCloud_Reader">MIP Sovereign Cloud</string>
      <string id="iMIPCloud_Reader_Explain">Locks which Microsoft cloud instance Acrobat and Reader use for MIP SDK operations.&#10;&#10;Machine-level FeatureLockDown lockdown. Relevant for sovereign and government tenants. MIP SDK Cloud enum values: 0: Unknown. 1: Custom. 2: Test. 3: Commercial (default/global). 4: Germany. 5: US DoD. 6: US GCC. 7: US GCC High. 8: US Sec. 9: US Nat. 10: China.</string>
      <string id="iMIPCloud_Reader_opt0">Unknown</string>
      <string id="iMIPCloud_Reader_opt1">Custom</string>
      <string id="iMIPCloud_Reader_opt2">Test</string>
      <string id="iMIPCloud_Reader_opt3">Commercial</string>
      <string id="iMIPCloud_Reader_opt4">Germany</string>
      <string id="iMIPCloud_Reader_opt5">US DoD</string>
      <string id="iMIPCloud_Reader_opt6">US GCC</string>
      <string id="iMIPCloud_Reader_opt7">US GCC High</string>
      <string id="iMIPCloud_Reader_opt8">US Sec</string>
      <string id="iMIPCloud_Reader_opt9">US Nat</string>
      <string id="iMIPCloud_Reader_opt10">China</string>
      <string id="bSilentAuth_Reader">Suppress OS Auth Prompts (MIP)</string>
      <string id="bSilentAuth_Reader_Explain">Locks whether operating-system authentication prompts are suppressed during MIP operations.&#10;&#10;By default, OS-driven auth prompts for MIP are suppressed. Set policy Disabled to write DWORD 0 and allow OS auth prompts (useful when troubleshooting AADSTS50020-type errors).&#10;&#10;Possible values include:&#10;0: Allow OS auth prompts&#10;1: Suppress OS auth prompts</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="bEnable3D_Reader">3D Content in PDFs</string>
      <string id="bEnable3D_Reader_Explain">Specifies whether to trust and render 3D content in PDFs.&#10;&#10;This setting can override b3DEnableContent.&#10;&#10;Possible values include:&#10;0: Don't render 3D content&#10;1: Trust and render 3D files</string>
      <string id="bEnableProtectedModeAppContainer_Reader">AppContainer Sandbox</string>
      <string id="bEnableProtectedModeAppContainer_Reader_Explain">Specifies whether to enable the AppContainer sandbox.&#10;&#10;Possible values include:&#10;0: Disable Microsoft's AppContainer sandbox&#10;1: Enable Microsoft's AppContainer sandbox</string>
      <string id="bEnableBlacklistForOpenSave_Reader">Attachment Extension Blocklist in Dialogs</string>
      <string id="bEnableBlacklistForOpenSave_Reader_Explain">Hide tBuiltInPermList level-3 extensions from Open/Save dialogs.&#10;&#10;New behavior since build 21.011.20029; enabled by default.&#10;&#10;Values:&#10;0 = legacy behavior (extensions visible)&#10;1 = retain new behavior (hidden)</string>
      <string id="bDisableJavaScript_Reader">Block JavaScript Execution</string>
      <string id="bDisableJavaScript_Reader_Explain">Blocks and locks JavaScript execution in PDF documents, preventing users from bypassing via privileged locations.&#10;&#10;This lockable setting overrides bEnableJS and prevents users from re-enabling JavaScript through the Yellow Message Bar or Trusted Locations.&#10;&#10;Possible values include:&#10;0 or null: Don't disable JS&#10;1: Disable and lock JS</string>
      <string id="iFileAttachmentPerms_Reader">Block non-PDF file attachments</string>
      <string id="iFileAttachmentPerms_Reader_Explain">Block opening non-PDF/FDF file attachments.&#10;&#10;Values:&#10;0 = allow&#10;1 = block</string>
      <string id="bDisablePDFRedirectionActions_Reader">Block PDF Link Actions</string>
      <string id="bDisablePDFRedirectionActions_Reader_Explain">Specifies whether to block specific PDF actions (listed below) which result in opening a link.&#10;&#10;This preference does not block regular web links. Enabling this feature blocks PDF actions that open links, including GoToE, GoToR, Launch, Thread, Import Data, Export Form Data, Submit Form, and Reset Form.&#10;&#10;Possible values include:&#10;0 or null: Don't block these opening links&#10;1: Block links</string>
      <string id="bEnablePVCertificateBasedTrust_Reader">Certification Status in Protected View</string>
      <string id="bEnablePVCertificateBasedTrust_Reader_Explain">Specifies whether a document's certification status should appear in the Protected View document message bar.&#10;&#10;Possible values include:&#10;0: Don't show the document's certification status&#10;1: Do show the document's certification status</string>
      <string id="bEnhancedSecurityInBrowser_Reader">Enhanced Security in Browser</string>
      <string id="bEnhancedSecurityInBrowser_Reader_Explain">Enhanced security when running in the browser.&#10;&#10;GUI checkbox sets this with bEnhancedSecurityStandalone. On 8.x, use bEnhancedSecurityStandalone for both.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled</string>
      <string id="bEnhancedSecurityStandalone_Reader">Enhanced Security Standalone</string>
      <string id="bEnhancedSecurityStandalone_Reader_Explain">Enhanced security in the standalone application.&#10;&#10;GUI checkbox sets this with bEnhancedSecurityInBrowser. On 8.x, this controls both browser and standalone.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled</string>
      <string id="bEnableFlash_Reader">Flash Content in PDFs</string>
      <string id="bEnableFlash_Reader_Explain">Render Flash content in PDFs.&#10;&#10;Privileged locations do not override this setting.&#10;&#10;Values:&#10;0 = empty box and security warning&#10;1 = play if Flash player present</string>
      <string id="bProtectedMode_Reader">Protected Mode Sandbox</string>
      <string id="bProtectedMode_Reader_Explain">Enables Protected Mode which sandboxes Acrobat and Reader processes.&#10;&#10;Protected Mode should be enabled to protect user systems and data.&#10;&#10;Possible values include:&#10;0: Don't enable protected mode&#10;1: Do enable protected mode</string>
      <string id="bUseWhitelistConfigFile_Reader">Protected Mode Whitelist Config</string>
      <string id="bUseWhitelistConfigFile_Reader_Explain">Allows the use of the policy whitelist to allow behavior that Protected Mode would otherwise prevent.&#10;&#10;This preference just toggles the ability of the application to read policy files. For additional security-related details, refer to the Application Security Guide .</string>
      <string id="iUnlistedAttachmentTypePerm_Reader">Unlisted Attachment Type Permissions</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_Explain">Specifies the default permissions for file types that aren't listed in the default or user-specified lists.&#10;&#10;Possible values include:&#10;0: Prompt user without ability to set file type as Allowed (two choices: Open File, Never Allow). 1 (default): Prompt user with ability to Allow or Prohibit (three choices)&#10;2: Always open unlisted file types&#10;3: Never open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt0">Prompt without ability to allow (most restrictive prompt)</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt1">Prompt with ability to allow or prohibit (default)</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt2">Always open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt3">Never open unlisted file types (most restrictive)</string>

      <!-- ======================================== -->
      <!--     Security: Trust and Permissions      -->
      <!-- ======================================== -->

      <string id="bMSStoreTrusted_Reader">Allow Changes to Windows Certificate Store Trust</string>
      <string id="bMSStoreTrusted_Reader_Explain">Locks the UI so that end users cannot change the value set by iMSStoreTrusted.&#10;&#10;Set iMSStoreTrusted first, then use this preference to lock it. Allowable values include: 0: Lock the UI. 1: Same as null. Don't lock the UI.</string>
      <string id="bAllowInvisibleSig_Reader">Allow Invisible Signatures</string>
      <string id="bAllowInvisibleSig_Reader_Explain">Specifies whether to allow invisible certification signatures.&#10;&#10;False disables the menu option, prevents signing and certifying with invisible signatures, and limits JavaScript support by signature fields.</string>
      <string id="bAllowPasswordSaving_Reader">Allow Password Caching</string>
      <string id="bAllowPasswordSaving_Reader_Explain">Controls whether certain passwords can be cached to disk; for example, passwords for digital IDs.&#10;&#10;If false, users are prompted to enter a password every time one is required. Not all passwords are affected by this setting.</string>
      <string id="bEnableSignatureClear_Reader">Allow Signature Clearing</string>
      <string id="bEnableSignatureClear_Reader_Explain">Specifies whether to disable and lock the ability for a signer to clear their own signature.&#10;&#10;Possible values include:&#10;0: Disable signature clearing&#10;1: Enable signature clearing</string>
      <string id="bVerifyUseAlways_Reader">Always Use Specified Verify Handler</string>
      <string id="bVerifyUseAlways_Reader_Explain">Qualifies the use of aVerify.&#10;&#10;If true and aVerify is set to a handler name, then this handler is used to verify all signatures. If false, then the aVerify handler is used only to verify signatures when the handler specified by the signature dictionary Filter attribute is not present.</string>
      <string id="bDisableExpandEnvironmentVariables_Reader">Block User Library Trust in Protected View</string>
      <string id="bDisableExpandEnvironmentVariables_Reader_Explain">Allow user-specific paths as trusted locations in Protected View.&#10;&#10;When off, only static org-wide trusted locations apply. Paths like C:\Users\%username%\Desktop can be trusted when enabled.&#10;&#10;Values:&#10;0 = trust user locations&#10;1 = do not trust user locations</string>
      <string id="bWinCacheSessionHandles_Reader">Cache Digital ID Session Handles</string>
      <string id="bWinCacheSessionHandles_Reader_Explain">Specifies whether to retain cryptographic service provider (CSP) handles when a user authenticates to a digital ID.&#10;&#10;If true, a user does not have to re-authenticate to use the ID unless they log out or the session ends. The impact of this preference will vary based on the CSP in use; however, the setting does not affect the Windows CSPs.</string>
      <string id="bDisableOSTrustedSites_Reader">Disable IE Trusted Sites as Privileged Locations</string>
      <string id="bDisableOSTrustedSites_Reader_Explain">Locks the ability to treat IE trusted sites as privileged locations either on or off so the users can't change the bTrustOSTrustedSites value via the user interface.&#10;&#10;If set, bTrustOSTrustedSites is simply ignored.&#10;&#10;Possible values include:&#10;0 or null: Enables and locks trusting sites from IE&#10;1: Disables and locks trusting sites from IE</string>
      <string id="bAllowAPSConfig_Reader">LiveCycle RMS Server Config</string>
      <string id="bAllowAPSConfig_Reader_Explain">Prevents a LiveCycle Right Management Server from being configured by disabling the menu option in the Security Settings Console.&#10;&#10;By default, configuration is allowed.</string>
      <string id="bReqRevCheck_Reader">Lock Revocation Check Setting</string>
      <string id="bReqRevCheck_Reader_Explain">Locks Security\cASPKI\cASPKI\cVerify\iReqRevCheck and disables the user interface item.</string>
      <string id="bReasons_Reader">Lock Signing Reasons Settings</string>
      <string id="bReasons_Reader_Explain">Prevents users from modifying reason settings.&#10;&#10;v8.1: If locked and cReasons is empty, bAllowSigningReasons is 0 and read only. If locked and cReasons has values, then bAllowSigningReasons is true and read only.</string>
      <string id="bDisableTrustedFolders_Reader">Lock Trusted Folders and Files</string>
      <string id="bDisableTrustedFolders_Reader_Explain">Disable and lock trusted folders and files.&#10;&#10;Prevents users from adding folder or file privileged locations.&#10;&#10;Values:&#10;0 or null = allowed&#10;1 = disabled and locked</string>
      <string id="bDisableTrustedSites_Reader">Lock Trusted Host Sites</string>
      <string id="bDisableTrustedSites_Reader_Explain">Disable and lock host-based privileged locations.&#10;&#10;Values:&#10;0 or null = enable and lock host-based locations&#10;1 = disable and lock host-based locations</string>
      <string id="bEnableCEFBasedUI_Reader">Modern Digital Signature UI</string>
      <string id="bEnableCEFBasedUI_Reader_Explain">Modern CEF-based digital signature UI.&#10;&#10;All values disable the user preference toggle. Block self-signed ID creation (post-June 2016) with bSelfSignCertGen=0 and bEnableCEFBasedUI=0.&#10;&#10;Values:&#10;0 = legacy UI&#10;1 = modern UI</string>
      <string id="bUseTSAsSigningTime_Reader">Show Timestamp in Signature</string>
      <string id="bUseTSAsSigningTime_Reader_Explain">Show timestamp server time in signature appearance.&#10;&#10;Default uses local clock. Requires bReqSigPropRetrieval=1 (HKCU). Verify time against iMaxClockSkew (default 65 min).&#10;&#10;Values:&#10;0 = hide timestamp&#10;1 = show timestamp</string>
      <string id="bAllowReasonWhenSigning_Reader">Signing Reason UI</string>
      <string id="bAllowReasonWhenSigning_Reader_Explain">Specifies whether the reason UI will appear during signing.&#10;&#10;The preference can be overridden by a document seed value set on a field. For 8.1 and later, if cReasons is locked and is empty, bAllowSigningReasons is 0 and read only (The UI is turned off). If cReasons is locked and has values, then bAllowSigningReasons is true and read only.</string>
      <string id="bEnableCertificateBasedTrust_Reader">Trust Certified Documents</string>
      <string id="bEnableCertificateBasedTrust_Reader_Explain">Trust certified documents as privileged locations (admin lock).&#10;&#10;Lockable counterpart to bTrustCertifiedDocuments. Does not apply in Protected View.&#10;&#10;Values:&#10;0 or null = not trusted&#10;1 = trusted</string>
      <string id="iUnknownURLPerms_Reader">Unknown URL Access Policy</string>
      <string id="iUnknownURLPerms_Reader_Explain">Access policy for URLs not in the user list.&#10;&#10;Overrides privileged location host settings in some versions.&#10;&#10;Values:&#10;1 = ask&#10;2 = allow&#10;3 = block</string>
      <string id="iUnknownURLPerms_Reader_opt0">Always ask</string>
      <string id="iUnknownURLPerms_Reader_opt1">Always allow</string>
      <string id="iUnknownURLPerms_Reader_opt2">Always block</string>
      <string id="iURLPerms_Reader">URL Access Permissions</string>
      <string id="iURLPerms_Reader_Explain">Allow, block, or custom website access from PDF files.&#10;&#10;This Computer-scope policy writes to HKLM FeatureLockDown and is the correct enforcement path. Setting this policy locks the Trust Manager dialog for all users and satisfies the DISA STIG automated scan (V-213172 / ARDC-CN-000025). Allow or Block resets tHostPerms; Custom uses tHostPerms.&#10;&#10;Possible values include:&#10;0: Custom Setting (uses tHostPerms URL list)&#10;1: Block all websites&#10;2: Allow all websites</string>
      <string id="iURLPerms_Reader_opt0">Custom Setting (uses tHostPerms URL list)</string>
      <string id="iURLPerms_Reader_opt1">Block all websites</string>
      <string id="iURLPerms_Reader_opt2">Allow all websites</string>
      <string id="bValidateOnOpen_Reader">Validate Signatures on Open</string>
      <string id="bValidateOnOpen_Reader_Explain">Specifies whether to automatically validate all signatures on document open.&#10;&#10;Note that the lockable setting does not configure the feature; instead, it locks what is set in HKCU and the user interface. 0: Don't validate signatures on document open. 1: Validate signatures on document open.</string>

      <!-- ======================================== -->
      <!--           Sharing and Features           -->
      <!-- ======================================== -->

      <string id="bToggleAdobeSign_Reader">Adobe Acrobat Sign</string>
      <string id="bToggleAdobeSign_Reader_Explain">Adobe Acrobat Sign (Send for Signature).&#10;&#10;On Continuous track, also set bToggleManageSign.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bToggleSendAndTrack_Reader">Adobe Send &amp; Track</string>
      <string id="bToggleSendAndTrack_Reader_Explain">Disables Adobe Send and Track (some UI is renamed to &quot;Share&quot; since October, 2018)&#10;&#10;Possible values include:&#10;0: Enable Adobe Send and Track&#10;1: Disable Adobe Send and Track</string>
      <string id="bDisableSharePointFeatures_Reader">Disable SharePoint &amp; Office 365 Integration</string>
      <string id="bDisableSharePointFeatures_Reader_Explain">Disable SharePoint and Office 365 integration.&#10;&#10;Disables SharePoint detection, check-out prompt, and SharePoint menu items.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bDisableWebmail_Reader">Disable WebMail Integration</string>
      <string id="bDisableWebmail_Reader_Explain">Disable WebMail integration.&#10;&#10;Values:&#10;0 = enable WebMail profiles&#10;1 = disable. With bSendMailShareRedirection=1, the email icon attaches the PDF directly</string>
      <string id="bToggleAdobeReview_Reader">Document Cloud Review Service</string>
      <string id="bToggleAdobeReview_Reader_Explain">Document Cloud Review service UI.&#10;&#10;When disabled, removes cloud review UI and legacy review types are used.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bSendMailShareRedirection_Reader">Email Icon Attach to Email Behavior</string>
      <string id="bSendMailShareRedirection_Reader_Explain">Email icon attaches document instead of opening the share pane.&#10;&#10;Values:&#10;0 or null = open share pane&#10;1 = attach to email</string>
      <string id="bMixRecentFilesFeatureLockDown_Reader">Hide Shared Files from Recent List</string>
      <string id="bMixRecentFilesFeatureLockDown_Reader_Explain">Show shared files in the Recent list.&#10;&#10;Covers shares, reviews, signing, and Send and Track workflows.&#10;&#10;Values:&#10;0 = add to Recent&#10;1 = do not add</string>
      <string id="bToggleFSSSignatureSaving_Reader">Save Signature to Cloud</string>
      <string id="bToggleFSSSignatureSaving_Reader_Explain">Specifies whether to save a newly created signature in the cloud.&#10;&#10;When a user creates a new signature, the dialog offers the option to store the signature in the cloud for later use. This preference also controls saving user initials.&#10;&#10;Possible values include:&#10;0: Show the Save Signature UI&#10;1: Hide the Save Signature UI</string>
      <string id="bAdobeSendPluginToggle_Reader">Send &amp; Track Outlook Plugin</string>
      <string id="bAdobeSendPluginToggle_Reader_Explain">Adobe Send and Track button in Outlook.&#10;&#10;Uploads attachments to Document Cloud and inserts public preview/download links in email.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bPreviouslyEnabledSharePointInChromeExtn_Reader">SharePoint Chrome Extension Previous State</string>
      <string id="bPreviouslyEnabledSharePointInChromeExtn_Reader_Explain">Stores the previous state of the SharePoint FeatureLockDown settings.&#10;&#10;Possible values include: Same as bEnableSharePointInChromeExtn in FeatureLockDown.</string>
      <string id="bEnableSharePointInChromeExtn_Reader">SharePoint in Chrome Extension</string>
      <string id="bEnableSharePointInChromeExtn_Reader_Explain">Specifies whether to integrate SharePoint into the Acrobat's Chrome extension.&#10;&#10;Possible values include:&#10;0: Don't enable SharePoint integration&#10;1: Enable</string>
      <string id="bToggleManageSign_Reader">Show Acrobat Sign Tracking Tab</string>
      <string id="bToggleManageSign_Reader_Explain">Signature tab on Home, notifications, and sign tracking.&#10;&#10;Hides agreements, notifications, and To Do sign cards when disabled.&#10;&#10;Values:&#10;0 = show&#10;1 = hide</string>
      <string id="bDisableOnBehalfOfText_Reader">Show Comment Author in Shared Review</string>
      <string id="bDisableOnBehalfOfText_Reader_Explain">If false, the string &quot;On behalf of&quot; does not append the author's name in the comment when another person opens the document in a shared-review workflow.&#10;&#10;This preference is only used in shared review workflows.&#10;&#10;Possible values include:&#10;0: Don't display the comment author's name&#10;1: Do display the comment author's name</string>
      <string id="iClientType_Gmail_Reader">WebMail Client Type (Gmail)</string>
      <string id="iClientType_Gmail_Reader_Explain">Identifies the Gmail Mail client type for WebMail.&#10;&#10;The value can only be: 1</string>
      <string id="iClientType_Gmail_Reader_opt0">Locked value: 1 (per Adobe PrefRef)</string>
      <string id="iClientType_Yahoo_Reader">WebMail Client Type (Yahoo)</string>
      <string id="iClientType_Yahoo_Reader_Explain">Identifies the Yahoo Mail client type for WebMail.&#10;&#10;The value can only be: 2</string>
      <string id="iClientType_Yahoo_Reader_opt0">Locked value: 2 (per Adobe PrefRef)</string>
      <string id="iIMAPPort_Reader">WebMail IMAP Port</string>
      <string id="iIMAPPort_Reader_Explain">Identifies the My Profile Mail IMAP server port number for WebMail.&#10;&#10;The value can be: Any valid port number.</string>
      <string id="iIMAPPort_Reader_opt0">143 (Standard IMAP)</string>
      <string id="iIMAPPort_Reader_opt1">993 (IMAP over SSL/TLS)</string>
      <string id="iIMAPSecurity_Reader">WebMail IMAP Security</string>
      <string id="iIMAPSecurity_Reader_Explain">Specifies whether to enable the My Profile Mail IMAP security for WebMail.&#10;&#10;The value can be: 0: Don't enable security. 1: Enable security.</string>
      <string id="iSMTPPort_Reader">WebMail SMTP Port</string>
      <string id="iSMTPPort_Reader_Explain">Identifies the My Profile Mail SMTP server port number for WebMail.&#10;&#10;The value can be: Any valid server port number.</string>
      <string id="iSMTPPort_Reader_opt0">25 (Standard SMTP)</string>
      <string id="iSMTPPort_Reader_opt1">465 (SMTP over SSL)</string>
      <string id="iSMTPPort_Reader_opt2">587 (SMTP Submission / TLS)</string>
      <string id="iSMTPSecurity_Reader">WebMail SMTP Security</string>
      <string id="iSMTPSecurity_Reader_Explain">Specifies whether to enable the My Profile Mail SMTP security for WebMail.&#10;&#10;The value can be: 0: Don't enable security. 1: Enable security.</string>

      <!-- ======================================== -->
      <!--          Startup and Experience          -->
      <!-- ======================================== -->

      <string id="bShowMsgAtLaunch_Reader">Adobe Messages at Launch</string>
      <string id="bShowMsgAtLaunch_Reader_Explain">Show Adobe messages at product launch.&#10;&#10;Also hides Share Feedback, EOL warnings, profile prompts, and the Home banner.&#10;&#10;Values:&#10;0 = hide&#10;1 = show</string>
      <string id="bAllowUserToChangeMsgPrefs_Reader">Allow Users to Change Message Preferences</string>
      <string id="bAllowUserToChangeMsgPrefs_Reader_Explain">Locks the features associated with bShowMsgAtLaunch and bDontShowMsgWhenViewingDoc so that end users can't change the settings.&#10;&#10;Possible values include:&#10;0: Locks the feature so end users can't change the settings&#10;1: Allows users to change the settings. A value of 1 has the same effect as this key not existing at all</string>
      <string id="bToggleNotifications_Reader">Desktop Notifications</string>
      <string id="bToggleNotifications_Reader_Explain">Specifies whether to disable all in-product and desktop notifications.&#10;&#10;When 0 (or null), feature-specific notifications are managed via the related service preference. When set to 1, this preference disables all notifications irrespective of the values of all other keys.&#10;&#10;Possible values include:&#10;0: Enable desktop notifications&#10;1: Disable all desktop notifications</string>
      <string id="bShowWelcomeScreen_Reader">Disable Welcome Screen</string>
      <string id="bShowWelcomeScreen_Reader_Explain">Specifies whether to show the Welcome screen at product launch.&#10;&#10;When enabled (DWORD 0), the Welcome screen is disabled.&#10;&#10;Possible values include:&#10;0: Do not show Welcome screen&#10;1: Show Welcome screen</string>
      <string id="bToggleFTE_Reader">First Time Experience</string>
      <string id="bToggleFTE_Reader_Explain">First Time Experience (welcome tour and page).&#10;&#10;Also disabled when bUpdater, bToggleAdobeDocumentServices, bToggleAdobeSign, bTogglePrefsSync, or bToggleWebConnectors is set.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bDontShowMsgWhenViewingDoc_Reader">Hide Adobe Messages on Document Open</string>
      <string id="bDontShowMsgWhenViewingDoc_Reader_Explain">Specifies whether to show messages from Adobe when a document opens.&#10;&#10;This preference also controls messages in the right-hand pane for 12.x and later products as well as the &quot;Learn More&quot; link, including the &quot;Start Free Trial&quot; message promoting Acrobat.&#10;&#10;Possible values include:&#10;0: Don't show messages from Adobe when a document opens&#10;1: Show messages from Adobe when a document opens</string>
      <string id="bEnableBellButton_Reader">Hide In-Product Notifications Bell</string>
      <string id="bEnableBellButton_Reader_Explain">Specifies whether to hide in-product messages.&#10;&#10;A value of 1 hides notifications, but the product still fetches and caches them.&#10;&#10;Possible values include:&#10;0: Show in-product notifications&#10;1: Hide in-product notifications</string>
      <string id="bToggleShareFeedback_Reader">Hide Send Feedback Icon</string>
      <string id="bToggleShareFeedback_Reader_Explain">Specifies whether to show the Send Feedback icon.&#10;&#10;By default, the UI displays a feedback icon so that users can easily send feedback to Adobe with one click. This preference replaces bUsageMeasurement for 12.x and later products. Setting bShowMsgAtLaunch to 0 also hides the icon.&#10;&#10;Possible values include:&#10;0: Hide the icon&#10;1: Show the icon</string>
      <string id="bToggleToDoList_Reader">Home Screen To Do List</string>
      <string id="bToggleToDoList_Reader_Explain">Specifies whether to show a &quot;to do&quot; list on the Home screen.&#10;&#10;By default, the Home screen displays a list of action items such as Take a Tour, Export PDF, and so on. For details, see the What's New .&#10;&#10;Possible values include:&#10;0: Enable the feature&#10;1: Disable the feature</string>
      <string id="bShowScanTabInHomeView_Reader">Scan Tab in Home View</string>
      <string id="bShowScanTabInHomeView_Reader_Explain">Specifies whether to disable the Scan tab in Home view.&#10;&#10;When enabled, links to scans appear under the Scan tab in the Home view.&#10;&#10;Possible values include:&#10;0: Hide the scan tab&#10;1: Show the Scan tab</string>
      <string id="bToggleNotificationToasts_Reader">Show Desktop Notification Toasts</string>
      <string id="bToggleNotificationToasts_Reader_Explain">Specifies whether to hide desktop notifications.&#10;&#10;A value of 1 hides notifications, but the product still fetches and caches them.&#10;&#10;Possible values include:&#10;0: Show desktop notifications&#10;1: Hide desktop notifications</string>
      <string id="bTogglePDFOwnershipToasts_Reader">Show PDF Ownership Notification</string>
      <string id="bTogglePDFOwnershipToasts_Reader_Explain">Specifies whether to show a notification on machine startup that allows the user to make Acrobat the default PDF viewer.&#10;&#10;When enabled and both Acrobat and Reader are installed, the user can click on the notification to change the default PDF viewer.&#10;&#10;Possible values include:&#10;0: Show PDF ownership notification on application startup&#10;1: Don't show ownership notification</string>
      <string id="bToggleToDoTiles_Reader">Show To Do Cards in Recent Tab</string>
      <string id="bToggleToDoTiles_Reader_Explain">Specifies whether to show To Do Cards in the Recent Tab view&#10;&#10;To Do cards list potential action items for members of certain workflows (for example, collaborative reviews). When set to 1, To Do cards do not appear in the Recent tab.&#10;&#10;Possible values include:&#10;0 or null: Show cards for unaccepted workflows (reviews, views and sign)&#10;1: Hide cards for unaccepted workflows (reviews, views and sign)</string>
      <string id="bUsageMeasurement_Reader">Usage Measurement (legacy)</string>
      <string id="bUsageMeasurement_Reader_Explain">Legacy master switch for usage measurement and analytics.&#10;&#10;Superseded by bToggleShareFeedback in 12.x and later, but still honored on some builds. When disabled (DWORD 0), usage measurement is off.&#10;&#10;Possible values include:&#10;0: Disable usage measurement&#10;1: Enable usage measurement</string>
      <string id="bWhatsNewExp_Reader">What's New Experience</string>
      <string id="bWhatsNewExp_Reader_Explain">Specifies whether to disable the What's New experience.&#10;&#10;This feature was phased in incrementally over 2022. When enabled, the default user on first launch will see a What's New screen as well as a See new features notification. These UI items appear once.&#10;&#10;Possible values include:&#10;0: Enable the What's New experience&#10;1: Disable</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="bDisableThirdPartyPluginNotif_Reader">32-Bit Plugin Upgrade Notification</string>
      <string id="bDisableThirdPartyPluginNotif_Reader_Explain">Specifies whether to notify users with 32 bit plugins that the app will soon update to 64 bit.&#10;&#10;32 bit plugins will not work in the 64 bit app. The notification provides a &quot;Learn more&quot; link that provides additional details about how to upgrade their plugin.&#10;&#10;Possible values include:&#10;0: Do not warn the user about 32 bit plugins&#10;1: Do warn the user</string>
      <string id="bEnableAutoDockUndockHUD_Reader">Auto Dock HUD Bar</string>
      <string id="bEnableAutoDockUndockHUD_Reader_Explain">Specifies whether to automatically dock and undock the HUD bar based on the window size.&#10;&#10;Possible values include:&#10;0: Disable automatic behavior&#10;1: Enable auto docking and undocking</string>
      <string id="bHasAcrobatConsent_Reader">Auto Open Acrobat from Reader</string>
      <string id="bHasAcrobatConsent_Reader_Explain">Specifies whether the Reader process should automatically open Acrobat for the current file.&#10;&#10;PDF ownership does not change. Reader will continue as the default PDF viewer on this machine.&#10;&#10;Possible values include:&#10;0: Don't automatically use Acrobat&#10;1: Use Acrobat</string>
      <string id="bAcroSuppressOpenInReader_Reader">Disable Chrome PDF Extension</string>
      <string id="bAcroSuppressOpenInReader_Reader_Explain">Specifies whether to disable and lock the PDF viewer Chrome extension.&#10;&#10;See also ENABLE_CHROMEEXT .&#10;&#10;Possible values include:&#10;0 or null: Extension is enabled; users can open PDFs in a browser with Acrobat Reader&#10;1: Disable the browser-based PDF viewer. A tooltip says &quot;The Acrobat Reader extension is currently disabled. Please contact your IT admin.&quot;</string>
      <string id="bSuppressMessageBar_Reader">Hide Document Message Bar</string>
      <string id="bSuppressMessageBar_Reader_Explain">Prevents the appearance of the document message bar.&#10;&#10;Adversely affects signing when preview mode is used.</string>
      <string id="bDisablePDFHandlerSwitching_Reader">Lock Default PDF Viewer</string>
      <string id="bDisablePDFHandlerSwitching_Reader_Explain">Lock the default PDF viewer handler.&#10;&#10;Adobe PDF handler only; does not switch to or from non-Adobe products. UI changes invoke the installer (HKLM), not HKCU.&#10;&#10;Values:&#10;0 or null = allow change&#10;1 = block change</string>
      <string id="bDisableThumbnailPreviewHandler_Reader">Lock PDF Thumbnails in Explorer</string>
      <string id="bDisableThumbnailPreviewHandler_Reader_Explain">Lock Explorer PDF thumbnail preview checkbox.&#10;&#10;Values:&#10;0 = users can enable via installer&#10;1 = disable and lock</string>
      <string id="PatchCleanFlag_Reader">Patch Cache Cleanup</string>
      <string id="PatchCleanFlag_Reader_Explain">Clean cached MSI/MSP patches on next update.&#10;&#10;Patches accumulate under ProgramData\Adobe\ARM and Windows\Installer.&#10;&#10;Values:&#10;0 = no cleanup&#10;1 = cleanup on next update</string>
      <string id="bUpdater_Updater_Reader">Product Updater</string>
      <string id="bUpdater_Updater_Reader_Explain">Controls Adobe Acrobat/Reader product updates.&#10;&#10;Disables or enables automatic product updates (distinct from cloud services in FeatureLockDown\cServices).&#10;&#10;Values:&#10;0 = disable product updates&#10;1 = enable product updates</string>
      <string id="bEnableAcrobatPromptForDocOpen_Reader">Prompt to Use Acrobat from Reader</string>
      <string id="bEnableAcrobatPromptForDocOpen_Reader_Explain">Specifies whether to prompt users to use Acrobat when both Reader and Acrobat are installed.&#10;&#10;When Acrobat and Reader are both present, opening a file in Reader prompts the user to switch to Acrobat as well as make Acrobat the default PDF viewer.&#10;&#10;Possible values include:&#10;0: Don't prompt to use Acrobat&#10;1: Prompt to use Acrobat</string>
      <string id="bShouldUseScalableCursor_Reader">Scalable Cursor</string>
      <string id="bShouldUseScalableCursor_Reader_Explain">Specifies whether to disable the scalable cursor.&#10;&#10;Because Citrix does not provide support for scalable cursors (32-bit cursors with an alpha channel) in legacy graphics mode, scalable cursor performance may be impaired on Citrix. Use this setting to improve performance on Citrix by using a non-scalable cursor.&#10;&#10;Possible values include:&#10;0: Don't use a scalable cursor&#10;1: Use a scalable cursor</string>
      <string id="bFavoritesFeaturesLockDown_Reader">Starred Files Feature</string>
      <string id="bFavoritesFeaturesLockDown_Reader_Explain">Specifies whether to disable and lock the starred file feature.&#10;&#10;A starred file is somewhat similar to a &quot;favorited&quot; file. This preference overrides bFavoritesStripInRFL.&#10;&#10;Possible values include:&#10;0: Disable and lock starred files in the recent files list&#10;1: Use bFavoritesStripInRFL to control this feature</string>

      <!-- ======================================== -->
      <!--                  Upsell                  -->
      <!-- ======================================== -->

      <string id="bLimitPromptsFeatureKey_Reader">Limit Informational Prompts</string>
      <string id="bLimitPromptsFeatureKey_Reader_Explain">Specifies whether to limit the number of prompts a user will see in a 24 hour period.&#10;&#10;Prompts include items like tips, calls-to-action, and feature walk throughs. These are not necessarily upsell items.&#10;&#10;Possible values include:&#10;0: Don't restrict informational prompts&#10;1: Limit prompts to 1 per day and 3 per week</string>
      <string id="bReaderRetentionExperiment_Reader">Prompt Reader Users to Download Acrobat</string>
      <string id="bReaderRetentionExperiment_Reader_Explain">Specifies whether to prompt Acrobat subscribers using Reader to download Acrobat.&#10;&#10;When enabled, download Acrobat prompts appear in Reader workflows where the user might benefit from Acrobat (purchased but not yet downloaded).&#10;&#10;Possible values include:&#10;0: Disable &quot;download Acrobat&quot; prompts in Reader&#10;1: Enable download prompts</string>
      <string id="bToggleDCAppCenter_Reader">Show App Center UI</string>
      <string id="bToggleDCAppCenter_Reader_Explain">App Center and get-apps banner on Home.&#10;&#10;Values:&#10;0 or null = show&#10;1 = hide</string>
      <string id="bShowRhpToolSearch_Reader">Show Purchasable Tools in Search</string>
      <string id="bShowRhpToolSearch_Reader_Explain">Specifies whether to show &quot;for purchase&quot; tools when searching for tools in Reader.&#10;&#10;When enabled, searching for tools in Reader shows all possible tool subscriptions.&#10;&#10;Possible values include:&#10;0: Don't show tool subscriptions&#10;1: Show tools which can be purchased</string>
      <string id="bAcroSuppressUpsell_Reader">Show Upgrade Prompts</string>
      <string id="bAcroSuppressUpsell_Reader_Explain">Disable upgrade and upsell messages (12.x+).&#10;&#10;Controls Reader tool purchase and Standard-to-Professional prompts.&#10;&#10;Values:&#10;0 or null = show upsell&#10;1 = disable upsell</string>
      <!-- ==================================================== -->
      <!--                                                      -->
      <!-- Non-Policy Settings - Acrobat and Reader DC (64-bit) -->
      <!--                                                      -->
      <!-- ==================================================== -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="ADC4275035_ClickEdit_AcrobatX64">Click-to-Edit Mode</string>
      <string id="ADC4275035_ClickEdit_AcrobatX64_Explain">Auto-enter edit mode when the user clicks a PDF object.&#10;&#10;Clicking image or text opens edit tools; clicking a form field enables form authoring.&#10;&#10;Values:&#10;0 or null = disabled&#10;1 = enabled&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="ADC4275034_AcrobatX64">Fill &amp; Sign Color Picker</string>
      <string id="ADC4275034_AcrobatX64_Explain">Specifies whether to disable the color picker in the Fill and Sign tool.&#10;&#10;The color picker is only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable the color picker&#10;1: Enable the color picker&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="ProtectOldExperience_AcrobatX64">Legacy Protect Tool Menu</string>
      <string id="ProtectOldExperience_AcrobatX64_Explain">Use legacy Protect tool menus instead of the new UI.&#10;&#10;Values:&#10;0 or null = new UI&#10;1 = pre-Oct 2019 menus&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="ADC4302862_AcrobatX64">Paste in Place</string>
      <string id="ADC4302862_AcrobatX64_Explain">Paste copied elements to the same location as the source.&#10;&#10;Applies to form fields, annotations, and links.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="ADC4275035_AcrobatX64">Remove Form Editing Tools (2019)</string>
      <string id="ADC4275035_AcrobatX64_Explain">Remove Oct 2019 AddText and EditText form tools from the UI.&#10;&#10;Form editing moved into the Prepare Form toolbar.&#10;&#10;Values:&#10;0 or null = no change&#10;1 = remove AddText and EditText tools&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="BlockEMFParsing_AcrobatX64">Block EMF to PDF Conversion</string>
      <string id="BlockEMFParsing_AcrobatX64_Explain">Block EMF to PDF conversion.&#10;&#10;Shows an unsupported dialog when blocked.&#10;&#10;Values:&#10;0 = allow&#10;1 = block&#10;&#10;When this policy is Enabled, EMF-to-PDF conversion is blocked. When Disabled, conversion is allowed.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="BlockXPSParsing_AcrobatX64">Block XPS to PDF Conversion</string>
      <string id="BlockXPSParsing_AcrobatX64_Explain">Block XPS to PDF conversion.&#10;&#10;Shows an unsupported dialog when blocked.&#10;&#10;Values:&#10;0 = allow&#10;1 = block&#10;&#10;When this policy is Enabled, XPS-to-PDF conversion is blocked. When Disabled, conversion is allowed.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="DisableScannedDocumentEditing_AcrobatX64">Disable Scanned PDF Text Recognition</string>
      <string id="DisableScannedDocumentEditing_AcrobatX64_Explain">Specifies whether to disable text recognition while editing scanned PDFs.&#10;&#10;Possible values include:&#10;0: Text recognition will be performed when invoking editing on scanned PDFs&#10;1: Text recognition will not be performed when invoking editing on scanned PDFs&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX64">PDFMaker Grouped Image Tag Fix</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX64_Explain">Specifies whether to disable accessibility fixes for tagging grouped images.&#10;&#10;0: Disable. 1: Enable.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX64">PDFMaker Table Header Tag Fix</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX64_Explain">Specifies whether to disable accessibility fixes for tagging table headers.&#10;&#10;0: Disable. 1: Enable.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX64">PDFMaker Text Path Tag Fix</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX64_Explain">Fix Text Path rendering bug in PDFMaker tags.&#10;&#10;Mitigates incorrect border/alt-text rendering from a 2020 bug. Enabled by default.&#10;&#10;Values:&#10;0 = disable correction&#10;1 = enable&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="EnableFlashEditing_AcrobatX64">Flash Editing Tools</string>
      <string id="EnableFlashEditing_AcrobatX64_Explain">Specifies whether to enable the Flash tools for adding annotations or Flash in the Rich Media app.&#10;&#10;Possible values include:&#10;0 or null: Remove &quot;Disable Flash ) Add SWF menu item.&quot;&#10;1: Show the menu item&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX64">Protected View Exit Shortcut Key</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX64_Explain">Shortcut key to exit Protected View for the current document.&#10;&#10;Allows Protected View by default with on-demand exit.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="EULA_AcrobatX64">Accept EULA for Updater</string>
      <string id="EULA_AcrobatX64_Explain">Accept EULA for the built-in updater.&#10;&#10;Alternative to EULA_ACCEPT=YES at install time.&#10;&#10;Values:&#10;0 = not accepted&#10;1 = accepted&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="DisableMaintenance_AcrobatX64">Disable Repair for All Users</string>
      <string id="DisableMaintenance_AcrobatX64_Explain">Disable Help &gt; Repair for all users.&#10;&#10;See Disable_Repair. Registry: HKLM\...\Installer.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="Disable_Repair_AcrobatX64">Disable Repair for Standard Users</string>
      <string id="Disable_Repair_AcrobatX64_Explain">Disable Help &gt; Repair for standard users on virtual installs.&#10;&#10;Restricts repair to admins on Citrix/WT servers. See DisableMaintenance. Registry: HKLM\...\Installer.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="IsAMTEnforced_AcrobatX64">Enforce AMT for AppV Deployment</string>
      <string id="IsAMTEnforced_AcrobatX64_Explain">Allows deployment of Acrobat on AppV for December, 2018 and later products.&#10;&#10;0: Do not use. 1: Required after December 2018 for Acrobat on AppV.&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="bMergeMenuBar_AcrobatX64">Merge Title and Menu Bar</string>
      <string id="bMergeMenuBar_AcrobatX64_Explain">Specifies whether to merge the application's title bar and menu bar into a single bar.&#10;&#10;Note that &quot;Policies&quot; does not appear in the HKLM path.&#10;&#10;Possible values include:&#10;0: Don't merge the title and menu bars&#10;1: Merge the bars&#10;&#10;This non-Policies setting applies to Acrobat and Reader DC (64-bit) installations and writes to the native 64-bit registry view.</string>
      <string id="ARMLegacyMode_AcrobatX64">ARM Updater: Auto-Update Mode (Acrobat)</string>
      <string id="ARMLegacyMode_AcrobatX64_Explain">Controls the Adobe ARM service's automatic update mode for Acrobat (64-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect. Use this as a secondary lockdown for machines where the FeatureLockDown policy has not yet applied.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-BC15014EA700}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download</string>
      <string id="ARMLegacyCheck_AcrobatX64">ARM Updater: Disable Update Checks (Acrobat)</string>
      <string id="ARMLegacyCheck_AcrobatX64_Explain">Suppresses update checks by the Adobe ARM service for Acrobat (64-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-BC15014EA700}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks</string>
      <string id="ARMLegacyMode_ReaderX64">ARM Updater: Auto-Update Mode (Reader)</string>
      <string id="ARMLegacyMode_ReaderX64_Explain">Controls the Adobe ARM service's automatic update mode for Reader (64-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect. Use this as a secondary lockdown for machines where the FeatureLockDown policy has not yet applied.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-1033-FF00-7760-BC15014EA700}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download</string>
      <string id="ARMLegacyCheck_ReaderX64">ARM Updater: Disable Update Checks (Reader)</string>
      <string id="ARMLegacyCheck_ReaderX64_Explain">Suppresses update checks by the Adobe ARM service for Reader (64-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-1033-FF00-7760-BC15014EA700}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks</string>
      <!-- Shared ARM Legacy Mode enum option strings -->
      <string id="ARMLegacyMode_opt0">Do not download or install updates automatically (0)</string>
      <string id="ARMLegacyMode_opt2">Download updates automatically; prompt user to install (2)</string>
      <string id="ARMLegacyMode_opt3">Download and install updates automatically (3)</string>
      <string id="ARMLegacyMode_opt4">Notify user of available updates; do not download (4)</string>
      <!-- ========================================= -->
      <!--                                           -->
      <!-- Non-Policy Settings - Acrobat DC (32-bit) -->
      <!--                                           -->
      <!-- ========================================= -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="ADC4275035_ClickEdit_AcrobatX86">Click-to-Edit Mode</string>
      <string id="ADC4275035_ClickEdit_AcrobatX86_Explain">Auto-enter edit mode when the user clicks a PDF object.&#10;&#10;Clicking image or text opens edit tools; clicking a form field enables form authoring.&#10;&#10;Values:&#10;0 or null = disabled&#10;1 = enabled&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="ADC4275034_AcrobatX86">Fill &amp; Sign Color Picker</string>
      <string id="ADC4275034_AcrobatX86_Explain">Specifies whether to disable the color picker in the Fill and Sign tool.&#10;&#10;The color picker is only supported on the Continuous track.&#10;&#10;Possible values include:&#10;0: Disable the color picker&#10;1: Enable the color picker&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="ProtectOldExperience_AcrobatX86">Legacy Protect Tool Menu</string>
      <string id="ProtectOldExperience_AcrobatX86_Explain">Use legacy Protect tool menus instead of the new UI.&#10;&#10;Values:&#10;0 or null = new UI&#10;1 = pre-Oct 2019 menus&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="ADC4302862_AcrobatX86">Paste in Place</string>
      <string id="ADC4302862_AcrobatX86_Explain">Paste copied elements to the same location as the source.&#10;&#10;Applies to form fields, annotations, and links.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="ADC4275035_AcrobatX86">Remove Form Editing Tools (2019)</string>
      <string id="ADC4275035_AcrobatX86_Explain">Remove Oct 2019 AddText and EditText form tools from the UI.&#10;&#10;Form editing moved into the Prepare Form toolbar.&#10;&#10;Values:&#10;0 or null = no change&#10;1 = remove AddText and EditText tools&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="BlockEMFParsing_AcrobatX86">Block EMF to PDF Conversion</string>
      <string id="BlockEMFParsing_AcrobatX86_Explain">Block EMF to PDF conversion.&#10;&#10;Shows an unsupported dialog when blocked.&#10;&#10;Values:&#10;0 = allow&#10;1 = block&#10;&#10;When this policy is Enabled, EMF-to-PDF conversion is blocked. When Disabled, conversion is allowed.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="BlockXPSParsing_AcrobatX86">Block XPS to PDF Conversion</string>
      <string id="BlockXPSParsing_AcrobatX86_Explain">Block XPS to PDF conversion.&#10;&#10;Shows an unsupported dialog when blocked.&#10;&#10;Values:&#10;0 = allow&#10;1 = block&#10;&#10;When this policy is Enabled, XPS-to-PDF conversion is blocked. When Disabled, conversion is allowed.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="DisableScannedDocumentEditing_AcrobatX86">Disable Scanned PDF Text Recognition</string>
      <string id="DisableScannedDocumentEditing_AcrobatX86_Explain">Specifies whether to disable text recognition while editing scanned PDFs.&#10;&#10;Possible values include:&#10;0: Text recognition will be performed when invoking editing on scanned PDFs&#10;1: Text recognition will not be performed when invoking editing on scanned PDFs&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX86">PDFMaker Grouped Image Tag Fix</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX86_Explain">Specifies whether to disable accessibility fixes for tagging grouped images.&#10;&#10;0: Disable. 1: Enable.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX86">PDFMaker Table Header Tag Fix</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX86_Explain">Specifies whether to disable accessibility fixes for tagging table headers.&#10;&#10;0: Disable. 1: Enable.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX86">PDFMaker Text Path Tag Fix</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX86_Explain">Fix Text Path rendering bug in PDFMaker tags.&#10;&#10;Mitigates incorrect border/alt-text rendering from a 2020 bug. Enabled by default.&#10;&#10;Values:&#10;0 = disable correction&#10;1 = enable&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="EnableFlashEditing_AcrobatX86">Flash Editing Tools</string>
      <string id="EnableFlashEditing_AcrobatX86_Explain">Specifies whether to enable the Flash tools for adding annotations or Flash in the Rich Media app.&#10;&#10;Possible values include:&#10;0 or null: Remove &quot;Disable Flash ) Add SWF menu item.&quot;&#10;1: Show the menu item&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX86">Protected View Exit Shortcut Key</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX86_Explain">Shortcut key to exit Protected View for the current document.&#10;&#10;Allows Protected View by default with on-demand exit.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="EULA_AcrobatX86">Accept EULA for Updater</string>
      <string id="EULA_AcrobatX86_Explain">Accept EULA for the built-in updater.&#10;&#10;Alternative to EULA_ACCEPT=YES at install time.&#10;&#10;Values:&#10;0 = not accepted&#10;1 = accepted&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="iDisablePromptForUpgrade_AcrobatX86">Disable Major Version Upgrade Prompt</string>
      <string id="iDisablePromptForUpgrade_AcrobatX86_Explain">Suppress major-version upgrade prompt.&#10;&#10;Requires automatic update settings; if bUpdater=0, upgrades are also disabled.&#10;&#10;Values:&#10;0 or null = no effect&#10;1 = disable prompt&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...&#10;&#10;Adobe ARM is a 32-bit component; on 64-bit Windows this policy writes to HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\...</string>
      <string id="DisableMaintenance_AcrobatX86">Disable Repair for All Users</string>
      <string id="DisableMaintenance_AcrobatX86_Explain">Disable Help &gt; Repair for all users.&#10;&#10;See Disable_Repair. Registry: HKLM\...\Installer.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="Disable_Repair_AcrobatX86">Disable Repair for Standard Users</string>
      <string id="Disable_Repair_AcrobatX86_Explain">Disable Help &gt; Repair for standard users on virtual installs.&#10;&#10;Restricts repair to admins on Citrix/WT servers. See DisableMaintenance. Registry: HKLM\...\Installer.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="IsAMTEnforced_AcrobatX86">Enforce AMT for AppV Deployment</string>
      <string id="IsAMTEnforced_AcrobatX86_Explain">Allows deployment of Acrobat on AppV for December, 2018 and later products.&#10;&#10;0: Do not use. 1: Required after December 2018 for Acrobat on AppV.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="bMergeMenuBar_AcrobatX86">Merge Title and Menu Bar</string>
      <string id="bMergeMenuBar_AcrobatX86_Explain">Specifies whether to merge the application's title bar and menu bar into a single bar.&#10;&#10;Note that &quot;Policies&quot; does not appear in the HKLM path.&#10;&#10;Possible values include:&#10;0: Don't merge the title and menu bars&#10;1: Merge the bars&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="iInterval_AcrobatX86">Update Watchdog Interval (Days)</string>
      <string id="iInterval_AcrobatX86_Explain">Days before Watchdog prompts manual update after a failed update.&#10;&#10;Internal key; default 135 days after a successful manifest download.&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...&#10;&#10;Adobe ARM is a 32-bit component; on 64-bit Windows this policy writes to HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\...</string>
      <string id="iInterval_AcrobatX86_opt0">90 days</string>
      <string id="iInterval_AcrobatX86_opt1">135 days (default)</string>
      <string id="iInterval_AcrobatX86_opt2">180 days</string>
      <string id="iInterval_AcrobatX86_opt3">365 days</string>
      <string id="iLogLevel_AcrobatX86">Updater Log Level</string>
      <string id="iLogLevel_AcrobatX86_Explain">Updater log verbosity.&#10;&#10;Logs truncated at 1 MB (backed up as AdobeARM-backup). Path: %LOCALAPPDATA%\Temp\AdobeARM.log.&#10;&#10;Values:&#10;0 = brief&#10;1 = verbose&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...&#10;&#10;Adobe ARM is a 32-bit component; on 64-bit Windows this policy writes to HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\...</string>
      <string id="iLogLevel_AcrobatX86_opt0">Brief</string>
      <string id="iLogLevel_AcrobatX86_opt1">Verbose</string>
      <string id="ARMLegacyMode_AcrobatX86">ARM Updater: Auto-Update Mode</string>
      <string id="ARMLegacyMode_AcrobatX86_Explain">Controls the Adobe ARM service's automatic update mode for Acrobat (32-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-0C0F074E4100}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
      <string id="ARMLegacyCheck_AcrobatX86">ARM Updater: Disable Update Checks</string>
      <string id="ARMLegacyCheck_AcrobatX86_Explain">Suppresses update checks by the Adobe ARM service for Acrobat (32-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-0C0F074E4100}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks&#10;&#10;This non-Policies setting applies to 32-bit Acrobat DC installations and writes to HKLM\SOFTWARE\WOW6432Node\...</string>
