<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  revision="3.5" schemaVersion="1.0"
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Adobe Acrobat DC / Reader DC (Machine + User v3.5)</displayName>
  <description>ADMX v3.5 - Combined machine (HKLM) and user (HKCU) policies for Acrobat and Reader DC.</description>
  <resources>
    <stringTable>
      <string id="SupportedAcrobatReaderPolicies">Adobe Acrobat and Reader DC</string>
      <string id="SupportedReaderPolicies">Adobe Reader DC (32-bit)</string>
      <string id="SupportedAcrobatX64">Adobe Acrobat and Reader DC (64-bit)</string>
      <string id="SupportedAcrobatX86">Adobe Acrobat DC (32-bit)</string>
      <string id="SupportedReaderX86">Adobe Reader DC (32-bit)</string>

      <string id="AdobeCategory">Adobe DC</string>
      <string id="AcrobatReaderPolicies">Acrobat &amp; Reader DC</string>
      <string id="ReaderPoliciesBranch">Reader DC (32-bit)</string>
      <string id="NonPolicySettings">Non-Policy Settings</string>
      <string id="NonPol_AcrobatX64">Acrobat &amp; Reader DC (64-bit)</string>
      <string id="NonPol_AcrobatX86">Acrobat DC (32-bit)</string>
      <string id="NonPol_ReaderX86">Reader DC (32-bit)</string>

      <string id="Cat_CloudConnectors">Cloud &amp; Connectors</string>
      <string id="Cat_ContextToolsSearch">Context, Tools &amp; Search</string>
      <string id="Cat_DocsEditAccess">Documents, Editing &amp; Accessibility</string>
      <string id="Cat_MicrosoftPurviewMIP">Microsoft Purview (MIP)</string>
      <string id="Cat_SecurityExec">Security: Execution &amp; Protection</string>
      <string id="Cat_SecurityTrust">Security: Trust &amp; Permissions</string>
      <string id="Cat_SharingFeatures">Sharing &amp; Features</string>
      <string id="Cat_StartupExperience">Startup &amp; Experience</string>
      <string id="Cat_UpdatesDesktop">Updates &amp; Desktop Integration</string>
      <string id="Cat_Upsell">Upsell</string>

      <string id="SupportedAcrobatDC_User">Adobe Acrobat DC</string>
      <string id="SupportedReaderDC_User">Adobe Reader DC</string>
      <string id="AcrobatDCCategory_User">Acrobat DC</string>
      <string id="ReaderDCCategory_User">Reader DC</string>
      <string id="Cat_ContextToolsSearch_User">Context, Tools &amp; Search</string>
      <string id="Cat_DocsEditAccess_User">Documents, Editing &amp; Accessibility</string>
      <string id="Cat_MicrosoftPurviewMIP_User">Microsoft Purview (MIP)</string>
      <string id="Cat_SecurityExec_User">Security: Execution &amp; Protection</string>
      <string id="Cat_SecurityTrust_User">Security: Trust &amp; Permissions</string>
      <string id="Cat_SharingFeatures_User">Sharing &amp; Features</string>
      <string id="Cat_StartupExperience_User">Startup &amp; Experience</string>
      <string id="Cat_UpdatesDesktop_User">Updates &amp; Desktop Integration</string>
      <string id="Cat_Upsell_User">Upsell</string>

      <!-- ======================================== -->
      <!--                                          -->
      <!--  Acrobat and Reader DC - policy strings  -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--           Cloud and Connectors           -->
      <!-- ======================================== -->

      <string id="bToggleFillSign_Acrobat">Adobe Fill &amp; Sign</string>
      <string id="bToggleFillSign_Acrobat_Explain">Controls whether Adobe Fill and Sign is available in the application.&#10;&#10;0 = Fill and Sign available&#10;1 = Fill and Sign hidden</string>
      <string id="bBoxConnectorEnabled_Acrobat">Box Cloud Connector</string>
      <string id="bBoxConnectorEnabled_Acrobat_Explain">Controls whether the Box cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = Box connector disabled&#10;1 = Box connector enabled</string>
      <string id="bToggleAdobeDocumentServices_Acrobat">Document Cloud Services</string>
      <string id="bToggleAdobeDocumentServices_Acrobat_Explain">Enable Document Cloud services (except those controlled by other prefs).&#10;&#10;Does not affect Sign, prefs sync, or third-party connectors. Reader removes Create/Export/Organize/Combine without subscription. Use bUpdater to disable all services.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bToggleDocumentCloud_Acrobat">Document Cloud Storage</string>
      <string id="bToggleDocumentCloud_Acrobat_Explain">Controls whether Document Cloud (Adobe cloud) storage is available in the application.&#10;&#10;0 = Document Cloud storage available&#10;1 = Document Cloud storage disabled</string>
      <string id="bDropboxConnectorEnabled_Acrobat">Dropbox Cloud Connector</string>
      <string id="bDropboxConnectorEnabled_Acrobat_Explain">Controls whether the Dropbox cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = Dropbox connector disabled&#10;1 = Dropbox connector enabled</string>
      <string id="bEnableGentech_Acrobat">Generative AI Technology</string>
      <string id="bEnableGentech_Acrobat_Explain">Controls whether generative AI features are available. AI capabilities use cloud services; verify organizational data-handling policies before enabling.&#10;&#10;0 = generative AI features disabled&#10;1 = generative AI features enabled</string>
      <string id="bGoogleDriveConnectorEnabled_Acrobat">Google Drive Connector</string>
      <string id="bGoogleDriveConnectorEnabled_Acrobat_Explain">Controls whether the Google Drive cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = Google Drive connector disabled&#10;1 = Google Drive connector enabled</string>
      <string id="bToggleSendACopy_Acrobat">Hide Fill &amp; Sign Send a Copy Button</string>
      <string id="bToggleSendACopy_Acrobat_Explain">Controls whether the Send a Copy button is hidden in the Fill and Sign tool.&#10;&#10;0 = Send a Copy button hidden&#10;1 = Send a Copy button shown</string>
      <string id="bSuppressSignOut_Acrobat">Hide Sign Out Menu Item</string>
      <string id="bSuppressSignOut_Acrobat_Explain">Hides the sign-in and sign-out items from the Help menu.&#10;&#10;0 = sign-in/sign-out items visible&#10;1 = sign-in/sign-out items hidden</string>
      <string id="bOneDriveConnectorEnabled_Acrobat">OneDrive Connector</string>
      <string id="bOneDriveConnectorEnabled_Acrobat_Explain">Controls whether the OneDrive cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = OneDrive connector disabled&#10;1 = OneDrive connector enabled</string>
      <string id="bTogglePrefsSync_Acrobat">Preferences Synchronization</string>
      <string id="bTogglePrefsSync_Acrobat_Explain">Sync desktop preferences across signed-in devices.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled and locked</string>
      <string id="bUpdater_Updates_Acrobat">Services &amp; Web-Plugin Updates</string>
      <string id="bUpdater_Updates_Acrobat_Explain">Web-plugin updates and cloud services.&#10;&#10;Disables all services including sign-in. Not the same as FeatureLockDown\bUpdater (product updates).&#10;&#10;Values:&#10;0 = disable services and component updates&#10;1 = enable</string>
      <string id="bToggleWebConnectors_Acrobat">Third-Party Cloud Connectors</string>
      <string id="bToggleWebConnectors_Acrobat_Explain">Third-party cloud storage connectors (Continuous track).&#10;&#10;Controls Box, OneDrive, and Dropbox (not SharePoint). Disables Home, Add Account, and custom Open/Save entry points.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="iAcroLoginType_Acrobat">External Browser Sign-In</string>
      <string id="iAcroLoginType_Acrobat_Explain">Forces Acrobat to use the default system browser for sign-in instead of the embedded CEF browser.&#10;&#10;Applies to Acrobat DC only. Use when CEF-based sign-in fails Conditional Access or device identity checks. Selecting this value writes iAcroLoginType = 5 under FeatureLockDown. Disabled or Not Configured removes the value and restores Adobe's default CEF sign-in. Not compatible with Federated Login Domain when external browser sign-in is configured. Adobe documents this as Workaround 1 for Azure AD Conditional Access.</string>
      <string id="iAcroLoginType_Acrobat_opt0">Use the default system browser</string>
      <string id="login_domain_Acrobat">Federated Login Domain</string>
      <string id="login_domain_Acrobat_Explain">Sets the federated login domain so sign-in redirects to the organization's identity provider for the claimed domain.&#10;&#10;Applies to Acrobat DC only. Requires a domain claimed in the Adobe Admin Console and Federated ID accounts. Specify the exact claimed domain (no wildcards). Not compatible with External Browser Sign-In. Adobe excludes Acrobat Reader from this feature.</string>
      <string id="iNGLCEFWorkflowEnabled_Acrobat">Legacy Sign-In Engine (HTTPS Calls)</string>
      <string id="iNGLCEFWorkflowEnabled_Acrobat_Explain">Forces Acrobat to use the legacy HTTPS calls sign-in engine instead of the embedded CEF browser.&#10;&#10;Applies to Acrobat DC only. Use when CEF-based sign-in fails and external browser sign-in is not suitable. Selecting this value writes iNGLCEFWorkflowEnabled = 0 under FeatureLockDown. Disabled or Not Configured removes the value and restores Adobe's default CEF sign-in. Adobe documents this as Workaround 2 for Azure AD Conditional Access.</string>
      <string id="iNGLCEFWorkflowEnabled_Acrobat_opt0">Use the HTTPS calls engine</string>

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="bUIDensityAutoDetectionEnabled_Acrobat">Auto UI Density Detection</string>
      <string id="bUIDensityAutoDetectionEnabled_Acrobat_Explain">Controls whether the automatic UI density detection is active, allowing the display size to adapt based on screen size, resolution, and monitor scaling.&#10;&#10;0 = auto UI density detection disabled&#10;1 = auto UI density detection enabled</string>
      <string id="bEnableCloudPoweredSearchTokenCaching_Acrobat">Cloud Search Token Caching</string>
      <string id="bEnableCloudPoweredSearchTokenCaching_Acrobat_Explain">Controls whether cloud-powered search service suggestions are cached locally.&#10;&#10;0 = cloud search suggestions not cached&#10;1 = cloud search suggestions cached locally</string>
      <string id="bEnableCloudPoweredSearch_Acrobat">Cloud-Powered Search</string>
      <string id="bEnableCloudPoweredSearch_Acrobat_Explain">Controls whether the cloud-powered search service is active in the Find tool. Data sent to the cloud is encrypted and not stored. Interacts with bEnableCloudPoweredSearchTokenCaching.&#10;&#10;0 = cloud-powered search disabled&#10;1 = cloud-powered search enabled</string>
      <string id="bEnableContextualTips_Acrobat">Contextual Help Tips</string>
      <string id="bEnableContextualTips_Acrobat_Explain">Controls whether context-sensitive help tips are shown automatically based on the current task.&#10;&#10;0 = contextual tips disabled&#10;1 = contextual tips enabled</string>
      <string id="bEnableContextualToolbar_Acrobat">Contextual Toolbar</string>
      <string id="bEnableContextualToolbar_Acrobat_Explain">Controls whether a floating contextual toolbar appears when the user selects a PDF object (e.g., text markup tools when text is selected, editing tools when an image is selected).&#10;&#10;0 = contextual toolbar disabled&#10;1 = contextual toolbar shown on object selection</string>
      <string id="bEnableExtractPageRange_Acrobat">Extract Page Range UI</string>
      <string id="bEnableExtractPageRange_Acrobat_Explain">Controls whether the page range selection UI is shown in the Extract Pages dialog.&#10;&#10;0 = page range UI hidden&#10;1 = page range UI shown</string>
      <string id="bDisableAcrobatShortcutCustomization_Acrobat">Lock Tool Shortcut Customization</string>
      <string id="bDisableAcrobatShortcutCustomization_Acrobat_Explain">Controls whether users can customize tool shortcuts in the right-hand panel.&#10;&#10;0 = shortcut customization allowed&#10;1 = shortcut customization locked</string>
      <string id="bEnableAV2Enterprise_Acrobat">Modern Viewer</string>
      <string id="bEnableAV2Enterprise_Acrobat_Explain">Controls whether the Modern Viewer UI is shown; interacts with bShownViewerOnboarding and bEnableAV2.&#10;&#10;0 = classic viewer&#10;1 = modern viewer</string>
      <string id="bEnableRCMNewPOPUp_Acrobat">New Right-Click Context Menu</string>
      <string id="bEnableRCMNewPOPUp_Acrobat_Explain">Controls whether the modern right-click context menu (with icons and additional options) is shown, or the legacy context menu is used instead.&#10;&#10;0 = legacy context menu&#10;1 = modern context menu with icons</string>
      <string id="bFindMoreWorkflowsOnline_Acrobat">Online Actions Library Link</string>
      <string id="bFindMoreWorkflowsOnline_Acrobat_Explain">Controls whether the menu item that opens the online Actions file library is shown.&#10;&#10;0 = online Actions library menu item hidden&#10;1 = online Actions library menu item shown</string>
      <string id="bFindMoreCustomizationsOnline_Acrobat">Online Tool Set Exchange Link</string>
      <string id="bFindMoreCustomizationsOnline_Acrobat_Explain">Controls whether the menu item that opens the online Acrobat Tool Set Exchange is shown.&#10;&#10;0 = Tool Set Exchange menu item hidden&#10;1 = Tool Set Exchange menu item shown</string>
      <string id="bOrganizePagesFromThumbnails_Acrobat">Organize Pages Thumbnail Shortcut</string>
      <string id="bOrganizePagesFromThumbnails_Acrobat_Explain">Controls whether the Organize Pages shortcut is shown in the thumbnail panel.&#10;&#10;0 = Organize Pages shortcut hidden in thumbnails&#10;1 = Organize Pages shortcut shown in thumbnails</string>
      <string id="bRCMCombineFeatureKey_Acrobat">Show Combine Files Context Menu</string>
      <string id="bRCMCombineFeatureKey_Acrobat_Explain">Controls whether the Combine Files item appears in the document right-click context menu.&#10;&#10;0 = Combine Files not shown in context menu&#10;1 = Combine Files shown in context menu</string>
      <string id="bEnableAutoCompleteExactMatchLoader_Acrobat">Show Search Loading Message</string>
      <string id="bEnableAutoCompleteExactMatchLoader_Acrobat_Explain">Controls whether a 'Working on it' loading indicator is shown in the Find tool autocomplete list while cloud search results load.&#10;&#10;0 = loading message not shown&#10;1 = loading message shown</string>
      <string id="bEnableAutoCompleteNoInternetConnectionHeader_Acrobat">Show Search No Internet Message</string>
      <string id="bEnableAutoCompleteNoInternetConnectionHeader_Acrobat_Explain">Controls whether a 'Requires internet connection' notice is shown in the Find tool autocomplete list when cloud search is unavailable.&#10;&#10;0 = no-internet message not shown&#10;1 = no-internet message shown</string>
      <string id="bEnableAutoCompleteNoExactMatchHeader_Acrobat">Show Search No Match Message</string>
      <string id="bEnableAutoCompleteNoExactMatchHeader_Acrobat_Explain">Controls whether a 'No exact match' notice is shown in the Find tool autocomplete list when the cloud search finds no result.&#10;&#10;0 = no-match message not shown&#10;1 = no-match message shown</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="bCloudATFeatureEnable_Acrobat">Accessibility Auto Tagging</string>
      <string id="bCloudATFeatureEnable_Acrobat_Explain">Controls whether the cloud-powered automatic accessibility tagging feature is shown in the accessibility UI.&#10;&#10;0 = legacy auto tagging experience&#10;1 = cloud-powered auto tagging enabled</string>
      <string id="bBatesLogOriginalFileName_Acrobat">Bates Log Original File Name</string>
      <string id="bBatesLogOriginalFileName_Acrobat_Explain">Use original filename in Bates numbering log output.&#10;&#10;When users choose Bates-based output filenames.&#10;&#10;Values:&#10;0 = Bates numbers in log&#10;1 = original filename</string>
      <string id="bGlobalBarMenuFeatureKey_Acrobat">Create PDF Split Menu</string>
      <string id="bGlobalBarMenuFeatureKey_Acrobat_Explain">Controls whether the Create Split Menu is shown under the Create a PDF menu item.&#10;&#10;0 = Create Split Menu hidden&#10;1 = Create Split Menu shown</string>
      <string id="bEnableReflowEditing_Acrobat">Reflow Editing</string>
      <string id="bEnableReflowEditing_Acrobat_Explain">Controls and locks the Reflow Editing feature, preventing users from toggling it via Preferences.&#10;&#10;0 = Reflow Editing disabled and locked&#10;1 = Reflow Editing available (user can toggle via Preferences)</string>
      <string id="bIgnoreDataSchema_Acrobat">Restrict Form Data to Schema</string>
      <string id="bIgnoreDataSchema_Acrobat_Explain">Controls whether form submissions save all form data or only data fields that match the form's defined schema.&#10;&#10;Enabled writes 1 = schema-only data saved. Disabled (or not configured) = all data saved regardless of schema.&#10;&#10;0 / not set = save all form data&#10;1 = save only schema-matching form data</string>

      <!-- ======================================== -->
      <!--         Microsoft Purview (MIP)          -->
      <!-- ======================================== -->

      <string id="bMIPCheckPolicyOnDocSave_Acrobat">Check MIP Policy on Save</string>
      <string id="bMIPCheckPolicyOnDocSave_Acrobat_Explain">Lock MIP labeling checks on save (admin).&#10;&#10;Requires default or mandatory labeling in the Purview portal. Grays out related Preferences UI. HKLM lockdown, not per-user MicrosoftAIP prefs.&#10;&#10;Values:&#10;0 = do not lock&#10;1 = lock enabled</string>
      <string id="bMIPLabelling_Acrobat">Enable MIP Labelling</string>
      <string id="bMIPLabelling_Acrobat_Explain">Lock Enable MIP labeling in Preferences ) Security.&#10;&#10;Machine-level lockdown; complements per-user MicrosoftAIP prefs.&#10;&#10;Values:&#10;0 = do not lock&#10;1 = lock enabled</string>
      <string id="bEnableDKEAdmin_Acrobat">MIP Double Key Encryption</string>
      <string id="bEnableDKEAdmin_Acrobat_Explain">Controls and locks whether Double Key Encryption (DKE) label support is available for Microsoft Purview Information Protection workflows.&#10;&#10;0 = DKE locked disabled&#10;1 = DKE locked enabled</string>
      <string id="bMIPExternalAuthAdmin_Acrobat">MIP External Browser Auth</string>
      <string id="bMIPExternalAuthAdmin_Acrobat_Explain">Controls and locks whether browser-based (external) authentication is used for Microsoft Purview Information Protection operations.&#10;&#10;0 = external browser auth locked off&#10;1 = external browser auth locked on</string>
      <string id="iMIPCloud_Acrobat">MIP Sovereign Cloud</string>
      <string id="iMIPCloud_Acrobat_Explain">Locks which Microsoft cloud instance Acrobat and Reader use for MIP SDK operations.&#10;&#10;Machine-level FeatureLockDown lockdown. Relevant for sovereign and government tenants. MIP SDK Cloud enum values: 0: Unknown. 1: Custom. 2: Test. 3: Commercial (default/global). 4: Germany. 5: US DoD. 6: US GCC. 7: US GCC High. 8: US Sec. 9: US Nat. 10: China.</string>
      <string id="iMIPCloud_Acrobat_opt0">Unknown</string>
      <string id="iMIPCloud_Acrobat_opt1">Custom</string>
      <string id="iMIPCloud_Acrobat_opt2">Test</string>
      <string id="iMIPCloud_Acrobat_opt3">Commercial</string>
      <string id="iMIPCloud_Acrobat_opt4">Germany</string>
      <string id="iMIPCloud_Acrobat_opt5">US DoD</string>
      <string id="iMIPCloud_Acrobat_opt6">US GCC</string>
      <string id="iMIPCloud_Acrobat_opt7">US GCC High</string>
      <string id="iMIPCloud_Acrobat_opt8">US Sec</string>
      <string id="iMIPCloud_Acrobat_opt9">US Nat</string>
      <string id="iMIPCloud_Acrobat_opt10">China</string>
      <string id="bSilentAuth_Acrobat">Suppress OS Auth Prompts (MIP)</string>
      <string id="bSilentAuth_Acrobat_Explain">Controls and locks whether OS authentication prompts are suppressed during MIP operations. OS prompts are suppressed by default; set Disabled to allow them (useful for troubleshooting AADSTS50020 errors).&#10;&#10;0 = OS auth prompts allowed&#10;1 = OS auth prompts suppressed (default)</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="bEnable3D_Acrobat">3D Content in PDFs</string>
      <string id="bEnable3D_Acrobat_Explain">Specifies whether to trust and render 3D content in PDFs.&#10;&#10;This setting can override b3DEnableContent.&#10;&#10;Possible values include:&#10;0: Don't render 3D content&#10;1: Trust and render 3D files</string>
      <string id="bEnableProtectedModeAppContainer_Acrobat">AppContainer Sandbox</string>
      <string id="bEnableProtectedModeAppContainer_Acrobat_Explain">Specifies whether to enable the AppContainer sandbox.&#10;&#10;Possible values include:&#10;0: Disable Microsoft's AppContainer sandbox&#10;1: Enable Microsoft's AppContainer sandbox</string>
      <string id="bEnableBlacklistForOpenSave_Acrobat">Attachment Extension Blocklist in Dialogs</string>
      <string id="bEnableBlacklistForOpenSave_Acrobat_Explain">Hide tBuiltInPermList level-3 extensions from Open/Save dialogs.&#10;&#10;New behavior since build 21.011.20029; enabled by default.&#10;&#10;Values:&#10;0 = legacy behavior (extensions visible)&#10;1 = retain new behavior (hidden)</string>
      <string id="bDisableJavaScript_Acrobat">Block JavaScript Execution</string>
      <string id="bDisableJavaScript_Acrobat_Explain">Blocks and locks JavaScript execution in PDF documents, preventing users from bypassing via privileged locations.&#10;&#10;This lockable setting overrides bEnableJS and prevents users from re-enabling JavaScript through the Yellow Message Bar or Trusted Locations.&#10;&#10;Possible values include:&#10;0 or null: Don't disable JS&#10;1: Disable and lock JS</string>
      <string id="iFileAttachmentPerms_Acrobat">Block non-PDF file attachments</string>
      <string id="iFileAttachmentPerms_Acrobat_Explain">Block opening non-PDF/FDF file attachments.&#10;&#10;Values:&#10;0 = allow&#10;1 = block</string>
      <string id="bDisablePDFRedirectionActions_Acrobat">Block PDF Link Actions</string>
      <string id="bDisablePDFRedirectionActions_Acrobat_Explain">Specifies whether to block specific PDF actions (listed below) which result in opening a link.&#10;&#10;This preference does not block regular web links. Enabling this feature blocks PDF actions that open links, including GoToE, GoToR, Launch, Thread, Import Data, Export Form Data, Submit Form, and Reset Form.&#10;&#10;Possible values include:&#10;0 or null: Don't block these opening links&#10;1: Block links</string>
      <string id="bEnablePVCertificateBasedTrust_Acrobat">Certification Status in Protected View</string>
      <string id="bEnablePVCertificateBasedTrust_Acrobat_Explain">Specifies whether a document's certification status should appear in the Protected View document message bar.&#10;&#10;Possible values include:&#10;0: Don't show the document's certification status&#10;1: Do show the document's certification status</string>
      <string id="bEnhancedSecurityInBrowser_Acrobat">Enhanced Security in Browser</string>
      <string id="bEnhancedSecurityInBrowser_Acrobat_Explain">Enhanced security when running in the browser.&#10;&#10;GUI checkbox sets this with bEnhancedSecurityStandalone. On 8.x, use bEnhancedSecurityStandalone for both.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled</string>
      <string id="bEnhancedSecurityStandalone_Acrobat">Enhanced Security Standalone</string>
      <string id="bEnhancedSecurityStandalone_Acrobat_Explain">Enhanced security in the standalone application.&#10;&#10;GUI checkbox sets this with bEnhancedSecurityInBrowser. On 8.x, this controls both browser and standalone.&#10;&#10;Values:&#10;0 = disabled&#10;1 = enabled</string>
      <string id="bEnableFlash_Acrobat">Flash Content in PDFs</string>
      <string id="bEnableFlash_Acrobat_Explain">Render Flash content in PDFs.&#10;&#10;Privileged locations do not override this setting.&#10;&#10;Values:&#10;0 = empty box and security warning&#10;1 = play if Flash player present</string>
      <string id="bProtectedMode_Acrobat">Protected Mode Sandbox</string>
      <string id="bProtectedMode_Acrobat_Explain">Enables Protected Mode which sandboxes Acrobat and Reader processes.&#10;&#10;Protected Mode should be enabled to protect user systems and data.&#10;&#10;Possible values include:&#10;0: Don't enable protected mode&#10;1: Do enable protected mode</string>
      <string id="iProtectedView_Acrobat">Protected View Mode</string>
      <string id="iProtectedView_Acrobat_Explain">Protected View mode.&#10;&#10;Values:&#10;0 = off (default)&#10;1 = untrusted locations only (recommended)&#10;2 = all files</string>
      <string id="iProtectedView_Acrobat_opt0">Disable Protected View</string>
      <string id="iProtectedView_Acrobat_opt1">Enable Protected View for unsafe locations only</string>
      <string id="iProtectedView_Acrobat_opt2">Enable Protected View for all files</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat">Unlisted Attachment Type Permissions</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_Explain">Specifies the default permissions for file types that aren't listed in the default or user-specified lists.&#10;&#10;Possible values include:&#10;0: Prompt user without ability to set file type as Allowed (two choices: Open File, Never Allow). 1 (default): Prompt user with ability to Allow or Prohibit (three choices)&#10;2: Always open unlisted file types&#10;3: Never open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt0">Prompt without ability to allow (most restrictive prompt)</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt1">Prompt with ability to allow or prohibit (default)</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt2">Always open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Acrobat_opt3">Never open unlisted file types (most restrictive)</string>

      <!-- ======================================== -->
      <!--     Security: Trust and Permissions      -->
      <!-- ======================================== -->

      <string id="bMSStoreTrusted_Acrobat">Allow Changes to Windows Certificate Store Trust</string>
      <string id="bMSStoreTrusted_Acrobat_Explain">Controls whether users can change Windows Certificate Store trust settings (iMSStoreTrusted) via the UI.&#10;&#10;Set the desired iMSStoreTrusted value before deploying this lock.&#10;&#10;0 = iMSStoreTrusted locked, UI disabled&#10;1 = iMSStoreTrusted user-configurable</string>
      <string id="bAllowInvisibleSig_Acrobat">Allow Invisible Signatures</string>
      <string id="bAllowInvisibleSig_Acrobat_Explain">Controls whether invisible certification signatures are permitted.&#10;&#10;0 = invisible signatures blocked&#10;1 = invisible signatures allowed</string>
      <string id="bAllowPasswordSaving_Acrobat">Allow Password Caching</string>
      <string id="bAllowPasswordSaving_Acrobat_Explain">Controls whether passwords such as digital ID passwords can be cached to disk.&#10;&#10;0 = no caching; user must enter password each time&#10;1 = passwords cached to disk</string>
      <string id="bEnableSignatureClear_Acrobat">Allow Signature Clearing</string>
      <string id="bEnableSignatureClear_Acrobat_Explain">Controls whether signers can clear their own signatures.&#10;&#10;0 = signature clearing disabled&#10;1 = signature clearing enabled</string>
      <string id="bVerifyUseAlways_Acrobat">Always Use Specified Verify Handler</string>
      <string id="bVerifyUseAlways_Acrobat_Explain">Controls whether the aVerify handler is used for all signature verification or only as a fallback when the signature's declared Filter handler is unavailable.&#10;&#10;0 = aVerify is a fallback handler only&#10;1 = aVerify used to verify all signatures</string>
      <string id="bDisableExpandEnvironmentVariables_Acrobat">Block User Library Trust in Protected View</string>
      <string id="bDisableExpandEnvironmentVariables_Acrobat_Explain">Allow user-specific paths as trusted locations in Protected View.&#10;&#10;When off, only static org-wide trusted locations apply. Paths like C:\Users\%username%\Desktop can be trusted when enabled.&#10;&#10;Values:&#10;0 = trust user locations&#10;1 = do not trust user locations</string>
      <string id="bWinCacheSessionHandles_Acrobat">Cache Digital ID Session Handles</string>
      <string id="bWinCacheSessionHandles_Acrobat_Explain">Controls whether CSP session handles are retained after digital ID authentication, avoiding repeated authentication prompts within the same session.&#10;&#10;0 = user must authenticate each time the digital ID is used&#10;1 = CSP handles cached until logout or session end</string>
      <string id="bDisableADCFileStore_Acrobat">Disable Acrobat.com File Storage</string>
      <string id="bDisableADCFileStore_Acrobat_Explain">Disables Acrobat.com file storage integration.&#10;&#10;When enabled, disables storage of files on Acrobat.com (Adobe Document Cloud).&#10;&#10;Possible values include:&#10;0: Allow Acrobat.com file storage&#10;1: Disable Acrobat.com file storage</string>
      <string id="bDisableOSTrustedSites_Acrobat">Disable IE Trusted Sites as Privileged Locations</string>
      <string id="bDisableOSTrustedSites_Acrobat_Explain">Controls whether sites in Internet Explorer's Trusted Sites zone are treated as privileged locations. When this policy is set, bTrustOSTrustedSites is overridden.&#10;&#10;0 = IE Trusted Sites honored as privileged locations&#10;1 = IE Trusted Sites not honored as privileged locations</string>
      <string id="bAllowAPSConfig_Acrobat">LiveCycle RMS Server Config</string>
      <string id="bAllowAPSConfig_Acrobat_Explain">Controls whether a LiveCycle Rights Management Server can be configured via the Security Settings Console.&#10;&#10;0 = LiveCycle RMS configuration blocked&#10;1 = LiveCycle RMS configuration allowed</string>
      <string id="bReqRevCheck_Acrobat">Lock Revocation Check Setting</string>
      <string id="bReqRevCheck_Acrobat_Explain">Locks the revocation check setting (iReqRevCheck) and prevents users from changing it via the UI.&#10;&#10;This policy locks whatever value is in iReqRevCheck — configure that preference before deploying this lock.&#10;&#10;0 = iReqRevCheck unlocked&#10;1 = iReqRevCheck locked and UI disabled</string>
      <string id="bReasons_Acrobat">Lock Signing Reasons Settings</string>
      <string id="bReasons_Acrobat_Explain">Locks signing reason settings and prevents users from modifying them.&#10;&#10;0 = signing reason settings user-configurable&#10;1 = signing reason settings locked (if cReasons is empty, reason UI disabled; if cReasons has values, those reasons are enforced read-only)</string>
      <string id="bDisableTrustedFolders_Acrobat">Lock Trusted Folders and Files</string>
      <string id="bDisableTrustedFolders_Acrobat_Explain">Disable and lock trusted folders and files.&#10;&#10;Prevents users from adding folder or file privileged locations.&#10;&#10;Values:&#10;0 or null = allowed&#10;1 = disabled and locked</string>
      <string id="bDisableTrustedSites_Acrobat">Lock Trusted Host Sites</string>
      <string id="bDisableTrustedSites_Acrobat_Explain">Disable and lock host-based privileged locations.&#10;&#10;Values:&#10;0 or null = enable and lock host-based locations&#10;1 = disable and lock host-based locations</string>
      <string id="bEnableCEFBasedUI_Acrobat">Modern Digital Signature UI</string>
      <string id="bEnableCEFBasedUI_Acrobat_Explain">Modern CEF-based digital signature UI.&#10;&#10;All values disable the user preference toggle. Block self-signed ID creation (post-June 2016) with bSelfSignCertGen=0 and bEnableCEFBasedUI=0.&#10;&#10;Values:&#10;0 = legacy UI&#10;1 = modern UI</string>
      <string id="bUseTSAsSigningTime_Acrobat">Show Timestamp in Signature</string>
      <string id="bUseTSAsSigningTime_Acrobat_Explain">Show timestamp server time in signature appearance.&#10;&#10;Default uses local clock. Requires bReqSigPropRetrieval=1 (HKCU). Verify time against iMaxClockSkew (default 65 min).&#10;&#10;Values:&#10;0 = hide timestamp&#10;1 = show timestamp</string>
      <string id="bShowSignMenu_Acrobat">Sign Menu in Menu Bar</string>
      <string id="bShowSignMenu_Acrobat_Explain">Controls whether the Sign menu appears in Acrobat's top-level menu bar.&#10;&#10;0 = Sign menu hidden&#10;1 = Sign menu shown</string>
      <string id="bAllowReasonWhenSigning_Acrobat">Signing Reason UI</string>
      <string id="bAllowReasonWhenSigning_Acrobat_Explain">Controls whether the signing reason dialog appears during the signature workflow.&#10;&#10;0 = reason dialog not shown during signing&#10;1 = reason dialog shown during signing</string>
      <string id="bEnableCertificateBasedTrust_Acrobat">Trust Certified Documents</string>
      <string id="bEnableCertificateBasedTrust_Acrobat_Explain">Trust certified documents as privileged locations (admin lock).&#10;&#10;Lockable counterpart to bTrustCertifiedDocuments. Does not apply in Protected View.&#10;&#10;Values:&#10;0 or null = not trusted&#10;1 = trusted</string>
      <string id="iUnknownURLPerms_Acrobat">Unknown URL Access Policy</string>
      <string id="iUnknownURLPerms_Acrobat_Explain">Access policy for URLs not in the user list.&#10;&#10;Overrides privileged location host settings in some versions.&#10;&#10;Values:&#10;1 = ask&#10;2 = allow&#10;3 = block</string>
      <string id="iUnknownURLPerms_Acrobat_opt0">Always ask</string>
      <string id="iUnknownURLPerms_Acrobat_opt1">Always allow</string>
      <string id="iUnknownURLPerms_Acrobat_opt2">Always block</string>
      <string id="iURLPerms_Acrobat">URL Access Permissions</string>
      <string id="iURLPerms_Acrobat_Explain">Allow, block, or custom website access from PDF files.&#10;&#10;This Computer-scope policy writes to HKLM FeatureLockDown and is the correct enforcement path. Setting this policy locks the Trust Manager dialog for all users and satisfies the DISA STIG automated scan (V-213121 / AADC-CN-000285). Allow or Block resets tHostPerms; Custom uses tHostPerms.&#10;&#10;Possible values include:&#10;0: Custom Setting (uses tHostPerms URL list)&#10;1: Block all websites&#10;2: Allow all websites</string>
      <string id="iURLPerms_Acrobat_opt0">Custom Setting (uses tHostPerms URL list)</string>
      <string id="iURLPerms_Acrobat_opt1">Block all websites</string>
      <string id="iURLPerms_Acrobat_opt2">Allow all websites</string>
      <string id="bValidateOnOpen_Acrobat">Validate Signatures on Open</string>
      <string id="bValidateOnOpen_Acrobat_Explain">Locks the signature validation on open setting and prevents users from changing it.&#10;&#10;This policy locks whatever value is currently in HKCU — it does not independently configure validation. Set the desired HKCU value before deploying this lock.&#10;&#10;0 = do not validate signatures on open&#10;1 = validate signatures on open</string>

      <!-- ======================================== -->
      <!--           Sharing and Features           -->
      <!-- ======================================== -->

      <string id="bToggleAdobeSign_Acrobat">Adobe Acrobat Sign</string>
      <string id="bToggleAdobeSign_Acrobat_Explain">Adobe Acrobat Sign (Send for Signature).&#10;&#10;On Continuous track, also set bToggleManageSign.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bToggleSendAndTrack_Acrobat">Adobe Send &amp; Track</string>
      <string id="bToggleSendAndTrack_Acrobat_Explain">Controls whether Adobe Send and Track is available in the application.&#10;&#10;0 = Send and Track enabled&#10;1 = Send and Track disabled</string>
      <string id="bEnableRecipientMention_Acrobat">Allow @Mention Non-Reviewers</string>
      <string id="bEnableRecipientMention_Acrobat_Explain">Controls whether participants in a shared review can @mention people who are not current review collaborators.&#10;&#10;0 = can only @mention current reviewers&#10;1 = can @mention any person</string>
      <string id="bDisableSharePointFeatures_Acrobat">Disable SharePoint &amp; Office 365 Integration</string>
      <string id="bDisableSharePointFeatures_Acrobat_Explain">Disable SharePoint and Office 365 integration.&#10;&#10;Disables SharePoint detection, check-out prompt, and SharePoint menu items.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bDisableWebmail_Acrobat">Disable WebMail Integration</string>
      <string id="bDisableWebmail_Acrobat_Explain">Disable WebMail integration.&#10;&#10;Values:&#10;0 = enable WebMail profiles&#10;1 = disable. With bSendMailShareRedirection=1, the email icon attaches the PDF directly</string>
      <string id="bToggleAdobeReview_Acrobat">Document Cloud Review Service</string>
      <string id="bToggleAdobeReview_Acrobat_Explain">Document Cloud Review service UI.&#10;&#10;When disabled, removes cloud review UI and legacy review types are used.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bSendMailShareRedirection_Acrobat">Email Icon Attach to Email Behavior</string>
      <string id="bSendMailShareRedirection_Acrobat_Explain">Email icon attaches document instead of opening the share pane.&#10;&#10;Values:&#10;0 or null = open share pane&#10;1 = attach to email</string>
      <string id="bMixRecentFilesFeatureLockDown_Acrobat">Hide Shared Files from Recent List</string>
      <string id="bMixRecentFilesFeatureLockDown_Acrobat_Explain">Show shared files in the Recent list.&#10;&#10;Covers shares, reviews, signing, and Send and Track workflows.&#10;&#10;Values:&#10;0 = add to Recent&#10;1 = do not add</string>
      <string id="bToggleFSSSignatureSaving_Acrobat">Save Signature to Cloud</string>
      <string id="bToggleFSSSignatureSaving_Acrobat_Explain">Controls whether the option to save a newly created signature to the cloud is shown. Also applies to user initials.&#10;&#10;0 = save signature to cloud UI shown&#10;1 = save signature to cloud UI hidden</string>
      <string id="bAdobeSendPluginToggle_Acrobat">Send &amp; Track Outlook Plugin</string>
      <string id="bAdobeSendPluginToggle_Acrobat_Explain">Adobe Send and Track button in Outlook.&#10;&#10;Uploads attachments to Document Cloud and inserts public preview/download links in email.&#10;&#10;Values:&#10;0 = enabled&#10;1 = disabled</string>
      <string id="bEnableReviewPromote_Acrobat">Share and Review Reminder Tip</string>
      <string id="bEnableReviewPromote_Acrobat_Explain">Controls whether a Share/Review reminder tip is shown to users who have previously used those features.&#10;&#10;0 = no reminder tip shown&#10;1 = reminder tip shown to eligible users</string>

      <string id="bEnableSharePointInChromeExtn_Acrobat">SharePoint in Chrome Extension</string>
      <string id="bEnableSharePointInChromeExtn_Acrobat_Explain">Controls whether SharePoint integration is active in the Acrobat Chrome browser extension.&#10;&#10;0 = SharePoint integration disabled&#10;1 = SharePoint integration enabled in Chrome extension</string>
      <string id="bToggleManageSign_Acrobat">Show Acrobat Sign Tracking Tab</string>
      <string id="bToggleManageSign_Acrobat_Explain">Signature tab on Home, notifications, and sign tracking.&#10;&#10;Hides agreements, notifications, and To Do sign cards when disabled.&#10;&#10;Values:&#10;0 = show&#10;1 = hide</string>
      <string id="bDisableOnBehalfOfText_Acrobat">Show Comment Author in Shared Review</string>
      <string id="bDisableOnBehalfOfText_Acrobat_Explain">Controls whether the comment author's name appears as 'On behalf of [name]' in shared review comments.&#10;&#10;0 = comment author name not displayed&#10;1 = 'On behalf of [name]' shown in shared review comments</string>
      <string id="iClientType_Gmail_Acrobat">WebMail Client Type (Gmail)</string>
      <string id="iClientType_Gmail_Acrobat_Explain">Identifies the Gmail Mail client type for WebMail.&#10;&#10;The value can only be: 1</string>
      <string id="iClientType_Gmail_Acrobat_opt0">Locked value: 1 (per Adobe PrefRef)</string>
      <string id="iClientType_Yahoo_Acrobat">WebMail Client Type (Yahoo)</string>
      <string id="iClientType_Yahoo_Acrobat_Explain">Identifies the Yahoo Mail client type for WebMail.&#10;&#10;The value can only be: 2</string>
      <string id="iClientType_Yahoo_Acrobat_opt0">Locked value: 2 (per Adobe PrefRef)</string>
      <string id="iIMAPPort_Acrobat">WebMail IMAP Port</string>
      <string id="iIMAPPort_Acrobat_Explain">Identifies the My Profile Mail IMAP server port number for WebMail.&#10;&#10;The value can be: Any valid port number.</string>
      <string id="iIMAPPort_Acrobat_opt0">143 (Standard IMAP)</string>
      <string id="iIMAPPort_Acrobat_opt1">993 (IMAP over SSL/TLS)</string>
      <string id="iIMAPSecurity_Acrobat">WebMail IMAP Security</string>
      <string id="iIMAPSecurity_Acrobat_Explain">Specifies whether to enable the My Profile Mail IMAP security for WebMail.&#10;&#10;The value can be: 0: Don't enable security. 1: Enable security.</string>
      <string id="iSMTPPort_Acrobat">WebMail SMTP Port</string>
      <string id="iSMTPPort_Acrobat_Explain">Identifies the My Profile Mail SMTP server port number for WebMail.&#10;&#10;The value can be: Any valid server port number.</string>
      <string id="iSMTPPort_Acrobat_opt0">25 (Standard SMTP)</string>
      <string id="iSMTPPort_Acrobat_opt1">465 (SMTP over SSL)</string>
      <string id="iSMTPPort_Acrobat_opt2">587 (SMTP Submission / TLS)</string>
      <string id="iSMTPSecurity_Acrobat">WebMail SMTP Security</string>
      <string id="iSMTPSecurity_Acrobat_Explain">Specifies whether to enable the My Profile Mail SMTP security for WebMail.&#10;&#10;The value can be: 0: Don't enable security. 1: Enable security.</string>

      <!-- ======================================== -->
      <!--          Startup and Experience          -->
      <!-- ======================================== -->

      <string id="bShowMsgAtLaunch_Acrobat">Adobe Messages at Launch</string>
      <string id="bShowMsgAtLaunch_Acrobat_Explain">Show Adobe messages at product launch.&#10;&#10;Also hides Share Feedback, EOL warnings, profile prompts, and the Home banner.&#10;&#10;Values:&#10;0 = hide&#10;1 = show</string>
      <string id="bAllowUserToChangeMsgPrefs_Acrobat">Allow Users to Change Message Preferences</string>
      <string id="bAllowUserToChangeMsgPrefs_Acrobat_Explain">Controls whether users can change message display settings (bShowMsgAtLaunch and bDontShowMsgWhenViewingDoc) via Preferences.&#10;&#10;0 = message preferences locked&#10;1 = message preferences user-configurable</string>
      <string id="bToggleNotifications_Acrobat">Desktop Notifications</string>
      <string id="bToggleNotifications_Acrobat_Explain">Controls whether all in-product and desktop notifications are enabled. When all notifications are off, individual service notification settings are ignored.&#10;&#10;0 = all notifications enabled&#10;1 = all notifications disabled</string>
      <string id="bShowWelcomeScreen_Acrobat">Disable Welcome Screen</string>
      <string id="bShowWelcomeScreen_Acrobat_Explain">Controls whether the Welcome screen is shown at product launch.&#10;&#10;0 = Welcome screen hidden&#10;1 = Welcome screen shown</string>
      <string id="bToggleFTE_Acrobat">First Time Experience</string>
      <string id="bToggleFTE_Acrobat_Explain">First Time Experience (welcome tour and page).&#10;&#10;Also disabled when bUpdater, bToggleAdobeDocumentServices, bToggleAdobeSign, bTogglePrefsSync, or bToggleWebConnectors is set.&#10;&#10;Values:&#10;0 or null = enabled&#10;1 = disabled</string>
      <string id="bDontShowMsgWhenViewingDoc_Acrobat">Hide Adobe Messages on Document Open</string>
      <string id="bDontShowMsgWhenViewingDoc_Acrobat_Explain">Controls whether Adobe messages are shown when a document opens, including right-pane messages and promotional messages such as 'Start Free Trial'.&#10;&#10;0 = Adobe messages hidden on document open&#10;1 = Adobe messages shown on document open</string>
      <string id="bEnableBellButton_Acrobat">Hide In-Product Notifications Bell</string>
      <string id="bEnableBellButton_Acrobat_Explain">Controls whether the in-product notifications bell is hidden. Notifications are still fetched and cached in the background when hidden.&#10;&#10;0 = notifications bell shown&#10;1 = notifications bell hidden</string>
      <string id="bToggleShareFeedback_Acrobat">Hide Send Feedback Icon</string>
      <string id="bToggleShareFeedback_Acrobat_Explain">Controls whether the Send Feedback icon is shown. Also hidden when bShowMsgAtLaunch is 0. Supersedes bUsageMeasurement in version 12 and later.&#10;&#10;0 = Send Feedback icon hidden&#10;1 = Send Feedback icon shown</string>
      <string id="bToggleToDoList_Acrobat">Home Screen To Do List</string>
      <string id="bToggleToDoList_Acrobat_Explain">Controls whether the To Do action item list is shown on the Home screen.&#10;&#10;0 = To Do list shown on Home screen&#10;1 = To Do list hidden</string>
      <string id="bIsSCReducedModeEnforcedEx_Acrobat">Reader mode on Acrobat (Unified x64)</string>
      <string id="bIsSCReducedModeEnforcedEx_Acrobat_Explain">Enforce Reader-like reduced mode on Unified Acrobat (64-bit MUI).&#10;&#10;Opens PDFs without Adobe ID sign-in.&#10;&#10;Values:&#10;0 = not enforced&#10;1 = enforced. May require additional cIPM values per Adobe enterprise KB</string>
      <string id="bShowScanTabInHomeView_Acrobat">Scan Tab in Home View</string>
      <string id="bShowScanTabInHomeView_Acrobat_Explain">Controls whether the Scan tab is visible in the Home view, providing access to scanned documents.&#10;&#10;0 = Scan tab hidden&#10;1 = Scan tab shown in Home view</string>
      <string id="bToggleNotificationToasts_Acrobat">Show Desktop Notification Toasts</string>
      <string id="bToggleNotificationToasts_Acrobat_Explain">Controls whether desktop notification toast messages are displayed. Notifications are still fetched and cached when toasts are hidden.&#10;&#10;0 = desktop notification toasts shown&#10;1 = desktop notification toasts hidden</string>
      <string id="bTogglePDFOwnershipToasts_Acrobat">Show PDF Ownership Notification</string>
      <string id="bTogglePDFOwnershipToasts_Acrobat_Explain">Controls whether a startup notification is shown that lets users set Acrobat as the default PDF viewer when both Acrobat and Reader are installed.&#10;&#10;0 = PDF ownership notification shown at startup&#10;1 = PDF ownership notification suppressed</string>
      <string id="bToggleToDoTiles_Acrobat">Show To Do Cards in Recent Tab</string>
      <string id="bToggleToDoTiles_Acrobat_Explain">Controls whether To Do cards for unaccepted workflows (reviews, views, and signing) are shown in the Recent tab.&#10;&#10;0 = To Do cards shown in Recent tab&#10;1 = To Do cards hidden</string>
      <string id="bUsageMeasurement_Acrobat">Usage Measurement (legacy)</string>
      <string id="bUsageMeasurement_Acrobat_Explain">Legacy master switch for usage measurement and analytics. Superseded by bToggleShareFeedback in version 12 and later.&#10;&#10;0 = usage measurement disabled&#10;1 = usage measurement enabled</string>
      <string id="bWhatsNewExp_Acrobat">What's New Experience</string>
      <string id="bWhatsNewExp_Acrobat_Explain">Controls whether the What's New screen and feature notification are shown to users on first launch. These UI items appear once per major version.&#10;&#10;0 = What's New screen and notification shown&#10;1 = What's New experience suppressed</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="bDisableThirdPartyPluginNotif_Acrobat">32-Bit Plugin Upgrade Notification</string>
      <string id="bDisableThirdPartyPluginNotif_Acrobat_Explain">Controls whether users with 32-bit plugins see an upgrade notification when the application transitions to 64-bit.&#10;&#10;0 = 32-bit plugin upgrade notification shown&#10;1 = notification suppressed</string>
      <string id="bEnableAutoDockUndockHUD_Acrobat">Auto Dock HUD Bar</string>
      <string id="bEnableAutoDockUndockHUD_Acrobat_Explain">Controls whether the HUD toolbar docks and undocks automatically based on window size.&#10;&#10;0 = HUD bar behavior fixed&#10;1 = HUD bar docks and undocks automatically</string>
      <string id="bHasAcrobatConsent_Acrobat">Auto Open Acrobat from Reader</string>
      <string id="bHasAcrobatConsent_Acrobat_Explain">Controls whether Reader automatically opens the current file in Acrobat when Acrobat is also installed.&#10;&#10;PDF ownership and the default viewer association are not changed.&#10;&#10;0 = Reader handles the file&#10;1 = file opened in Acrobat automatically</string>
      <string id="bCrashReporterEnabled_Acrobat">Crash Reporter Dialog</string>
      <string id="bCrashReporterEnabled_Acrobat_Explain">Controls whether the crash reporter dialog appears after an application crash, allowing users to send logs to Adobe.&#10;&#10;0 = crash reporter dialog suppressed&#10;1 = crash reporter dialog shown</string>
      <string id="bAcroSuppressOpenInReader_Acrobat">Disable Chrome PDF Extension</string>
      <string id="bAcroSuppressOpenInReader_Acrobat_Explain">Controls whether the Acrobat PDF viewer Chrome extension is disabled and locked.&#10;&#10;When disabled by policy, users see a tooltip: "The Acrobat Reader extension is currently disabled. Please contact your IT admin."&#10;&#10;0 = Chrome PDF extension available&#10;1 = Chrome PDF extension disabled and locked</string>
      <string id="bSuppressMessageBar_Acrobat">Hide Document Message Bar</string>
      <string id="bSuppressMessageBar_Acrobat_Explain">Controls whether the document message bar is suppressed.&#10;&#10;Suppressing the message bar adversely affects signing when preview mode is used.&#10;&#10;0 = document message bar shown&#10;1 = document message bar hidden</string>
      <string id="bDisablePDFHandlerSwitching_Acrobat">Lock Default PDF Viewer</string>
      <string id="bDisablePDFHandlerSwitching_Acrobat_Explain">Locks the default PDF viewer so users cannot switch to another Adobe PDF handler.&#10;&#10;Does not affect switching to or from non-Adobe products. UI changes invoke the installer (HKLM), not HKCU.&#10;&#10;0 = default PDF viewer can be changed&#10;1 = default PDF viewer locked</string>
      <string id="bDisableThumbnailPreviewHandler_Acrobat">Lock PDF Thumbnails in Explorer</string>
      <string id="bDisableThumbnailPreviewHandler_Acrobat_Explain">Locks the PDF thumbnail preview handler in Windows Explorer, preventing users from enabling it.&#10;&#10;0 = thumbnail preview configurable&#10;1 = thumbnail preview disabled and locked</string>
      <string id="PatchCleanFlag_Acrobat">Patch Cache Cleanup</string>
      <string id="PatchCleanFlag_Acrobat_Explain">Triggers cleanup of cached MSI and MSP patch files on the next product update.&#10;&#10;Patches accumulate under ProgramData\Adobe\ARM and Windows\Installer; cleanup reclaims disk space.&#10;&#10;0 = no patch cache cleanup&#10;1 = cleanup cached patches on next update</string>
      <string id="bUpdater_Updater_Acrobat">Product Updater</string>
      <string id="bUpdater_Updater_Acrobat_Explain">Controls whether automatic Adobe product updates run (distinct from cloud service toggles in FeatureLockDown\cServices).&#10;&#10;0 = automatic product updates disabled&#10;1 = automatic product updates enabled</string>
      <string id="bShouldUseScalableCursor_Acrobat">Scalable Cursor</string>
      <string id="bShouldUseScalableCursor_Acrobat_Explain">Controls whether the application uses a scalable (32-bit alpha-channel) cursor.&#10;&#10;Citrix legacy graphics mode does not support scalable cursors; disabling this setting improves cursor performance in Citrix environments.&#10;&#10;0 = standard cursor (recommended for Citrix)&#10;1 = scalable cursor</string>
      <string id="dSplitBySizeMaxSize_Acrobat">Split by Size Maximum (MB)</string>
      <string id="dSplitBySizeMaxSize_Acrobat_Explain">Maximum MB per split file.&#10;&#10;Allowed range 50-1024; out-of-range values default to 50.</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt0">50 MB (minimum)</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt1">100 MB</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt2">250 MB</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt3">500 MB</string>
      <string id="dSplitBySizeMaxSize_Acrobat_opt4">1024 MB (maximum)</string>
      <string id="bFavoritesFeaturesLockDown_Acrobat">Starred Files Feature</string>
      <string id="bFavoritesFeaturesLockDown_Acrobat_Explain">Controls whether the starred files feature is disabled and locked, or deferred to the bFavoritesStripInRFL preference.&#10;&#10;0 = starred files disabled and locked&#10;1 = behavior deferred to bFavoritesStripInRFL</string>

      <!-- ======================================== -->
      <!--                  Upsell                  -->
      <!-- ======================================== -->

      <string id="bToggleBillingIssue_Acrobat">Disable Billing Issue Call to Action</string>
      <string id="bToggleBillingIssue_Acrobat_Explain">Controls whether a billing issue call-to-action appears in the top bar when a billing problem is detected.&#10;&#10;0 = billing issue CTA hidden&#10;1 = billing issue CTA shown</string>
      <string id="bToggleSophiaWebInfra_Acrobat">Disable Promotional Campaign Messages</string>
      <string id="bToggleSophiaWebInfra_Acrobat_Explain">Controls whether promotional campaign messages (trial prompts, Acrobat download prompts) are shown to users.&#10;&#10;0 = promotional campaigns disabled&#10;1 = promotional campaigns shown</string>
      <string id="bMerchandizingEnabled_Acrobat">Express Templates in Create PDF</string>
      <string id="bMerchandizingEnabled_Acrobat_Explain">Controls whether Express Templates are shown in the Create PDF workflow.&#10;&#10;0 = Express Templates hidden&#10;1 = Express Templates shown in Create PDF</string>
      <string id="bLimitPromptsFeatureKey_Acrobat">Limit Informational Prompts</string>
      <string id="bLimitPromptsFeatureKey_Acrobat_Explain">Controls whether informational prompts (tips, calls-to-action, feature walkthroughs) are throttled per user per day.&#10;&#10;0 = prompts not throttled&#10;1 = prompts limited to 1 per day and 3 per week</string>
      <string id="bToggleDCAppCenter_Acrobat">Show App Center UI</string>
      <string id="bToggleDCAppCenter_Acrobat_Explain">Controls whether the App Center and get-apps banner are shown on the Home screen.&#10;&#10;0 = App Center shown&#10;1 = App Center hidden</string>
      <string id="bAcroSuppressUpsell_Acrobat">Show Upgrade Prompts</string>
      <string id="bAcroSuppressUpsell_Acrobat_Explain">Controls whether upgrade and upsell prompts are shown, including Reader tool purchase prompts and Standard-to-Professional upgrade prompts.&#10;&#10;0 = upsell prompts shown&#10;1 = upsell suppressed</string>
      <string id="bEnableTrialistLaunchCard_Acrobat">Trial Purchase Prompt</string>
      <string id="bEnableTrialistLaunchCard_Acrobat_Explain">Controls whether trial users see a prompt to complete their Acrobat purchase.&#10;&#10;0 = trial purchase prompt suppressed&#10;1 = trial purchase prompt shown</string>
      <!-- ======================================== -->
      <!--                                          -->
      <!--   Reader DC (32-bit) - policy strings    -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--           Cloud and Connectors           -->
      <!-- ======================================== -->

      <string id="bToggleFillSign_Reader">Adobe Fill &amp; Sign</string>
      <string id="bToggleFillSign_Reader_Explain">Controls whether Adobe Fill and Sign is available in the application.&#10;&#10;0 = Fill and Sign available&#10;1 = Fill and Sign hidden</string>
      <string id="bBoxConnectorEnabled_Reader">Box Cloud Connector</string>
      <string id="bBoxConnectorEnabled_Reader_Explain">Controls whether the Box cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = Box connector disabled&#10;1 = Box connector enabled</string>
      <string id="bToggleAdobeDocumentServices_Reader">Document Cloud Services</string>
      <string id="bToggleAdobeDocumentServices_Reader_Explain">Controls whether Document Cloud services are available (excluding Sign, prefs sync, and third-party connectors).&#10;&#10;Reader removes Create/Export/Organize/Combine tools without a subscription. Uses cServices semantics: 0 enables the service, 1 disables it.&#10;&#10;0 = Document Cloud services active&#10;1 = Document Cloud services disabled</string>
      <string id="bToggleDocumentCloud_Reader">Document Cloud Storage</string>
      <string id="bToggleDocumentCloud_Reader_Explain">Controls whether Document Cloud (Adobe cloud) storage is available in the application.&#10;&#10;0 = Document Cloud storage available&#10;1 = Document Cloud storage disabled</string>
      <string id="bDropboxConnectorEnabled_Reader">Dropbox Cloud Connector</string>
      <string id="bDropboxConnectorEnabled_Reader_Explain">Controls whether the Dropbox cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = Dropbox connector disabled&#10;1 = Dropbox connector enabled</string>
      <string id="bEnableGentech_Reader">Generative AI Technology</string>
      <string id="bEnableGentech_Reader_Explain">Controls whether generative AI features are available. AI capabilities use cloud services; verify organizational data-handling policies before enabling.&#10;&#10;0 = generative AI features disabled&#10;1 = generative AI features enabled</string>
      <string id="bGoogleDriveConnectorEnabled_Reader">Google Drive Connector</string>
      <string id="bGoogleDriveConnectorEnabled_Reader_Explain">Controls whether the Google Drive cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = Google Drive connector disabled&#10;1 = Google Drive connector enabled</string>
      <string id="bToggleSendACopy_Reader">Hide Fill &amp; Sign Send a Copy Button</string>
      <string id="bToggleSendACopy_Reader_Explain">Controls whether the Send a Copy button is hidden in the Fill and Sign tool.&#10;&#10;0 = Send a Copy button hidden&#10;1 = Send a Copy button shown</string>
      <string id="bSuppressSignOut_Reader">Hide Sign Out Menu Item</string>
      <string id="bSuppressSignOut_Reader_Explain">Hides the sign-in and sign-out items from the Help menu.&#10;&#10;0 = sign-in/sign-out items visible&#10;1 = sign-in/sign-out items hidden</string>
      <string id="bOneDriveConnectorEnabled_Reader">OneDrive Connector</string>
      <string id="bOneDriveConnectorEnabled_Reader_Explain">Controls whether the OneDrive cloud connector is active. Overrides bToggleWebConnectors=1 on the Continuous track.&#10;&#10;0 = OneDrive connector disabled&#10;1 = OneDrive connector enabled</string>
      <string id="bTogglePrefsSync_Reader">Preferences Synchronization</string>
      <string id="bTogglePrefsSync_Reader_Explain">Controls whether desktop preferences are synchronized across signed-in devices. Uses cServices semantics: 0 enables the service, 1 disables it.&#10;&#10;0 = preferences sync active&#10;1 = preferences sync disabled and locked</string>
      <string id="bUpdater_Updates_Reader">Services &amp; Web-Plugin Updates</string>
      <string id="bUpdater_Updates_Reader_Explain">Controls whether web-plugin updates and cloud services (including sign-in) are active. Distinct from FeatureLockDown\bUpdater which controls product installer updates.&#10;&#10;0 = web-plugin updates and cloud services disabled&#10;1 = web-plugin updates and cloud services enabled</string>
      <string id="bToggleWebConnectors_Reader">Third-Party Cloud Connectors</string>
      <string id="bToggleWebConnectors_Reader_Explain">Controls whether third-party cloud storage connectors (Box, OneDrive, Dropbox) are available on the Continuous track. Uses cServices semantics: 0 enables the service, 1 disables it.&#10;&#10;Disabling also removes the Home screen, Add Account, and custom Open/Save entry points. Does not affect SharePoint.&#10;&#10;0 = third-party cloud connectors active&#10;1 = third-party cloud connectors disabled</string>

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="bUIDensityAutoDetectionEnabled_Reader">Auto UI Density Detection</string>
      <string id="bUIDensityAutoDetectionEnabled_Reader_Explain">Controls whether the automatic UI density detection is active, allowing the display size to adapt based on screen size, resolution, and monitor scaling.&#10;&#10;0 = auto UI density detection disabled&#10;1 = auto UI density detection enabled</string>
      <string id="bEnableContextualTips_Reader">Contextual Help Tips</string>
      <string id="bEnableContextualTips_Reader_Explain">Controls whether context-sensitive help tips are shown automatically based on the current task.&#10;&#10;0 = contextual tips disabled&#10;1 = contextual tips enabled</string>
      <string id="bEnableContextualToolbar_Reader">Contextual Toolbar</string>
      <string id="bEnableContextualToolbar_Reader_Explain">Controls whether a floating contextual toolbar appears when the user selects a PDF object (e.g., text markup tools when text is selected, editing tools when an image is selected).&#10;&#10;0 = contextual toolbar disabled&#10;1 = contextual toolbar shown on object selection</string>
      <string id="bEnableExtractPageRange_Reader">Extract Page Range UI</string>
      <string id="bEnableExtractPageRange_Reader_Explain">Controls whether the page range selection UI is shown in the Extract Pages dialog.&#10;&#10;0 = page range UI hidden&#10;1 = page range UI shown</string>
      <string id="bDisableAcrobatShortcutCustomization_Reader">Lock Tool Shortcut Customization</string>
      <string id="bDisableAcrobatShortcutCustomization_Reader_Explain">Controls whether users can customize tool shortcuts in the right-hand panel.&#10;&#10;0 = shortcut customization allowed&#10;1 = shortcut customization locked</string>
      <string id="bEnableAV2Enterprise_Reader">Modern Viewer</string>
      <string id="bEnableAV2Enterprise_Reader_Explain">Controls whether the Modern Viewer UI is shown; interacts with bShownViewerOnboarding and bEnableAV2.&#10;&#10;0 = classic viewer&#10;1 = modern viewer</string>
      <string id="bEnableRCMNewPOPUp_Reader">New Right-Click Context Menu</string>
      <string id="bEnableRCMNewPOPUp_Reader_Explain">Controls whether the modern right-click context menu (with icons and additional options) is shown, or the legacy context menu is used instead.&#10;&#10;0 = legacy context menu&#10;1 = modern context menu with icons</string>
      <string id="bFindMoreWorkflowsOnline_Reader">Online Actions Library Link</string>
      <string id="bFindMoreWorkflowsOnline_Reader_Explain">Controls whether the menu item that opens the online Actions file library is shown.&#10;&#10;0 = online Actions library menu item hidden&#10;1 = online Actions library menu item shown</string>
      <string id="bFindMoreCustomizationsOnline_Reader">Online Tool Set Exchange Link</string>
      <string id="bFindMoreCustomizationsOnline_Reader_Explain">Controls whether the menu item that opens the online Acrobat Tool Set Exchange is shown.&#10;&#10;0 = Tool Set Exchange menu item hidden&#10;1 = Tool Set Exchange menu item shown</string>
      <string id="bRCMCombineFeatureKey_Reader">Show Combine Files Context Menu</string>
      <string id="bRCMCombineFeatureKey_Reader_Explain">Controls whether the Combine Files item appears in the document right-click context menu.&#10;&#10;0 = Combine Files not shown in context menu&#10;1 = Combine Files shown in context menu</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="bGlobalBarMenuFeatureKey_Reader">Create PDF Split Menu</string>
      <string id="bGlobalBarMenuFeatureKey_Reader_Explain">Controls whether the Create Split Menu is shown under the Create a PDF menu item.&#10;&#10;0 = Create Split Menu hidden&#10;1 = Create Split Menu shown</string>
      <string id="bEnableFrictionlessInChromeExtn_Reader">Online Create PDF in Reader</string>
      <string id="bEnableFrictionlessInChromeExtn_Reader_Explain">Controls whether the online Create PDF service option is shown to Reader users.&#10;&#10;0 = online Create PDF UI hidden&#10;1 = online Create PDF UI shown</string>
      <string id="bIgnoreDataSchema_Reader">Restrict Form Data to Schema</string>
      <string id="bIgnoreDataSchema_Reader_Explain">Controls whether form submissions save all form data or only data fields that match the form's defined schema.&#10;&#10;Enabled writes 1 = schema-only data saved. Disabled (or not configured) = all data saved regardless of schema.&#10;&#10;0 / not set = save all form data&#10;1 = save only schema-matching form data</string>

      <!-- ======================================== -->
      <!--         Microsoft Purview (MIP)          -->
      <!-- ======================================== -->

      <string id="bMIPCheckPolicyOnDocSave_Reader">Check MIP Policy on Save</string>
      <string id="bMIPCheckPolicyOnDocSave_Reader_Explain">Locks the MIP policy check on document save, requiring a valid label before saving. Grays out related Preferences UI. Requires default or mandatory labeling configured in the Purview portal.&#10;&#10;0 = MIP policy check on save not enforced&#10;1 = MIP policy check on save locked on</string>
      <string id="bMIPLabelling_Reader">Enable MIP Labelling</string>
      <string id="bMIPLabelling_Reader_Explain">Locks the Enable MIP Labeling setting in Preferences and prevents users from changing it. Machine-level lockdown that complements per-user MicrosoftAIP preferences.&#10;&#10;0 = MIP labeling preference not locked&#10;1 = MIP labeling locked on</string>
      <string id="bEnableDKEAdmin_Reader">MIP Double Key Encryption</string>
      <string id="bEnableDKEAdmin_Reader_Explain">Controls and locks whether Double Key Encryption (DKE) label support is available for Microsoft Purview Information Protection workflows.&#10;&#10;0 = DKE locked disabled&#10;1 = DKE locked enabled</string>
      <string id="bMIPExternalAuthAdmin_Reader">MIP External Browser Auth</string>
      <string id="bMIPExternalAuthAdmin_Reader_Explain">Controls and locks whether browser-based (external) authentication is used for Microsoft Purview Information Protection operations.&#10;&#10;0 = external browser auth locked off&#10;1 = external browser auth locked on</string>
      <string id="iMIPCloud_Reader">MIP Sovereign Cloud</string>
      <string id="iMIPCloud_Reader_Explain">Locks which Microsoft cloud instance Acrobat and Reader use for MIP SDK operations.&#10;&#10;Machine-level FeatureLockDown lockdown. Relevant for sovereign and government tenants. MIP SDK Cloud enum values: 0: Unknown. 1: Custom. 2: Test. 3: Commercial (default/global). 4: Germany. 5: US DoD. 6: US GCC. 7: US GCC High. 8: US Sec. 9: US Nat. 10: China.</string>
      <string id="iMIPCloud_Reader_opt0">Unknown</string>
      <string id="iMIPCloud_Reader_opt1">Custom</string>
      <string id="iMIPCloud_Reader_opt2">Test</string>
      <string id="iMIPCloud_Reader_opt3">Commercial</string>
      <string id="iMIPCloud_Reader_opt4">Germany</string>
      <string id="iMIPCloud_Reader_opt5">US DoD</string>
      <string id="iMIPCloud_Reader_opt6">US GCC</string>
      <string id="iMIPCloud_Reader_opt7">US GCC High</string>
      <string id="iMIPCloud_Reader_opt8">US Sec</string>
      <string id="iMIPCloud_Reader_opt9">US Nat</string>
      <string id="iMIPCloud_Reader_opt10">China</string>
      <string id="bSilentAuth_Reader">Suppress OS Auth Prompts (MIP)</string>
      <string id="bSilentAuth_Reader_Explain">Controls and locks whether OS authentication prompts are suppressed during MIP operations. OS prompts are suppressed by default; set Disabled to allow them (useful for troubleshooting AADSTS50020 errors).&#10;&#10;0 = OS auth prompts allowed&#10;1 = OS auth prompts suppressed (default)</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="bEnable3D_Reader">3D Content in PDFs</string>
      <string id="bEnable3D_Reader_Explain">Controls whether 3D content in PDFs is trusted and rendered. Can override the b3DEnableContent preference.&#10;&#10;0 = 3D content blocked&#10;1 = 3D content rendered</string>
      <string id="bEnableProtectedModeAppContainer_Reader">AppContainer Sandbox</string>
      <string id="bEnableProtectedModeAppContainer_Reader_Explain">Controls whether the Microsoft AppContainer sandbox is enabled for additional process isolation.&#10;&#10;0 = AppContainer sandbox disabled&#10;1 = AppContainer sandbox enabled</string>
      <string id="bEnableBlacklistForOpenSave_Reader">Attachment Extension Blocklist in Dialogs</string>
      <string id="bEnableBlacklistForOpenSave_Reader_Explain">Hide tBuiltInPermList level-3 extensions from Open/Save dialogs.&#10;&#10;New behavior since build 21.011.20029; enabled by default.&#10;&#10;Values:&#10;0 = legacy behavior (extensions visible)&#10;1 = retain new behavior (hidden)</string>
      <string id="bDisableJavaScript_Reader">Block JavaScript Execution</string>
      <string id="bDisableJavaScript_Reader_Explain">Blocks and locks JavaScript execution in PDF documents. Overrides bEnableJS and prevents users from re-enabling JavaScript through the Yellow Message Bar or Trusted Locations.&#10;&#10;0 = JavaScript not blocked by this policy&#10;1 = JavaScript blocked and locked</string>
      <string id="iFileAttachmentPerms_Reader">Block non-PDF file attachments</string>
      <string id="iFileAttachmentPerms_Reader_Explain">Block opening non-PDF/FDF file attachments.&#10;&#10;Values:&#10;0 = allow&#10;1 = block</string>
      <string id="bDisablePDFRedirectionActions_Reader">Block PDF Link Actions</string>
      <string id="bDisablePDFRedirectionActions_Reader_Explain">Blocks PDF actions that open external links: GoToE, GoToR, Launch, Thread, Import Data, Export Form Data, Submit Form, and Reset Form. Does not block regular web links.&#10;&#10;0 = PDF link actions not blocked&#10;1 = link-opening PDF actions blocked</string>
      <string id="bEnablePVCertificateBasedTrust_Reader">Certification Status in Protected View</string>
      <string id="bEnablePVCertificateBasedTrust_Reader_Explain">Controls whether a document's certification status is shown in the Protected View document message bar.&#10;&#10;0 = certification status not shown in Protected View&#10;1 = certification status shown in Protected View</string>
      <string id="bEnhancedSecurityInBrowser_Reader">Enhanced Security in Browser</string>
      <string id="bEnhancedSecurityInBrowser_Reader_Explain">Controls whether enhanced security is enforced when Reader runs in a browser. The GUI checkbox for this setting also toggles bEnhancedSecurityStandalone.&#10;&#10;0 = enhanced security in browser disabled&#10;1 = enhanced security in browser enabled</string>
      <string id="bEnhancedSecurityStandalone_Reader">Enhanced Security Standalone</string>
      <string id="bEnhancedSecurityStandalone_Reader_Explain">Controls whether enhanced security is enforced in the standalone application. The GUI checkbox for this setting also toggles bEnhancedSecurityInBrowser.&#10;&#10;0 = enhanced security in standalone application disabled&#10;1 = enhanced security in standalone application enabled</string>
      <string id="bEnableFlash_Reader">Flash Content in PDFs</string>
      <string id="bEnableFlash_Reader_Explain">Controls whether Flash content in PDFs is rendered. Privileged locations do not override this setting.&#10;&#10;0 = Flash content blocked (empty box and security warning)&#10;1 = Flash content rendered if Flash Player is present</string>
      <string id="bProtectedMode_Reader">Protected Mode Sandbox</string>
      <string id="bProtectedMode_Reader_Explain">Controls whether Protected Mode is enabled, sandboxing Reader processes to protect user systems and data.&#10;&#10;0 = Protected Mode disabled&#10;1 = Protected Mode enabled</string>
      <string id="iProtectedView_Reader">Protected View Mode</string>
      <string id="iProtectedView_Reader_Explain">Protected View mode.&#10;&#10;Values: 0 = off (default); 1 = untrusted locations only (recommended); 2 = all files.&#10;&#10;Security Reference: STIG ARDC-CN-000020 (V-213171) Medium; STIG AADC-CN-001015 (V-213128) Medium</string>
      <string id="iProtectedView_Reader_opt0">Disable Protected View</string>
      <string id="iProtectedView_Reader_opt1">Enable Protected View for unsafe locations only</string>
      <string id="iProtectedView_Reader_opt2">Enable Protected View for all files</string>
      <string id="bUseWhitelistConfigFile_Reader">Protected Mode Whitelist Config</string>
      <string id="bUseWhitelistConfigFile_Reader_Explain">Controls whether the application reads a policy whitelist file to allow behavior that Protected Mode would otherwise block.&#10;&#10;0 = whitelist config file ignored&#10;1 = whitelist config file honored</string>
      <string id="iUnlistedAttachmentTypePerm_Reader">Unlisted Attachment Type Permissions</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_Explain">Specifies the default permissions for file types that aren't listed in the default or user-specified lists.&#10;&#10;Possible values include:&#10;0: Prompt user without ability to set file type as Allowed (two choices: Open File, Never Allow). 1 (default): Prompt user with ability to Allow or Prohibit (three choices)&#10;2: Always open unlisted file types&#10;3: Never open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt0">Prompt without ability to allow (most restrictive prompt)</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt1">Prompt with ability to allow or prohibit (default)</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt2">Always open unlisted file types</string>
      <string id="iUnlistedAttachmentTypePerm_Reader_opt3">Never open unlisted file types (most restrictive)</string>

      <!-- ======================================== -->
      <!--     Security: Trust and Permissions      -->
      <!-- ======================================== -->

      <string id="bMSStoreTrusted_Reader">Allow Changes to Windows Certificate Store Trust</string>
      <string id="bMSStoreTrusted_Reader_Explain">Controls whether users can change Windows Certificate Store trust settings (iMSStoreTrusted) via the UI.&#10;&#10;Set the desired iMSStoreTrusted value before deploying this lock.&#10;&#10;0 = iMSStoreTrusted locked, UI disabled&#10;1 = iMSStoreTrusted user-configurable</string>
      <string id="bAllowInvisibleSig_Reader">Allow Invisible Signatures</string>
      <string id="bAllowInvisibleSig_Reader_Explain">Controls whether invisible certification signatures are permitted.&#10;&#10;0 = invisible signatures blocked&#10;1 = invisible signatures allowed</string>
      <string id="bAllowPasswordSaving_Reader">Allow Password Caching</string>
      <string id="bAllowPasswordSaving_Reader_Explain">Controls whether passwords such as digital ID passwords can be cached to disk.&#10;&#10;0 = no caching; user must enter password each time&#10;1 = passwords cached to disk</string>
      <string id="bEnableSignatureClear_Reader">Allow Signature Clearing</string>
      <string id="bEnableSignatureClear_Reader_Explain">Controls whether signers can clear their own signatures.&#10;&#10;0 = signature clearing disabled&#10;1 = signature clearing enabled</string>
      <string id="bVerifyUseAlways_Reader">Always Use Specified Verify Handler</string>
      <string id="bVerifyUseAlways_Reader_Explain">Controls whether the aVerify handler is used for all signature verification or only as a fallback when the signature's declared Filter handler is unavailable.&#10;&#10;0 = aVerify is a fallback handler only&#10;1 = aVerify used to verify all signatures</string>
      <string id="bDisableExpandEnvironmentVariables_Reader">Block User Library Trust in Protected View</string>
      <string id="bDisableExpandEnvironmentVariables_Reader_Explain">Controls whether user-specific paths (such as C:\Users\%username%\Desktop) can be used as trusted locations in Protected View.&#10;&#10;When disabled (value 0), user-specific paths are trusted. When enabled (value 1), only static org-wide trusted locations apply.&#10;&#10;0 = user-specific paths trusted as privileged locations&#10;1 = user-specific paths blocked; only org-wide locations apply</string>
      <string id="bWinCacheSessionHandles_Reader">Cache Digital ID Session Handles</string>
      <string id="bWinCacheSessionHandles_Reader_Explain">Controls whether CSP session handles are retained after digital ID authentication, avoiding repeated authentication prompts within the same session.&#10;&#10;0 = user must authenticate each time the digital ID is used&#10;1 = CSP handles cached until logout or session end</string>
      <string id="bDisableOSTrustedSites_Reader">Disable IE Trusted Sites as Privileged Locations</string>
      <string id="bDisableOSTrustedSites_Reader_Explain">Controls whether sites in Internet Explorer's Trusted Sites zone are treated as privileged locations. When this policy is set, bTrustOSTrustedSites is overridden.&#10;&#10;0 = IE Trusted Sites honored as privileged locations&#10;1 = IE Trusted Sites not honored as privileged locations</string>
      <string id="bAllowAPSConfig_Reader">LiveCycle RMS Server Config</string>
      <string id="bAllowAPSConfig_Reader_Explain">Controls whether a LiveCycle Rights Management Server can be configured via the Security Settings Console.&#10;&#10;0 = LiveCycle RMS configuration blocked&#10;1 = LiveCycle RMS configuration allowed</string>
      <string id="bReqRevCheck_Reader">Lock Revocation Check Setting</string>
      <string id="bReqRevCheck_Reader_Explain">Locks the revocation check setting (iReqRevCheck) and prevents users from changing it via the UI.&#10;&#10;This policy locks whatever value is in iReqRevCheck — configure that preference before deploying this lock.&#10;&#10;0 = iReqRevCheck unlocked&#10;1 = iReqRevCheck locked and UI disabled</string>
      <string id="bReasons_Reader">Lock Signing Reasons Settings</string>
      <string id="bReasons_Reader_Explain">Locks signing reason settings and prevents users from modifying them.&#10;&#10;0 = signing reason settings user-configurable&#10;1 = signing reason settings locked (if cReasons is empty, reason UI disabled; if cReasons has values, those reasons are enforced read-only)</string>
      <string id="bDisableTrustedFolders_Reader">Lock Trusted Folders and Files</string>
      <string id="bDisableTrustedFolders_Reader_Explain">Disables and locks trusted folders and files, preventing users from adding folder or file privileged locations.&#10;&#10;0 = trusted folders and files allowed&#10;1 = trusted folders and files disabled and locked</string>
      <string id="bDisableTrustedSites_Reader">Lock Trusted Host Sites</string>
      <string id="bDisableTrustedSites_Reader_Explain">Disables and locks host-based privileged locations, preventing users from adding trusted host sites.&#10;&#10;0 = trusted host sites allowed&#10;1 = trusted host sites disabled and locked</string>
      <string id="bEnableCEFBasedUI_Reader">Modern Digital Signature UI</string>
      <string id="bEnableCEFBasedUI_Reader_Explain">Controls whether the modern CEF-based digital signature UI is used. Setting any value disables the user preference toggle.&#10;&#10;To block self-signed ID creation, combine bSelfSignCertGen=0 with bEnableCEFBasedUI=0.&#10;&#10;0 = legacy digital signature UI&#10;1 = modern CEF-based digital signature UI</string>
      <string id="bUseTSAsSigningTime_Reader">Show Timestamp in Signature</string>
      <string id="bUseTSAsSigningTime_Reader_Explain">Controls whether the timestamp server time is shown in the signature appearance instead of the local clock. Requires bReqSigPropRetrieval=1 (HKCU); verify clock skew tolerance with iMaxClockSkew (default 65 min).&#10;&#10;0 = local clock time in signature&#10;1 = timestamp server time in signature</string>
      <string id="bAllowReasonWhenSigning_Reader">Signing Reason UI</string>
      <string id="bAllowReasonWhenSigning_Reader_Explain">Controls whether the signing reason dialog appears during the signature workflow.&#10;&#10;0 = reason dialog not shown during signing&#10;1 = reason dialog shown during signing</string>
      <string id="bEnableCertificateBasedTrust_Reader">Trust Certified Documents</string>
      <string id="bEnableCertificateBasedTrust_Reader_Explain">Controls and locks whether certified documents are trusted as privileged locations. Lockable counterpart to bTrustCertifiedDocuments; does not apply in Protected View.&#10;&#10;0 = certified documents not trusted&#10;1 = certified documents trusted as privileged locations</string>
      <string id="iUnknownURLPerms_Reader">Unknown URL Access Policy</string>
      <string id="iUnknownURLPerms_Reader_Explain">Access policy for URLs not in the user list.&#10;&#10;Overrides privileged location host settings in some versions.&#10;&#10;Values:&#10;1 = ask&#10;2 = allow&#10;3 = block</string>
      <string id="iUnknownURLPerms_Reader_opt0">Always ask</string>
      <string id="iUnknownURLPerms_Reader_opt1">Always allow</string>
      <string id="iUnknownURLPerms_Reader_opt2">Always block</string>
      <string id="iURLPerms_Reader">URL Access Permissions</string>
      <string id="iURLPerms_Reader_Explain">Allow, block, or custom website access from PDF files.&#10;&#10;This Computer-scope policy writes to HKLM FeatureLockDown and is the correct enforcement path. Setting this policy locks the Trust Manager dialog for all users and satisfies the DISA STIG automated scan (V-213172 / ARDC-CN-000025). Allow or Block resets tHostPerms; Custom uses tHostPerms.&#10;&#10;Possible values include:&#10;0: Custom Setting (uses tHostPerms URL list)&#10;1: Block all websites&#10;2: Allow all websites</string>
      <string id="iURLPerms_Reader_opt0">Custom Setting (uses tHostPerms URL list)</string>
      <string id="iURLPerms_Reader_opt1">Block all websites</string>
      <string id="iURLPerms_Reader_opt2">Allow all websites</string>
      <string id="bValidateOnOpen_Reader">Validate Signatures on Open</string>
      <string id="bValidateOnOpen_Reader_Explain">Locks the signature validation on open setting and prevents users from changing it.&#10;&#10;This policy locks whatever value is currently in HKCU — it does not independently configure validation. Set the desired HKCU value before deploying this lock.&#10;&#10;0 = do not validate signatures on open&#10;1 = validate signatures on open</string>

      <!-- ======================================== -->
      <!--           Sharing and Features           -->
      <!-- ======================================== -->

      <string id="bToggleAdobeSign_Reader">Adobe Acrobat Sign</string>
      <string id="bToggleAdobeSign_Reader_Explain">Controls whether Adobe Acrobat Sign (Send for Signature) is available. Uses cServices semantics: 0 enables the service, 1 disables it.&#10;&#10;On the Continuous track, also configure bToggleManageSign.&#10;&#10;0 = Acrobat Sign active&#10;1 = Acrobat Sign disabled</string>
      <string id="bToggleSendAndTrack_Reader">Adobe Send &amp; Track</string>
      <string id="bToggleSendAndTrack_Reader_Explain">Controls whether Adobe Send and Track is available in the application.&#10;&#10;0 = Send and Track enabled&#10;1 = Send and Track disabled</string>
      <string id="bDisableSharePointFeatures_Reader">Disable SharePoint &amp; Office 365 Integration</string>
      <string id="bDisableSharePointFeatures_Reader_Explain">Disables SharePoint and Office 365 integration, removing SharePoint detection, the check-out prompt, and SharePoint menu items.&#10;&#10;0 = SharePoint integration active&#10;1 = SharePoint integration disabled</string>
      <string id="bDisableWebmail_Reader">Disable WebMail Integration</string>
      <string id="bDisableWebmail_Reader_Explain">Disables WebMail integration. When disabled and bSendMailShareRedirection=1, the email icon attaches the PDF directly instead of opening the share pane.&#10;&#10;0 = WebMail profiles active&#10;1 = WebMail integration disabled</string>
      <string id="bToggleAdobeReview_Reader">Document Cloud Review Service</string>
      <string id="bToggleAdobeReview_Reader_Explain">Controls whether the Document Cloud Review service UI is available. When disabled, the cloud review UI is removed and legacy review types are used. Uses cServices semantics: 0 enables the service, 1 disables it.&#10;&#10;0 = Document Cloud Review active&#10;1 = Document Cloud Review disabled</string>
      <string id="bSendMailShareRedirection_Reader">Email Icon Attach to Email Behavior</string>
      <string id="bSendMailShareRedirection_Reader_Explain">Controls whether the email icon attaches the document directly to an email instead of opening the share pane.&#10;&#10;0 = email icon opens share pane&#10;1 = email icon attaches document directly</string>
      <string id="bMixRecentFilesFeatureLockDown_Reader">Hide Shared Files from Recent List</string>
      <string id="bMixRecentFilesFeatureLockDown_Reader_Explain">Controls whether shared files (from shares, reviews, signing, and Send and Track workflows) appear in the Recent list.&#10;&#10;0 = shared files added to Recent list&#10;1 = shared files hidden from Recent list</string>
      <string id="bToggleFSSSignatureSaving_Reader">Save Signature to Cloud</string>
      <string id="bToggleFSSSignatureSaving_Reader_Explain">Controls whether the option to save a newly created signature to the cloud is shown. Also applies to user initials.&#10;&#10;0 = save signature to cloud UI shown&#10;1 = save signature to cloud UI hidden</string>
      <string id="bAdobeSendPluginToggle_Reader">Send &amp; Track Outlook Plugin</string>
      <string id="bAdobeSendPluginToggle_Reader_Explain">Controls whether the Adobe Send and Track button appears in Outlook, allowing users to upload attachments to Document Cloud and insert preview/download links.&#10;&#10;0 = Send and Track Outlook plugin active&#10;1 = Send and Track Outlook plugin disabled</string>

      <string id="bEnableSharePointInChromeExtn_Reader">SharePoint in Chrome Extension</string>
      <string id="bEnableSharePointInChromeExtn_Reader_Explain">Controls whether SharePoint integration is active in the Acrobat Chrome browser extension.&#10;&#10;0 = SharePoint integration disabled&#10;1 = SharePoint integration enabled in Chrome extension</string>
      <string id="bToggleManageSign_Reader">Show Acrobat Sign Tracking Tab</string>
      <string id="bToggleManageSign_Reader_Explain">Controls whether the Acrobat Sign tracking tab appears on Home, along with agreement notifications and To Do sign cards. Uses cServices semantics: 0 enables the service, 1 disables it.&#10;&#10;0 = Manage Sign tab shown&#10;1 = Manage Sign tab hidden</string>
      <string id="bDisableOnBehalfOfText_Reader">Show Comment Author in Shared Review</string>
      <string id="bDisableOnBehalfOfText_Reader_Explain">Controls whether the comment author's name appears as 'On behalf of [name]' in shared review comments.&#10;&#10;0 = comment author name not displayed&#10;1 = 'On behalf of [name]' shown in shared review comments</string>
      <string id="iClientType_Gmail_Reader">WebMail Client Type (Gmail)</string>
      <string id="iClientType_Gmail_Reader_Explain">Identifies the Gmail Mail client type for WebMail.&#10;&#10;The value can only be: 1</string>
      <string id="iClientType_Gmail_Reader_opt0">Locked value: 1 (per Adobe PrefRef)</string>
      <string id="iClientType_Yahoo_Reader">WebMail Client Type (Yahoo)</string>
      <string id="iClientType_Yahoo_Reader_Explain">Identifies the Yahoo Mail client type for WebMail.&#10;&#10;The value can only be: 2</string>
      <string id="iClientType_Yahoo_Reader_opt0">Locked value: 2 (per Adobe PrefRef)</string>
      <string id="iIMAPPort_Reader">WebMail IMAP Port</string>
      <string id="iIMAPPort_Reader_Explain">Identifies the My Profile Mail IMAP server port number for WebMail.&#10;&#10;The value can be: Any valid port number.</string>
      <string id="iIMAPPort_Reader_opt0">143 (Standard IMAP)</string>
      <string id="iIMAPPort_Reader_opt1">993 (IMAP over SSL/TLS)</string>
      <string id="iIMAPSecurity_Reader">WebMail IMAP Security</string>
      <string id="iIMAPSecurity_Reader_Explain">Controls whether TLS/SSL security is used for the WebMail IMAP connection.&#10;&#10;0 = IMAP security disabled&#10;1 = IMAP security enabled</string>
      <string id="iSMTPPort_Reader">WebMail SMTP Port</string>
      <string id="iSMTPPort_Reader_Explain">Identifies the My Profile Mail SMTP server port number for WebMail.&#10;&#10;The value can be: Any valid server port number.</string>
      <string id="iSMTPPort_Reader_opt0">25 (Standard SMTP)</string>
      <string id="iSMTPPort_Reader_opt1">465 (SMTP over SSL)</string>
      <string id="iSMTPPort_Reader_opt2">587 (SMTP Submission / TLS)</string>
      <string id="iSMTPSecurity_Reader">WebMail SMTP Security</string>
      <string id="iSMTPSecurity_Reader_Explain">Controls whether TLS/SSL security is used for the WebMail SMTP connection.&#10;&#10;0 = SMTP security disabled&#10;1 = SMTP security enabled</string>

      <!-- ======================================== -->
      <!--          Startup and Experience          -->
      <!-- ======================================== -->

      <string id="bShowMsgAtLaunch_Reader">Adobe Messages at Launch</string>
      <string id="bShowMsgAtLaunch_Reader_Explain">Controls whether Adobe messages (Share Feedback, EOL warnings, profile prompts, and the Home banner) are shown at product launch.&#10;&#10;0 = Adobe messages hidden at launch&#10;1 = Adobe messages shown at launch</string>
      <string id="bAllowUserToChangeMsgPrefs_Reader">Allow Users to Change Message Preferences</string>
      <string id="bAllowUserToChangeMsgPrefs_Reader_Explain">Controls whether users can change the settings governed by bShowMsgAtLaunch and bDontShowMsgWhenViewingDoc.&#10;&#10;0 = bShowMsgAtLaunch and bDontShowMsgWhenViewingDoc locked for users&#10;1 = users can change message preferences</string>
      <string id="bToggleNotifications_Reader">Desktop Notifications</string>
      <string id="bToggleNotifications_Reader_Explain">Controls whether desktop notifications are managed per-feature or disabled globally. When set to 1, all notifications are suppressed regardless of other notification preferences.&#10;&#10;0 = notifications governed per feature&#10;1 = all desktop notifications disabled</string>
      <string id="bShowWelcomeScreen_Reader">Disable Welcome Screen</string>
      <string id="bShowWelcomeScreen_Reader_Explain">Controls whether the Welcome screen is suppressed at product launch.&#10;&#10;0 = Welcome screen hidden&#10;1 = Welcome screen shown</string>
      <string id="bToggleFTE_Reader">First Time Experience</string>
      <string id="bToggleFTE_Reader_Explain">Controls whether the First Time Experience (welcome tour and page) is available. Also suppressed when bUpdater, bToggleAdobeDocumentServices, bToggleAdobeSign, bTogglePrefsSync, or bToggleWebConnectors are configured.&#10;&#10;0 = First Time Experience shown&#10;1 = First Time Experience suppressed</string>
      <string id="bDontShowMsgWhenViewingDoc_Reader">Hide Adobe Messages on Document Open</string>
      <string id="bDontShowMsgWhenViewingDoc_Reader_Explain">Controls whether Adobe messages (including Start Free Trial, Learn More prompts, and right-pane messages) are shown when a document opens.&#10;&#10;0 = Adobe messages hidden on document open&#10;1 = Adobe messages shown on document open</string>
      <string id="bEnableBellButton_Reader">Hide In-Product Notifications Bell</string>
      <string id="bEnableBellButton_Reader_Explain">Controls whether the in-product notifications bell is hidden. When hidden, the product still fetches and caches notifications in the background.&#10;&#10;0 = bell button shown&#10;1 = bell button hidden</string>
      <string id="bToggleShareFeedback_Reader">Hide Send Feedback Icon</string>
      <string id="bToggleShareFeedback_Reader_Explain">Controls whether the Send Feedback icon is shown. Setting bShowMsgAtLaunch=0 also hides this icon. Supersedes bUsageMeasurement in 12.x+.&#10;&#10;0 = Send Feedback icon hidden&#10;1 = Send Feedback icon shown</string>
      <string id="bToggleToDoList_Reader">Home Screen To Do List</string>
      <string id="bToggleToDoList_Reader_Explain">Controls whether a To Do list of action items (Take a Tour, Export PDF, etc.) is shown on the Home screen.&#10;&#10;0 = To Do list shown on Home screen&#10;1 = To Do list hidden</string>
      <string id="bShowScanTabInHomeView_Reader">Scan Tab in Home View</string>
      <string id="bShowScanTabInHomeView_Reader_Explain">Controls whether the Scan tab is shown in the Home view, providing access to linked scan documents.&#10;&#10;0 = Scan tab hidden&#10;1 = Scan tab shown in Home view</string>
      <string id="bToggleNotificationToasts_Reader">Show Desktop Notification Toasts</string>
      <string id="bToggleNotificationToasts_Reader_Explain">Controls whether desktop notification toasts are shown. When hidden, the product still fetches and caches notifications in the background.&#10;&#10;0 = desktop notification toasts shown&#10;1 = desktop notification toasts hidden</string>
      <string id="bTogglePDFOwnershipToasts_Reader">Show PDF Ownership Notification</string>
      <string id="bTogglePDFOwnershipToasts_Reader_Explain">Controls whether a notification appears at startup prompting users to make Acrobat the default PDF viewer when both Acrobat and Reader are installed.&#10;&#10;0 = PDF ownership notification shown at startup&#10;1 = PDF ownership notification hidden</string>
      <string id="bToggleToDoTiles_Reader">Show To Do Cards in Recent Tab</string>
      <string id="bToggleToDoTiles_Reader_Explain">Controls whether To Do cards (listing action items for collaborative reviews, views, and sign workflows) appear in the Recent tab.&#10;&#10;0 = To Do cards shown in Recent tab&#10;1 = To Do cards hidden</string>
      <string id="bUsageMeasurement_Reader">Usage Measurement (legacy)</string>
      <string id="bUsageMeasurement_Reader_Explain">Legacy master switch for usage measurement and analytics. Superseded by bToggleShareFeedback in 12.x+ but still honored on some builds.&#10;&#10;0 = usage measurement disabled&#10;1 = usage measurement enabled</string>
      <string id="bWhatsNewExp_Reader">What's New Experience</string>
      <string id="bWhatsNewExp_Reader_Explain">Controls whether the What's New experience (welcome screen and new-features notification shown once at first launch) is available.&#10;&#10;0 = What's New experience shown at first launch&#10;1 = What's New experience suppressed</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="bDisableThirdPartyPluginNotif_Reader">32-Bit Plugin Upgrade Notification</string>
      <string id="bDisableThirdPartyPluginNotif_Reader_Explain">Controls whether users with 32-bit plugins see an upgrade notification when the application transitions to 64-bit.&#10;&#10;0 = 32-bit plugin upgrade notification shown&#10;1 = notification suppressed</string>
      <string id="bEnableAutoDockUndockHUD_Reader">Auto Dock HUD Bar</string>
      <string id="bEnableAutoDockUndockHUD_Reader_Explain">Controls whether the HUD toolbar docks and undocks automatically based on window size.&#10;&#10;0 = HUD bar behavior fixed&#10;1 = HUD bar docks and undocks automatically</string>
      <string id="bHasAcrobatConsent_Reader">Auto Open Acrobat from Reader</string>
      <string id="bHasAcrobatConsent_Reader_Explain">Controls whether Reader automatically opens the current file in Acrobat when Acrobat is also installed. PDF ownership and the default viewer association are not changed.&#10;&#10;0 = Reader handles the file&#10;1 = file opened in Acrobat automatically</string>
      <string id="bAcroSuppressOpenInReader_Reader">Disable Chrome PDF Extension</string>
      <string id="bAcroSuppressOpenInReader_Reader_Explain">Controls whether the Acrobat PDF viewer Chrome extension is disabled and locked. When disabled by policy, users see a tooltip: "The Acrobat Reader extension is currently disabled. Please contact your IT admin."&#10;&#10;0 = Chrome PDF extension available&#10;1 = Chrome PDF extension disabled and locked</string>
      <string id="bSuppressMessageBar_Reader">Hide Document Message Bar</string>
      <string id="bSuppressMessageBar_Reader_Explain">Controls whether the document message bar is suppressed. Suppressing the message bar adversely affects signing when preview mode is used.&#10;&#10;0 = document message bar shown&#10;1 = document message bar hidden</string>
      <string id="bDisablePDFHandlerSwitching_Reader">Lock Default PDF Viewer</string>
      <string id="bDisablePDFHandlerSwitching_Reader_Explain">Locks the default PDF viewer so users cannot switch to another Adobe PDF handler. Does not affect switching to or from non-Adobe products; UI changes invoke the installer (HKLM), not HKCU.&#10;&#10;0 = default PDF viewer can be changed&#10;1 = default PDF viewer locked</string>
      <string id="bDisableThumbnailPreviewHandler_Reader">Lock PDF Thumbnails in Explorer</string>
      <string id="bDisableThumbnailPreviewHandler_Reader_Explain">Locks the PDF thumbnail preview handler in Windows Explorer, preventing users from enabling it.&#10;&#10;0 = thumbnail preview configurable&#10;1 = thumbnail preview disabled and locked</string>
      <string id="PatchCleanFlag_Reader">Patch Cache Cleanup</string>
      <string id="PatchCleanFlag_Reader_Explain">Triggers cleanup of cached MSI and MSP patch files on the next product update. Patches accumulate under ProgramData\Adobe\ARM and Windows\Installer; cleanup reclaims disk space.&#10;&#10;0 = no patch cache cleanup&#10;1 = cleanup cached patches on next update</string>
      <string id="bUpdater_Updater_Reader">Product Updater</string>
      <string id="bUpdater_Updater_Reader_Explain">Controls whether automatic Adobe product updates run (distinct from cloud service toggles in FeatureLockDown\cServices).&#10;&#10;0 = automatic product updates disabled&#10;1 = automatic product updates enabled</string>
      <string id="bEnableAcrobatPromptForDocOpen_Reader">Prompt to Use Acrobat from Reader</string>
      <string id="bEnableAcrobatPromptForDocOpen_Reader_Explain">Controls whether Reader prompts users to switch to Acrobat (and set it as the default PDF viewer) when both applications are installed.&#10;&#10;0 = no prompt to switch to Acrobat&#10;1 = prompt shown to use Acrobat</string>
      <string id="bShouldUseScalableCursor_Reader">Scalable Cursor</string>
      <string id="bShouldUseScalableCursor_Reader_Explain">Controls whether the application uses a scalable (32-bit alpha-channel) cursor. Citrix legacy graphics mode does not support scalable cursors; disabling this setting improves cursor performance in Citrix environments.&#10;&#10;0 = standard cursor (recommended for Citrix)&#10;1 = scalable cursor</string>
      <string id="bFavoritesFeaturesLockDown_Reader">Starred Files Feature</string>
      <string id="bFavoritesFeaturesLockDown_Reader_Explain">Controls whether the starred files feature is disabled and locked, or deferred to the bFavoritesStripInRFL preference.&#10;&#10;0 = starred files disabled and locked&#10;1 = behavior deferred to bFavoritesStripInRFL</string>

      <!-- ======================================== -->
      <!--                  Upsell                  -->
      <!-- ======================================== -->

      <string id="bToggleSophiaWebInfra_Reader">Disable Promotional Campaign Messages</string>
      <string id="bToggleSophiaWebInfra_Reader_Explain">Controls whether Adobe promotional campaign messages (trials, upsell banners) are shown in the Reader right-hand pane.&#10;&#10;0 = campaign messages disabled&#10;1 = campaign messages enabled</string>
      <string id="bLimitPromptsFeatureKey_Reader">Limit Informational Prompts</string>
      <string id="bLimitPromptsFeatureKey_Reader_Explain">Controls whether informational prompts (tips, calls-to-action, feature walkthroughs) are throttled per user per day.&#10;&#10;0 = prompts not throttled&#10;1 = prompts limited to 1 per day and 3 per week</string>
      <string id="bReaderRetentionExperiment_Reader">Prompt Reader Users to Download Acrobat</string>
      <string id="bReaderRetentionExperiment_Reader_Explain">Controls whether Acrobat subscribers using Reader see prompts to download Acrobat in workflows where they would benefit from it.&#10;&#10;0 = download Acrobat prompts suppressed&#10;1 = download Acrobat prompts shown in Reader workflows</string>
      <string id="bToggleDCAppCenter_Reader">Show App Center UI</string>
      <string id="bToggleDCAppCenter_Reader_Explain">Controls whether the App Center and get-apps banner are shown on the Home screen.&#10;&#10;0 = App Center shown&#10;1 = App Center hidden</string>
      <string id="bShowRhpToolSearch_Reader">Show Purchasable Tools in Search</string>
      <string id="bShowRhpToolSearch_Reader_Explain">Controls whether purchasable tool subscriptions are shown when users search for tools in Reader.&#10;&#10;0 = purchasable tools hidden from search&#10;1 = purchasable tools shown in search results</string>
      <string id="bAcroSuppressUpsell_Reader">Show Upgrade Prompts</string>
      <string id="bAcroSuppressUpsell_Reader_Explain">Controls whether upgrade and upsell prompts are shown, including Reader tool purchase prompts and Standard-to-Professional upgrade prompts.&#10;&#10;0 = upsell prompts shown&#10;1 = upsell suppressed</string>
      <!-- ==================================================== -->
      <!--                                                      -->
      <!-- Non-Policy Settings - Acrobat and Reader DC (64-bit) -->
      <!--                                                      -->
      <!-- ==================================================== -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="ADC4275035_ClickEdit_AcrobatX64">Click-to-Edit Mode</string>
      <string id="ADC4275035_ClickEdit_AcrobatX64_Explain">Controls whether clicking a PDF object automatically enters edit mode (clicking image or text opens edit tools; clicking a form field enables form authoring).&#10;&#10;0 = click-to-edit disabled&#10;1 = click-to-edit enabled&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ADC4275034_AcrobatX64">Fill &amp; Sign Color Picker</string>
      <string id="ADC4275034_AcrobatX64_Explain">Controls whether the color picker is available in the Fill and Sign tool (Continuous track only).&#10;&#10;0 = color picker disabled&#10;1 = color picker enabled&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ProtectOldExperience_AcrobatX64">Legacy Protect Tool Menu</string>
      <string id="ProtectOldExperience_AcrobatX64_Explain">Controls whether the pre-2019 Protect tool menus are used instead of the redesigned Protection UI.&#10;&#10;0 = new Protection UI&#10;1 = legacy Protect tool menus&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ADC4302862_AcrobatX64">Paste in Place</string>
      <string id="ADC4302862_AcrobatX64_Explain">Controls whether copied elements (form fields, annotations, links) are pasted at their original source coordinates rather than offset from the cursor.&#10;&#10;0 = paste offset from cursor (default)&#10;1 = paste at original source location&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ADC4275035_AcrobatX64">Remove Form Editing Tools (2019)</string>
      <string id="ADC4275035_AcrobatX64_Explain">Controls whether the AddText and EditText form tools are removed from the UI (these tools were superseded by the Prepare Form toolbar).&#10;&#10;0 = AddText and EditText tools present&#10;1 = AddText and EditText tools removed from UI&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="BlockEMFParsing_AcrobatX64">Block EMF to PDF Conversion</string>
      <string id="BlockEMFParsing_AcrobatX64_Explain">Controls whether EMF-to-PDF conversion is blocked; when blocked, an unsupported-format dialog appears instead of converting.&#10;&#10;0 = EMF-to-PDF conversion allowed&#10;1 = EMF-to-PDF conversion blocked&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="BlockXPSParsing_AcrobatX64">Block XPS to PDF Conversion</string>
      <string id="BlockXPSParsing_AcrobatX64_Explain">Controls whether XPS-to-PDF conversion is blocked; when blocked, an unsupported-format dialog appears instead of converting.&#10;&#10;0 = XPS-to-PDF conversion allowed&#10;1 = XPS-to-PDF conversion blocked&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="DisableScannedDocumentEditing_AcrobatX64">Disable Scanned PDF Text Recognition</string>
      <string id="DisableScannedDocumentEditing_AcrobatX64_Explain">Controls whether OCR text recognition runs automatically when a scanned PDF is opened for editing.&#10;&#10;0 = OCR runs when editing scanned PDFs&#10;1 = OCR suppressed when editing scanned PDFs&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX64">PDFMaker Grouped Image Tag Fix</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX64_Explain">Controls whether PDFMaker applies accessibility tag corrections for grouped images when creating tagged PDFs.&#10;&#10;0 = grouped-image tag correction disabled&#10;1 = grouped-image tag correction enabled&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX64">PDFMaker Table Header Tag Fix</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX64_Explain">Controls whether PDFMaker applies accessibility tag fixes for table header cells and scope attributes when creating tagged PDFs.&#10;&#10;0 = table header tag fix disabled&#10;1 = table header tag fix enabled&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX64">PDFMaker Text Path Tag Fix</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX64_Explain">Controls whether PDFMaker applies a correction for incorrect border and alt-text rendering caused by a text path element tagging bug.&#10;&#10;0 = text path tag correction disabled&#10;1 = text path tag correction enabled&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="EnableFlashEditing_AcrobatX64">Flash Editing Tools</string>
      <string id="EnableFlashEditing_AcrobatX64_Explain">Controls whether Flash annotation tools appear in the Rich Media toolbar, including the Add SWF menu item.&#10;&#10;0 = Flash Rich Media tools hidden&#10;1 = Flash Rich Media tools shown&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX64">Protected View Exit Shortcut Key</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX64_Explain">Controls whether a keyboard shortcut is available to exit Protected View for the current document on demand.&#10;&#10;0 = exit-Protected-View shortcut disabled&#10;1 = exit-Protected-View shortcut enabled&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\Installer</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="EULA_AcrobatX64">Accept EULA for Updater</string>
      <string id="EULA_AcrobatX64_Explain">Controls whether the end-user license agreement is accepted for the built-in updater, equivalent to passing EULA_ACCEPT=YES at install time.&#10;&#10;0 = EULA not accepted&#10;1 = EULA accepted&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\AdobeViewer</string>
      <string id="DisableMaintenance_AcrobatX64">Disable Repair for All Users</string>
      <string id="DisableMaintenance_AcrobatX64_Explain">Controls whether the Help &gt; Repair menu item is disabled for all users on all installation types.&#10;&#10;0 = Help &gt; Repair available&#10;1 = Help &gt; Repair disabled for all users&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\Installer</string>
      <string id="Disable_Repair_AcrobatX64">Disable Repair for Standard Users</string>
      <string id="Disable_Repair_AcrobatX64_Explain">Controls whether the Help &gt; Repair menu item is restricted to administrators only on virtual deployments (Citrix and Windows Terminal Server); use DisableMaintenance to disable Repair on all installation types.&#10;&#10;0 = Help &gt; Repair available to all users&#10;1 = Help &gt; Repair restricted to administrators on virtual installs&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\Installer</string>
      <string id="IsAMTEnforced_AcrobatX64">Enforce AMT for AppV Deployment</string>
      <string id="IsAMTEnforced_AcrobatX64_Explain">Controls whether App-V deployments use the updated AMT licensing enforcement required for Acrobat DC 2019 and later.&#10;&#10;0 = AMT enforcement not applied&#10;1 = AMT enforcement active (required for App-V deployments)&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\Activation</string>
      <string id="bMergeMenuBar_AcrobatX64">Merge Title and Menu Bar</string>
      <string id="bMergeMenuBar_AcrobatX64_Explain">Merges the application title bar and menu bar into a single combined bar.&#10;&#10;0 = separate title and menu bars&#10;1 = merged into one bar&#10;&#10;Registry: HKLM\SOFTWARE\Adobe\Adobe Acrobat\DC\FeatureLockDown</string>
      <string id="ARMLegacyMode_AcrobatX64">ARM Updater: Auto-Update Mode (Acrobat)</string>
      <string id="ARMLegacyMode_AcrobatX64_Explain">Controls the Adobe ARM service's automatic update mode for Acrobat (64-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect. Use this as a secondary lockdown for machines where the FeatureLockDown policy has not yet applied.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-BC15014EA700}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download</string>
      <string id="ARMLegacyCheck_AcrobatX64">ARM Updater: Disable Update Checks (Acrobat)</string>
      <string id="ARMLegacyCheck_AcrobatX64_Explain">Suppresses update checks by the Adobe ARM service for Acrobat (64-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-BC15014EA700}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks</string>
      <string id="ARMLegacyMode_ReaderX64">ARM Updater: Auto-Update Mode (Reader)</string>
      <string id="ARMLegacyMode_ReaderX64_Explain">Controls the Adobe ARM service's automatic update mode for Reader (64-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect. Use this as a secondary lockdown for machines where the FeatureLockDown policy has not yet applied.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-1033-FF00-7760-BC15014EA700}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download</string>
      <string id="ARMLegacyCheck_ReaderX64">ARM Updater: Disable Update Checks (Reader)</string>
      <string id="ARMLegacyCheck_ReaderX64_Explain">Suppresses update checks by the Adobe ARM service for Reader (64-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Adobe ARM is a 32-bit service; this key is always under WOW6432Node regardless of product bitness.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-1033-FF00-7760-BC15014EA700}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks</string>
      <!-- Shared ARM Legacy Mode enum option strings -->
      <string id="ARMLegacyMode_opt0">Do not download or install updates automatically (0)</string>
      <string id="ARMLegacyMode_opt2">Download updates automatically; prompt user to install (2)</string>
      <string id="ARMLegacyMode_opt3">Download and install updates automatically (3)</string>
      <string id="ARMLegacyMode_opt4">Notify user of available updates; do not download (4)</string>
      <!-- ========================================= -->
      <!--                                           -->
      <!-- Non-Policy Settings - Acrobat DC (32-bit) -->
      <!--                                           -->
      <!-- ========================================= -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="ADC4275035_ClickEdit_AcrobatX86">Click-to-Edit Mode</string>
      <string id="ADC4275035_ClickEdit_AcrobatX86_Explain">Controls whether clicking a PDF object automatically enters edit mode (clicking image or text opens edit tools; clicking a form field enables form authoring).&#10;&#10;0 = click-to-edit disabled&#10;1 = click-to-edit enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ADC4275034_AcrobatX86">Fill &amp; Sign Color Picker</string>
      <string id="ADC4275034_AcrobatX86_Explain">Controls whether the color picker is available in the Fill and Sign tool (Continuous track only).&#10;&#10;0 = color picker disabled&#10;1 = color picker enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ProtectOldExperience_AcrobatX86">Legacy Protect Tool Menu</string>
      <string id="ProtectOldExperience_AcrobatX86_Explain">Controls whether the pre-2019 Protect tool menus are used instead of the redesigned Protection UI.&#10;&#10;0 = new Protection UI&#10;1 = legacy Protect tool menus&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ADC4302862_AcrobatX86">Paste in Place</string>
      <string id="ADC4302862_AcrobatX86_Explain">Controls whether copied elements (form fields, annotations, links) are pasted at their original source coordinates rather than offset from the cursor.&#10;&#10;0 = paste offset from cursor (default)&#10;1 = paste at original source location&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="ADC4275035_AcrobatX86">Remove Form Editing Tools (2019)</string>
      <string id="ADC4275035_AcrobatX86_Explain">Controls whether the AddText and EditText form tools are removed from the UI (these tools were superseded by the Prepare Form toolbar).&#10;&#10;0 = AddText and EditText tools present&#10;1 = AddText and EditText tools removed from UI&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="BlockEMFParsing_AcrobatX86">Block EMF to PDF Conversion</string>
      <string id="BlockEMFParsing_AcrobatX86_Explain">Controls whether EMF-to-PDF conversion is blocked; when blocked, an unsupported-format dialog appears instead of converting.&#10;&#10;0 = EMF-to-PDF conversion allowed&#10;1 = EMF-to-PDF conversion blocked&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="BlockXPSParsing_AcrobatX86">Block XPS to PDF Conversion</string>
      <string id="BlockXPSParsing_AcrobatX86_Explain">Controls whether XPS-to-PDF conversion is blocked; when blocked, an unsupported-format dialog appears instead of converting.&#10;&#10;0 = XPS-to-PDF conversion allowed&#10;1 = XPS-to-PDF conversion blocked&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="DisableScannedDocumentEditing_AcrobatX86">Disable Scanned PDF Text Recognition</string>
      <string id="DisableScannedDocumentEditing_AcrobatX86_Explain">Controls whether OCR text recognition runs automatically when a scanned PDF is opened for editing.&#10;&#10;0 = OCR runs when editing scanned PDFs&#10;1 = OCR suppressed when editing scanned PDFs&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX86">PDFMaker Grouped Image Tag Fix</string>
      <string id="EnablePDFMakerGroupImagesTagCorrectionFeature_AcrobatX86_Explain">Controls whether PDFMaker applies accessibility tag corrections for grouped images when creating tagged PDFs.&#10;&#10;0 = grouped-image tag correction disabled&#10;1 = grouped-image tag correction enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX86">PDFMaker Table Header Tag Fix</string>
      <string id="EnablePDFMakerTableHeaderCellTagAndScopeUpdateFeature_AcrobatX86_Explain">Controls whether PDFMaker applies accessibility tag fixes for table header cells and scope attributes when creating tagged PDFs.&#10;&#10;0 = table header tag fix disabled&#10;1 = table header tag fix enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX86">PDFMaker Text Path Tag Fix</string>
      <string id="EnablePDFMakerSplitTextPathElemsFeature_AcrobatX86_Explain">Controls whether PDFMaker applies a correction for incorrect border and alt-text rendering caused by a text path element tagging bug.&#10;&#10;0 = text path tag correction disabled&#10;1 = text path tag correction enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="EnableFlashEditing_AcrobatX86">Flash Editing Tools</string>
      <string id="EnableFlashEditing_AcrobatX86_Explain">Controls whether Flash annotation tools appear in the Rich Media toolbar, including the Add SWF menu item.&#10;&#10;0 = Flash Rich Media tools hidden&#10;1 = Flash Rich Media tools shown&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureState</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX86">Protected View Exit Shortcut Key</string>
      <string id="bEnablePVSwitchoutShortcut_AcrobatX86_Explain">Controls whether a keyboard shortcut is available to exit Protected View for the current document on demand.&#10;&#10;0 = exit-Protected-View shortcut disabled&#10;1 = exit-Protected-View shortcut enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\Installer</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="EULA_AcrobatX86">Accept EULA for Updater</string>
      <string id="EULA_AcrobatX86_Explain">Controls whether the end-user license agreement is accepted for the built-in updater, equivalent to passing EULA_ACCEPT=YES at install time.&#10;&#10;0 = EULA not accepted&#10;1 = EULA accepted&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\AdobeViewer</string>
      <string id="iDisablePromptForUpgrade_AcrobatX86">Disable Major Version Upgrade Prompt</string>
      <string id="iDisablePromptForUpgrade_AcrobatX86_Explain">Suppress major-version upgrade prompt.&#10;&#10;Requires automatic update settings; if bUpdater=0, upgrades are also disabled.&#10;&#10;Values:&#10;0 or null = no effect&#10;1 = disable prompt&#10;&#10;Adobe ARM is a 32-bit component; on 64-bit Windows this policy writes to HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\...</string>
      <string id="DisableMaintenance_AcrobatX86">Disable Repair for All Users</string>
      <string id="DisableMaintenance_AcrobatX86_Explain">Controls whether the Help &gt; Repair menu item is disabled for all users on all installation types.&#10;&#10;0 = Help &gt; Repair available&#10;1 = Help &gt; Repair disabled for all users&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\Installer</string>
      <string id="Disable_Repair_AcrobatX86">Disable Repair for Standard Users</string>
      <string id="Disable_Repair_AcrobatX86_Explain">Controls whether the Help &gt; Repair menu item is restricted to administrators only on virtual deployments (Citrix and Windows Terminal Server); use DisableMaintenance to disable Repair on all installation types.&#10;&#10;0 = Help &gt; Repair available to all users&#10;1 = Help &gt; Repair restricted to administrators on virtual installs&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\Installer</string>
      <string id="IsAMTEnforced_AcrobatX86">Enforce AMT for AppV Deployment</string>
      <string id="IsAMTEnforced_AcrobatX86_Explain">Controls whether App-V deployments use the updated AMT licensing enforcement required for Acrobat DC 2019 and later.&#10;&#10;0 = AMT enforcement not applied&#10;1 = AMT enforcement active (required for App-V deployments)&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\Activation</string>
      <string id="bMergeMenuBar_AcrobatX86">Merge Title and Menu Bar</string>
      <string id="bMergeMenuBar_AcrobatX86_Explain">Merges the application title bar and menu bar into a single combined bar.&#10;&#10;0 = separate title and menu bars&#10;1 = merged into one bar&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe Acrobat\DC\FeatureLockDown</string>
      <string id="iInterval_AcrobatX86">Update Watchdog Interval (Days)</string>
      <string id="iInterval_AcrobatX86_Explain">Days before Watchdog prompts manual update after a failed update.&#10;&#10;Internal key; default 135 days after a successful manifest download.&#10;&#10;Adobe ARM is a 32-bit component; on 64-bit Windows this policy writes to HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\...</string>
      <string id="iInterval_AcrobatX86_opt0">90 days</string>
      <string id="iInterval_AcrobatX86_opt1">135 days (default)</string>
      <string id="iInterval_AcrobatX86_opt2">180 days</string>
      <string id="iInterval_AcrobatX86_opt3">365 days</string>
      <string id="iLogLevel_AcrobatX86">Updater Log Level</string>
      <string id="iLogLevel_AcrobatX86_Explain">Updater log verbosity.&#10;&#10;Logs truncated at 1 MB (backed up as AdobeARM-backup). Path: %LOCALAPPDATA%\Temp\AdobeARM.log.&#10;&#10;Values:&#10;0 = brief&#10;1 = verbose&#10;&#10;Adobe ARM is a 32-bit component; on 64-bit Windows this policy writes to HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\...</string>
      <string id="iLogLevel_AcrobatX86_opt0">Brief</string>
      <string id="iLogLevel_AcrobatX86_opt1">Verbose</string>
      <string id="ARMLegacyMode_AcrobatX86">ARM Updater: Auto-Update Mode</string>
      <string id="ARMLegacyMode_AcrobatX86_Explain">Controls the Adobe ARM service's automatic update mode for Acrobat (32-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-0C0F074E4100}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download</string>
      <string id="ARMLegacyCheck_AcrobatX86">ARM Updater: Disable Update Checks</string>
      <string id="ARMLegacyCheck_AcrobatX86_Explain">Suppresses update checks by the Adobe ARM service for Acrobat (32-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Acrobat\{AC76BA86-1033-FFFF-7760-0C0F074E4100}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks</string>
      <!-- ======================================== -->
      <!--                                          -->
      <!-- Non-Policy Settings - Reader DC (32-bit) -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="ProtectOldExperience_ReaderX86">Legacy Protect Tool Menu</string>
      <string id="ProtectOldExperience_ReaderX86_Explain">Controls whether the pre-2019 Protect tool menus are used instead of the redesigned Protection UI.&#10;&#10;0 = new Protection UI&#10;1 = legacy Protect tool menus&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\FeatureState</string>
      <string id="ADC4302862_ReaderX86">Paste in Place</string>
      <string id="ADC4302862_ReaderX86_Explain">Controls whether copied elements (form fields, annotations, links) are pasted at their original source coordinates rather than offset from the cursor.&#10;&#10;0 = paste offset from cursor (default)&#10;1 = paste at original source location&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\FeatureState</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="DisableScannedDocumentEditing_ReaderX86">Disable Scanned PDF Text Recognition</string>
      <string id="DisableScannedDocumentEditing_ReaderX86_Explain">Controls whether OCR text recognition runs automatically when a scanned PDF is opened for editing.&#10;&#10;0 = OCR runs when editing scanned PDFs&#10;1 = OCR suppressed when editing scanned PDFs&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\FeatureState</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="EnableFlashEditing_ReaderX86">Flash Editing Tools</string>
      <string id="EnableFlashEditing_ReaderX86_Explain">Controls whether Flash annotation tools appear in the Rich Media toolbar, including the Add SWF menu item.&#10;&#10;0 = Flash Rich Media tools hidden&#10;1 = Flash Rich Media tools shown&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\FeatureState</string>
      <string id="bEnablePVSwitchoutShortcut_ReaderX86">Protected View Exit Shortcut Key</string>
      <string id="bEnablePVSwitchoutShortcut_ReaderX86_Explain">Controls whether a keyboard shortcut is available to exit Protected View for the current document on demand.&#10;&#10;0 = exit-Protected-View shortcut disabled&#10;1 = exit-Protected-View shortcut enabled&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\Installer</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="EULA_ReaderX86">Accept EULA for Updater</string>
      <string id="EULA_ReaderX86_Explain">Controls whether the end-user license agreement is accepted for the built-in updater, equivalent to passing EULA_ACCEPT=YES at install time.&#10;&#10;0 = EULA not accepted&#10;1 = EULA accepted&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\AdobeViewer</string>
      <string id="DisableMaintenance_ReaderX86">Disable Repair for All Users</string>
      <string id="DisableMaintenance_ReaderX86_Explain">Controls whether the Help &gt; Repair menu item is disabled for all users on all installation types.&#10;&#10;0 = Help &gt; Repair available&#10;1 = Help &gt; Repair disabled for all users&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\Installer</string>
      <string id="Disable_Repair_ReaderX86">Disable Repair for Standard Users</string>
      <string id="Disable_Repair_ReaderX86_Explain">Controls whether the Help &gt; Repair menu item is restricted to administrators only on virtual deployments (Citrix and Windows Terminal Server); use DisableMaintenance to disable Repair on all installation types.&#10;&#10;0 = Help &gt; Repair available to all users&#10;1 = Help &gt; Repair restricted to administrators on virtual installs&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\Installer</string>
      <string id="bMergeMenuBar_ReaderX86">Merge Title and Menu Bar</string>
      <string id="bMergeMenuBar_ReaderX86_Explain">Merges the application title bar and menu bar into a single combined bar.&#10;&#10;0 = separate title and menu bars&#10;1 = merged into one bar&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Acrobat Reader\DC\FeatureLockDown</string>
      <string id="ARMLegacyMode_ReaderX86">ARM Updater: Auto-Update Mode</string>
      <string id="ARMLegacyMode_ReaderX86_Explain">Controls the Adobe ARM service's automatic update mode for Reader (32-bit).&#10;&#10;FeatureLockDown\bUpdater takes precedence over this value — if bUpdater is set via policy, this key has no effect.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-7AD7-1033-7B44-AC0F074E4100}\Mode&#10;&#10;Values:&#10;0: Do not download or install updates automatically&#10;2: Download updates automatically; prompt user to install&#10;3: Download and install updates automatically&#10;4: Notify user of available updates; do not download</string>
      <string id="ARMLegacyCheck_ReaderX86">ARM Updater: Disable Update Checks</string>
      <string id="ARMLegacyCheck_ReaderX86_Explain">Suppresses update checks by the Adobe ARM service for Reader (32-bit). Enabled writes check = 0.&#10;&#10;FeatureLockDown\bUpdater takes precedence — use this as a secondary lockdown.&#10;&#10;Registry: HKLM\SOFTWARE\WOW6432Node\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-7AD7-1033-7B44-AC0F074E4100}\check&#10;&#10;Values:&#10;0 = disable update checks&#10;1 = allow update checks</string>
      <!-- ======================================== -->
      <!--                                          -->
      <!-- Adobe Acrobat DC (User) - policy strings -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="tBaseFolderNameDC_User">Base Folder Name</string>
      <string id="tBaseFolderNameDC_User_Explain">Sets an alias name that maps to a specific Action Wizard (Sequences) folder path.&#10;&#10;Standard values: &quot;install&quot; = application-level Sequences folder; &quot;user&quot; = user-level Sequences folder. Administrators may specify a custom folder name.</string>
      <string id="iColumnSelectHaloDC_User">Column Select Halo</string>
      <string id="iColumnSelectHaloDC_User_Explain">Controls the pixel halo width that determines when a click near a column boundary is treated as a column selection.&#10;&#10;0 = column-select halo disabled&#10;1 = column-select halo enabled</string>
      <string id="DisableSignInOfficeDC_User">Disable Sign in Office</string>
      <string id="DisableSignInOfficeDC_User_Explain">Controls whether the PDFMaker Acrobat Sign integration component is disabled and its UI hidden in Microsoft Office.&#10;&#10;0 = Sign integration in Office available&#10;1 = Sign integration in Office disabled</string>
      <string id="EnableSignInOfficeDC_User">Enable Sign in Office</string>
      <string id="EnableSignInOfficeDC_User_Explain">Controls whether the PDFMaker Acrobat Sign integration component is installed and its UI shown in Microsoft Office.&#10;&#10;0 = Sign integration in Office not enabled by this policy&#10;1 = Sign integration in Office enabled</string>
      <string id="tFileFormatDC_User">File Format Version</string>
      <string id="tFileFormatDC_User_Explain">Sets the format version for Action Wizard sequence (.sequ) files.&#10;&#10;Valid values: &quot;11&quot; = Acrobat 11 format; &quot;pre-11&quot; = Acrobat 10 and earlier format.</string>
      <string id="bAlwaysUseFileNameAsDocTitleDC_User">Filename as Title</string>
      <string id="bAlwaysUseFileNameAsDocTitleDC_User_Explain">Controls whether the PDF file name is always shown in the title bar instead of the document's embedded title property.&#10;&#10;0 = document title property shown in title bar&#10;1 = file name shown in title bar</string>
      <string id="bUseFixedSnapshotResolutionDC_User">Fixed Snapshot Resolution</string>
      <string id="bUseFixedSnapshotResolutionDC_User_Explain">Controls whether snapshot captures use a fixed DPI (set by iSnapshotResolution) instead of the current screen resolution.&#10;&#10;0 = snapshot uses screen resolution&#10;1 = snapshot uses fixed DPI (configure with Snapshot Resolution DPI)</string>
      <string id="ADC4318556DC_User">Flash Player for 3D</string>
      <string id="ADC4318556DC_User_Explain">Controls whether a locally installed Flash player is used to render 3D and multimedia content embedded in PDFs.&#10;&#10;0 = Flash player not used for 3D/multimedia content&#10;1 = Flash player used for 3D/multimedia content</string>
      <string id="bHandSelectsDC_User">Hand Tool Select</string>
      <string id="bHandSelectsDC_User_Explain">Controls whether the hand tool can also select text and images (including on Windows Touch devices).&#10;&#10;0 = hand tool does not select text or images&#10;1 = hand tool selects text and images</string>
      <string id="iMaxMRUCntToBeStoredDC_User">Max Recent Files</string>
      <string id="iMaxMRUCntToBeStoredDC_User_Explain">Sets the maximum number of files shown in the recent files list (File menu, splash screen, and My Files view).&#10;&#10;Valid range: 0 to 100. Default is 100.</string>
      <string id="bEnableAv2DC_User">Modern Viewer</string>
      <string id="bEnableAv2DC_User_Explain">Controls whether the modern Acrobat viewer UI is shown instead of the classic viewer.&#10;&#10;0 = classic viewer&#10;1 = modern viewer</string>
      <string id="bAllowMultipleExpandedPanelsDC_User">Multiple Comment Panels</string>
      <string id="bAllowMultipleExpandedPanelsDC_User_Explain">Controls whether more than one comment panel can be expanded simultaneously in the comments pane.&#10;&#10;0 = only one comment panel expanded at a time&#10;1 = multiple comment panels can be expanded</string>
      <string id="iNumSwitcherContextualToolTipAV2ShownDC_User">New Look Coachmark</string>
      <string id="iNumSwitcherContextualToolTipAV2ShownDC_User_Explain">Controls whether the &quot;Acrobat has a new look&quot; coachmark is shown on the first launch; has no effect if Modern Viewer (bEnableAv2) is disabled.&#10;&#10;0 = coachmark not shown&#10;1 = coachmark shown on first launch</string>
      <string id="bPinHUDDC_User">Pin HUD Toolbar</string>
      <string id="bPinHUDDC_User_Explain">Controls whether the floating HUD toolbar is pinned to the main toolbar.&#10;&#10;0 = HUD not pinned to toolbar&#10;1 = HUD pinned to toolbar</string>
      <string id="bPromptBeforeClosingMultipleTabsDC_User">Prompt Close Tabs</string>
      <string id="bPromptBeforeClosingMultipleTabsDC_User_Explain">Controls whether a confirmation prompt appears when the user attempts to close a window that contains multiple open tabs.&#10;&#10;0 = close multiple tabs without prompt&#10;1 = prompt before closing multiple tabs</string>
      <string id="bImagesFirstDC_User">Select Images First</string>
      <string id="bImagesFirstDC_User_Explain">Controls whether clicking in an area where text and images overlap selects the image rather than the text.&#10;&#10;0 = text takes selection priority over images&#10;1 = image takes selection priority over text</string>
      <string id="bInfobubbleDC_User">Show Tool Pane Tips</string>
      <string id="bInfobubbleDC_User_Explain">Controls whether popup tooltips appear for items in the Tools, Comments, and Share panes.&#10;&#10;0 = pane tooltips hidden&#10;1 = pane tooltips shown</string>
      <string id="bKeyPrefsShowVirtualKeyoardDC_User">Show Touch Keyboard</string>
      <string id="bKeyPrefsShowVirtualKeyoardDC_User_Explain">Controls whether the on-screen touch keyboard appears when the user taps a text area (search box, comment popup, form field) on a Windows touch or tablet device.&#10;&#10;0 = touch keyboard not shown automatically&#10;1 = touch keyboard shown on text area tap</string>
      <string id="iSnapshotResolutionDC_User">Snapshot Resolution DPI</string>
      <string id="iSnapshotResolutionDC_User_Explain">Sets the fixed DPI used for snapshot captures when Fixed Snapshot Resolution (bUseFixedSnapshotResolution) is enabled.&#10;&#10;Valid range: 72 to 600 DPI.</string>
      <string id="ADC4406238DC_User">Suppress PDF/UA Dialog</string>
      <string id="ADC4406238DC_User_Explain">Controls whether the PDF/UA compliance confirmation dialog is suppressed when Mark PDF/UA Compliant is enabled in the Word PDFMaker.&#10;&#10;0 = PDF/UA confirmation dialog suppressed&#10;1 = PDF/UA confirmation dialog shown</string>
      <string id="irightPaneStateDC_User">Tools Pane State</string>
      <string id="irightPaneStateDC_User_Explain">Controls the Tools Pane open/closed state on every application launch.&#10;&#10;0 = use application default&#10;1 = always closed on launch&#10;2 = always open on launch</string>
      <string id="irightPaneStateDC_User_opt0">Use the default</string>
      <string id="irightPaneStateDC_User_opt1">Always closed</string>
      <string id="irightPaneStateDC_User_opt2">Always open</string>
      <string id="iBasicSharePaneStickyStatusDC_User">Tools Pane Sticky</string>
      <string id="iBasicSharePaneStickyStatusDC_User_Explain">Controls whether the Tools Pane open/closed state is remembered across sessions (interacts with irightPaneState).&#10;&#10;0 = Tools Pane state not remembered; always closed on launch&#10;1 = Tools Pane state remembered across sessions</string>
      <string id="iBasicSharePaneStickyStatusDC_User_opt0">Don't remember the Tool Pane's state (always closed on launch)</string>
      <string id="iBasicSharePaneStickyStatusDC_User_opt1">Do remember the Tool Pane's state</string>
      <string id="iNumSwitcherContextualToolTipAVShownDC_User">Try New Coachmark</string>
      <string id="iNumSwitcherContextualToolTipAVShownDC_User_Explain">Controls whether the &quot;Try the new Acrobat&quot; UI switcher coachmark is shown on first launch; has no effect if Modern Viewer (bEnableAv2) is disabled.&#10;&#10;0 = UI switcher coachmark not shown&#10;1 = UI switcher coachmark shown on first launch</string>
      <string id="iNumSessionAV2DC_User">UI Switcher Sessions</string>
      <string id="iNumSessionAV2DC_User_Explain">Controls the session threshold at which the UI switcher coachmark becomes eligible to appear (interacts with iNumSwitcherContextualToolTipAV2Shown).&#10;&#10;Enabled writes 1 = one session threshold. Disabled writes 0 = coachmark not shown.&#10;&#10;0 or 1 = coachmark not shown&#10;2 or greater = coachmark shown if iNumSwitcherContextualToolTipAV2Shown = 0</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="bUse2DGPUfDC_User">2D GPU Acceleration</string>
      <string id="bUse2DGPUfDC_User_Explain">Controls whether 2D GPU hardware acceleration is used for rendering.&#10;&#10;0 = 2D GPU acceleration disabled&#10;1 = 2D GPU acceleration enabled</string>
      <string id="bAllowDocsToHideUIDC_User">Allow Hide UI</string>
      <string id="bAllowDocsToHideUIDC_User_Explain">Controls whether PDF documents are permitted to hide the menu bar, toolbars, and window controls via JavaScript.&#10;&#10;0 = documents cannot hide UI elements&#10;1 = documents can hide UI elements</string>
      <string id="benableTextSelectionDC_User">Annotation Text Selection</string>
      <string id="benableTextSelectionDC_User_Explain">Controls whether text selection is available directly on highlight, strikethrough, and underline annotations by hovering (shows cursor after 2 s; reverts 3 s after leaving).&#10;&#10;0 = text selection on annotations enabled (hover cursor active)&#10;1 = text selection on annotations disabled (context menu only)</string>
      <string id="bEnableATDC_User">Assistive Technology</string>
      <string id="bEnableATDC_User_Explain">Controls whether assistive technology support is enabled; when AT such as JAWS is detected, prompts the setup assistant for untagged documents and OCR for scans.&#10;&#10;0 = assistive technology workflows disabled&#10;1 = assistive technology workflows enabled</string>
      <string id="bAttachLogDC_User">Attach Report</string>
      <string id="bAttachLogDC_User_Explain">Controls whether the accessibility check report is attached to the document after an accessibility full check.&#10;&#10;0 = report not attached to document&#10;1 = report attached to document after accessibility check</string>
      <string id="bAutoCompleteOnTabDC_User">Auto-Complete on Tab</string>
      <string id="bAutoCompleteOnTabDC_User_Explain">Controls whether tabbing out of a form field auto-completes the entry using remembered values (requires Advanced auto-complete mode).&#10;&#10;0 = tabbing does not auto-complete&#10;1 = tabbing auto-completes from remembered values</string>
      <string id="bautoOpenOtherDC_User">Auto-Open Drawing Popup</string>
      <string id="bautoOpenOtherDC_User_Explain">Controls whether a popup note is automatically added when a drawing tool, Stamp, or Pencil annotation is created.&#10;&#10;0 = no automatic popup for drawing annotations&#10;1 = popup note added automatically when drawing annotation is created</string>
      <string id="bAutoSaveDocsEnabledDC_User">Auto-Save</string>
      <string id="bAutoSaveDocsEnabledDC_User_Explain">Controls whether documents are automatically saved at the interval set by Auto-Save Interval (iAutoSaveDocsInterval).&#10;&#10;0 = auto-save disabled&#10;1 = auto-save enabled</string>
      <string id="iAutoSaveDocsIntervalDC_User">Auto-Save Interval</string>
      <string id="iAutoSaveDocsIntervalDC_User_Explain">Sets the auto-save interval in minutes (requires Auto-Save to be enabled via bAutoSaveDocsEnabled).&#10;&#10;Valid range: 1 to 99 minutes. Default is 5.</string>
      <string id="bAutoSetLayersDC_User">Auto-Set Layers</string>
      <string id="bAutoSetLayersDC_User_Explain">Controls whether document layers are automatically shown or hidden based on user information embedded in the PDF.&#10;&#10;0 = layer state not set by user information&#10;1 = layer state set automatically by user information</string>
      <string id="iPagesDC_User">Check Page Range</string>
      <string id="iPagesDC_User_Explain">Controls whether the accessibility full check scans all pages or a user-specified page range.&#10;&#10;0 = check a specific page range&#10;1 = check all pages</string>
      <string id="benableDDRDC_User">ClearType Smoothing</string>
      <string id="benableDDRDC_User_Explain">Controls whether ClearType-style DDR sub-pixel rendering is applied for additional text smoothing on LCD screens (beyond standard anti-aliasing).&#10;&#10;0 = standard text smoothing (monitor mode)&#10;1 = DDR sub-pixel smoothing for LCD screens</string>
      <string id="bEnableCloudBasedATDC_User">Cloud Auto Tagging</string>
      <string id="bEnableCloudBasedATDC_User_Explain">Controls whether the cloud-based automatic tagging service is used to tag untagged PDFs for accessibility.&#10;&#10;0 = cloud-based auto-tagging disabled&#10;1 = cloud-based auto-tagging enabled</string>
      <string id="iAccessColorPolicyDC_User">Color Replace Policy</string>
      <string id="iAccessColorPolicyDC_User_Explain">Sets the Replace Document Colors policy in the Accessibility preferences panel; when Not Configured, the key is removed and the user chooses.&#10;&#10;1 = use Windows color scheme&#10;2 = use custom colors&#10;4 = use high contrast colors</string>
      <string id="iAccessColorPolicyDC_User_opt0">Use Windows Color Scheme</string>
      <string id="iAccessColorPolicyDC_User_opt1">Use Custom Colors</string>
      <string id="iAccessColorPolicyDC_User_opt2">Use High Contrast Colors</string>
      <string id="bCombineContentDC_User">Combine Reading Order</string>
      <string id="bCombineContentDC_User_Explain">Controls whether similar content types are grouped together in the reading order view.&#10;&#10;0 = similar content types grouped together&#10;1 = similar content types displayed separately</string>
      <string id="tauthorDC_User">Comment Author</string>
      <string id="tauthorDC_User_Explain">Sets the author name used in comments when Login Name as Author (balwaysUseIdent) is disabled.&#10;&#10;User-specified text field; sets HKCU\Software\Adobe\Adobe Acrobat\DC\cAnnots\cAnnot\tauthor.</string>
      <string id="tNoteFontNameDC_User">Comment Font Name</string>
      <string id="tNoteFontNameDC_User_Explain">Sets the font used for comment text in the viewer (does not embed in the PDF; controls viewer display preference only).&#10;&#10;Enter a font name available on the system, e.g. Tahoma.</string>
      <string id="dNoteFontSizeDC_User">Comment Font Size</string>
      <string id="dNoteFontSizeDC_User_Explain">Sets the font size (in points) for comment text in the viewer (does not embed in the PDF; controls viewer display preference only).&#10;&#10;Valid range: 6 to 72 points. Default is 10.</string>

      <string id="bComplexScriptDC_User">Complex Script Support</string>
      <string id="bComplexScriptDC_User_Explain">Controls whether complex script support is enabled, allowing writing direction switching for right-to-left and bidirectional languages.&#10;&#10;0 = writing direction switching disabled&#10;1 = writing direction switching enabled</string>
      <string id="bconfirmEBRMergeDC_User">Confirm Review Import</string>
      <string id="bconfirmEBRMergeDC_User_Explain">Controls whether a confirmation alert appears on document open when comments are about to be imported into an active review.&#10;&#10;0 = comments imported without confirmation&#10;1 = confirmation alert shown before importing review comments</string>
      <string id="bcopyTextToDrawAnnotDC_User">Copy Text to Drawing</string>
      <string id="bcopyTextToDrawAnnotDC_User_Explain">Controls whether text enclosed by a drawing annotation is automatically copied into the annotation's popup note.&#10;&#10;0 = enclosed text not copied into drawing annotation popup&#10;1 = enclosed text copied into drawing annotation popup</string>
      <string id="bcopyTextToMarkupAnnotDC_User">Copy Text to Markup</string>
      <string id="bcopyTextToMarkupAnnotDC_User_Explain">Controls whether selected text is automatically copied into the popup note for highlight, cross-out, and underline annotations.&#10;&#10;0 = selected text copied into markup annotation popup&#10;1 = selected text not copied into markup annotation popup</string>
      <string id="bCreateLogDC_User">Create Report</string>
      <string id="bCreateLogDC_User_Explain">Controls whether an accessibility report file is created when an accessibility full check is run.&#10;&#10;0 = no report file created&#10;1 = accessibility report file created</string>

      <string id="iPageViewLayoutModeDC_User">Default Page Layout</string>
      <string id="iPageViewLayoutModeDC_User_Explain">Sets the default page layout used when a PDF opens (can be overridden by Accessibility page layout settings).&#10;&#10;0 = automatic&#10;1 = single page&#10;2 = single page continuous&#10;3 = two up continuous&#10;5 = two up</string>
      <string id="iPageViewLayoutModeDC_User_opt0">Automatic</string>
      <string id="iPageViewLayoutModeDC_User_opt1">Single Page</string>
      <string id="iPageViewLayoutModeDC_User_opt2">Single Page Continuous</string>
      <string id="iPageViewLayoutModeDC_User_opt3">Two Up Continuous</string>
      <string id="iPageViewLayoutModeDC_User_opt4">Two Up</string>
      <string id="iParaDirDC_User">Default Paragraph Dir</string>
      <string id="iParaDirDC_User_Explain">Sets the default paragraph text direction for newly created text.&#10;&#10;0 = left to right&#10;1 = right to left&#10;2 = infer from document</string>
      <string id="iParaDirDC_User_opt0">Left to Right</string>
      <string id="iParaDirDC_User_opt1">Right to Left</string>
      <string id="iParaDirDC_User_opt2">Infer from document</string>

      <string id="iDefaultZoomTypeDC_User">Default Zoom Type</string>
      <string id="iDefaultZoomTypeDC_User_Explain">Sets the default zoom mode when a PDF opens; percentage zoom levels use iDefaultZoomScale.&#10;&#10;1 = fit page&#10;2 = fit width&#10;3 = fit height&#10;4 = fit visible&#10;6 = reflow</string>
      <string id="iDefaultZoomTypeDC_User_opt0">Fit Page (automatic)</string>
      <string id="iDefaultZoomTypeDC_User_opt1">Fit Width</string>
      <string id="iDefaultZoomTypeDC_User_opt2">Fit Height</string>
      <string id="iDefaultZoomTypeDC_User_opt3">Fit Visible</string>
      <string id="iDefaultZoomTypeDC_User_opt4">Reflow</string>
      <string id="tDictionaryNameDC_User">Dictionary Name</string>
      <string id="tDictionaryNameDC_User_Explain">Sets the default spelling dictionary by name (from cDictionaryOrder\t0; corresponding ID in cDictionaryOrderID\i0).</string>
      <string id="imaxPDFCommentsSizeDC_User">Embedded Comment Limit</string>
      <string id="imaxPDFCommentsSizeDC_User_Explain">Sets the comment size threshold (in MB) below which comments are embedded in the PDF and above which they are sent as separate FDF files.&#10;&#10;Default: 3 MB for Reader, 5 MB for Acrobat.</string>
      <string id="bemptyContentToolTipDC_User">Empty Comment Tooltip</string>
      <string id="bemptyContentToolTipDC_User_Explain">Controls whether a tooltip appears indicating that a hovered comment is empty.&#10;&#10;0 = no tooltip for empty comments&#10;1 = tooltip shown for empty comments</string>
      <string id="bUseThinCodeDC_User">Enhance Thin Lines</string>
      <string id="bUseThinCodeDC_User_Explain">Controls whether thin lines are enhanced to improve their visibility on screen.&#10;&#10;0 = thin lines not enhanced&#10;1 = thin lines enhanced for visibility</string>
      <string id="bSuperFastDrawingDC_User">Fast Scroll Drawing</string>
      <string id="bSuperFastDrawingDC_User_Explain">Use low-resolution rendering during scroll, zoom, and pan.&#10;&#10;Temporarily shows lower quality during fast interactions.&#10;&#10;Values:&#10;0 = high quality intermediates&#10;1 = superfast low-res intermediates</string>
      <string id="iaskFormsSelectEmailCLientDC_User">Form Email Prompt</string>
      <string id="iaskFormsSelectEmailCLientDC_User_Explain">Controls whether a confirmation dialog appears on each XFA form email submission asking whether to use desktop or webmail email client.&#10;&#10;0 = email client dialog not shown on XFA submit&#10;1 = email client selection dialog shown on each XFA submit</string>
      <string id="bHidePopupIfShowSummaryDC_User">Hide Popup on Summary</string>
      <string id="bHidePopupIfShowSummaryDC_User_Explain">Controls whether comment popup notes are hidden when the comments list panel is open.&#10;&#10;0 = popups visible when comment list is open&#10;1 = popups hidden when comment list is open</string>
      <string id="bHindiDigitDC_User">Hindi Digits</string>
      <string id="bHindiDigitDC_User_Explain">Controls whether Hindi digit display is enabled for Devanagari numeral rendering.&#10;&#10;0 = Hindi digits disabled&#10;1 = Hindi digits enabled</string>
      <string id="bHoveringPopupsDC_User">Hover Popups</string>
      <string id="bHoveringPopupsDC_User_Explain">Controls whether comment popup notes open automatically when the mouse hovers over a comment annotation.&#10;&#10;0 = popups do not open on mouse hover&#10;1 = popups open automatically on mouse hover</string>
      <string id="bInlineAutoCompleteDC_User">Inline Auto-Complete</string>
      <string id="bInlineAutoCompleteDC_User_Explain">Controls whether form fields suggest remembered values inline as the user types (available in both Basic and Advanced auto-complete modes).&#10;&#10;0 = no inline suggestions&#10;1 = inline auto-complete suggestions shown while typing</string>
      <string id="iIntlSelectFontDC_User">International Font</string>
      <string id="iIntlSelectFontDC_User_Explain">Sets the international font compatibility mode for East Asian character rendering.&#10;&#10;0 = application default font&#10;1 = GB18030 compatible font (Simplified Chinese)&#10;2 = HKSCS compatible font (Traditional Chinese)</string>
      <string id="iIntlSelectFontDC_User_opt0">Application default</string>
      <string id="iIntlSelectFontDC_User_opt1">GB18030 compatible font</string>
      <string id="iIntlSelectFontDC_User_opt2">HKSCS compatible font</string>
      <string id="bLigaturesDC_User">Ligatures</string>
      <string id="bLigaturesDC_User_Explain">Controls whether typographic ligature rendering is enabled for supported fonts.&#10;&#10;0 = ligatures disabled&#10;1 = ligatures enabled</string>
      <string id="balwaysUseIdentDC_User">Login Name as Author</string>
      <string id="balwaysUseIdentDC_User_Explain">Controls whether the Windows login name is used as the comment author name (falls back to identity login name, then shared-review author name).&#10;&#10;0 = login name used as comment author (feature enabled)&#10;1 = login name not used as comment author</string>
      <string id="bOpenInPlaceDC_User">Open Links in Place</string>
      <string id="bOpenInPlaceDC_User_Explain">Controls whether cross-document links open the target PDF in the same window (replacing the current document) rather than in a new window or tab.&#10;&#10;0 = cross-document links open in new window/tab&#10;1 = cross-document links open in the same window</string>
      <string id="bOverprintPreviewUseShiftClickDC_User">Overprint Shift+Click</string>
      <string id="bOverprintPreviewUseShiftClickDC_User_Explain">Shift+Click behavior in the output preview dialog.&#10;&#10;Values:&#10;0 = Shift+Click adds color-value sticky note&#10;1 = Shift+Click multi-select&#10;Alt/Option+Click adds sticky note</string>
      <string id="bAccessOverrideDocColorsDC_User">Override Document Colors</string>
      <string id="bAccessOverrideDocColorsDC_User_Explain">Controls whether black text and line art colors are replaced when the Replace Document Colors accessibility policy (iAccessColorPolicy) is active and a custom color is set.&#10;&#10;0 = black text/line art not replaced&#10;1 = black text/line art replaced with accessibility color</string>
      <string id="bOverrideLineArtColorsDC_User">Override Line Art Colors</string>
      <string id="bOverrideLineArtColorsDC_User_Explain">Controls whether line art color replacement is restricted to black text and line art only (rather than all colors) when the Replace Document Colors policy is active.&#10;&#10;0 = all text/line art colors replaced&#10;1 = only black text/line art colors replaced</string>
      <string id="iPageLayoutDC_User">Override Page Layout</string>
      <string id="iPageLayoutDC_User_Explain">Sets the accessibility page layout override applied when Override Page Layout is enabled (bOverridePageLayout = 1).&#10;&#10;1 = single page&#10;2 = single page continuous&#10;3 = two up continuous&#10;5 = two up</string>
      <string id="iPageLayoutDC_User_opt0">Single Page</string>
      <string id="iPageLayoutDC_User_opt1">Single Page Continuous</string>
      <string id="iPageLayoutDC_User_opt2">Two Up Continuous</string>
      <string id="iPageLayoutDC_User_opt3">Two Up</string>
      <string id="bOverrideZoomDC_User">Override Zoom</string>
      <string id="bOverrideZoomDC_User_Explain">Let users set a default zoom for all documents.&#10;&#10;Overrides author Page Display settings and sets iZoomScale when enabled.&#10;&#10;Values:&#10;0 = document default&#10;1 = enable zoom dropdown</string>

      <string id="iZoomTypeDC_User">Override Zoom Type</string>
      <string id="iZoomTypeDC_User_Explain">Sets the accessibility zoom mode override applied to all documents (percentage zoom levels use iZoomScale).&#10;&#10;1 = fit page&#10;2 = fit width&#10;3 = fit height&#10;4 = fit visible&#10;6 = reflow</string>
      <string id="iZoomTypeDC_User_opt0">Fit Page</string>
      <string id="iZoomTypeDC_User_opt1">Fit Width</string>
      <string id="iZoomTypeDC_User_opt2">Fit Height</string>
      <string id="iZoomTypeDC_User_opt3">Fit Visible</string>
      <string id="iZoomTypeDC_User_opt4">Reflow</string>
      <string id="iParagraphDirectionDC_User">Paragraph Direction</string>
      <string id="iParagraphDirectionDC_User_Explain">Sets the default paragraph direction for the TouchUp Text tool.&#10;&#10;0 = right to left&#10;1 = left to right</string>
      <string id="iParagraphDirectionDC_User_opt0">Right to Left</string>
      <string id="iParagraphDirectionDC_User_opt1">Left to Right</string>
      <string id="bPopupsOpenIffSelectedDC_User">Popup When Selected</string>
      <string id="bPopupsOpenIffSelectedDC_User_Explain">Controls whether comment popup notes open only when the annotation is selected rather than on mouse hover.&#10;&#10;0 = popup opens on hover or selection&#10;1 = popup opens only when annotation is selected</string>
      <string id="bPopupsScrollWithPageDC_User">Popups Scroll With Page</string>
      <string id="bPopupsScrollWithPageDC_User_Explain">Controls whether open comment popup notes scroll with the page or are hidden during scrolling.&#10;&#10;0 = popups hidden when document is scrolled&#10;1 = popups scroll with the page</string>
      <string id="bUseDetailsNavigatorDC_User">Portfolio File List</string>
      <string id="bUseDetailsNavigatorDC_User_Explain">Controls whether PDF Portfolio component files are shown in an accessible list view for better screen reader and keyboard navigation (improves usability for mobility, vision, and blindness accessibility needs).&#10;&#10;0 = default portfolio navigation&#10;1 = accessible file list view for portfolio components</string>
      <string id="bPrintAnnotsDC_User">Print Annotations</string>
      <string id="bPrintAnnotsDC_User_Explain">Controls whether notes, popups, and other annotations are included when printing.&#10;&#10;0 = annotations not printed&#10;1 = annotations included in print output</string>
      <string id="bprintCommentPopupsDC_User">Print Comment Popups</string>
      <string id="bprintCommentPopupsDC_User_Explain">Controls whether open comment popups are printed along with the document.&#10;&#10;0 = open comment popups not printed&#10;1 = open comment popups included in print output</string>
      <string id="bprintNotesOpaqueDC_User">Print Popups Opaque</string>
      <string id="bprintNotesOpaqueDC_User_Explain">Controls whether printed comment popups are rendered as fully opaque regardless of the user's popup opacity setting.&#10;&#10;0 = popup opacity setting respected when printing&#10;1 = popups printed as fully opaque</string>
      <string id="bUserAskedToEnableAutoCompleteDC_User">Prompt Auto-Complete</string>
      <string id="bUserAskedToEnableAutoCompleteDC_User_Explain">Controls whether the user is prompted at runtime to enable auto-complete when Advanced auto-complete mode is selected.&#10;&#10;0 = user not prompted to enable auto-complete&#10;1 = user prompted to enable auto-complete</string>
      <string id="iShowOrderDC_User">Reading Order Display</string>
      <string id="iShowOrderDC_User_Explain">Sets the display mode for the TouchUp Reading Order panel, controlling how content blocks are labeled.&#10;&#10;0 = numbered order&#10;1 = structure type labels&#10;2 = no labels</string>
      <string id="iShowOrderDC_User_opt0">Order (numbered)</string>
      <string id="iShowOrderDC_User_opt1">Structure type</string>
      <string id="iShowOrderDC_User_opt2">None</string>
      <string id="bRecordNewEntriesDC_User">Remember Form Entries</string>
      <string id="bRecordNewEntriesDC_User_Explain">Controls whether new form field entries are saved for future auto-complete suggestions (applies to both Basic and Advanced auto-complete modes).&#10;&#10;0 = form entries not saved for auto-complete&#10;1 = form entries saved for auto-complete</string>
      <string id="iRememberViewDC_User">Restore Last View</string>
      <string id="iRememberViewDC_User_Explain">Controls whether the last-used view settings (zoom level, scroll position) are restored when reopening a document.&#10;&#10;1 = last view settings not restored&#10;2 = last view settings restored on reopen</string>
      <string id="iRememberViewDC_User_opt0">Don't restore the last view settings</string>
      <string id="iRememberViewDC_User_opt1">Do restore the last view settings</string>
      <string id="bRTLUIDC_User">Right-to-Left UI</string>
      <string id="bRTLUIDC_User_Explain">Controls whether right-to-left language UI options are enabled for Arabic, Hebrew, and similar languages.&#10;&#10;0 = right-to-left UI options disabled&#10;1 = right-to-left UI options enabled</string>
      <string id="bDigitsUIDC_User">RTL Digit Display</string>
      <string id="bDigitsUIDC_User_Explain">Controls whether numeric digits are displayed in Arabic-Indic style to match right-to-left UI conventions.&#10;&#10;0 = digits displayed in standard (LTR) style&#10;1 = digits displayed in Arabic-Indic (RTL) style</string>
      <string id="bPrintSaveTonerDC_User">Save Toner/Ink</string>
      <string id="bPrintSaveTonerDC_User_Explain">Controls whether Acrobat optimizes print output to reduce toner and ink consumption.&#10;&#10;0 = standard print quality (no toner saving)&#10;1 = toner/ink saving mode enabled</string>
      <string id="bSDIModeDC_User">SDI Mode</string>
      <string id="bSDIModeDC_User_Explain">Controls whether each document opens in its own application window (SDI mode) or as a tab within a single window.&#10;&#10;0 = documents open as tabs in one window&#10;1 = each document opens in a separate window</string>
      <string id="bsendFinalApprovalEmailDC_User">Send Approval Email</string>
      <string id="bsendFinalApprovalEmailDC_User_Explain">Controls whether a notification email is sent when the final approval in an approval workflow is received.&#10;&#10;0 = no email sent on final approval&#10;1 = notification email sent on final approval</string>
      <string id="bShowOptionsDialogDC_User">Show Check Options</string>
      <string id="bShowOptionsDialogDC_User_Explain">Controls whether the options dialog is displayed before running the Accessibility Full Check.&#10;&#10;0 = accessibility check runs without showing options&#10;1 = options dialog shown before accessibility check</string>
      <string id="bcommentPanelOnImportDC_User">Show Comments on Import</string>
      <string id="bcommentPanelOnImportDC_User_Explain">Controls whether the comment list panel opens automatically when comments are imported into a PDF.&#10;&#10;0 = comment list not opened on import&#10;1 = comment list opened automatically on import</string>
      <string id="bShowAnnotConnectorDC_User">Show Connector Lines</string>
      <string id="bShowAnnotConnectorDC_User_Explain">Controls whether connector lines are drawn between comment markup indicators and their popup notes on mouse rollover.&#10;&#10;0 = connector lines hidden&#10;1 = connector lines shown on rollover</string>
      <string id="bFocusRectDC_User">Show Focus Rectangle</string>
      <string id="bFocusRectDC_User_Explain">Controls whether a focus rectangle is drawn around form fields when they receive keyboard focus.&#10;&#10;0 = focus rectangle not shown on focused fields&#10;1 = focus rectangle shown on focused fields</string>
      <string id="bShowKeyboardSelectionCursorDC_User">Show Keyboard Cursor</string>
      <string id="bShowKeyboardSelectionCursorDC_User_Explain">Controls whether the keyboard selection cursor is always visible in the document, regardless of the active tool (recommended for screen magnifier users).&#10;&#10;0 = keyboard cursor not always displayed&#10;1 = keyboard cursor always displayed in document</string>
      <string id="bshowMarkupModifiersDC_User">Show Markup Indicators</string>
      <string id="bshowMarkupModifiersDC_User_Explain">Controls whether markup tooltips and text indicators are shown when hovering over annotation tools.&#10;&#10;0 = markup tooltips and indicators hidden&#10;1 = markup tooltips and indicators shown</string>
      <string id="bRulersVisibleDC_User">Show Rulers</string>
      <string id="bRulersVisibleDC_User_Explain">Controls whether page rulers are visible when a document is opened.&#10;&#10;0 = rulers hidden on document open&#10;1 = rulers visible on document open</string>
      <string id="bStampsPaletteInvisibleDC_User">Show Stamps Palette</string>
      <string id="bStampsPaletteInvisibleDC_User_Explain">Controls whether the Stamps palette is automatically shown when the commenting toolbar is displayed (note: the registry value bStampsPaletteInvisible is inverted).&#10;&#10;0 = stamps palette shown automatically&#10;1 = stamps palette hidden</string>
      <string id="bShowAnnotSequenceDC_User">Show Tab Order</string>
      <string id="bShowAnnotSequenceDC_User_Explain">Controls whether tab order numbers are displayed on form fields for AcroForms and XFA forms.&#10;&#10;0 = field tab order not displayed&#10;1 = field tab order numbers displayed</string>
      <string id="bsideNotesDC_User">Side-Aligned Popups</string>
      <string id="bsideNotesDC_User_Explain">Controls whether new comment popup notes are aligned to the edge of the document page rather than placed near their anchor.&#10;&#10;0 = popups positioned near annotation anchor&#10;1 = popups aligned to document page edge</string>
      <string id="bAntialiasImagesDC_User">Smooth Images</string>
      <string id="bAntialiasImagesDC_User_Explain">Controls whether anti-aliasing (smoothing) is applied to raster images when rendering PDF content.&#10;&#10;0 = images not smoothed&#10;1 = images anti-aliased (smoothed)</string>
      <string id="bAntialiasGraphicsDC_User">Smooth Line Art</string>
      <string id="bAntialiasGraphicsDC_User_Explain">Controls whether anti-aliasing (smoothing) is applied to vector line art when rendering PDF content.&#10;&#10;0 = line art not smoothed&#10;1 = line art anti-aliased (smoothed)</string>
      <string id="bAntialiasTextDC_User">Smooth Text</string>
      <string id="bAntialiasTextDC_User_Explain">Controls whether text is rendered with anti-aliasing (monitor and laptop/LCD smoothing mode).&#10;&#10;0 = text not anti-aliased&#10;1 = text anti-aliased for monitor and laptop/LCD displays</string>
      <string id="bSmoothZoomingDC_User">Smooth Zooming</string>
      <string id="bSmoothZoomingDC_User_Explain">Controls whether smooth animated zooming is used when changing document view magnification.&#10;&#10;0 = smooth zooming disabled&#10;1 = smooth zooming enabled</string>
      <string id="bSpellingUnderlineDC_User">Spell Check Underline</string>
      <string id="bSpellingUnderlineDC_User_Explain">Controls whether spelling errors are underlined in real time as text is typed in form fields and comments.&#10;&#10;0 = no underline on spelling errors&#10;1 = spelling errors underlined as you type</string>
      <string id="bStoreNumericEntriesDC_User">Store Numeric Entries</string>
      <string id="bStoreNumericEntriesDC_User_Explain">Controls whether numeric values entered in form fields are saved for future auto-complete suggestions (applies to both Basic and Advanced auto-complete modes).&#10;&#10;0 = numeric form entries not saved for auto-complete&#10;1 = numeric form entries saved for auto-complete</string>
      <string id="bUseStructTabOrderDC_User">Structure Tab Order</string>
      <string id="bUseStructTabOrderDC_User_Explain">Controls whether the PDF document's logical structure is used to determine form field tab order instead of the visual layout order.&#10;&#10;0 = visual layout tab order&#10;1 = document structure tab order</string>
      <string id="bUseSystemSelectionColorDC_User">System Selection Color</string>
      <string id="bUseSystemSelectionColorDC_User_Explain">Controls whether the system-defined highlight color is used for text selection instead of the default blue.&#10;&#10;0 = default selection color (blue) used&#10;1 = system-defined selection color used</string>

      <string id="bUseLocalFontsDC_User">Use Local Fonts</string>
      <string id="bUseLocalFontsDC_User_Explain">Controls whether fonts installed locally on the system are used when rendering PDF content that references them.&#10;&#10;0 = local fonts not used for rendering&#10;1 = local fonts used for rendering</string>
      <string id="iEmailClientSelectionDC_User">XFA Email Client</string>
      <string id="iEmailClientSelectionDC_User_Explain">Controls whether a custom email client selection is active when an XFA form is submitted via the email submit button.&#10;&#10;Enabled writes 1 = email client selection enabled. Disabled writes 0 = default email client used.</string>
      <string id="iRXOPolicyDC_User">XObjects View Mode</string>
      <string id="iRXOPolicyDC_User_Explain">Controls whether Referenced XObjects (external PDF references in PDF/X-5 documents) can be accessed and displayed.&#10;&#10;0 = XObjects never displayed&#10;1 = XObjects always displayed&#10;2 = only PDF/X-5 compliant XObjects displayed</string>
      <string id="iRXOPolicyDC_User_opt0">Never allow XObjects view mode</string>
      <string id="iRXOPolicyDC_User_opt1">Always allow XObjects view mode</string>
      <string id="iRXOPolicyDC_User_opt2">Only PDF/X-5 compliant documents</string>

      <!-- ======================================== -->
      <!--         Microsoft Purview (MIP)          -->
      <!-- ======================================== -->

      <string id="bEnableLoggingDC_User">MIP Logging</string>
      <string id="bEnableLoggingDC_User_Explain">Controls whether debug logging is enabled for Microsoft Purview Information Protection (MIP) operations, useful for troubleshooting label and authentication issues.&#10;&#10;0 = MIP debug logging disabled&#10;1 = MIP debug logging enabled</string>
      <string id="bEnablePolicyAuthenticationDC_User">MIP Policy Authentication</string>
      <string id="bEnablePolicyAuthenticationDC_User_Explain">Controls whether Microsoft Purview Information Protection (MIP) policy authentication is active for the user. Setting both this policy and bShowDMB to Disabled hides the applied sensitivity label from the document.&#10;&#10;0 = MIP policy authentication disabled&#10;1 = MIP policy authentication enabled</string>
      <string id="bShowDMBDC_User">Show Document Message Bar (MIP)</string>
      <string id="bShowDMBDC_User_Explain">Controls whether the applied Microsoft Purview Information Protection (MIP) sensitivity label is shown in the document message bar.&#10;&#10;0 = MIP label not shown in document message bar&#10;1 = MIP label shown in document message bar</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="b3DEnableContentDC_User">3D Content Trust</string>
      <string id="b3DEnableContentDC_User_Explain">Controls whether 3D content in PDF files is trusted and rendered automatically without showing a security warning bar.&#10;&#10;0 = 3D content blocked; user prompted to trust&#10;1 = 3D content trusted and rendered</string>
      <string id="bCrossDomainLoggingDC_User">Cross-Domain Logging</string>
      <string id="bCrossDomainLoggingDC_User_Explain">Controls whether cross-domain logging is enabled for non-same-origin server communication, creating an AcrobatCrossDomain.log file in the user's Adobe application data folder.&#10;&#10;0 = cross-domain logging disabled&#10;1 = cross-domain logging enabled</string>
      <string id="tEditorFontNameDC_User">Editor Font Name</string>
      <string id="tEditorFontNameDC_User_Explain">Sets the font name used in the JavaScript script editor. Enter a valid installed font name.</string>
      <string id="tEditorFontSizeDC_User">Editor Font Size</string>
      <string id="tEditorFontSizeDC_User_Explain">Sets the font size (in points) used in the JavaScript script editor.</string>
      <string id="tEditorPathDC_User">Editor Path</string>
      <string id="tEditorPathDC_User_Explain">Sets the file system path to an external JavaScript editor. This path is used when bChooseDialog is enabled.</string>
      <string id="bEnableDebuggerDC_User">Enable JS Debugger</string>
      <string id="bEnableDebuggerDC_User_Explain">Controls whether the JavaScript debugger is enabled (requires an application restart to take effect).&#10;&#10;0 = JavaScript debugger disabled&#10;1 = JavaScript debugger enabled</string>
      <string id="bChooseDialogDC_User">External JS Editor</string>
      <string id="bChooseDialogDC_User_Explain">Controls whether an external JavaScript editor is used instead of the built-in Acrobat editor. When enabled, the tEditorPath setting must specify the external editor path.&#10;&#10;0 = built-in Acrobat JS editor used&#10;1 = external editor specified by tEditorPath used</string>
      <string id="bFIPSModeDC_User">FIPS Mode</string>
      <string id="bFIPSModeDC_User_Explain">Controls whether FIPS 140-2 compliant encryption mode is active, restricting Acrobat to FIPS-approved algorithms and limiting certain non-FIPS-compliant features.&#10;&#10;0 = FIPS mode disabled&#10;1 = FIPS mode enabled</string>
      <string id="bConsoleInputDC_User">JS Console Input</string>
      <string id="bConsoleInputDC_User_Explain">Controls whether the JavaScript console opens when a script error or message occurs during execution.&#10;&#10;0 = console does not open on script errors&#10;1 = console opens on script errors or messages</string>
      <string id="bConsoleOpenDC_User">JS Debugger Console</string>
      <string id="bConsoleOpenDC_User_Explain">Controls whether the interactive JavaScript debugger console is open when Acrobat starts.&#10;&#10;0 = debugger console not opened at startup&#10;1 = debugger console opened at startup</string>
      <string id="iExceptionsDC_User">JS Exception Handling</string>
      <string id="iExceptionsDC_User_Explain">Sets how JavaScript exceptions are handled by the debugger.&#10;&#10;0 = exceptions ignored&#10;1 = exceptions traced (logged)&#10;2 = exceptions break into debugger</string>
      <string id="iExceptionsDC_User_opt0">Ignore</string>
      <string id="iExceptionsDC_User_opt1">Trace</string>
      <string id="iExceptionsDC_User_opt2">Break</string>
      <string id="bEnableGlobalSecurityDC_User">JS Global Security</string>
      <string id="bEnableGlobalSecurityDC_User_Explain">Controls whether JavaScript in one document sandbox is allowed to access script objects in another document sandbox.&#10;&#10;0 = scripts cannot access objects in other document sandboxes&#10;1 = scripts can access objects across document sandboxes</string>
      <string id="bEnableMenuItemsDC_User">JS Menu Items</string>
      <string id="bEnableMenuItemsDC_User_Explain">Controls whether JavaScript is allowed to programmatically execute menu items.&#10;&#10;0 = JavaScript cannot execute menu items&#10;1 = JavaScript can execute menu items</string>
      <string id="bEnableAlwaysOutlookAttachmentProtectedViewDC_User">Outlook Protected View</string>
      <string id="bEnableAlwaysOutlookAttachmentProtectedViewDC_User_Explain">Controls whether Protected View is enforced for Outlook email attachments opened in Acrobat (note: the registry value bEnableAlwaysOutlookAttachmentProtectedView is inverted).&#10;&#10;0 = Protected View enforced for Outlook attachments&#10;1 = Protected View not enforced for Outlook attachments</string>
      <string id="bOldRecentFilesMigratedDC_User">Recent Files Migrated</string>
      <string id="bOldRecentFilesMigratedDC_User_Explain">Tracks whether the user's recent files list has been migrated to the current format. This is an internal application state flag; administrators should not configure this policy.</string>
      <string id="bSaveBreakpointsDC_User">Save JS Breakpoints</string>
      <string id="bSaveBreakpointsDC_User_Explain">Controls whether JavaScript debugger breakpoints are saved persistently in the PDF file.&#10;&#10;0 = breakpoints not saved in PDF&#10;1 = breakpoints saved in PDF file</string>

      <!-- ======================================== -->
      <!--     Security: Trust and Permissions      -->
      <!-- ======================================== -->

      <string id="bUseExpiredTimestampsDC_User">Accept Expired Timestamps</string>
      <string id="bUseExpiredTimestampsDC_User_Explain">Controls whether expired timestamps are accepted as valid, allowing them to count toward signature validation without invalidating the signature.&#10;&#10;0 = expired timestamp invalidates the signature&#10;1 = expired timestamp accepted; signature remains valid</string>
      <string id="bAllowConnectViaHTTPDC_User">Allow LiveCycle HTTP</string>
      <string id="bAllowConnectViaHTTPDC_User_Explain">Controls whether LiveCycle Rights Management server connections use plain HTTP instead of HTTPS.&#10;&#10;0 = server connections use HTTPS&#10;1 = server connections may use HTTP</string>
      <string id="bAllowCertNonGreenDC_User">Allow Non-Green Cert</string>
      <string id="bAllowCertNonGreenDC_User_Explain">Controls whether a certification signature can be applied to a document that contains Legal PDF warnings (non-green state). When disabled, certification is blocked and the author is notified.&#10;&#10;0 = certification signature blocked when Legal PDF warnings present&#10;1 = certification signature allowed regardless of Legal PDF warnings</string>
      <string id="bAllowOCSPNoCheckDC_User">Allow OCSP NoCheck</string>
      <string id="bAllowOCSPNoCheckDC_User_Explain">Controls whether the OCSPNoCheck extension in an OCSP response signing certificate is honored, bypassing revocation checking for that certificate.&#10;&#10;0 = OCSPNoCheck extension not honored in response signer cert&#10;1 = OCSPNoCheck extension honored in response signer cert</string>
      <string id="bAlwaysConsultDC_User">Always Consult CDP</string>
      <string id="bAlwaysConsultDC_User_Explain">Controls whether an additional CRL distribution point URL is always consulted, even when the certificate already has a CRLDp extension. When disabled, the URL is only used if the certificate lacks a CRLDp extension.&#10;&#10;0 = additional CDP URL used only when certificate lacks CRLDp extension&#10;1 = additional CDP URL always consulted</string>
      <string id="iAuthMechanismsDC_User">Auth Mechanisms</string>
      <string id="iAuthMechanismsDC_User_Explain">Sets which registered authentication provider(s) are used for cryptographic operations.&#10;&#10;0 = no registered providers used&#10;1 = first registered provider used&#10;2 = all registered providers used</string>
      <string id="iAuthMechanismsDC_User_opt0">Use none of the registered providers</string>
      <string id="iAuthMechanismsDC_User_opt1">Use first registered provider</string>
      <string id="iAuthMechanismsDC_User_opt2">Use all registered providers</string>
      <string id="iAutoAcceptEDCPrivacyNotificationDC_User">Auto-Accept Privacy</string>
      <string id="iAutoAcceptEDCPrivacyNotificationDC_User_Explain">Controls whether an alert asking the user to confirm acceptance of the privacy policy is shown for EDC (encrypted document cloud) operations.&#10;&#10;0 = privacy policy acceptance alert not shown&#10;1 = privacy policy acceptance alert shown</string>
      <string id="iAutoAddLTVDC_User">Auto-Add LTV Info</string>
      <string id="iAutoAddLTVDC_User_Explain">Auto-add LTV information to signatures.&#10;&#10;Large LTV may prompt when over 10% of file size plus 10 KB. Choosing Do not show again and No sets this to 0.&#10;&#10;Values:&#10;0 = never&#10;1 = ask if too big (default)&#10;2 = always</string>
      <string id="iAutoAddLTVDC_User_opt0">Never add LTV information</string>
      <string id="iAutoAddLTVDC_User_opt1">Ask whether to add LTV if too big (default)</string>
      <string id="iAutoAddLTVDC_User_opt2">Always add LTV information</string>
      <string id="bSavePasswordDC_User">Cache Server Password</string>
      <string id="bSavePasswordDC_User_Explain">Controls whether the user's LiveCycle Rights Management server password is cached securely for reuse.&#10;&#10;0 = server password not cached&#10;1 = server password cached</string>
      <string id="iMaxRevokeInfoCacheLifetimeDC_User">CRL Cache Lifetime</string>
      <string id="iMaxRevokeInfoCacheLifetimeDC_User_Explain">Maximum lifetime in hours the cached CRL is used for revocation checking.&#10;&#10;iMaxRevokeInfoCacheLifetime is only used if the validation method is set to &quot;current time&quot;.&#10;&#10;Possible values include: The number of hours for which the cached CRL is valid.</string>
      <string id="bCustomPrefsCreatedDC_User">Custom Cert Prefs</string>
      <string id="bCustomPrefsCreatedDC_User_Explain">Tracks whether custom certificate-specific preferences (such as Identrus) have been created. When set to 0 or deleted, Acrobat recreates the preferences on the next launch and resets this value to 1. This is an internal application state flag; administrators should not normally configure it.</string>
      <string id="aDefDirectoryDC_User">Default ID Directory</string>
      <string id="aDefDirectoryDC_User_Explain">Sets the default directory searched when looking up digital IDs (Windows only). ADSI directories added via the Security Settings Console appear with names such as Adobe.PPKMS.ADSI.dir0.</string>
      <string id="iDirectoryProviderDC_User">Directory Provider</string>
      <string id="iDirectoryProviderDC_User_Explain">Sets which registered directory provider(s) are used for signature validation certificate lookups.&#10;&#10;0 = no registered providers used&#10;1 = first registered provider used&#10;2 = all registered providers used</string>
      <string id="iDirectoryProviderDC_User_opt0">Use none of the registered providers</string>
      <string id="iDirectoryProviderDC_User_opt1">Use first registered provider</string>
      <string id="iDirectoryProviderDC_User_opt2">Use all registered providers</string>
      <string id="bEnforceSecureChannelDC_User">Enforce Digest Compare</string>
      <string id="bEnforceSecureChannelDC_User_Explain">Block signing when original and signed message digests differ.&#10;&#10;Shows a warning on mismatch. Skipped for certs without a public key (e.g. DSA with omitted key). Do not enable if such certs are used.&#10;&#10;Values:&#10;0 = no enforcement&#10;1 = enforce</string>
      <string id="bAutoLaunchAtDocCloseDC_User">Examine on Close</string>
      <string id="bAutoLaunchAtDocCloseDC_User_Explain">Controls whether the document is automatically scanned for hidden content (metadata, comments, hidden layers) when it is closed.&#10;&#10;0 = hidden content not examined on document close&#10;1 = hidden content examined automatically on close</string>
      <string id="bAutoLaunchAtSendMailDC_User">Examine on Send</string>
      <string id="bAutoLaunchAtSendMailDC_User_Explain">Controls whether the document is automatically scanned for hidden content when it is sent as an email attachment.&#10;&#10;0 = hidden content not examined before email send&#10;1 = hidden content examined automatically before email send</string>
      <string id="bExpiredCertGoOnlineDC_User">Expired Cert Go Online</string>
      <string id="bExpiredCertGoOnlineDC_User_Explain">Go online for revocation on expired certificates.&#10;&#10;11.0.16+ invalidates signatures on expired certs without embedded revocation.&#10;&#10;Values:&#10;0 = do not go online&#10;1 = go online (pre-11.0.16 behavior)</string>
      <string id="bFDFRequestExcludeCertDC_User">FDF Exclude Cert</string>
      <string id="bFDFRequestExcludeCertDC_User_Explain">Controls whether the user's certificate is excluded from FDF certificate requests. When disabled, the user's certificate is included in all requests.&#10;&#10;0 = user certificate included in FDF certificate requests&#10;1 = user certificate excluded from FDF certificate requests</string>
      <string id="bFDFExportSaveDC_User">FDF Export Save</string>
      <string id="bFDFExportSaveDC_User_Explain">Caches the user's last choice of whether to save (1) or email (0) an FDF during certificate export. This is a persisted user preference, not typically configured by administrators.&#10;&#10;0 = last FDF export action was email&#10;1 = last FDF export action was save to file</string>
      <string id="bFDFExportSignDC_User">FDF Export Sign</string>
      <string id="bFDFExportSignDC_User_Explain">Caches the user's last choice of whether to sign the FDF during certificate export. This is a persisted user preference.&#10;&#10;0 = FDF not signed during export&#10;1 = FDF signed during export</string>
      <string id="bFDFRequestSaveDC_User">FDF Request Save</string>
      <string id="bFDFRequestSaveDC_User_Explain">Caches whether the user chose to save (1) or email (0) the certificate request FDF. This is a persisted user preference.&#10;&#10;0 = last certificate request FDF action was email&#10;1 = last certificate request FDF action was save to file</string>
      <string id="bFollowURIsFromAIADC_User">Follow AIA URIs</string>
      <string id="bFollowURIsFromAIADC_User_Explain">Controls whether the certificate chain builder is allowed to follow URIs in AIA extensions to download intermediate certificates not available locally.&#10;&#10;0 = AIA certificate URIs not followed (no certificate download)&#10;1 = AIA certificate URIs followed; missing certificates downloaded</string>
      <string id="bSigAPStatusIconDisableDC_User">Hide Sig Status Icon</string>
      <string id="bSigAPStatusIconDisableDC_User_Explain">Controls whether the signature status icon is hidden in signature appearances, overriding iDisplayValidIcon and bShowWarningForChanges.&#10;&#10;0 = signature status icon displayed in signature appearance&#10;1 = signature status icon hidden regardless of signature status</string>
      <string id="cDialogs_xSelHandlerDC_User">ID Dialog Position</string>
      <string id="cDialogs_xSelHandlerDC_User_Explain">The last on-screen coordinates of a handler's digital ID selection dialog&#10;&#10;It is a subkey containing 4 keys: Top, Bottom, Left, and Right. This preference could be used by 3rd party handlers or by someone invoking a non-signing digital ID selection dialog via JavaScript.</string>
      <string id="xDefEnrollmentURLDC_User">ID Enrollment URL</string>
      <string id="xDefEnrollmentURLDC_User_Explain">The destination URL when the user selects &quot;Enroll at an online CA&quot; while adding a new digital ID.</string>
      <string id="bIgnoreNextUpdateDC_User">Ignore OCSP NextUpdate</string>
      <string id="bIgnoreNextUpdateDC_User_Explain">Use embedded OCSP when nextUpdate is absent (with iMaxClockSkew).&#10;&#10;Supports long-term validation using signing-time responses.&#10;&#10;Values:&#10;0 = apply iMaxClockSkew on both sides of validation time&#10;1 = if no nextUpdate, accept OCSP indefinitely</string>
      <string id="iImportAddressBookDC_User">Import Address Book</string>
      <string id="iImportAddressBookDC_User_Explain">Import addressbook.acrodata on new install.&#10;&#10;Values:&#10;0 = do not import, no prompt&#10;1 or null = prompt user (default)&#10;2 = silent import</string>
      <string id="iImportAddressBookDC_User_opt0">Do not copy; user not prompted</string>
      <string id="iImportAddressBookDC_User_opt1">Ask whether to install the address book (default)</string>
      <string id="iImportAddressBookDC_User_opt2">Import the address book silently</string>
      <string id="bCertStoreImportEnableDC_User">Import Windows Certs</string>
      <string id="bCertStoreImportEnableDC_User_Explain">Controls whether users are allowed to import certificates from Windows MSCAPI certificate stores into the Acrobat Trusted Identity Manager.&#10;&#10;0 = import from Windows certificate stores blocked&#10;1 = import from Windows certificate stores allowed</string>
      <string id="bDontRemoveOverlappingDC_User">Keep Hidden Content</string>
      <string id="bDontRemoveOverlappingDC_User_Explain">Controls whether hidden (overlapping) content is preserved instead of removed during document sanitization. Removing it triggers automatic rasterization, which can significantly increase file size; keeping it skips rasterization.&#10;&#10;0 = overlapping hidden content removed during sanitization&#10;1 = overlapping hidden content kept during sanitization</string>
      <string id="cReasonsDC_User">List Of Signing Reasons</string>
      <string id="cReasonsDC_User_Explain">Custom signing reason list.&#10;&#10;Entries named t0, t1, etc. Overridable by document seed value. Defaults: author, reviewed, approving, attest accuracy, agree terms, agree portions.</string>
      <string id="bLoadSettingsFromURLAdobeDC_User">Load Security Settings from Server (Adobe Certificates)</string>
      <string id="bLoadSettingsFromURLAdobeDC_User_Explain">Controls whether Adobe root certificate trust anchors are periodically downloaded from Adobe's certificate distribution server.&#10;&#10;0 = Adobe certificate trust anchors not updated from server&#10;1 = Adobe certificate trust anchors periodically downloaded</string>
      <string id="bLoadSettingsFromURLEUTLDC_User">Load Security Settings from Server (European Certificates)</string>
      <string id="bLoadSettingsFromURLEUTLDC_User_Explain">Controls whether EU root certificate trust anchors are periodically downloaded from the European Union Trusted Lists (EUTL) server.&#10;&#10;0 = EUTL certificate trust anchors not updated from server&#10;1 = EUTL certificate trust anchors periodically downloaded</string>
      <string id="tLoadSettingsNAMEDC_User">Load Settings NAME</string>
      <string id="tLoadSettingsNAMEDC_User_Explain">Specifies the name of the signing certificate that must be used to sign imported security settings files. Leave blank to allow any certificate.</string>
      <string id="bIsEnabledDC_User">Long Term Validation</string>
      <string id="bIsEnabledDC_User_Explain">Controls whether Long Term Validation (LTV) information, including revocation status, is embedded in the signature at signing time.&#10;&#10;0 = revocation status not embedded (LTV disabled)&#10;1 = revocation status embedded in signature (LTV enabled)</string>
      <string id="iMaxRevInfoArchiveSizeDC_User">Max Rev Info Archive</string>
      <string id="iMaxRevInfoArchiveSizeDC_User_Explain">The maximum size of the revocation archival information in kilobytes.&#10;&#10;An attempt is made to store as much revocation information as possible without exceeding the limit. Note that older product versions may have a smaller supported size limit.</string>
      <string id="iMaxVerifySessionDC_User">Max Verify Sessions</string>
      <string id="iMaxVerifySessionDC_User_Explain">Sets the maximum number of nested certificate verification sessions allowed, preventing infinite loops caused by circular OCSP or CRL signer certificate references. Valid range: 1 to 100.</string>
      <string id="iCreateNewSigFieldAVAlertDC_User">New Sig Field Alert</string>
      <string id="iCreateNewSigFieldAVAlertDC_User_Explain">Controls whether a prompt is shown asking whether to create a new signature field when signing a document without one.&#10;&#10;0 = new signature field prompt not shown&#10;1 = new signature field prompt shown</string>
      <string id="bEnNonEmbFontLegPDFWarnDC_User">Non-Embedded Font Warn</string>
      <string id="bEnNonEmbFontLegPDFWarnDC_User_Explain">Controls whether a warning is shown in the PDF Signature Report when the document contains non-embedded fonts (detected via the LegalPDF dictionary NonEmbeddedFonts attribute).&#10;&#10;0 = no warning for non-embedded fonts in signature report&#10;1 = warning shown when document contains non-embedded fonts</string>
      <string id="iSendNonceDC_User">OCSP Nonce Behavior</string>
      <string id="iSendNonceDC_User_Explain">Controls how nonces are handled in OCSP requests during signature validation.&#10;&#10;0 = no nonces sent with OCSP requests&#10;1 = nonces sent; response must contain matching nonce&#10;2 = nonces sent; absent nonce in response is accepted</string>
      <string id="iSendNonceDC_User_opt0">No nonces sent</string>
      <string id="iSendNonceDC_User_opt1">Send nonces; expect matching nonce in response</string>
      <string id="iSendNonceDC_User_opt2">Send nonces; ignore absent nonce in response</string>
      <string id="iURLToConsultDC_User">OCSP Responder URL</string>
      <string id="iURLToConsultDC_User_Explain">Controls which OCSP responder URL source the revocation checker uses.&#10;&#10;0 = use AIA extension from the certificate&#10;1 = use URL specified in sURL&#10;2 = use AIA extension; fall back to sURL if absent&#10;3 = use OCSP request signer certificate's AIA extension (only when bSignRequest is 0)</string>
      <string id="iURLToConsultDC_User_opt0">Use the AIA extension in the certificate</string>
      <string id="iURLToConsultDC_User_opt1">Use the URL key in sURL</string>
      <string id="iURLToConsultDC_User_opt2">Use AIA; if absent use URL key in sURL</string>
      <string id="iURLToConsultDC_User_opt3">Use OCSP request signer certificate AIA (SignRequest=0 only)</string>
      <string id="iResponseFreshnessDC_User">OCSP Response Freshness</string>
      <string id="iResponseFreshnessDC_User_Explain">Sets the maximum age in minutes (measured from the response's thisUpdate timestamp) for which an OCSP response is considered fresh and valid. Responses older than this limit are rejected.</string>
      <string id="bAllowOpenFileDC_User">Open Non-PDF Attachments</string>
      <string id="bAllowOpenFileDC_User_Explain">Open non-PDF attachments in native applications.&#10;&#10;Works with bSecureOpenFile and tBuiltInPermsList; any block setting prevents opening.&#10;&#10;Values:&#10;0 = block&#10;1 = allow</string>
      <string id="tLockboxIdDC_User">Password Lockbox ID</string>
      <string id="tLockboxIdDC_User_Explain">Stores the lockbox identifier used to look up a cached server password when bSavePassword is enabled. Not exposed directly in the user interface.</string>
      <string id="bPreviewModeBeforeSigningDC_User">Preview Before Signing</string>
      <string id="bPreviewModeBeforeSigningDC_User_Explain">Controls whether document preview mode is automatically invoked before signing, requiring the user to review the document message bar and any warnings before completing the signature.&#10;&#10;0 = signing proceeds without forced preview&#10;1 = document preview mode required before signing</string>
      <string id="bRequireAKIDC_User">Require AKI in CRL</string>
      <string id="bRequireAKIDC_User_Explain">Controls whether the Authority Key Identifier (AKI) extension is required to be present in Certificate Revocation Lists (CRLs) during validation.&#10;&#10;0 = AKI extension not required in CRL&#10;1 = AKI extension required in CRL</string>
      <string id="bRequireOCSPCertHashDC_User">Require OCSP Cert Hash</string>
      <string id="bRequireOCSPCertHashDC_User_Explain">Controls whether OCSP responses must include a certificate public key hash extension for the response to be considered valid.&#10;&#10;0 = certificate hash not required in OCSP responses&#10;1 = certificate hash extension required in OCSP responses</string>
      <string id="iRequireReviewWarningsDC_User">Require Sign Warnings</string>
      <string id="iRequireReviewWarningsDC_User_Explain">Controls when the user is required to review document warnings before completing a signature in the signing dialog (interacts with iShowDocumentWarnings).&#10;&#10;0 = never required&#10;1 = required only when certifying&#10;2 = always required before signing</string>
      <string id="iRequireReviewWarningsDC_User_opt0">Never</string>
      <string id="iRequireReviewWarningsDC_User_opt1">Show when certifying only</string>
      <string id="iRequireReviewWarningsDC_User_opt2">Always</string>
      <string id="bReqSigPropRetrievalDC_User">Require Timestamp</string>
      <string id="bReqSigPropRetrievalDC_User_Explain">Require successful timestamp retrieval when signing.&#10;&#10;On failure, signing aborts with an error instead of using local time.&#10;&#10;Values:&#10;0 = best effort (local time fallback)&#10;1 = must succeed</string>
      <string id="bRequireValidSigForChainingDC_User">Require Valid Sig Chain</string>
      <string id="bRequireValidSigForChainingDC_User_Explain">Stop chain building at invalid RSA signatures on intermediates.&#10;&#10;Example: invalid ICA signature excludes the CA from the chain. Does not affect DSA.&#10;&#10;Values:&#10;0 = build full chain&#10;1 = stop at invalid signature</string>
      <string id="bReturnRevInfoToUserDC_User">Return Rev Info to JS</string>
      <string id="bReturnRevInfoToUserDC_User_Explain">Controls whether revocation information is retained in the SignatureInfo JavaScript object, making it accessible to scripts for inspection.&#10;&#10;0 = revocation information not available via JavaScript&#10;1 = revocation information accessible through SignatureInfo JS object</string>
      <string id="iRevocationCheckerDC_User">Revocation Checker</string>
      <string id="iRevocationCheckerDC_User_Explain">Sets which registered revocation checking provider(s) are used during certificate validation.&#10;&#10;0 = no registered providers used&#10;1 = first registered provider used&#10;2 = all registered providers used</string>
      <string id="iRevocationCheckerDC_User_opt0">Use none of the registered providers</string>
      <string id="iRevocationCheckerDC_User_opt1">Use first registered provider</string>
      <string id="iRevocationCheckerDC_User_opt2">Use all registered providers</string>
      <string id="bRevCheckTrustDC_User">Revoke Check Trust</string>
      <string id="bRevCheckTrustDC_User_Explain">Revocation-check intermediate (non-root) trust anchors.&#10;&#10;Detects compromise of third-party trust anchors. Root and self-signed certs are exempt.&#10;&#10;Values:&#10;0 = no check&#10;1 = check</string>
      <string id="iRSAPSSSaltLengthDC_User">RSA-PSS Salt Length</string>
      <string id="iRSAPSSSaltLengthDC_User_Explain">Sets the salt length (in bytes) used by the RSA-PSS signing algorithm. Enter the value in decimal; the registry stores it as a DWORD (e.g. decimal 32 = hex 0x20).</string>
      <string id="bEnableRSAPSSSigningDC_User">RSA-PSS Signing</string>
      <string id="bEnableRSAPSSSigningDC_User_Explain">Controls whether signatures are created using the RSA-PSS algorithm instead of the default RSA PKCS#1 v1.5 algorithm.&#10;&#10;0 = signatures use RSA PKCS#1 v1.5&#10;1 = signatures use RSA-PSS algorithm</string>
      <string id="aRSAPSSHashAlgorithmDC_User">RSAPSS Hash Algorithm</string>
      <string id="aRSAPSSHashAlgorithmDC_User_Explain">Sets the hash algorithm used when signing with RSA-PSS. Overrides aSignHash when bEnableRSAPSSSigning is enabled; defaults to SHA256 if not set. Accepted values: SHA1, SHA224, SHA256, SHA384, SHA512.</string>
      <string id="tSAML_Assertion_SourceDC_User">SAML Auth Server URL</string>
      <string id="tSAML_Assertion_SourceDC_User_Explain">Stores the URL of the SAML authentication server from which the user's last SAML assertion was obtained.</string>
      <string id="tSAML_Name_FormatDC_User">SAML Name Format</string>
      <string id="tSAML_Name_FormatDC_User_Explain">Stores the format component of the SAML subject name identifier from the user's last SAML authentication assertion. This is a machine-readable identifier independent of the authentication mechanism used.</string>
      <string id="tSAML_Name_QualifierDC_User">SAML Name Qualifier</string>
      <string id="tSAML_Name_QualifierDC_User_Explain">Stores the name qualifier component of the SAML subject name identifier from the user's last SAML authentication assertion, used to disambiguate the subject name across identity providers.</string>
      <string id="iDigSigSaveAsCertifiedDC_User">Save Certified Alert</string>
      <string id="iDigSigSaveAsCertifiedDC_User_Explain">Controls whether an alert is shown when saving a certified document (reminding the user that certification may be affected).&#10;&#10;0 = alert not shown when saving certified document&#10;1 = alert shown when saving certified document</string>
      <string id="bSecureOpenFileDC_User">Secure Open Attachments</string>
      <string id="bSecureOpenFileDC_User_Explain">Restrict attachment opens to PDF only.&#10;&#10;Works with bAllowOpenFile and tBuiltInPermsList; any block setting prevents opening.&#10;&#10;Values:&#10;0 = allow non-PDF&#10;1 = PDF only</string>
      <string id="bSelfSignCertGenDC_User">Self-Sign ID Create</string>
      <string id="bSelfSignCertGenDC_User_Explain">Allow Create a self-signed ID in Add ID workflows.&#10;&#10;Post-June 2016 products require bSelfSignCertGen=0 and bEnableCEFBasedUI=0 to fully block.&#10;&#10;Values:&#10;0 = disallow&#10;1 = allow</string>
      <string id="tServerURLDC_User">Server URL</string>
      <string id="tServerURLDC_User_Explain">Sets the default LiveCycle Rights Management server URL used for document rights connections.</string>
      <string id="bShowAllChainsDC_User">Show All Chains</string>
      <string id="bShowAllChainsDC_User_Explain">Controls whether the Certificate Viewer shows all certificate chains or only the trusted chain. When no trusted chain exists, all chains are shown regardless of this setting.&#10;&#10;0 = only trusted certificate chain shown in Certificate Viewer&#10;1 = all certificate chains shown in Certificate Viewer</string>
      <string id="iShowDocumentWarningsDC_User">Show Document Warnings</string>
      <string id="iShowDocumentWarningsDC_User_Explain">Controls when a "Review Warnings" button appears on the signing dialog (interacts with iRequireReviewWarnings).&#10;&#10;0 = button never shown&#10;1 = button shown only when certifying&#10;2 = button always shown in signing dialog</string>
      <string id="iShowDocumentWarningsDC_User_opt0">Never</string>
      <string id="iShowDocumentWarningsDC_User_opt1">Show when certifying only</string>
      <string id="iShowDocumentWarningsDC_User_opt2">Always</string>
      <string id="bShowWarningForChangesDC_User">Show Post-Sign Warning</string>
      <string id="bShowWarningForChangesDC_User_Explain">Show blue info icon when a validated approval signature document changes after signing.&#10;&#10;Does not affect certification signatures. Requires iDisplayValidIcon not set to 2.&#10;&#10;Values:&#10;0 = no warning (green check)&#10;1 = show warning</string>
      <string id="bAllowOtherInfoWhenSigningDC_User">Show Sign Contact Info</string>
      <string id="bAllowOtherInfoWhenSigningDC_User_Explain">Controls whether the Location and Contact Info fields are shown in the signing dialog.&#10;&#10;0 = location and contact info fields not shown in signing dialog&#10;1 = location and contact info fields shown in signing dialog</string>
      <string id="bShowSignerWarningsDC_User">Show Signer Warnings</string>
      <string id="bShowSignerWarningsDC_User_Explain">Controls whether a warning about increased forgery risk is shown when revocation information is embedded in the signature. Applicable to Acrobat 9.x only; this warning was removed in 10.x.&#10;&#10;0 = signer warning not shown&#10;1 = signer forgery-risk warning shown</string>
      <string id="iDisplayValidIconDC_User">Show Valid Sig Icon</string>
      <string id="iDisplayValidIconDC_User_Explain">When to show signature status icon in appearance.&#10;&#10;Value 2 disables bShowWarningForChanges and the GUI hide option. Does not affect Signatures pane icons.&#10;&#10;Values:&#10;0 = always&#10;1 = except when valid&#10;2 = never</string>
      <string id="iDisplayValidIconDC_User_opt0">Always display valid signature icon</string>
      <string id="iDisplayValidIconDC_User_opt1">Hide icon when signature is valid</string>
      <string id="iDisplayValidIconDC_User_opt2">Never display valid signature icon</string>
      <string id="bReqSigPropVerificationDC_User">Sig Property Verify</string>
      <string id="bReqSigPropVerificationDC_User_Explain">Controls whether signature property verification (such as timestamp URL validation) must succeed for the signature to be considered valid.&#10;&#10;0 = signature property verification failure does not invalidate signature&#10;1 = signature property verification must succeed</string>
      <string id="iSigVerificationTimeDC_User">Sig Verification Time</string>
      <string id="iSigVerificationTimeDC_User_Explain">Sets the reference time used when validating signatures.&#10;&#10;0 = always validate at current time&#10;1 = use signing time if secured (e.g. timestamped); otherwise use current time&#10;2 = always use signing time</string>
      <string id="iSigVerificationTimeDC_User_opt0">Verify at current time</string>
      <string id="iSigVerificationTimeDC_User_opt1">Use signing time if secure, else current time</string>
      <string id="iSigVerificationTimeDC_User_opt2">Always use signing time</string>
      <string id="bAllowSigCertOnlyDC_User">Sign Certified Only</string>
      <string id="bAllowSigCertOnlyDC_User_Explain">Controls whether additional approval signatures can be added to a certified document that contains LegalPDF warnings. When enabled, LegalPDF warnings block any further signatures.&#10;&#10;0 = additional approval signatures allowed on certified documents with warnings&#10;1 = additional approval signatures blocked when LegalPDF warnings present</string>
      <string id="isignDoneDC_User">Sign Done Dialog</string>
      <string id="isignDoneDC_User_Explain">Controls whether a confirmation dialog is shown after a document is successfully signed (note: the registry value isignDone is inverted).&#10;&#10;0 = signing confirmation dialog shown after successful signing&#10;1 = signing confirmation dialog suppressed</string>
      <string id="bAllowSigCertGreenOnlyDC_User">Sign Green Cert Only</string>
      <string id="bAllowSigCertGreenOnlyDC_User_Explain">Controls whether additional approval signatures can be added only to certified documents that do not contain LegalPDF warnings (green/clean state). When enabled, documents with warnings cannot receive further signatures.&#10;&#10;0 = certified documents with or without LegalPDF warnings can receive additional signatures&#10;1 = additional signatures only allowed on warning-free certified documents</string>
      <string id="tSignHashDC_User">Sign Hash Algorithm</string>
      <string id="tSignHashDC_User_Explain">Sets the hash algorithm OID for signing. An alternative to aSignHash. Accepted OIDs: 1.2.840.113549.2.5 (MD5), 1.3.14.3.2.26 (SHA1), 2.16.840.1.101.3.4.2.1 (SHA256), 2.16.840.1.101.3.4.2.2 (SHA384), 2.16.840.1.101.3.4.2.3 (SHA512), 1.3.36.3.2.1 (RIPEMD160).</string>
      <string id="bSignRequestDC_User">Sign OCSP Requests</string>
      <string id="bSignRequestDC_User_Explain">Controls whether OCSP requests are signed before being sent, required by some OCSP providers (e.g. IdenTrust).&#10;&#10;0 = OCSP requests sent unsigned&#10;1 = OCSP requests signed before sending</string>
      <string id="tContactInfoDC_User">Signing Contact Info</string>
      <string id="tContactInfoDC_User_Explain">Stores the default contact information pre-filled in the signing dialog when bAllowOtherInfoWhenSigning is enabled. The value is saved and reused on subsequent signing actions.</string>
      <string id="iHashAlgoDC_User">Timestamp Hash Algo</string>
      <string id="iHashAlgoDC_User_Explain">Sets the hash algorithm used for timestamp signing. For more options, use sHashAlgo.&#10;&#10;0 = MD5&#10;1 = SHA1&#10;2 = SHA256</string>
      <string id="iHashAlgoDC_User_opt0">MD5</string>
      <string id="iHashAlgoDC_User_opt1">SHA1</string>
      <string id="iHashAlgoDC_User_opt2">SHA256</string>
      <string id="iSizeDC_User">Timestamp Sig Size</string>
      <string id="iSizeDC_User_Explain">Sets the predicted timestamp signature size in bytes, which ASPKI uses to reserve adequate space in the signature field. Increase this value if timestamp embedding fails due to insufficient reserved space.</string>
      <string id="tServerDC_User">Tracker Server URL</string>
      <string id="tServerDC_User_Explain">The DNS server name (i.e. alrms.adobe.com).&#10;&#10;There is no scheme specified.</string>
      <string id="bTrueTypeFontPDFSigQWarnDC_User">TrueType Font Warn</string>
      <string id="bTrueTypeFontPDFSigQWarnDC_User_Explain">Controls whether a warning is shown in the PDF Signature Report when the document contains TrueType fonts that may affect signature quality.&#10;&#10;0 = no warning for TrueType fonts in signature report&#10;1 = warning shown when document contains TrueType fonts</string>
      <string id="bTrustCertifiedDocumentsDC_User">Trust Certified Docs</string>
      <string id="bTrustCertifiedDocumentsDC_User_Explain">Trust certified documents as privileged locations.&#10;&#10;Does not apply in Protected View. Lock via bEnableCertificateBasedTrust.&#10;&#10;Values:&#10;0 or null = not trusted&#10;1 = trusted</string>
      <string id="bTrustOSTrustedSitesDC_User">Trust IE Trusted Sites</string>
      <string id="bTrustOSTrustedSitesDC_User_Explain">Treat IE Trusted Sites and Local Intranet as privileged locations.&#10;&#10;Local Intranet included since 10.1.2/9.5. Disable with bDisableOSTrustedSites.&#10;&#10;Values:&#10;0 = do not trust OS zones&#10;1 = trust OS zones</string>
      <string id="tHostPermsDC_User">Trusted/Blocked URL List</string>
      <string id="tHostPermsDC_User_Explain">Stores trusted and blocked URLs when URL Access Permissions (iURLPerms) is set to Custom Setting (DWORD 0). Pipe-separated Adobe TrustManager host permission list syntax: version:1|host:N where N is 2 (Allow) or 3 (Block). Only effective when iURLPerms is 0; Allow or Block overrides this list. Not lockable via HKLM - this preference only exists at User scope.</string>
      <string id="iURLPermsDC_User">URL Access Permissions</string>
      <string id="iURLPermsDC_User_Explain">Allow, block, or custom website access.&#10;&#10;Allow or Block resets tHostPerms; Custom uses tHostPerms.&#10;&#10;Values:&#10;0 = custom&#10;1 = block all&#10;2 = allow all&#10;&#10;When set to Custom Setting (0), configure the URL list using the Trusted/Blocked URL List (tHostPerms) text policy.</string>
      <string id="iURLPermsDC_User_opt0">Custom Setting (uses tHostPerms URL list)</string>
      <string id="iURLPermsDC_User_opt1">Block all websites</string>
      <string id="iURLPermsDC_User_opt2">Allow all websites</string>
      <string id="tURLDC_User">Url Of The Roaming Id</string>
      <string id="tURLDC_User_Explain">The URL of the Roaming ID server.</string>
      <string id="iUseArchivedRevInfoDC_User">Use Archived Rev Info</string>
      <string id="iUseArchivedRevInfoDC_User_Explain">Indicates whether the revocation information archived with the signature is used for revocation checking.&#10;&#10;Allowable values include: 0: Never (always require fresh revocation information to be successfully downloaded). 1: Deprecated. Do not use. 2: Always use (if embedded revocation information is available do not download fresh revocation information).</string>
      <string id="iUseArchivedRevInfoDC_User_opt0">Never (require fresh revocation download)</string>
      <string id="iUseArchivedRevInfoDC_User_opt1">Deprecated - do not use</string>
      <string id="iUseArchivedRevInfoDC_User_opt2">Always use embedded revocation if available</string>
      <string id="iValidityModelDC_User">Validity Model</string>
      <string id="iValidityModelDC_User_Explain">Signature and certificate validity model.&#10;&#10;German signature law may require chain validation.&#10;&#10;Values:&#10;0 = PKIX shell model&#10;1 = chain model (for qualified policy or chain model extension OIDs)</string>
      <string id="iValidityModelDC_User_opt0">PKIX shell model (default)</string>
      <string id="iValidityModelDC_User_opt1">Chain validity model</string>
      <string id="iMSStoreTrustedDC_User">Windows Store Trust</string>
      <string id="iMSStoreTrustedDC_User_Explain">Trust Windows Certificate Store certs for signing and certifying.&#10;&#10;Lock via bMSStoreTrusted.&#10;&#10;Values:&#10;0x00 = none&#10;0x60 = validating signatures&#10;0x62 = certified documents and signatures&#10;&#10;Windows Store trust is a hex bitmask stored as a DWORD. Documented values: 0x00 (0) = no trust; 0x60 (96) = validating signatures; 0x62 (98) = validating certified documents and signatures. Other bit combinations may be set using the numeric control (0-255).</string>

      <!-- ======================================== -->
      <!--           Sharing and Features           -->
      <!-- ======================================== -->

      <string id="iSendMailDefaultAccountAlertDC_User">Default Email Prompt</string>
      <string id="iSendMailDefaultAccountAlertDC_User_Explain">Controls whether a dialog prompts the user to select their default email method the first time they send a PDF via email.&#10;&#10;0 = email client selection dialog not shown&#10;1 = email client selection dialog shown on first send</string>
      <string id="bDefaultSetDC_User">Default Email Set</string>
      <string id="bDefaultSetDC_User_Explain">Caches whether the user has already selected a default email client for sending PDFs. This is an internal state flag; setting it to 1 tells the application a default has been chosen.&#10;&#10;0 = no default email client set&#10;1 = default email client has been selected</string>
      <string id="bDisableSharedReviewDC_User">Disable Shared Review</string>
      <string id="bDisableSharedReviewDC_User_Explain">Controls whether the cloud-based (DC) shared review option is available (note: the registry value bDisableSharedReview is inverted). To fully disable DC Review, use bToggleAdobeReview or disable all services.&#10;&#10;0 = cloud-based DC review option removed&#10;1 = cloud-based DC review option available</string>
      <string id="bNeedSynchronizerDC_User">Enable Synchronizer</string>
      <string id="bNeedSynchronizerDC_User_Explain">Controls whether the background synchronizer is enabled. The synchronizer is required for services, AATL updates, shared reviews, and recent files sync; disabling it is not recommended.&#10;&#10;0 = synchronizer disabled&#10;1 = synchronizer enabled</string>
      <string id="bEnableFillSignDC_User">Fill &amp; Sign Pane</string>
      <string id="bEnableFillSignDC_User_Explain">Controls whether the Fill and Sign pane is available, allowing its removal without affecting the Work with Certificates menu (Acrobat 11.x only).&#10;&#10;0 = Fill and Sign pane removed&#10;1 = Fill and Sign pane shown</string>
      <string id="bRemoveCommaDelimiterDC_User">Remove Comma Delimiter</string>
      <string id="bRemoveCommaDelimiterDC_User_Explain">Controls whether commas are stripped from address book entries during shared review workflows, preventing errors in older product versions that could not handle comma-delimited entries.&#10;&#10;0 = address book entry commas preserved&#10;1 = commas stripped from address book entries</string>
      <string id="bShowConnectDialogDC_User">Show Connect Dialog</string>
      <string id="bShowConnectDialogDC_User_Explain">Controls whether the Connect dialog is displayed when initiating a Shared Review.&#10;&#10;0 = Connect dialog not shown in Shared Reviews&#10;1 = Connect dialog shown in Shared Reviews</string>
      <string id="bIsUsedShareReviewDC_User">Show Review Tip</string>
      <string id="bIsUsedShareReviewDC_User_Explain">Controls whether the collaborative review feature tip is shown to users who have opened but not yet sent a review file. Once a review is initiated the application sets the value to 1 and suppresses the tip (note: registry value bIsUsedShareReview is inverted).&#10;&#10;0 = collaborative review tip shown&#10;1 = collaborative review tip suppressed</string>
      <string id="bIsUsedShareDC_User">Show Share Tip</string>
      <string id="bIsUsedShareDC_User_Explain">Controls whether the file sharing feature tip is shown to users who have opened but not yet shared a file. Once a file is shared the application sets the value to 1 and suppresses the tip (note: registry value bIsUsedShare is inverted).&#10;&#10;0 = share file tip shown&#10;1 = share file tip suppressed</string>
      <string id="bShowWelcomeDialogDC_User">Show Welcome Dialog</string>
      <string id="bShowWelcomeDialogDC_User_Explain">Controls whether the Welcome dialog is shown when a Shared Review is initiated.&#10;&#10;0 = Shared Review Welcome dialog not shown&#10;1 = Shared Review Welcome dialog shown</string>

      <!-- ======================================== -->
      <!--          Startup and Experience          -->
      <!-- ======================================== -->

      <string id="bActivatedDC_User">App Activated</string>
      <string id="bActivatedDC_User_Explain">Tracks whether the application has been activated online after installation. This is an internal application state flag; setting it to 1 suppresses the activation prompt.&#10;&#10;0 = application not yet activated&#10;1 = application has been activated</string>
      <string id="bHasLaunchedDC_User">App Has Launched</string>
      <string id="bHasLaunchedDC_User_Explain">Tracks whether the application has been launched at least once since installation. This is an internal state flag.&#10;&#10;0 = application not yet launched after install&#10;1 = application has been launched</string>
      <string id="bAppInitializedDC_User">App Initialized</string>
      <string id="bAppInitializedDC_User_Explain">Tracks whether the application has completed its first-run initialization. This is an internal state flag; setting it to 1 can skip first-launch setup sequences.&#10;&#10;0 = application not yet initialized&#10;1 = application has been initialized</string>
      <string id="bLaunchedDC_User">App Launched</string>
      <string id="bLaunchedDC_User_Explain">Caches whether the application has ever been launched. Certain first-run behaviors depend on this flag being set.&#10;&#10;0 = application not yet launched&#10;1 = application has been launched</string>
      <string id="EULAAcceptedForBrowserDC_User">Browser EULA Accepted</string>
      <string id="EULAAcceptedForBrowserDC_User_Explain">Caches whether the browser plugin EULA has been accepted. Setting to 1 suppresses the EULA prompt; if not accepted within the grace period, the application stops running.&#10;&#10;0 = EULA not accepted; EULA prompt shown&#10;1 = EULA accepted; EULA prompt suppressed</string>
      <string id="bChooseLangAtStartupDC_User">Choose Language Startup</string>
      <string id="bChooseLangAtStartupDC_User_Explain">Controls whether a language selection dialog is shown at startup, allowing the user to choose their preferred interface language.&#10;&#10;0 = language selection dialog not shown at startup&#10;1 = language selection dialog shown at startup</string>
      <string id="bCreateFormDiscoveryShownDC_User">Create Form Onboarding</string>
      <string id="bCreateFormDiscoveryShownDC_User_Explain">Controls whether the Create Form panel onboarding coachmark is shown. Set to 0 (Enabled) to reset the coachmark so it displays again; set to 1 (Disabled) to mark it as already shown (note: registry value bCreateFormDiscoveryShown is inverted).&#10;&#10;0 = Create Form onboarding coachmark shown&#10;1 = Create Form onboarding coachmark suppressed</string>
      <string id="bEditDiscoveryShownDC_User">Edit Onboarding</string>
      <string id="bEditDiscoveryShownDC_User_Explain">Controls whether the Edit panel onboarding coachmark is shown (note: registry value bEditDiscoveryShown is inverted).&#10;&#10;0 = Edit onboarding coachmark shown&#10;1 = Edit onboarding coachmark suppressed</string>
      <string id="bFillSignDiscoveryShownDC_User">Fill &amp; Sign Onboarding</string>
      <string id="bFillSignDiscoveryShownDC_User_Explain">Controls whether the Fill &amp; Sign panel onboarding coachmark is shown (note: registry value bFillSignDiscoveryShown is inverted).&#10;&#10;0 = Fill &amp; Sign onboarding coachmark shown&#10;1 = Fill &amp; Sign onboarding coachmark suppressed</string>
      <string id="bHideHelpWelcomeDC_User">Hide Help Welcome</string>
      <string id="bHideHelpWelcomeDC_User_Explain">Controls whether the Welcome menu item under Help is hidden.&#10;&#10;0 = Help &gt; Welcome menu item shown&#10;1 = Help &gt; Welcome menu item hidden</string>
      <string id="bShownHomeOnboardingDC_User">Home Onboarding</string>
      <string id="bShownHomeOnboardingDC_User_Explain">Controls whether the home onboarding tour is shown when the modern viewer (AV2) is first launched. After the tour runs, the app resets this to 0. Has no effect if bEnableAv2 is 0 (note: registry value bShownHomeOnboarding is inverted).&#10;&#10;0 = home onboarding tour shown&#10;1 = home onboarding tour suppressed</string>
      <string id="bLoadAllPluginsAtStartupDC_User">Load All Plugins</string>
      <string id="bLoadAllPluginsAtStartupDC_User_Explain">Controls whether all installed plugins are loaded at application startup, as opposed to deferred or on-demand loading.&#10;&#10;0 = plugins not all loaded at startup&#10;1 = all plugins loaded at startup</string>
      <string id="bOrganizeDiscoveryShownDC_User">Organize Onboarding</string>
      <string id="bOrganizeDiscoveryShownDC_User_Explain">Controls whether the Organize panel onboarding coachmark is shown (note: registry value bOrganizeDiscoveryShown is inverted).&#10;&#10;0 = Organize onboarding coachmark shown&#10;1 = Organize onboarding coachmark suppressed</string>
      <string id="bUsePageCacheDC_User">Page Caching</string>
      <string id="bUsePageCacheDC_User_Explain">Controls whether rendered PDF pages are cached in memory to improve scrolling and navigation performance.&#10;&#10;0 = page caching disabled&#10;1 = page caching enabled</string>
      <string id="bRedactDiscoveryShownDC_User">Redaction Onboarding</string>
      <string id="bRedactDiscoveryShownDC_User_Explain">Controls whether the Redaction panel onboarding coachmark is shown (note: registry value bRedactDiscoveryShown is inverted).&#10;&#10;0 = Redaction onboarding coachmark shown&#10;1 = Redaction onboarding coachmark suppressed</string>
      <string id="bDisplayAboutDialogDC_User">Show About Dialog</string>
      <string id="bDisplayAboutDialogDC_User_Explain">Controls whether the About/splash screen is displayed on every application launch.&#10;&#10;0 = About dialog not shown at startup&#10;1 = About dialog shown at every startup</string>
      <string id="idontShowAllImagesHaveAltTextDC_User">Show Alt Text Alert</string>
      <string id="idontShowAllImagesHaveAltTextDC_User_Explain">Controls whether an informational alert is shown when the Set Alternate Text dialog is opened and all images already have alt text (note: registry value idontShowAllImagesHaveAltText is inverted).&#10;&#10;0 = "all images have alt text" alert shown&#10;1 = "all images have alt text" alert suppressed</string>
      <string id="bshowEULADC_User">Show EULA Startup</string>
      <string id="bshowEULADC_User_Explain">Controls whether the End User License Agreement (EULA) is displayed at startup.&#10;&#10;0 = EULA not shown at startup&#10;1 = EULA shown at startup</string>
      <string id="bLastShowStatusDC_User">Show Getting Started</string>
      <string id="bLastShowStatusDC_User_Explain">Controls whether the "Get Started with Acrobat" page is shown on application startup.&#10;&#10;0 = Getting Started page not shown at startup&#10;1 = Getting Started page shown at startup</string>
      <string id="bShowHorizontalScrollbarDC_User">Show H-Scrollbar</string>
      <string id="bShowHorizontalScrollbarDC_User_Explain">Controls whether a horizontal scrollbar is shown when the viewing area is narrower than the document width.&#10;&#10;0 = horizontal scrollbar not shown&#10;1 = horizontal scrollbar shown when needed</string>
      <string id="bShowExistingAttachedReportAlertDC_User">Show Report Alert</string>
      <string id="bShowExistingAttachedReportAlertDC_User_Explain">Controls whether an alert is shown when a user tries to attach a report to a document that already has one attached (note: registry value bShowExistingAttachedReportAlert is inverted).&#10;&#10;0 = existing report attachment alert shown&#10;1 = existing report attachment alert suppressed</string>
      <string id="idontShowSetAltTextInfoDC_User">Show Set Alt Alert</string>
      <string id="idontShowSetAltTextInfoDC_User_Explain">Controls whether an informational alert is shown when the Set Alternate Text dialog is opened (note: registry value idontShowSetAltTextInfo is inverted).&#10;&#10;0 = Set Alternate Text informational alert shown&#10;1 = Set Alternate Text informational alert suppressed</string>
      <string id="bShowedSkipCardDC_User">Show Skip Card</string>
      <string id="bShowedSkipCardDC_User_Explain">Caches whether the skipped-onboarding card has been shown to the user. Set to 1 to mark it as shown and prevent it from appearing again.&#10;&#10;0 = skipped onboarding card not yet shown&#10;1 = skipped onboarding card has been shown</string>
      <string id="bSplashDisplayedAtStartupDC_User">Show Splash Screen</string>
      <string id="bSplashDisplayedAtStartupDC_User_Explain">Controls whether the splash screen is displayed when Acrobat starts.&#10;&#10;0 = splash screen not displayed at startup&#10;1 = splash screen displayed at startup</string>
      <string id="bDisplayedSplashDC_User">Splash Displayed</string>
      <string id="bDisplayedSplashDC_User_Explain">Caches whether the application has ever shown the splash screen. This is an internal application state flag.&#10;&#10;0 = splash screen not yet displayed&#10;1 = splash screen has been displayed</string>
      <string id="bInTrialModeDC_User">Trial Mode Active</string>
      <string id="bInTrialModeDC_User_Explain">Caches whether the application is running in Trial Mode. This is an internal application state flag set automatically during the trial period.&#10;&#10;0 = application not in trial mode&#10;1 = application operating in trial mode</string>
      <string id="bShownViewerOnboardingDC_User">Viewer Onboarding</string>
      <string id="bShownViewerOnboardingDC_User_Explain">Controls whether the new viewer onboarding tour is shown when a PDF first opens in the modern viewer. After the tour runs the app resets this to 0. Has no effect if bEnableAv2 is 0 (note: registry value bShownViewerOnboarding is inverted).&#10;&#10;0 = viewer onboarding tour shown&#10;1 = viewer onboarding tour suppressed</string>
      <string id="iDelayBeforeQuitViewerDC_User">Viewer Quit Delay</string>
      <string id="iDelayBeforeQuitViewerDC_User_Explain">Controls how many seconds the standalone application remains in memory after the last document closes before shutting down completely.&#10;&#10;Enabled writes the configured integer value (seconds). Disabled removes the override (application uses its built-in default of 30 seconds).&#10;&#10;Integer: number of seconds to remain in memory before quitting (default 30)</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="bDownloadEntireFileDC_User">Background Download</string>
      <string id="bDownloadEntireFileDC_User_Explain">Controls whether the viewer downloads additional PDF resources in the background to ensure complete rendering.&#10;&#10;0 = background downloading disabled&#10;1 = background downloading enabled</string>
      <string id="iDelayBeforeQuitBrowserDC_User">Browser Quit Delay</string>
      <string id="iDelayBeforeQuitBrowserDC_User_Explain">Controls how many seconds the browser helper application remains in memory after the browser closes before shutting down completely.&#10;&#10;Enabled writes the configured integer value (seconds). Disabled removes the override (application uses its built-in default of 30 seconds).&#10;&#10;Integer: number of seconds to remain in memory before quitting (default 30)</string>
      <string id="bBrowserDisplayInReadModeDC_User">Browser Read Mode</string>
      <string id="bBrowserDisplayInReadModeDC_User_Explain">Controls whether PDFs opened in a browser display in Read Mode, which hides standard toolbars and shows a compact menu on hover.&#10;&#10;0 = standard toolbars shown in browser&#10;1 = Read Mode active in browser</string>
      <string id="bInstalledCleanupCheckDoneDC_User">Cleanup Check Done</string>
      <string id="bInstalledCleanupCheckDoneDC_User_Explain">Caches whether the installer cleanup check for UsageMeasurement registry keys has already run. This is an internal application state flag.&#10;&#10;0 = cleanup check not yet performed&#10;1 = cleanup check completed</string>
      <string id="bLoadOnStartDC_User">Collab Sync Startup</string>
      <string id="bLoadOnStartDC_User_Explain">Controls whether AdobeCollabSync.exe (used for shared reviews and forms data collection) launches automatically on application startup (note: registry value bLoadOnStart is inverted).&#10;&#10;0 = AdobeCollabSync.exe starts automatically&#10;1 = AdobeCollabSync.exe does not start automatically</string>
      <string id="bAllowByteRangeRequestsDC_User">Fast Web View</string>
      <string id="bAllowByteRangeRequestsDC_User_Explain">Controls whether Fast Web View is enabled, allowing the PDF to begin displaying before the entire file has downloaded.&#10;&#10;0 = Fast Web View disabled&#10;1 = Fast Web View enabled</string>
      <string id="bFavoriteFilesRememberChoiceDC_User">Remember Stars Choice</string>
      <string id="bFavoriteFilesRememberChoiceDC_User_Explain">Caches the per-file choice made when a user selects "Ask every time" for starred-file actions (iFavoriteFilesAccessOption = 0). This is an application-generated internal state flag.</string>
      <string id="bFavoritesStripInRFLDC_User">Show Starred Files</string>
      <string id="bFavoritesStripInRFLDC_User_Explain">Controls whether starred (favorited) files appear in the recent files list (note: registry value bFavoritesStripInRFL is inverted).&#10;&#10;0 = starred files shown in recent files list&#10;1 = starred files not shown in recent files list</string>
      <string id="iFavoriteFilesAccessOptionDC_User">Starred Files Action</string>
      <string id="iFavoriteFilesAccessOptionDC_User_Explain">Controls the action taken when a user stars (favorites) a file.&#10;&#10;0 = show dialog asking whether to save locally or upload (also creates bFavoriteFilesRememberChoice per-file cache)&#10;1 = upload to Document Cloud automatically&#10;2 = save file locally automatically</string>
      <string id="iFavoriteFilesAccessOptionDC_User_opt0">Show dialog (save or upload)</string>
      <string id="iFavoriteFilesAccessOptionDC_User_opt1">Upload to Document Cloud</string>
      <string id="iFavoriteFilesAccessOptionDC_User_opt2">Save the file locally</string>
      <string id="bStoreCredentialsDC_User">Store Credentials</string>
      <string id="bStoreCredentialsDC_User_Explain">Controls whether the user's Tracker logon credentials are stored for future sessions.&#10;&#10;0 = Tracker credentials not stored&#10;1 = Tracker credentials stored</string>
      <string id="iAVARMNoAutoUpdateWarningDC_User">Suppress Update Warning</string>
      <string id="iAVARMNoAutoUpdateWarningDC_User_Explain">Controls whether the "Updater has not been able to check for updates recently" warning dialog is suppressed.&#10;&#10;0 = update warning dialog shown&#10;1 = update warning dialog suppressed</string>

      <!-- ======================================== -->
      <!--                  Upsell                  -->
      <!-- ======================================== -->

      <string id="bAcrobatAppInstalledDC_User">Acrobat App Promo</string>
      <string id="bAcrobatAppInstalledDC_User_Explain">Controls whether the Acrobat mobile app promotion and link appear in the Home banner (note: registry value bAcrobatAppInstalled is inverted; to suppress the App Center entirely, also set bToggleDCAppCenter under FeatureLockDown).&#10;&#10;0 = Acrobat mobile app promoted in Home banner&#10;1 = Acrobat mobile app promotion hidden</string>
      <string id="bScanAppInstalledDC_User">Scan App Promo</string>
      <string id="bScanAppInstalledDC_User_Explain">Controls whether the Adobe Scan mobile app promotion and link appear in the Home banner (note: registry value bScanAppInstalled is inverted; to suppress the App Center entirely, also set bToggleDCAppCenter under FeatureLockDown).&#10;&#10;0 = Adobe Scan app promoted in Home banner&#10;1 = Adobe Scan app promotion hidden</string>
      <string id="bShowTrialNagDC_User">Show Trial Nag</string>
      <string id="bShowTrialNagDC_User_Explain">Controls whether the "Trial Expired" purchase prompt dialog appears after the 30-day trial period ends. When the trial expires, the application enters reduced functionality mode regardless of this setting.&#10;&#10;0 = Trial Expired dialog suppressed&#10;1 = Trial Expired dialog shown</string>
      <!-- ======================================== -->
      <!--                                          -->
      <!-- Adobe Reader DC (User) - policy strings  -->
      <!--                                          -->
      <!-- ======================================== -->

      <!-- ======================================== -->
      <!--        Context, Tools and Search         -->
      <!-- ======================================== -->

      <string id="tBaseFolderName_User">Base Folder Name</string>
      <string id="tBaseFolderName_User_Explain">Specifies the alias name for a folder used in batch sequences.&#10;&#10;Enabled writes the configured text value. Disabled removes the override.&#10;&#10;"install" = application-level Sequences folder&#10;"user" = user-level Sequences folder&#10;Any other name = administrator-specified folder</string>
      <string id="iColumnSelectHalo_User">Column Select Halo</string>
      <string id="iColumnSelectHalo_User_Explain">Controls whether a pixel halo is used when selecting column text.&#10;&#10;0 = column select halo disabled&#10;1 = column select halo enabled</string>
      <string id="tFileFormat_User">File Format Version</string>
      <string id="tFileFormat_User_Explain">Specifies the version format for batch sequence (.sequ) files used in this workflow.&#10;&#10;Enabled writes the configured text value. Disabled removes the override.&#10;&#10;"11" = Acrobat 11 format .sequ file&#10;"pre-11" = Acrobat 10 or earlier format .sequ file</string>
      <string id="bAlwaysUseFileNameAsDocTitle_User">Filename as Title</string>
      <string id="bAlwaysUseFileNameAsDocTitle_User_Explain">Controls whether the PDF file name is used as the title bar display name, overriding any document-level "Document Title" Initial View setting.&#10;&#10;0 = document title property shown in title bar&#10;1 = file name shown in title bar</string>
      <string id="bUseFixedSnapshotResolution_User">Fixed Snapshot Resolution</string>
      <string id="bUseFixedSnapshotResolution_User_Explain">Controls whether snapshot captures use a fixed DPI (configured via iSnapshotResolution) instead of the screen resolution.&#10;&#10;0 = screen resolution used for snapshot captures&#10;1 = fixed DPI used for snapshot captures</string>
      <string id="ADC4318556_User">Flash Player for 3D</string>
      <string id="ADC4318556_User_Explain">Controls whether 3D and multimedia content in PDF files is played using a Flash player (Flash is no longer supported; an administrator-provided player must be installed separately).&#10;&#10;0 = Flash player not used for 3D/multimedia content&#10;1 = Flash player used for 3D/multimedia content</string>
      <string id="bHandSelects_User">Hand Tool Select</string>
      <string id="bHandSelects_User_Explain">Controls whether the hand tool can also select text and images (including on Windows touch devices).&#10;&#10;0 = hand tool cannot select text and images&#10;1 = hand tool can select text and images</string>
      <string id="iMaxMRUCntToBeStored_User">Max Recent Files</string>
      <string id="iMaxMRUCntToBeStored_User_Explain">Controls how many recently opened files are stored for display in the recent files list (File menu shows up to 5; My Files View shows up to 100).&#10;&#10;Enabled writes the configured integer value. Disabled removes the override (application default of 100 applies).&#10;&#10;Integer: 0-100 (default 100)</string>
      <string id="bEnableAv2_User">Modern Viewer</string>
      <string id="bEnableAv2_User_Explain">Controls whether the modern viewer (AV2) is used instead of the classic viewer.&#10;&#10;0 = classic viewer shown&#10;1 = modern viewer shown</string>
      <string id="bAllowMultipleExpandedPanels_User">Multiple Comment Panels</string>
      <string id="bAllowMultipleExpandedPanels_User_Explain">Controls whether more than one comment panel can be expanded simultaneously in the Comments pane.&#10;&#10;0 = only one comment panel expanded at a time&#10;1 = multiple comment panels can be expanded simultaneously</string>
      <string id="iNumSwitcherContextualToolTipAV2Shown_User">New Look Coachmark</string>
      <string id="iNumSwitcherContextualToolTipAV2Shown_User_Explain">Controls whether the "Acrobat has a new look" coachmark is shown after the first launch with the modern viewer. After the coachmark displays, the app resets this to 0. Has no effect if bEnableAv2 is 0.&#10;&#10;0 = coachmark suppressed&#10;1 = coachmark will be shown</string>
      <string id="bPinHUD_User">Pin HUD Toolbar</string>
      <string id="bPinHUD_User_Explain">Controls whether the heads-up display (HUD) toolbar is pinned persistently to the top toolbar.&#10;&#10;0 = HUD not pinned to toolbar&#10;1 = HUD pinned to toolbar</string>
      <string id="bPromptBeforeClosingMultipleTabs_User">Prompt Close Tabs</string>
      <string id="bPromptBeforeClosingMultipleTabs_User_Explain">Controls whether a confirmation prompt is shown before closing multiple document tabs at once.&#10;&#10;0 = no prompt when closing multiple tabs&#10;1 = confirmation prompt shown before closing multiple tabs</string>
      <string id="bImagesFirst_User">Select Images First</string>
      <string id="bImagesFirst_User_Explain">Controls whether images take selection priority over text when clicking in areas where both overlap.&#10;&#10;0 = text selection takes priority in overlapping areas&#10;1 = image selection takes priority in overlapping areas</string>
      <string id="bInfobubble_User">Show Tool Pane Tips</string>
      <string id="bInfobubble_User_Explain">Controls whether popup tooltips are shown in the Tools, Comments, and Share panes.&#10;&#10;0 = pane tooltips hidden&#10;1 = pane tooltips shown</string>
      <string id="bKeyPrefsShowVirtualKeyoard_User">Show Touch Keyboard</string>
      <string id="bKeyPrefsShowVirtualKeyoard_User_Explain">Controls whether the on-screen touch keyboard is shown when the device is in touch or tablet mode and the user taps a text area (search box, comment popup, form field, etc.).&#10;&#10;0 = touch keyboard not shown automatically&#10;1 = touch keyboard shown automatically on touch/tablet devices</string>
      <string id="iSnapshotResolution_User">Snapshot Resolution DPI</string>
      <string id="iSnapshotResolution_User_Explain">Specifies the fixed DPI for snapshot captures when bUseFixedSnapshotResolution is enabled.&#10;&#10;Enabled writes the configured integer value (DPI). Disabled removes the override.&#10;&#10;Integer: 72-600 DPI</string>
      <string id="irightPaneState_User">Tools Pane State</string>
      <string id="irightPaneState_User_Explain">Controls the Tools Pane open/close state when the application launches.&#10;&#10;0 = use application default&#10;1 = always closed on launch&#10;2 = always open on launch</string>
      <string id="irightPaneState_User_opt0">Use the default</string>
      <string id="irightPaneState_User_opt1">Always closed</string>
      <string id="irightPaneState_User_opt2">Always open</string>
      <string id="iBasicSharePaneStickyStatus_User">Tools Pane Sticky</string>
      <string id="iBasicSharePaneStickyStatus_User_Explain">Controls whether the Tools Pane open/close state is remembered between sessions (interacts with irightPaneState).&#10;&#10;0 = pane state not remembered; always closed on launch&#10;1 = pane state remembered across sessions</string>
      <string id="iBasicSharePaneStickyStatus_User_opt0">Don't remember the Tool Pane's state (always closed on launch)</string>
      <string id="iBasicSharePaneStickyStatus_User_opt1">Do remember the Tool Pane's state</string>
      <string id="iNumSwitcherContextualToolTipAVShown_User">Try New Coachmark</string>
      <string id="iNumSwitcherContextualToolTipAVShown_User_Explain">Controls whether the "Try the new Acrobat/Reader" coachmark is shown on first launch with the classic viewer. After the coachmark displays, the app resets this to 0. Has no effect if bEnableAv2 is 0.&#10;&#10;0 = coachmark suppressed&#10;1 = coachmark will be shown</string>
      <string id="iNumSessionAV2_User">UI Switcher Sessions</string>
      <string id="iNumSessionAV2_User_Explain">Tracks the number of user sessions, used to determine when to show the UI switcher coachmark (interacts with iNumSwitcherContextualToolTipAV2Shown).&#10;&#10;Enabled writes 1 = session count set to 1. Disabled writes 0 = session count reset to 0.&#10;&#10;0-1 = UI switcher coachmark not shown&#10;2 or greater = UI switcher coachmark shown if iNumSwitcherContextualToolTipAV2Shown is 0</string>

      <!-- ======================================== -->
      <!--   Documents, Editing and Accessibility   -->
      <!-- ======================================== -->

      <string id="bUse2DGPUf_User">2D GPU Acceleration</string>
      <string id="bUse2DGPUf_User_Explain">Controls whether 2D hardware graphics acceleration is used for rendering PDF content.&#10;&#10;0 = 2D GPU acceleration disabled&#10;1 = 2D GPU acceleration enabled</string>
      <string id="bAllowDocsToHideUI_User">Allow Hide UI</string>
      <string id="bAllowDocsToHideUI_User_Explain">Controls whether PDF documents are permitted to hide the menu bar, toolbars, and window controls via document-level scripting.&#10;&#10;0 = documents cannot hide UI elements&#10;1 = documents can hide UI elements</string>
      <string id="benableTextSelection_User">Annotation Text Selection</string>
      <string id="benableTextSelection_User_Explain">Controls whether text can be selected directly on highlight, strikethrough, and underline annotations by hovering (note: registry value benableTextSelection is inverted).&#10;&#10;0 = text selection on annotations enabled (][ cursor after 2s hover, reverts after 3s outside)&#10;1 = text selection disabled (][ only via context menu)</string>
      <string id="bEnableAT_User">Assistive Technology</string>
      <string id="bEnableAT_User_Explain">Controls whether assistive technology (AT) workflows are active, causing prompts for setup assistance on untagged documents and OCR on scanned files when AT such as JAWS is detected.&#10;&#10;0 = assistive technology workflows disabled&#10;1 = assistive technology workflows enabled</string>
      <string id="bAttachLog_User">Attach Report</string>
      <string id="bAttachLog_User_Explain">Controls whether the accessibility report is attached to the document after running a full accessibility check.&#10;&#10;0 = accessibility report not attached to document&#10;1 = accessibility report attached to document after check</string>
      <string id="bAutoCompleteOnTab_User">Auto-Complete on Tab</string>
      <string id="bAutoCompleteOnTab_User_Explain">Controls whether pressing Tab in a form field automatically completes the entry using the remembered auto-complete value (requires Advanced auto-complete mode).&#10;&#10;0 = Tab key does not trigger auto-complete&#10;1 = Tab key triggers auto-complete in form fields</string>
      <string id="bautoOpenOther_User">Auto-Open Drawing Popup</string>
      <string id="bautoOpenOther_User_Explain">Controls whether a popup note is automatically created when an annotation is added using drawing tools, the Stamp tool, or the Pencil tool.&#10;&#10;0 = no automatic popup note for drawing annotations&#10;1 = popup note added automatically for drawing annotations</string>
      <string id="bAutoSaveDocsEnabled_User">Auto-Save</string>
      <string id="bAutoSaveDocsEnabled_User_Explain">Controls whether documents are saved automatically at intervals configured by iAutoSaveDocsInterval.&#10;&#10;0 = auto-save disabled&#10;1 = auto-save enabled</string>
      <string id="iAutoSaveDocsInterval_User">Auto-Save Interval</string>
      <string id="iAutoSaveDocsInterval_User_Explain">Controls how frequently (in minutes) documents are auto-saved when bAutoSaveDocsEnabled is active.&#10;&#10;Enabled writes the configured integer value (minutes). Disabled removes the override (application default of 5 minutes applies).&#10;&#10;Integer: 1-99 minutes (default 5)</string>
      <string id="bAutoSetLayers_User">Auto-Set Layers</string>
      <string id="bAutoSetLayers_User_Explain">Controls whether the document's optional content layer visibility can be automatically set based on user information.&#10;&#10;0 = layer state not automatically set by user information&#10;1 = layer state automatically set by user information</string>
      <string id="iPages_User">Check Page Range</string>
      <string id="iPages_User_Explain">Controls whether all pages or only a page range subset are checked during an accessibility full check.&#10;&#10;0 = page range (subset) checked&#10;1 = all pages checked</string>
      <string id="benableDDR_User">ClearType Smoothing</string>
      <string id="benableDDR_User_Explain">Controls whether ClearType/DDR sub-pixel rendering is applied to further smooth text on LCD screens (in addition to standard anti-aliasing).&#10;&#10;0 = standard anti-aliasing only (monitors)&#10;1 = DDR sub-pixel smoothing enabled (Laptop/LCD screens)</string>
      <string id="iAccessColorPolicy_User">Color Replace Policy</string>
      <string id="iAccessColorPolicy_User_Explain">Controls the Replace Document Colors accessibility policy, overriding document colors according to the selected scheme. Disabling this policy removes the key from registry (restoring user choice).&#10;&#10;1 = use Windows color scheme&#10;2 = use custom colors&#10;4 = use high contrast colors</string>
      <string id="iAccessColorPolicy_User_opt0">Use Windows Color Scheme</string>
      <string id="iAccessColorPolicy_User_opt1">Use Custom Colors</string>
      <string id="iAccessColorPolicy_User_opt2">Use High Contrast Colors</string>
      <string id="bCombineContent_User">Combine Reading Order</string>
      <string id="bCombineContent_User_Explain">Controls whether similar content types in the TouchUp Reading Order panel are displayed grouped together (note: registry value bCombineContent is inverted).&#10;&#10;0 = similar content types grouped together&#10;1 = similar content types displayed separately</string>
      <string id="tauthor_User">Comment Author</string>
      <string id="tauthor_User_Explain">Specifies the comment author name used when balwaysUseIdent is disabled (i.e., the user has opted not to use the login name as author).&#10;&#10;Enabled writes the configured text value. Disabled removes the override.</string>
      <string id="tNoteFontName_User">Comment Font Name</string>
      <string id="tNoteFontName_User_Explain">Specifies the font used for comment text in the viewer. The font is not embedded in the PDF and controls viewer display only, not the author preference.&#10;&#10;Enabled writes the configured font name (e.g., "Tahoma"). Disabled removes the override.</string>
      <string id="dNoteFontSize_User">Comment Font Size</string>
      <string id="dNoteFontSize_User_Explain">Specifies the font size (in points) used for comment text in the viewer.&#10;&#10;Enabled writes the configured value (points). Disabled removes the override (application default of 10 points applies).&#10;&#10;Integer: 6-72 points (default 10)</string>

      <string id="bComplexScript_User">Complex Script Support</string>
      <string id="bComplexScript_User_Explain">Controls whether complex script support (writing direction switching for right-to-left languages) is enabled.&#10;&#10;0 = complex script / writing direction switching disabled&#10;1 = complex script / writing direction switching enabled</string>
      <string id="bconfirmEBRMerge_User">Confirm Review Import</string>
      <string id="bconfirmEBRMerge_User_Explain">Controls whether a confirmation alert is shown on document open when comments from an email-based review are about to be imported.&#10;&#10;0 = comments imported without confirmation alert&#10;1 = confirmation alert shown before importing comments</string>
      <string id="bcopyTextToDrawAnnot_User">Copy Text to Drawing</string>
      <string id="bcopyTextToDrawAnnot_User_Explain">Controls whether text encircled by a drawing annotation is automatically copied into the annotation popup comment.&#10;&#10;0 = encircled text not copied to drawing annotation popup&#10;1 = encircled text copied into drawing annotation popup</string>
      <string id="bcopyTextToMarkupAnnot_User">Copy Text to Markup</string>
      <string id="bcopyTextToMarkupAnnot_User_Explain">Controls whether selected text is automatically copied into highlight, cross-out, and underline annotation popups (note: registry value bcopyTextToMarkupAnnot is inverted).&#10;&#10;0 = selected text copied into markup annotation popups&#10;1 = selected text not copied into markup annotation popups</string>
      <string id="bCreateLog_User">Create Report</string>
      <string id="bCreateLog_User_Explain">Controls whether an accessibility report file is created when running a full accessibility check.&#10;&#10;0 = accessibility report not created&#10;1 = accessibility report created after full check</string>

      <string id="iPageViewLayoutMode_User">Default Page Layout</string>
      <string id="iPageViewLayoutMode_User_Explain">Controls the default page layout mode when a PDF opens (may be overridden by Accessibility settings such as bOverridePageLayout).&#10;&#10;0 = automatic&#10;1 = single page&#10;2 = single page continuous&#10;3 = two up continuous&#10;5 = two up</string>
      <string id="iPageViewLayoutMode_User_opt0">Automatic</string>
      <string id="iPageViewLayoutMode_User_opt1">Single Page</string>
      <string id="iPageViewLayoutMode_User_opt2">Single Page Continuous</string>
      <string id="iPageViewLayoutMode_User_opt3">Two Up Continuous</string>
      <string id="iPageViewLayoutMode_User_opt4">Two Up</string>
      <string id="iParaDir_User">Default Paragraph Dir</string>
      <string id="iParaDir_User_Explain">Controls the default paragraph text direction for new text elements.&#10;&#10;0 = left to right&#10;1 = right to left&#10;2 = infer from document</string>
      <string id="iParaDir_User_opt0">Left to Right</string>
      <string id="iParaDir_User_opt1">Right to Left</string>
      <string id="iParaDir_User_opt2">Infer from document</string>

      <string id="iDefaultZoomType_User">Default Zoom Type</string>
      <string id="iDefaultZoomType_User_Explain">Controls the default zoom type (non-percentage) applied when a PDF opens; percentage scales are configured separately via iDefaultZoomScale.&#10;&#10;1 = fit page (automatic)&#10;2 = fit width&#10;3 = fit height&#10;4 = fit visible&#10;6 = reflow</string>
      <string id="iDefaultZoomType_User_opt0">Fit Page (automatic)</string>
      <string id="iDefaultZoomType_User_opt1">Fit Width</string>
      <string id="iDefaultZoomType_User_opt2">Fit Height</string>
      <string id="iDefaultZoomType_User_opt3">Fit Visible</string>
      <string id="iDefaultZoomType_User_opt4">Reflow</string>
      <string id="tDictionaryName_User">Dictionary Name</string>
      <string id="tDictionaryName_User_Explain">Specifies the display name of the default spelling dictionary, corresponding to the name from cDictionaryOrder\t0 (see also iDictionaryDefaultID for the corresponding ID).&#10;&#10;Enabled writes the configured text value. Disabled removes the override.</string>
      <string id="imaxPDFCommentsSize_User">Embedded Comment Limit</string>
      <string id="imaxPDFCommentsSize_User_Explain">Controls the size threshold (in MB) that determines whether comments are embedded in the PDF or sent as separate FDF files during collaboration workflows.&#10;&#10;Enabled writes the configured value. Disabled removes the override (Reader default is 3 MB).&#10;&#10;Integer: 1-100 MB (default 3 for Reader)</string>
      <string id="bemptyContentToolTip_User">Empty Comment Tooltip</string>
      <string id="bemptyContentToolTip_User_Explain">Controls whether a tooltip is shown when hovering over a comment popup that has no text content.&#10;&#10;0 = no tooltip for empty comment popups&#10;1 = tooltip shown indicating the comment is empty</string>
      <string id="bUseThinCode_User">Enhance Thin Lines</string>
      <string id="bUseThinCode_User_Explain">Controls whether thin lines in PDF content are enhanced (widened slightly) to improve their visibility on screen.&#10;&#10;0 = thin lines displayed at actual width&#10;1 = thin lines enhanced for visibility</string>
      <string id="bSuperFastDrawing_User">Fast Scroll Drawing</string>
      <string id="bSuperFastDrawing_User_Explain">Controls whether low-resolution rendering is used during fast scroll, zoom, and pan interactions (temporarily shows lower quality to improve responsiveness).&#10;&#10;0 = high quality rendering during scroll/zoom/pan&#10;1 = fast low-resolution rendering during scroll/zoom/pan</string>
      <string id="iaskFormsSelectEmailCLient_User">Form Email Prompt</string>
      <string id="iaskFormsSelectEmailCLient_User_Explain">Controls whether a dialog asking the user to choose between desktop and internet email is shown each time an XFA form is submitted via email.&#10;&#10;0 = email client selection dialog suppressed on XFA form submit&#10;1 = email client selection dialog shown on each XFA form submit</string>
      <string id="bHidePopupIfShowSummary_User">Hide Popup on Summary</string>
      <string id="bHidePopupIfShowSummary_User_Explain">Controls whether comment popup notes are hidden when the comments list panel is open.&#10;&#10;0 = comment popups visible while comment list is open&#10;1 = comment popups hidden when comment list is open</string>
      <string id="bHindiDigit_User">Hindi Digits</string>
      <string id="bHindiDigit_User_Explain">Controls whether Hindi (Devanagari) digit display is supported in the application.&#10;&#10;0 = Hindi digit support disabled&#10;1 = Hindi digit support enabled</string>
      <string id="bHoveringPopups_User">Hover Popups</string>
      <string id="bHoveringPopups_User_Explain">Controls whether comment popup notes automatically open when the mouse hovers over the annotation marker.&#10;&#10;0 = comment popups do not open on mouse hover&#10;1 = comment popups open automatically on mouse hover</string>
      <string id="bInlineAutoComplete_User">Inline Auto-Complete</string>
      <string id="bInlineAutoComplete_User_Explain">Controls whether form fields show inline auto-complete suggestions as the user types, based on previously remembered values (applies to both Basic and Advanced auto-complete modes).&#10;&#10;0 = inline auto-complete disabled&#10;1 = inline auto-complete suggestions shown while typing</string>
      <string id="iIntlSelectFont_User">International Font</string>
      <string id="iIntlSelectFont_User_Explain">Controls which international font is used for displaying CJK (Chinese/Japanese/Korean) content.&#10;&#10;0 = application default font&#10;1 = GB18030 compatible font (Simplified Chinese)&#10;2 = HKSCS compatible font (Traditional Chinese)</string>
      <string id="iIntlSelectFont_User_opt0">Application default</string>
      <string id="iIntlSelectFont_User_opt1">GB18030 compatible font</string>
      <string id="iIntlSelectFont_User_opt2">HKSCS compatible font</string>
      <string id="bLigatures_User">Ligatures</string>
      <string id="bLigatures_User_Explain">Controls whether typographic ligatures (combined letterforms such as fi, fl) are supported and rendered in PDF content.&#10;&#10;0 = ligature rendering disabled&#10;1 = ligature rendering enabled</string>
      <string id="balwaysUseIdent_User">Login Name as Author</string>
      <string id="balwaysUseIdent_User_Explain">Controls whether the system login name is used as the comment author name instead of the user-specified name in identity preferences (note: registry value balwaysUseIdent is inverted).&#10;&#10;0 = login name used as comment author&#10;1 = identity preference name used as comment author</string>
      <string id="bOpenInPlace_User">Open Links in Place</string>
      <string id="bOpenInPlace_User_Explain">Controls whether cross-document links open in the same application window rather than a new one.&#10;&#10;0 = cross-document links open in a new window&#10;1 = cross-document links open in the same window</string>
      <string id="bOverprintPreviewUseShiftClick_User">Overprint Shift+Click</string>
      <string id="bOverprintPreviewUseShiftClick_User_Explain">Controls Shift+Click behavior in the Output Preview dialog (when disabled, Shift+Click adds a color-value sticky note; when enabled, Shift+Click performs multi-select and Alt/Option+Click adds the sticky note).&#10;&#10;0 = Shift+Click adds color-value sticky note; Alt/Option+Click for sticky note unavailable&#10;1 = Shift+Click multi-selects; Alt/Option+Click adds color-value sticky note</string>
      <string id="bAccessOverrideDocColors_User">Override Document Colors</string>
      <string id="bAccessOverrideDocColors_User_Explain">Controls whether black text and line art colors are replaced when iAccessColorPolicy is active and a replacement color is specified. Only read when iAccessColorPolicy is enabled.&#10;&#10;0 = black text/line art colors not replaced&#10;1 = black text/line art colors replaced with the accessibility color</string>
      <string id="bOverrideLineArtColors_User">Override Line Art Colors</string>
      <string id="bOverrideLineArtColors_User_Explain">Controls whether line art colors (not just black text) are also replaced when iAccessColorPolicy is active. Only read when Accessibility color replacement is enabled. See also bAccessOverrideDocColors.&#10;&#10;0 = line art colors not replaced&#10;1 = line art colors replaced with the accessibility color</string>
      <string id="iPageLayout_User">Override Page Layout</string>
      <string id="iPageLayout_User_Explain">Controls the accessibility page layout override applied when bOverridePageLayout is enabled.&#10;&#10;1 = single page&#10;2 = single page continuous&#10;3 = two up continuous&#10;5 = two up</string>
      <string id="iPageLayout_User_opt0">Single Page</string>
      <string id="iPageLayout_User_opt1">Single Page Continuous</string>
      <string id="iPageLayout_User_opt2">Two Up Continuous</string>
      <string id="iPageLayout_User_opt3">Two Up</string>
      <string id="bOverrideZoom_User">Override Zoom</string>
      <string id="bOverrideZoom_User_Explain">Controls whether a user-defined zoom level overrides the document's Page Display settings (when enabled, configure the zoom level via iZoomScale and iZoomType).&#10;&#10;0 = document default zoom used&#10;1 = zoom override active (configured via iZoomScale/iZoomType)</string>

      <string id="iZoomType_User">Override Zoom Type</string>
      <string id="iZoomType_User_Explain">Controls the zoom type override for all documents (non-percentage modes; percentage scales are configured via iZoomScale). Requires bOverrideZoom = 1.&#10;&#10;1 = fit page&#10;2 = fit width&#10;3 = fit height&#10;4 = fit visible&#10;6 = reflow</string>
      <string id="iZoomType_User_opt0">Fit Page</string>
      <string id="iZoomType_User_opt1">Fit Width</string>
      <string id="iZoomType_User_opt2">Fit Height</string>
      <string id="iZoomType_User_opt3">Fit Visible</string>
      <string id="iZoomType_User_opt4">Reflow</string>
      <string id="iParagraphDirection_User">Paragraph Direction</string>
      <string id="iParagraphDirection_User_Explain">Controls the paragraph writing direction for TouchUp Text operations.&#10;&#10;0 = right to left&#10;1 = left to right</string>
      <string id="iParagraphDirection_User_opt0">Right to Left</string>
      <string id="iParagraphDirection_User_opt1">Left to Right</string>
      <string id="bPopupsOpenIffSelected_User">Popup When Selected</string>
      <string id="bPopupsOpenIffSelected_User_Explain">Controls whether a comment popup note opens only when its annotation marker is selected (rather than on hover).&#10;&#10;0 = popup opens on hover&#10;1 = popup opens only when annotation is selected</string>
      <string id="bUseDetailsNavigator_User">Portfolio File List</string>
      <string id="bUseDetailsNavigator_User_Explain">Controls whether PDF Portfolio component files and details are displayed in an accessible list view, improving usability for people with disabilities (replaces bUsePlatformNavigator).&#10;&#10;0 = portfolio uses standard non-list view&#10;1 = portfolio component files shown in accessible list view</string>
      <string id="bPrintAnnots_User">Print Annotations</string>
      <string id="bPrintAnnots_User_Explain">Controls whether notes, popups, and other annotations are included when printing a PDF.&#10;&#10;0 = annotations not printed&#10;1 = annotations included in print output</string>
      <string id="bprintCommentPopups_User">Print Comment Popups</string>
      <string id="bprintCommentPopups_User_Explain">Controls whether open comment popup notes are printed along with the document content.&#10;&#10;0 = open comment popups not printed&#10;1 = open comment popups printed with document</string>
      <string id="bprintNotesOpaque_User">Print Popups Opaque</string>
      <string id="bprintNotesOpaque_User_Explain">Controls whether comment popup notes print as fully opaque, ignoring the opacity percentage set in commenting preferences.&#10;&#10;0 = popup opacity preference honored when printing&#10;1 = popup notes print fully opaque</string>
      <string id="bUserAskedToEnableAutoComplete_User">Prompt Auto-Complete</string>
      <string id="bUserAskedToEnableAutoComplete_User_Explain">Controls whether the user is prompted at runtime to enable auto-complete (applies to Advanced auto-complete mode).&#10;&#10;0 = user not prompted to enable auto-complete&#10;1 = user prompted at runtime to enable auto-complete</string>
      <string id="iShowOrder_User">Reading Order Display</string>
      <string id="iShowOrder_User_Explain">Controls the grouping display mode in the TouchUp Reading Order panel.&#10;&#10;0 = order (numbered sequence)&#10;1 = structure type&#10;2 = no grouping shown</string>
      <string id="iShowOrder_User_opt0">Order (numbered)</string>
      <string id="iShowOrder_User_opt1">Structure type</string>
      <string id="iShowOrder_User_opt2">None</string>
      <string id="bRecordNewEntries_User">Remember Form Entries</string>
      <string id="bRecordNewEntries_User_Explain">Controls whether new form field entries are saved for future auto-complete suggestions (applies to both Basic and Advanced auto-complete modes).&#10;&#10;0 = form entries not saved for auto-complete&#10;1 = form entries saved for auto-complete</string>
      <string id="iRememberView_User">Restore Last View</string>
      <string id="iRememberView_User_Explain">Controls whether the last view settings (zoom level, page position) are restored when a document is reopened.&#10;&#10;1 = last view settings not restored&#10;2 = last view settings restored on reopen</string>
      <string id="iRememberView_User_opt0">Don't restore the last view settings</string>
      <string id="iRememberView_User_opt1">Do restore the last view settings</string>
      <string id="bRTLUI_User">Right-to-Left UI</string>
      <string id="bRTLUI_User_Explain">Controls whether right-to-left language UI options (such as paragraph direction controls) are shown in the application.&#10;&#10;0 = right-to-left language options not shown&#10;1 = right-to-left language options enabled</string>
      <string id="bDigitsUI_User">RTL Digit Display</string>
      <string id="bDigitsUI_User_Explain">Controls whether digits are displayed in a right-to-left-compatible format (automatically set when bRTLUI is configured via the UI).&#10;&#10;0 = standard left-to-right digit display&#10;1 = right-to-left compatible digit display</string>
      <string id="bPrintSaveToner_User">Save Toner/Ink</string>
      <string id="bPrintSaveToner_User_Explain">Controls whether print output is optimized to reduce toner/ink usage (savings may reach approximately 15% with minimal visible impact on print quality).&#10;&#10;0 = standard print quality (no toner saving)&#10;1 = toner/ink optimization applied during printing</string>
      <string id="bSDIMode_User">SDI Mode</string>
      <string id="bSDIMode_User_Explain">Controls whether documents open in separate windows (SDI mode) or as tabs within the same window (MDI mode).&#10;&#10;0 = tabbed document mode (MDI)&#10;1 = separate window mode (SDI)</string>
      <string id="bsendFinalApprovalEmail_User">Send Approval Email</string>
      <string id="bsendFinalApprovalEmail_User_Explain">Controls whether a notification email is automatically sent when the last approver in an approval workflow signs off.&#10;&#10;0 = no email sent on final approval&#10;1 = notification email sent on final approval</string>
      <string id="bShowOptionsDialog_User">Show Check Options</string>
      <string id="bShowOptionsDialog_User_Explain">Controls whether the accessibility check options dialog is shown before running a full accessibility check.&#10;&#10;0 = accessibility check options dialog not shown&#10;1 = accessibility check options dialog shown before full check</string>
      <string id="bcommentPanelOnImport_User">Show Comments on Import</string>
      <string id="bcommentPanelOnImport_User_Explain">Controls whether the comment list panel is automatically opened when comments are imported into a document.&#10;&#10;0 = comment list not opened automatically on import&#10;1 = comment list opens automatically when comments are imported</string>
      <string id="bShowAnnotConnector_User">Show Connector Lines</string>
      <string id="bShowAnnotConnector_User_Explain">Controls whether connector lines are drawn between comment annotation markers and their popup notes on mouse hover.&#10;&#10;0 = connector lines between annotations and popups hidden&#10;1 = connector lines between annotations and popups shown on hover</string>
      <string id="bFocusRect_User">Show Focus Rectangle</string>
      <string id="bFocusRect_User_Explain">Controls whether a focus rectangle is drawn around form fields when they have keyboard focus.&#10;&#10;0 = no focus rectangle shown on form fields&#10;1 = focus rectangle shown around focused form field</string>
      <string id="bShowKeyboardSelectionCursor_User">Show Keyboard Cursor</string>
      <string id="bShowKeyboardSelectionCursor_User_Explain">Controls whether the keyboard selection cursor is always displayed in the document (recommended for users of screen magnifiers).&#10;&#10;0 = keyboard selection cursor not shown&#10;1 = keyboard selection cursor always shown in document</string>
      <string id="bshowMarkupModifiers_User">Show Markup Indicators</string>
      <string id="bshowMarkupModifiers_User_Explain">Controls whether tool-tips and text indicators are shown for markup annotation tools.&#10;&#10;0 = markup tool-tips and text indicators hidden&#10;1 = markup tool-tips and text indicators shown</string>
      <string id="bStampsPaletteInvisible_User">Show Stamps Palette</string>
      <string id="bStampsPaletteInvisible_User_Explain">Controls whether the Stamps palette is automatically shown when the commenting toolbar is displayed (note: registry value bStampsPaletteInvisible is inverted).&#10;&#10;0 = stamps palette shown automatically&#10;1 = stamps palette hidden</string>
      <string id="bShowAnnotSequence_User">Show Tab Order</string>
      <string id="bShowAnnotSequence_User_Explain">Controls whether the tab order of fields is shown for Acroforms and XFA forms.&#10;&#10;0 = field tab order not shown&#10;1 = field tab order shown for Acroforms and XFA forms</string>
      <string id="bsideNotes_User">Side-Aligned Popups</string>
      <string id="bsideNotes_User_Explain">Controls whether new comment popup notes are positioned aligned to the edge of the document rather than near the annotation marker.&#10;&#10;0 = comment popups positioned near annotation marker&#10;1 = comment popups aligned to document edge</string>
      <string id="bAntialiasImages_User">Smooth Images</string>
      <string id="bAntialiasImages_User_Explain">Controls whether anti-aliasing (smoothing) is applied to images in PDF content. Disabling can improve scrolling performance in Citrix environments.&#10;&#10;0 = image anti-aliasing disabled&#10;1 = image anti-aliasing enabled</string>
      <string id="bAntialiasGraphics_User">Smooth Line Art</string>
      <string id="bAntialiasGraphics_User_Explain">Controls whether anti-aliasing (smoothing) is applied to line art in PDF content. Disabling can improve scrolling performance in Citrix environments.&#10;&#10;0 = line art anti-aliasing disabled&#10;1 = line art anti-aliasing enabled</string>
      <string id="bAntialiasText_User">Smooth Text</string>
      <string id="bAntialiasText_User_Explain">Controls whether text anti-aliasing is applied in the viewer. With benableDDR=1, DDR further smooths text on LCD-capable displays.&#10;&#10;0 = no text anti-aliasing&#10;1 = text anti-aliasing enabled for monitors and Laptop/LCD screens</string>
      <string id="bSmoothZooming_User">Smooth Zooming</string>
      <string id="bSmoothZooming_User_Explain">Controls whether animated smooth zooming is used when changing zoom levels.&#10;&#10;0 = instant zoom level changes&#10;1 = animated smooth zooming enabled</string>
      <string id="bSpellingUnderline_User">Spell Check Underline</string>
      <string id="bSpellingUnderline_User_Explain">Controls whether real-time spell checking (underline as you type) is active. Also stored under cPICommonPrefs\cSpelling.&#10;&#10;0 = real-time spell check underline disabled&#10;1 = real-time spell check underline active</string>
      <string id="bStoreNumericEntries_User">Store Numeric Entries</string>
      <string id="bStoreNumericEntries_User_Explain">Controls whether numeric values entered in form fields are saved for future auto-complete suggestions (applies to both Basic and Advanced auto-complete modes).&#10;&#10;0 = numeric form entries not saved for auto-complete&#10;1 = numeric form entries saved for auto-complete</string>
      <string id="bUseStructTabOrder_User">Structure Tab Order</string>
      <string id="bUseStructTabOrder_User_Explain">Controls whether the PDF document's logical structure (tag tree) determines the Tab key navigation order rather than the visual order of fields.&#10;&#10;0 = visual order used for Tab navigation&#10;1 = document structure (tag tree) used for Tab navigation</string>
      <string id="bUseSystemSelectionColor_User">System Selection Color</string>
      <string id="bUseSystemSelectionColor_User_Explain">Controls whether the system-defined selection highlight color replaces the application's default blue selection color.&#10;&#10;0 = default blue selection color used&#10;1 = system selection color used for text/content selection</string>

      <string id="bUseLocalFonts_User">Use Local Fonts</string>
      <string id="bUseLocalFonts_User_Explain">Controls whether locally installed system fonts are used for rendering when the PDF's embedded fonts are not available.&#10;&#10;0 = local fonts not used for rendering&#10;1 = local fonts used when embedded fonts are unavailable</string>
      <string id="iEmailClientSelection_User">XFA Email Client</string>
      <string id="iEmailClientSelection_User_Explain">Controls whether a specific email client is selected for use when submitting XFA forms via the email submit button.&#10;&#10;Enabled writes 1 = email client selection active. Disabled writes 0 = email client selection not set (user is prompted).</string>
      <string id="iRXOPolicy_User">XObjects View Mode</string>
      <string id="iRXOPolicy_User_Explain">Controls access to referenced XObjects (external PDF objects). Also requires cRXOLocation and a privileged location for the parent document to be configured on Windows.&#10;&#10;0 = never allow XObject access&#10;1 = always allow XObject access&#10;2 = only allow XObject access for PDF/X-5 compliant documents</string>
      <string id="iRXOPolicy_User_opt0">Never allow XObjects view mode</string>
      <string id="iRXOPolicy_User_opt1">Always allow XObjects view mode</string>
      <string id="iRXOPolicy_User_opt2">Only PDF/X-5 compliant documents</string>

      <!-- ======================================== -->
      <!--         Microsoft Purview (MIP)          -->
      <!-- ======================================== -->

      <string id="bEnableLogging_User">MIP Logging</string>
      <string id="bEnableLogging_User_Explain">Controls whether debug logging is enabled for Microsoft Purview Information Protection (MIP) operations, useful for troubleshooting label and authentication issues.&#10;&#10;0 = MIP debug logging disabled&#10;1 = MIP debug logging enabled</string>
      <string id="bEnablePolicyAuthentication_User">MIP Policy Authentication</string>
      <string id="bEnablePolicyAuthentication_User_Explain">Controls whether MIP policy authentication is performed for the current user. Used alongside bShowDMB; setting both to 0 hides the applied MIP label from the document.&#10;&#10;0 = MIP policy authentication disabled&#10;1 = MIP policy authentication enabled</string>
      <string id="bShowDMB_User">Show Document Message Bar (MIP)</string>
      <string id="bShowDMB_User_Explain">Controls whether the MIP label is shown in the document message bar. Used alongside bEnablePolicyAuthentication; setting both to 0 hides the applied label from the document.&#10;&#10;0 = MIP label not shown in document message bar&#10;1 = MIP label shown in document message bar</string>

      <!-- ======================================== -->
      <!--    Security: Execution and Protection    -->
      <!-- ======================================== -->

      <string id="b3DEnableContent_User">3D Content Trust</string>
      <string id="b3DEnableContent_User_Explain">Controls whether 3D content in PDFs is trusted and rendered automatically. When disabled, the Yellow Message Bar is shown so users can manually trust the document. Can be overridden by bEnable3D.&#10;&#10;0 = 3D content not auto-rendered; Yellow Message Bar prompts user to trust&#10;1 = 3D content trusted and rendered automatically</string>
      <string id="tBrokerLogfilePath_User">Broker Logfile Path</string>
      <string id="tBrokerLogfilePath_User_Explain">Specifies the full file path for the Protected Mode broker log, used to troubleshoot workflows or plugins that fail when Protected Mode is enabled.&#10;&#10;Enabled writes the configured path value. Disabled removes the override (no log file created).&#10;&#10;String: full path including log filename (e.g., C:\Logs\broker.log)</string>
      <string id="bCrossDomainLogging_User">Cross-Domain Logging</string>
      <string id="bCrossDomainLogging_User_Explain">Controls whether cross-domain logging is enabled for non-same-origin server communications, creating an AcrobatCrossDomain.log file in the user's Adobe Application Data folder.&#10;&#10;0 = cross-domain logging disabled&#10;1 = cross-domain logging enabled</string>
      <string id="bEnableDebugger_User">Enable JS Debugger</string>
      <string id="bEnableDebugger_User_Explain">Controls whether the JavaScript debugger is enabled. Requires an application restart to take effect.&#10;&#10;0 = JavaScript debugger disabled&#10;1 = JavaScript debugger enabled (requires restart)</string>
      <string id="bFIPSMode_User">FIPS Mode</string>
      <string id="bFIPSMode_User_Explain">Controls whether FIPS 140 mode is active, requiring stronger encryption algorithms and restricting certain application behaviors to FIPS-compliant operations.&#10;&#10;0 = FIPS mode inactive&#10;1 = FIPS mode active (stronger encryption, restricted behaviors)</string>
      <string id="bEnableGlobalSecurity_User">JS Global Security</string>
      <string id="bEnableGlobalSecurity_User_Explain">Controls whether a JavaScript in one document sandbox can access script objects in another sandbox. By default this cross-sandbox access is blocked; it only functions in the standalone application (not the browser viewer, where each window is a discrete instance).&#10;&#10;0 = cross-sandbox JavaScript access blocked&#10;1 = cross-sandbox JavaScript access enabled</string>
      <string id="bEnableMenuItems_User">JS Menu Items</string>
      <string id="bEnableMenuItems_User_Explain">Controls whether JavaScript is permitted to programmatically execute menu items.&#10;&#10;0 = JavaScript menu item execution disabled&#10;1 = JavaScript menu item execution enabled</string>
      <string id="bEnableAlwaysOutlookAttachmentProtectedView_User">Outlook Protected View</string>
      <string id="bEnableAlwaysOutlookAttachmentProtectedView_User_Explain">Controls whether PDFs received as Outlook attachments open in Protected View. Older Office versions may not mark the download origin, so such files may not open in Protected View automatically (note: registry value bEnableAlwaysOutlookAttachmentProtectedView is inverted).&#10;&#10;0 = Protected View enabled for Outlook attachments&#10;1 = Protected View disabled for Outlook attachments</string>
      <string id="bOldRecentFilesMigrated_User">Recent Files Migrated</string>
      <string id="bOldRecentFilesMigrated_User_Explain">Caches whether the recent files list has been migrated from an older format. This is an internal application state flag; administrators should not modify this value.&#10;&#10;0 = recent files list not yet migrated&#10;1 = recent files list migration completed</string>

      <!-- ======================================== -->
      <!--     Security: Trust and Permissions      -->
      <!-- ======================================== -->

      <string id="bUseExpiredTimestamps_User">Accept Expired Timestamps</string>
      <string id="bUseExpiredTimestamps_User_Explain">Controls whether expired timestamps are accepted for signature validation.&#10;&#10;0 = reject expired timestamps&#10;1 = accept expired timestamps (expired timestamp will not invalidate a signature)</string>
      <string id="bAllowConnectViaHTTP_User">Allow LiveCycle HTTP</string>
      <string id="bAllowConnectViaHTTP_User_Explain">Controls whether the LiveCycle Rights Management server connection uses HTTP instead of HTTPS.&#10;&#10;0 = use HTTPS (https://server:port/path)&#10;1 = use HTTP (http://server:port/path)</string>
      <string id="bAllowCertNonGreen_User">Allow Non-Green Cert</string>
      <string id="bAllowCertNonGreen_User_Explain">Controls whether a certification signature may be applied to a document containing Legal PDF warnings.&#10;&#10;0 = block certification when Legal PDF warnings present&#10;1 = allow certification regardless of Legal PDF warnings</string>
      <string id="bAllowOCSPNoCheck_User">Allow OCSP NoCheck</string>
      <string id="bAllowOCSPNoCheck_User_Explain">Controls whether the OCSPNoCheck extension is accepted in the response signing certificate.&#10;&#10;0 = OCSPNoCheck extension not allowed&#10;1 = OCSPNoCheck extension allowed</string>
      <string id="bAlwaysConsult_User">Always Consult CDP</string>
      <string id="bAlwaysConsult_User_Explain">Controls when the CDP URL is consulted for certificate revocation checking.&#10;&#10;0 = use CDP URL only when certificate has no CRLDp extension&#10;1 = always consult the CDP URL</string>
      <string id="iAuthMechanisms_User">Auth Mechanisms</string>
      <string id="iAuthMechanisms_User_Explain">Specifies which registered authentication provider(s) to use for security services.&#10;&#10;0 = use none of the registered providers&#10;1 = use first registered provider&#10;2 = use all registered providers</string>
      <string id="iAuthMechanisms_User_opt0">Use none of the registered providers</string>
      <string id="iAuthMechanisms_User_opt1">Use first registered provider</string>
      <string id="iAuthMechanisms_User_opt2">Use all registered providers</string>
      <string id="iAutoAcceptEDCPrivacyNotification_User">Auto-Accept Privacy</string>
      <string id="iAutoAcceptEDCPrivacyNotification_User_Explain">Controls whether a privacy policy confirmation alert is shown when connecting to a LiveCycle Rights Management server.&#10;&#10;0 = do not show privacy confirmation alert&#10;1 = show privacy confirmation alert</string>
      <string id="iAutoAddLTV_User">Auto-Add LTV Info</string>
      <string id="iAutoAddLTV_User_Explain">Auto-add LTV information to signatures.&#10;&#10;Large LTV may prompt when over 10% of file size plus 10 KB. Choosing Do not show again and No sets this to 0.&#10;&#10;Values:&#10;0 = never&#10;1 = ask if too big (default)&#10;2 = always</string>
      <string id="iAutoAddLTV_User_opt0">Never add LTV information</string>
      <string id="iAutoAddLTV_User_opt1">Ask whether to add LTV if too big (default)</string>
      <string id="iAutoAddLTV_User_opt2">Always add LTV information</string>
      <string id="bSavePassword_User">Cache Server Password</string>
      <string id="bSavePassword_User_Explain">Indicates whether the server password is cached in the user's secure password store.&#10;&#10;0 = password not cached&#10;1 = password cached</string>
      <string id="iMaxRevokeInfoCacheLifetime_User">CRL Cache Lifetime</string>
      <string id="iMaxRevokeInfoCacheLifetime_User_Explain">Sets the maximum lifetime in hours for which a cached CRL is valid for revocation checking.&#10;&#10;Applied only when signature validation time is set to current time. Range: 1–8,760 hours.&#10;&#10;Enabled writes the configured value (hours). Disabled removes the override.</string>
      <string id="bCustomPrefsCreated_User">Custom Cert Prefs</string>
      <string id="bCustomPrefsCreated_User_Explain">Tracks whether custom certificate-specific preferences have already been written.&#10;&#10;0 = re-create custom certificate preferences on next launch&#10;1 = custom certificate preferences already created</string>
      <string id="aDefDirectory_User">Default ID Directory</string>
      <string id="aDefDirectory_User_Explain">Specifies the default directory used when searching for digital IDs.&#10;&#10;ADSI directories from the Security Settings Console use names like Adobe.PPKMS.ADSI.dir0.&#10;&#10;Enabled writes the configured directory path. Disabled removes the override.</string>
      <string id="iDirectoryProvider_User">Directory Provider</string>
      <string id="iDirectoryProvider_User_Explain">Specifies which registered directory provider(s) to use for signature validation.&#10;&#10;0 = use none of the registered providers&#10;1 = use first registered provider&#10;2 = use all registered providers</string>
      <string id="iDirectoryProvider_User_opt0">Use none of the registered providers</string>
      <string id="iDirectoryProvider_User_opt1">Use first registered provider</string>
      <string id="iDirectoryProvider_User_opt2">Use all registered providers</string>
      <string id="bEnforceSecureChannel_User">Enforce Digest Compare</string>
      <string id="bEnforceSecureChannel_User_Explain">Block signing when original and signed message digests differ.&#10;&#10;Enabled writes 1 = enforce. Disabled writes 0 = no enforcement.&#10;&#10;Shows a warning on mismatch. Skipped for certs without a public key (e.g. DSA with omitted key). Do not enable if such certs are used.&#10;&#10;Values:&#10;0 = no enforcement&#10;1 = enforce</string>
      <string id="bAutoLaunchAtDocClose_User">Examine on Close</string>
      <string id="bAutoLaunchAtDocClose_User_Explain">Controls whether hidden content examination runs automatically when a document is closed.&#10;&#10;0 = do not examine on close&#10;1 = examine on close</string>
      <string id="bAutoLaunchAtSendMail_User">Examine on Send</string>
      <string id="bAutoLaunchAtSendMail_User_Explain">Controls whether hidden content examination runs automatically when a document is sent via email.&#10;&#10;0 = do not examine on send&#10;1 = examine on send</string>
      <string id="bExpiredCertGoOnline_User">Expired Cert Go Online</string>
      <string id="bExpiredCertGoOnline_User_Explain">Go online for revocation on expired certificates.&#10;&#10;Enabled writes 1 = go online. Disabled writes 0 = do not go online.&#10;&#10;Newer versions invalidate signatures on expired certs without embedded revocation.&#10;&#10;Values:&#10;0 = do not go online&#10;1 = go online</string>
      <string id="bFDFRequestExcludeCert_User">FDF Exclude Cert</string>
      <string id="bFDFRequestExcludeCert_User_Explain">Controls whether the user's certificate is excluded from certificate requests.&#10;&#10;0 = include certificate in requests&#10;1 = exclude certificate from requests</string>
      <string id="bFDFExportSave_User">FDF Export Save</string>
      <string id="bFDFExportSave_User_Explain">Caches the user's last export choice for FDF data.&#10;&#10;0 = email FDF&#10;1 = save FDF to file</string>
      <string id="bFDFExportSign_User">FDF Export Sign</string>
      <string id="bFDFExportSign_User_Explain">Caches the user's last choice on whether to sign the FDF during export.&#10;&#10;0 = do not sign FDF on export&#10;1 = sign FDF on export</string>
      <string id="bFDFRequestSave_User">FDF Request Save</string>
      <string id="bFDFRequestSave_User_Explain">Caches whether the user last chose to save the certificate request as an FDF or email it directly.&#10;&#10;0 = email certificate request directly&#10;1 = save certificate request as FDF</string>
      <string id="bFollowURIsFromAIA_User">Follow AIA URIs</string>
      <string id="bFollowURIsFromAIA_User_Explain">Controls whether the chain builder follows Authority Information Access (AIA) URIs to download intermediate certificates not available locally.&#10;&#10;0 = do not follow AIA URIs (no phone-home)&#10;1 = follow AIA URIs to download missing certificates</string>
      <string id="bSigAPStatusIconDisable_User">Hide Sig Status Icon</string>
      <string id="bSigAPStatusIconDisable_User_Explain">Controls whether the signature status icon is hidden in signature appearances.&#10;&#10;0 = signature status icon shown&#10;1 = signature status icon hidden</string>
      <string id="cDialogs_xSelHandler_User">ID Dialog Position</string>
      <string id="cDialogs_xSelHandler_User_Explain">Stores the on-screen position of the digital ID selection dialog for the signing handler.&#10;&#10;0 = position tracking inactive&#10;1 = position tracking active</string>
      <string id="xDefEnrollmentURL_User">ID Enrollment URL</string>
      <string id="xDefEnrollmentURL_User_Explain">Specifies the URL that opens when the user selects Enroll at an online CA while adding a new digital ID.&#10;&#10;Enabled writes the configured enrollment URL. Disabled removes the override.</string>
      <string id="bIgnoreNextUpdate_User">Ignore OCSP NextUpdate</string>
      <string id="bIgnoreNextUpdate_User_Explain">Use embedded OCSP when nextUpdate is absent (with iMaxClockSkew).&#10;&#10;Enabled writes 1 = accept OCSP without nextUpdate indefinitely. Disabled writes 0 = apply iMaxClockSkew.&#10;&#10;Supports long-term validation using signing-time responses.&#10;&#10;Values:&#10;0 = apply iMaxClockSkew on both sides of validation time&#10;1 = if no nextUpdate, accept OCSP indefinitely</string>
      <string id="iImportAddressBook_User">Import Address Book</string>
      <string id="iImportAddressBook_User_Explain">Import addressbook.acrodata on new install.&#10;&#10;Values:&#10;0 = do not import, no prompt&#10;1 or null = prompt user (default)&#10;2 = silent import</string>
      <string id="iImportAddressBook_User_opt0">Do not copy; user not prompted</string>
      <string id="iImportAddressBook_User_opt1">Ask whether to install the address book (default)</string>
      <string id="iImportAddressBook_User_opt2">Import the address book silently</string>
      <string id="bCertStoreImportEnable_User">Import Windows Certs</string>
      <string id="bCertStoreImportEnable_User_Explain">Controls whether users can import certificates from Windows (MSCAPI) certificate stores into the Trusted Identity Manager.&#10;&#10;0 = import from Windows certificate stores not allowed&#10;1 = import from Windows certificate stores allowed</string>
      <string id="cReasons_User">List Of Signing Reasons</string>
      <string id="cReasons_User_Explain">Custom signing reason list.&#10;&#10;Entries named t0, t1, etc. Overridable by document seed value. Defaults: author, reviewed, approving, attest accuracy, agree terms, agree portions.</string>
      <string id="bLoadSettingsFromURLAdobe_User">Load Security Settings from Server (Adobe Certificates)</string>
      <string id="bLoadSettingsFromURLAdobe_User_Explain">Controls whether trust anchors are periodically downloaded from Adobe's certificate server.&#10;&#10;0 = do not load from Adobe certificate server&#10;1 = load from Adobe certificate server</string>
      <string id="bLoadSettingsFromURLEUTL_User">Load Security Settings from Server (European Certificates)</string>
      <string id="bLoadSettingsFromURLEUTL_User_Explain">Controls whether trust anchors are periodically downloaded from the European Union Trusted Lists (EUTL) server.&#10;&#10;0 = do not load from EUTL server&#10;1 = load from EUTL server</string>
      <string id="tLoadSettingsNAME_User">Load Settings NAME</string>
      <string id="tLoadSettingsNAME_User_Explain">Specifies the common name of the certificate that must sign an imported security settings file.&#10;&#10;When set, only settings files signed by a matching certificate are accepted. Leave blank to accept any valid certificate.&#10;&#10;Enabled writes the configured certificate name. Disabled removes the certificate name requirement.</string>
      <string id="bIsEnabled_User">Long Term Validation</string>
      <string id="bIsEnabled_User_Explain">Controls whether Long Term Validation (LTV) revocation information is embedded in signatures.&#10;&#10;0 = do not embed LTV revocation status&#10;1 = embed LTV revocation status in signature</string>
      <string id="iMaxRevInfoArchiveSize_User">Max Rev Info Archive</string>
      <string id="iMaxRevInfoArchiveSize_User_Explain">Sets the maximum size in kilobytes for revocation information archived in signatures.&#10;&#10;Acrobat stores as much revocation data as possible without exceeding this limit. Range: 1–1,048,576 KB.&#10;&#10;Enabled writes the configured value (KB). Disabled removes the override.</string>
      <string id="iMaxVerifySession_User">Max Verify Sessions</string>
      <string id="iMaxVerifySession_User_Explain">Sets the maximum number of nested signature verification sessions allowed.&#10;&#10;Prevents infinite loops when verifying OCSP and CRL signer certificates. Range: 1–100.&#10;&#10;Enabled writes the configured value. Disabled removes the override.</string>
      <string id="iCreateNewSigFieldAVAlert_User">New Sig Field Alert</string>
      <string id="iCreateNewSigFieldAVAlert_User_Explain">Controls whether an alert is shown asking if a new signature field should be created.&#10;&#10;0 = do not show new signature field alert&#10;1 = show new signature field alert</string>
      <string id="bEnNonEmbFontLegPDFWarn_User">Non-Embedded Font Warn</string>
      <string id="bEnNonEmbFontLegPDFWarn_User_Explain">Controls whether a warning appears in the PDF Signature Report when a document contains non-embedded fonts.&#10;&#10;0 = no non-embedded font warning&#10;1 = warn when document contains non-embedded fonts</string>
      <string id="iSendNonce_User">OCSP Nonce Behavior</string>
      <string id="iSendNonce_User_Explain">Controls whether nonces are sent in OCSP requests during signature validation.&#10;&#10;0 = no nonces sent&#10;1 = send nonce; require matching nonce in response&#10;2 = send nonce; ignore absent nonce in response</string>
      <string id="iSendNonce_User_opt0">No nonces sent</string>
      <string id="iSendNonce_User_opt1">Send nonces; expect matching nonce in response</string>
      <string id="iSendNonce_User_opt2">Send nonces; ignore absent nonce in response</string>
      <string id="iURLToConsult_User">OCSP Responder URL</string>
      <string id="iURLToConsult_User_Explain">Specifies which OCSP responder URL the revocation checker uses.&#10;&#10;0 = use AIA extension in the certificate&#10;1 = use the URL key in sURL&#10;2 = use AIA extension; fall back to sURL if absent&#10;3 = use OCSP request signer certificate AIA (only when bSignRequest is 0)</string>
      <string id="iURLToConsult_User_opt0">Use the AIA extension in the certificate</string>
      <string id="iURLToConsult_User_opt1">Use the URL key in sURL</string>
      <string id="iURLToConsult_User_opt2">Use AIA; if absent use URL key in sURL</string>
      <string id="iURLToConsult_User_opt3">Use OCSP request signer certificate AIA (SignRequest=0 only)</string>
      <string id="iResponseFreshness_User">OCSP Response Freshness</string>
      <string id="iResponseFreshness_User_Explain">Sets the maximum age in minutes after the OCSP response thisUpdate time for the response to be considered valid.&#10;&#10;Responses older than this threshold are treated as stale. Range: 1–86,400 minutes.&#10;&#10;Enabled writes the configured value (minutes). Disabled removes the override.</string>
      <string id="bAllowOpenFile_User">Open Non-PDF Attachments</string>
      <string id="bAllowOpenFile_User_Explain">Open non-PDF attachments in native applications.&#10;&#10;Enabled writes 1 = allow. Disabled writes 0 = block.&#10;&#10;Works with bSecureOpenFile and tBuiltInPermsList; any block setting prevents opening.&#10;&#10;Values:&#10;0 = block&#10;1 = allow</string>
      <string id="tLockboxId_User">Password Lockbox ID</string>
      <string id="tLockboxId_User_Explain">Stores the lockbox identifier used to look up the cached server password when bSavePassword is enabled.&#10;&#10;Enabled writes the configured lockbox ID. Disabled removes the override.</string>
      <string id="bPreviewModeBeforeSigning_User">Preview Before Signing</string>
      <string id="bPreviewModeBeforeSigning_User_Explain">Controls whether preview mode is automatically invoked when a user initiates signing.&#10;&#10;0 = signing proceeds without forced preview&#10;1 = preview mode required before signing</string>
      <string id="bRequireAKI_User">Require AKI in CRL</string>
      <string id="bRequireAKI_User_Explain">Controls whether the Authority Key Identifier (AKI) extension must be present in all CRLs.&#10;&#10;0 = AKI extension not required in CRLs&#10;1 = AKI extension required in CRLs</string>
      <string id="bRequireOCSPCertHash_User">Require OCSP Cert Hash</string>
      <string id="bRequireOCSPCertHash_User_Explain">Controls whether a certificate public key hash extension must be present in OCSP responses.&#10;&#10;0 = certificate public key hash not required in OCSP responses&#10;1 = certificate public key hash required in OCSP responses</string>
      <string id="iRequireReviewWarnings_User">Require Sign Warnings</string>
      <string id="iRequireReviewWarnings_User_Explain">Controls when users are required to review document warnings before signing.&#10;&#10;0 = never required&#10;1 = required when certifying only&#10;2 = always required</string>
      <string id="iRequireReviewWarnings_User_opt0">Never</string>
      <string id="iRequireReviewWarnings_User_opt1">Show when certifying only</string>
      <string id="iRequireReviewWarnings_User_opt2">Always</string>
      <string id="bReqSigPropRetrieval_User">Require Timestamp</string>
      <string id="bReqSigPropRetrieval_User_Explain">Require successful timestamp retrieval when signing.&#10;&#10;Enabled writes 1 = must succeed. Disabled writes 0 = best effort (local time fallback).&#10;&#10;On failure, signing aborts with an error instead of using local time.&#10;&#10;Values:&#10;0 = best effort (local time fallback)&#10;1 = must succeed</string>
      <string id="bRequireValidSigForChaining_User">Require Valid Sig Chain</string>
      <string id="bRequireValidSigForChaining_User_Explain">Stop chain building at invalid RSA signatures on intermediates.&#10;&#10;Enabled writes 1 = stop at invalid signature. Disabled writes 0 = build full chain.&#10;&#10;Example: invalid ICA signature excludes the CA from the chain. Does not affect DSA.&#10;&#10;Values:&#10;0 = build full chain&#10;1 = stop at invalid signature</string>
      <string id="bReturnRevInfoToUser_User">Return Rev Info to JS</string>
      <string id="bReturnRevInfoToUser_User_Explain">Controls whether revocation information is accessible via the JavaScript SignatureInfo object.&#10;&#10;0 = revocation information not accessible via JavaScript&#10;1 = revocation information accessible via JavaScript</string>
      <string id="iRevocationChecker_User">Revocation Checker</string>
      <string id="iRevocationChecker_User_Explain">Specifies which registered revocation-checking provider(s) to use.&#10;&#10;0 = use none of the registered providers&#10;1 = use first registered provider&#10;2 = use all registered providers</string>
      <string id="iRevocationChecker_User_opt0">Use none of the registered providers</string>
      <string id="iRevocationChecker_User_opt1">Use first registered provider</string>
      <string id="iRevocationChecker_User_opt2">Use all registered providers</string>
      <string id="bRevCheckTrust_User">Revoke Check Trust</string>
      <string id="bRevCheckTrust_User_Explain">Revocation-check intermediate (non-root) trust anchors.&#10;&#10;Enabled writes 1 = check. Disabled writes 0 = no check.&#10;&#10;Detects compromise of third-party trust anchors. Root and self-signed certs are exempt.&#10;&#10;Values:&#10;0 = no check&#10;1 = check</string>
      <string id="iRSAPSSSaltLength_User">RSA-PSS Salt Length</string>
      <string id="iRSAPSSSaltLength_User_Explain">Specifies the salt length (in bytes) the RSA-PSS algorithm uses. Enter in decimal; registry stores as DWORD (e.g. decimal 32 = hex 0x20).</string>
      <string id="bEnableRSAPSSSigning_User">RSA-PSS Signing</string>
      <string id="bEnableRSAPSSSigning_User_Explain">Controls whether signatures are created using the RSA-PSS algorithm.&#10;&#10;0 = use default RSA signing algorithm&#10;1 = use RSA-PSS for signing</string>
      <string id="aRSAPSSHashAlgorithm_User">RSAPSS Hash Algorithm</string>
      <string id="aRSAPSSHashAlgorithm_User_Explain">Specifies the hash algorithm used for RSA-PSS signing.&#10;&#10;If not set or null, aSignHash is used; if aSignHash is also absent, SHA256 is used.&#10;&#10;Enabled writes the configured algorithm name. Disabled removes the override.&#10;&#10;Valid values: SHA1, SHA224, SHA256, SHA384, SHA512</string>
      <string id="tSAML_Assertion_Source_User">SAML Auth Server URL</string>
      <string id="tSAML_Assertion_Source_User_Explain">Holds the URL of the authentication server from which the SAML assertion was obtained.&#10;&#10;Enabled writes the configured URL. Disabled removes the override.</string>
      <string id="tSAML_Name_Format_User">SAML Name Format</string>
      <string id="tSAML_Name_Format_User_Explain">Stores the format of the subject name identifier from the SAML assertion (tSAML_Name_Format).&#10;&#10;Enabled writes the configured name format string. Disabled removes the override.</string>
      <string id="tSAML_Name_Qualifier_User">SAML Name Qualifier</string>
      <string id="tSAML_Name_Qualifier_User_Explain">Stores the name qualifier attribute from the SAML assertion subject name identifier (tSAML_Name_Qualifier).&#10;&#10;Enabled writes the configured name qualifier string. Disabled removes the override.</string>
      <string id="iDigSigSaveAsCertified_User">Save Certified Alert</string>
      <string id="iDigSigSaveAsCertified_User_Explain">Controls whether an alert is shown when saving a document that contains certification signatures.&#10;&#10;0 = do not show certified save alert&#10;1 = show certified save alert</string>
      <string id="bSecureOpenFile_User">Secure Open Attachments</string>
      <string id="bSecureOpenFile_User_Explain">Restrict attachment opens to PDF only.&#10;&#10;Enabled writes 1 = PDF only. Disabled writes 0 = allow non-PDF.&#10;&#10;Works with bAllowOpenFile and tBuiltInPermsList; any block setting prevents opening.&#10;&#10;Values:&#10;0 = allow non-PDF&#10;1 = PDF only</string>
      <string id="bSelfSignCertGen_User">Self-Sign ID Create</string>
      <string id="bSelfSignCertGen_User_Explain">Allow Create a self-signed ID in Add ID workflows.&#10;&#10;Enabled writes 1 = allow. Disabled writes 0 = disallow.&#10;&#10;Values:&#10;0 = disallow&#10;1 = allow</string>
      <string id="tServerURL_User">Server URL</string>
      <string id="tServerURL_User_Explain">Specifies the default server URL for the EDC server connection.&#10;&#10;Enabled writes the configured URL. Disabled removes the override.</string>
      <string id="bShowAllChains_User">Show All Chains</string>
      <string id="bShowAllChains_User_Explain">Controls whether all certificate chains are shown in the Certificate Viewer.&#10;&#10;0 = show trusted chain only&#10;1 = show all chains</string>
      <string id="iShowDocumentWarnings_User">Show Document Warnings</string>
      <string id="iShowDocumentWarnings_User_Explain">Controls when a document warnings review button appears in the signing dialog.&#10;&#10;0 = never show&#10;1 = show when certifying only&#10;2 = always show</string>
      <string id="iShowDocumentWarnings_User_opt0">Never</string>
      <string id="iShowDocumentWarnings_User_opt1">Show when certifying only</string>
      <string id="iShowDocumentWarnings_User_opt2">Always</string>
      <string id="bShowWarningForChanges_User">Show Post-Sign Warning</string>
      <string id="bShowWarningForChanges_User_Explain">Show blue info icon when a validated approval signature document changes after signing.&#10;&#10;Enabled writes 1 = show warning. Disabled writes 0 = no warning.&#10;&#10;Does not affect certification signatures. Requires iDisplayValidIcon not set to 2.&#10;&#10;Values:&#10;0 = no warning (green check)&#10;1 = show warning</string>
      <string id="bAllowOtherInfoWhenSigning_User">Show Sign Contact Info</string>
      <string id="bAllowOtherInfoWhenSigning_User_Explain">Controls whether location and contact information fields are shown during signing.&#10;&#10;0 = hide location and contact information during signing&#10;1 = show location and contact information during signing</string>
      <string id="bShowSignerWarnings_User">Show Signer Warnings</string>
      <string id="bShowSignerWarnings_User_Explain">Controls whether a warning is shown indicating greater forgery risk when revocation information is embedded in the signature.&#10;&#10;0 = do not show signer risk warning&#10;1 = show signer risk warning</string>
      <string id="iDisplayValidIcon_User">Show Valid Sig Icon</string>
      <string id="iDisplayValidIcon_User_Explain">When to show signature status icon in appearance.&#10;&#10;Value 2 disables bShowWarningForChanges and the GUI hide option. Does not affect Signatures pane icons.&#10;&#10;Values:&#10;0 = always&#10;1 = except when valid&#10;2 = never</string>
      <string id="iDisplayValidIcon_User_opt0">Always display valid signature icon</string>
      <string id="iDisplayValidIcon_User_opt1">Hide icon when signature is valid</string>
      <string id="iDisplayValidIcon_User_opt2">Never display valid signature icon</string>
      <string id="bReqSigPropVerification_User">Sig Property Verify</string>
      <string id="bReqSigPropVerification_User_Explain">Controls whether signature property verification must succeed for a signature to be considered valid.&#10;&#10;0 = signature property verification not required&#10;1 = signature property verification required</string>
      <string id="iSigVerificationTime_User">Sig Verification Time</string>
      <string id="iSigVerificationTime_User_Explain">Indicates the time at which signature validation should occur.&#10;&#10;Possible values include:&#10;0: Always carry out the verification at current time&#10;1: Use the signing time if it's secure (e.g. timestamped), else use current time&#10;2: Always use signing time</string>
      <string id="iSigVerificationTime_User_opt0">Verify at current time</string>
      <string id="iSigVerificationTime_User_opt1">Use signing time if secure, else current time</string>
      <string id="iSigVerificationTime_User_opt2">Always use signing time</string>
      <string id="bAllowSigCertOnly_User">Sign Certified Only</string>
      <string id="bAllowSigCertOnly_User_Explain">Controls whether approval signatures may be added to certified documents that contain Legal PDF warnings.&#10;&#10;0 = block approval signatures when Legal PDF warnings are present&#10;1 = allow approval signatures on certified documents with Legal PDF warnings</string>
      <string id="isignDone_User">Sign Done Dialog</string>
      <string id="isignDone_User_Explain">Controls whether a confirmation dialog is shown after a document is successfully signed (note: registry value isignDone is inverted).&#10;&#10;0 = show confirmation dialog after signing&#10;1 = suppress confirmation dialog</string>
      <string id="bAllowSigCertGreenOnly_User">Sign Green Cert Only</string>
      <string id="bAllowSigCertGreenOnly_User_Explain">Controls whether approval signatures may be added to certified documents that do not contain Legal PDF warnings.&#10;&#10;0 = do not allow approval signatures on certified documents&#10;1 = allow approval signatures on certified documents without Legal PDF warnings</string>
      <string id="tSignHash_User">Sign Hash Algorithm</string>
      <string id="tSignHash_User_Explain">Specifies the OID of the hashing algorithm used for signing.&#10;&#10;Enabled writes the configured OID string. Disabled removes the override.&#10;&#10;Valid OIDs:&#10;1.2.840.113549.2.5 = MD5&#10;1.3.14.3.2.26 = SHA1&#10;2.16.840.1.101.3.4.2.1 = SHA256&#10;1.3.36.3.2.1 = RIPEMD160&#10;2.16.840.1.101.3.4.2.2 = SHA384&#10;2.16.840.1.101.3.4.2.3 = SHA512</string>
      <string id="bSignRequest_User">Sign OCSP Requests</string>
      <string id="bSignRequest_User_Explain">Controls whether OCSP requests are signed before sending.&#10;&#10;0 = do not sign OCSP requests&#10;1 = sign OCSP requests before sending</string>
      <string id="tContactInfo_User">Signing Contact Info</string>
      <string id="tContactInfo_User_Explain">Specifies the default contact information pre-filled in the signing dialog when bAllowOtherInfoWhenSigning is enabled.&#10;&#10;Enabled writes the configured contact information string. Disabled removes the override.</string>
      <string id="iHashAlgo_User">Timestamp Hash Algo</string>
      <string id="iHashAlgo_User_Explain">Specifies the hash algorithm used to hash the timestamped data.&#10;&#10;0 = MD5&#10;1 = SHA1&#10;2 = SHA256</string>
      <string id="iHashAlgo_User_opt0">MD5</string>
      <string id="iHashAlgo_User_opt1">SHA1</string>
      <string id="iHashAlgo_User_opt2">SHA256</string>
      <string id="iSize_User">Timestamp Sig Size</string>
      <string id="iSize_User_Explain">ASPKI requires the signature property to predict the size (in bytes) so that enough space can be set aside.</string>
      <string id="tServer_User">Tracker Server URL</string>
      <string id="tServer_User_Explain">Specifies the DNS server name for the Acrobat tracker server (e.g., alrms.adobe.com). No URL scheme is included.&#10;&#10;Enabled writes the configured server name. Disabled removes the override.</string>
      <string id="bTrueTypeFontPDFSigQWarn_User">TrueType Font Warn</string>
      <string id="bTrueTypeFontPDFSigQWarn_User_Explain">Controls whether a warning appears in the PDF Signature Report when the document contains TrueType fonts.&#10;&#10;0 = no TrueType font warning&#10;1 = warn when document contains TrueType fonts</string>
      <string id="bTrustCertifiedDocuments_User">Trust Certified Docs</string>
      <string id="bTrustCertifiedDocuments_User_Explain">Trust certified documents as privileged locations.&#10;&#10;Enabled writes 1 = trusted. Disabled writes 0 = not trusted.&#10;&#10;Does not apply in Protected View.&#10;&#10;Values:&#10;0 = not trusted&#10;1 = trusted</string>
      <string id="bTrustOSTrustedSites_User">Trust IE Trusted Sites</string>
      <string id="bTrustOSTrustedSites_User_Explain">Treat IE Trusted Sites and Local Intranet zones as privileged locations.&#10;&#10;Enabled writes 1 = trust OS zones. Disabled writes 0 = do not trust OS zones.&#10;&#10;Values:&#10;0 = do not trust OS zones&#10;1 = trust OS zones</string>
      <string id="tHostPerms_User">Trusted/Blocked URL List</string>
      <string id="tHostPerms_User_Explain">Stores trusted and blocked URLs when URL Access Permissions (iURLPerms) is set to Custom Setting (DWORD 0). Pipe-separated Adobe TrustManager host permission list syntax: version:1|host:N where N is 2 (Allow) or 3 (Block). Only effective when iURLPerms is 0; Allow or Block overrides this list. Not lockable via HKLM - this preference only exists at User scope.</string>
      <string id="iURLPerms_User">URL Access Permissions</string>
      <string id="iURLPerms_User_Explain">Allow, block, or custom website access.&#10;&#10;Allow or Block resets tHostPerms; Custom uses tHostPerms.&#10;&#10;Values:&#10;0 = custom&#10;1 = block all&#10;2 = allow all&#10;&#10;When set to Custom Setting (0), configure the URL list using the Trusted/Blocked URL List (tHostPerms) text policy.</string>
      <string id="iURLPerms_User_opt0">Custom Setting (uses tHostPerms URL list)</string>
      <string id="iURLPerms_User_opt1">Block all websites</string>
      <string id="iURLPerms_User_opt2">Allow all websites</string>
      <string id="tURL_User">Url Of The Roaming Id</string>
      <string id="tURL_User_Explain">Specifies the URL of the Roaming ID server.&#10;&#10;Enabled writes the configured URL. Disabled removes the override.</string>
      <string id="iUseArchivedRevInfo_User">Use Archived Rev Info</string>
      <string id="iUseArchivedRevInfo_User_Explain">Controls whether archived revocation information is used during signature verification.&#10;&#10;0 = never (always download fresh revocation information)&#10;1 = deprecated; do not use&#10;2 = always use embedded revocation information if available</string>
      <string id="iUseArchivedRevInfo_User_opt0">Never (require fresh revocation download)</string>
      <string id="iUseArchivedRevInfo_User_opt1">Deprecated - do not use</string>
      <string id="iUseArchivedRevInfo_User_opt2">Always use embedded revocation if available</string>
      <string id="iValidityModel_User">Validity Model</string>
      <string id="iValidityModel_User_Explain">Signature and certificate validity model.&#10;&#10;German signature law may require chain validation.&#10;&#10;Values:&#10;0 = PKIX shell model&#10;1 = chain model (for qualified policy or chain model extension OIDs)</string>
      <string id="iValidityModel_User_opt0">PKIX shell model (default)</string>
      <string id="iValidityModel_User_opt1">Chain validity model</string>
      <string id="iMSStoreTrusted_User">Windows Store Trust</string>
      <string id="iMSStoreTrusted_User_Explain">Trust Windows Certificate Store certs for signing and certifying.&#10;&#10;Lock via bMSStoreTrusted.&#10;&#10;Values:&#10;0x00 = none&#10;0x60 = validating signatures&#10;0x62 = certified documents and signatures&#10;&#10;Windows Store trust is a hex bitmask stored as a DWORD. Documented values: 0x00 (0) = no trust; 0x60 (96) = validating signatures; 0x62 (98) = validating certified documents and signatures. Other bit combinations may be set using the numeric control (0-255).</string>

      <!-- ======================================== -->
      <!--           Sharing and Features           -->
      <!-- ======================================== -->

      <string id="iSendMailDefaultAccountAlert_User">Default Email Prompt</string>
      <string id="iSendMailDefaultAccountAlert_User_Explain">Controls whether a dialog appears asking the user to select how they want to send a PDF via email.&#10;&#10;0 = do not show email method dialog&#10;1 = show email method dialog on first email send</string>
      <string id="bDefaultSet_User">Default Email Set</string>
      <string id="bDefaultSet_User_Explain">Indicates whether a default email client has been set for shared review email workflows.&#10;&#10;0 = default webmail client not set&#10;1 = default webmail client set</string>
      <string id="bDisableSharedReview_User">Disable Shared Review</string>
      <string id="bDisableSharedReview_User_Explain">Controls whether cloud-based DC shared review is available (note: registry value bDisableSharedReview is inverted).&#10;&#10;0 = DC review enabled&#10;1 = remove DC review option (legacy only)</string>
      <string id="bNeedSynchronizer_User">Enable Synchronizer</string>
      <string id="bNeedSynchronizer_User_Explain">Enable the synchronizer.&#10;&#10;Enabled writes 1 = enable synchronizer. Disabled writes 0 = disable synchronizer.&#10;&#10;Used by services, AATL, shared reviews, and recent files. Disabling not recommended; Acrobat and Reader use separate synchronizers.&#10;&#10;Values:&#10;0 = disable&#10;1 = enable</string>
      <string id="bEnableFillSign_User">Fill &amp; Sign Pane</string>
      <string id="bEnableFillSign_User_Explain">Controls whether the Fill and Sign pane is available (without affecting the Work with Certificates menu).&#10;&#10;0 = Fill and Sign pane removed&#10;1 = Fill and Sign pane shown</string>
      <string id="bRemoveCommaDelimiter_User">Remove Comma Delimiter</string>
      <string id="bRemoveCommaDelimiter_User_Explain">Controls whether commas are removed from comma-delimited address book entries during shared review workflows.&#10;&#10;0 = keep commas in address book entries&#10;1 = remove commas from address book entries</string>
      <string id="bShowConnectDialog_User">Show Connect Dialog</string>
      <string id="bShowConnectDialog_User_Explain">Controls whether the Connect dialog is shown in Shared Reviews.&#10;&#10;0 = do not show Connect dialog&#10;1 = show Connect dialog</string>
      <string id="bShowWelcomeDialog_User">Show Welcome Dialog</string>
      <string id="bShowWelcomeDialog_User_Explain">Controls whether the Welcome dialog is shown when a shared review is initiated.&#10;&#10;0 = do not show Welcome dialog&#10;1 = show Welcome dialog</string>

      <!-- ======================================== -->
      <!--          Startup and Experience          -->
      <!-- ======================================== -->

      <string id="bActivated_User">App Activated</string>
      <string id="bActivated_User_Explain">Records whether the application has been activated online after installation.&#10;&#10;0 = not activated&#10;1 = activated</string>
      <string id="bHasLaunched_User">App Has Launched</string>
      <string id="bHasLaunched_User_Explain">Records whether the application has been launched at least once after installation.&#10;&#10;0 = not yet launched&#10;1 = launched</string>
      <string id="bAppInitialized_User">App Initialized</string>
      <string id="bAppInitialized_User_Explain">Records whether the application has been initialized after installation.&#10;&#10;0 = not initialized&#10;1 = initialized</string>
      <string id="bLaunched_User">App Launched</string>
      <string id="bLaunched_User_Explain">Caches whether the application has ever been launched.&#10;&#10;0 = application has not been launched&#10;1 = application has been launched</string>
      <string id="bChooseLangAtStartup_User">Choose Language Startup</string>
      <string id="bChooseLangAtStartup_User_Explain">Controls whether a language selection prompt is shown at application startup.&#10;&#10;0 = no language selection at startup&#10;1 = show language selection at startup</string>
      <string id="bCreateFormDiscoveryShown_User">Create Form Onboarding</string>
      <string id="bCreateFormDiscoveryShown_User_Explain">Controls whether the onboarding coachmark is shown when the user invokes the Create Form panel (note: registry value bCreateFormDiscoveryShown is inverted).&#10;&#10;0 = show Create Form onboarding coachmark&#10;1 = suppress Create Form onboarding coachmark</string>
      <string id="bEditDiscoveryShown_User">Edit Onboarding</string>
      <string id="bEditDiscoveryShown_User_Explain">Controls whether the onboarding coachmark is shown when the user invokes the Edit panel (note: registry value bEditDiscoveryShown is inverted).&#10;&#10;0 = show Edit onboarding coachmark&#10;1 = suppress Edit onboarding coachmark</string>
      <string id="EULA_User">EULA Acceptance</string>
      <string id="EULA_User_Explain">Accept EULA for the built-in updater.&#10;&#10;Enabled writes 1 = EULA accepted. Disabled writes 0 = EULA not accepted.&#10;&#10;Alternative to EULA_ACCEPT=YES at install time.&#10;&#10;Values:&#10;0 = not accepted&#10;1 = accepted</string>
      <string id="bFillSignDiscoveryShown_User">Fill &amp; Sign Onboarding</string>
      <string id="bFillSignDiscoveryShown_User_Explain">Controls whether the onboarding coachmark is shown when the user invokes the Fill &amp; Sign panel (note: registry value bFillSignDiscoveryShown is inverted).&#10;&#10;0 = show Fill &amp; Sign onboarding coachmark&#10;1 = suppress Fill &amp; Sign onboarding coachmark</string>
      <string id="bHideHelpWelcome_User">Hide Help Welcome</string>
      <string id="bHideHelpWelcome_User_Explain">Controls whether the Welcome menu item under Help is hidden.&#10;&#10;0 = Welcome menu item shown&#10;1 = Welcome menu item hidden</string>
      <string id="bShownHomeOnboarding_User">Home Onboarding</string>
      <string id="bShownHomeOnboarding_User_Explain">Controls whether the home onboarding tour is shown when the modern viewer is first invoked (note: registry value bShownHomeOnboarding is inverted).&#10;&#10;0 = show home onboarding tour (not yet shown)&#10;1 = suppress home onboarding tour (already shown or declined)</string>
      <string id="bLoadAllPluginsAtStartup_User">Load All Plugins</string>
      <string id="bLoadAllPluginsAtStartup_User_Explain">Controls whether all plugins are loaded when the application starts.&#10;&#10;0 = do not load all plugins at startup&#10;1 = load all plugins at startup</string>
      <string id="bOrganizeDiscoveryShown_User">Organize Onboarding</string>
      <string id="bOrganizeDiscoveryShown_User_Explain">Controls whether the onboarding coachmark is shown when the user invokes the Organize panel (note: registry value bOrganizeDiscoveryShown is inverted).&#10;&#10;0 = show Organize onboarding coachmark&#10;1 = suppress Organize onboarding coachmark</string>
      <string id="bUsePageCache_User">Page Caching</string>
      <string id="bUsePageCache_User_Explain">Controls whether previously loaded pages are cached in memory.&#10;&#10;0 = do not cache loaded pages&#10;1 = cache loaded pages</string>
      <string id="bRedactDiscoveryShown_User">Redaction Onboarding</string>
      <string id="bRedactDiscoveryShown_User_Explain">Controls whether the onboarding coachmark is shown when the user invokes the Redaction panel (note: registry value bRedactDiscoveryShown is inverted).&#10;&#10;0 = show Redaction onboarding coachmark&#10;1 = suppress Redaction onboarding coachmark</string>
      <string id="bDisplayAboutDialog_User">Show About Dialog</string>
      <string id="bDisplayAboutDialog_User_Explain">Controls whether the startup splash screen (About dialog) is displayed at every launch.&#10;&#10;0 = do not show startup splash screen&#10;1 = show startup splash screen at every launch</string>
      <string id="idontShowAllImagesHaveAltText_User">Show Alt Text Alert</string>
      <string id="idontShowAllImagesHaveAltText_User_Explain">Controls whether an alert is shown when the Set Alternate Text dialog is invoked and all images already have alternate text (note: registry value idontShowAllImagesHaveAltText is inverted).&#10;&#10;0 = show alert (all images have alt text)&#10;1 = suppress alert</string>
      <string id="bshowEULA_User">Show EULA Startup</string>
      <string id="bshowEULA_User_Explain">Controls whether the end user license agreement (EULA) dialog appears on startup.&#10;&#10;0 = do not show EULA dialog&#10;1 = show EULA dialog</string>
      <string id="bLastShowStatus_User">Show Getting Started</string>
      <string id="bLastShowStatus_User_Explain">Controls whether the Get Started with Acrobat page is shown on startup.&#10;&#10;0 = do not show Getting Started page&#10;1 = show Getting Started page on startup</string>
      <string id="bShowHorizontalScrollbar_User">Show H-Scrollbar</string>
      <string id="bShowHorizontalScrollbar_User_Explain">Controls whether a horizontal scrollbar is shown when the viewing area is narrower than the document width.&#10;&#10;0 = hide horizontal scrollbar&#10;1 = show horizontal scrollbar</string>
      <string id="bShowExistingAttachedReportAlert_User">Show Report Alert</string>
      <string id="bShowExistingAttachedReportAlert_User_Explain">Controls whether an alert is shown when attaching a report if one is already attached (note: registry value bShowExistingAttachedReportAlert is inverted).&#10;&#10;0 = show alert when report already attached&#10;1 = suppress alert</string>
      <string id="idontShowSetAltTextInfo_User">Show Set Alt Alert</string>
      <string id="idontShowSetAltTextInfo_User_Explain">Controls whether an informative alert is shown when the Set Alternate Text dialog is opened (note: registry value idontShowSetAltTextInfo is inverted).&#10;&#10;0 = show informative alt text alert&#10;1 = suppress informative alt text alert</string>
      <string id="bShowedSkipCard_User">Show Skip Card</string>
      <string id="bShowedSkipCard_User_Explain">Tracks whether the skipped onboarding coachmark has been shown.&#10;&#10;0 = skip card not shown&#10;1 = skip card shown</string>
      <string id="bSplashDisplayedAtStartup_User">Show Splash Screen</string>
      <string id="bSplashDisplayedAtStartup_User_Explain">Controls whether the splash screen appears during application startup.&#10;&#10;0 = do not show splash screen&#10;1 = show splash screen at startup</string>
      <string id="bDisplayedSplash_User">Splash Displayed</string>
      <string id="bDisplayedSplash_User_Explain">Indicates whether the application has started up and displayed the splash screen.&#10;&#10;0 = splash screen not yet displayed&#10;1 = splash screen has been displayed</string>
      <string id="bInTrialMode_User">Trial Mode Active</string>
      <string id="bInTrialMode_User_Explain">Records whether the application is currently operating in Trial Mode.&#10;&#10;0 = not in trial mode&#10;1 = trial mode active</string>
      <string id="bShownViewerOnboarding_User">Viewer Onboarding</string>
      <string id="bShownViewerOnboarding_User_Explain">Controls whether the viewer onboarding tour is shown when a PDF first opens in the modern viewer (note: registry value bShownViewerOnboarding is inverted).&#10;&#10;0 = show viewer onboarding tour (not yet shown)&#10;1 = suppress viewer onboarding tour (already shown or declined)</string>
      <string id="iDelayBeforeQuitViewer_User">Viewer Quit Delay</string>
      <string id="iDelayBeforeQuitViewer_User_Explain">Sets the number of seconds the standalone viewer application stays in memory before shutting down.&#10;&#10;Range: 0–3,600 seconds.&#10;&#10;Enabled writes the configured value (seconds). Disabled removes the override.</string>

      <!-- ======================================== -->
      <!--     Updates and Desktop Integration      -->
      <!-- ======================================== -->

      <string id="bDownloadEntireFile_User">Background Download</string>
      <string id="bDownloadEntireFile_User_Explain">Controls whether the viewer can download PDF resources in the background before they are needed for display.&#10;&#10;0 = do not allow background downloading&#10;1 = allow background downloading</string>
      <string id="iDelayBeforeQuitBrowser_User">Browser Quit Delay</string>
      <string id="iDelayBeforeQuitBrowser_User_Explain">Sets the number of seconds the browser plug-in stays in memory after the PDF tab closes.&#10;&#10;Range: 0–3,600 seconds.&#10;&#10;Enabled writes the configured value (seconds). Disabled removes the override.</string>
      <string id="bBrowserDisplayInReadMode_User">Browser Read Mode</string>
      <string id="bBrowserDisplayInReadMode_User_Explain">Open browser PDFs in Read Mode.&#10;&#10;Enabled writes 1 = Read Mode. Disabled writes 0 = standard toolbars.&#10;&#10;Hides standard toolbars; compact menu appears on hover.&#10;&#10;Values:&#10;0 = standard toolbars&#10;1 = Read Mode</string>
      <string id="bInstalledCleanupCheckDone_User">Cleanup Check Done</string>
      <string id="bInstalledCleanupCheckDone_User_Explain">Records whether the usage measurement cleanup check has already run.&#10;&#10;0 = cleanup check pending&#10;1 = cleanup check complete</string>
      <string id="bLoadOnStart_User">Collab Sync Startup</string>
      <string id="bLoadOnStart_User_Explain">Controls whether AdobeCollabSync.exe starts as a background process on application launch (note: registry value bLoadOnStart is inverted).&#10;&#10;0 = start the collaboration sync process on startup&#10;1 = do not start the collaboration sync process</string>
      <string id="bAllowByteRangeRequests_User">Fast Web View</string>
      <string id="bAllowByteRangeRequests_User_Explain">Controls whether Fast Web View is enabled, allowing PDF display before the entire file is downloaded.&#10;&#10;0 = require full file download before display&#10;1 = allow display before download completes (Fast Web View)</string>
      <string id="bFavoriteFilesRememberChoice_User">Remember Stars Choice</string>
      <string id="bFavoriteFilesRememberChoice_User_Explain">Records the user's saved choice for how to handle starred files when iFavoriteFilesAccessOption is set to 0 (ask every time).&#10;&#10;0 = always ask&#10;1 = use remembered choice</string>
      <string id="bFavoritesStripInRFL_User">Show Starred Files</string>
      <string id="bFavoritesStripInRFL_User_Explain">Controls whether starred files are shown in the Recent Files list (note: registry value bFavoritesStripInRFL is inverted).&#10;&#10;0 = show starred files in the Recent Files list&#10;1 = hide starred files from the Recent Files list</string>
      <string id="iFavoriteFilesAccessOption_User">Starred Files Action</string>
      <string id="iFavoriteFilesAccessOption_User_Explain">Specifies the action taken when a user stars a file.&#10;&#10;0 = ask whether to save locally or upload (also creates bFavoriteFilesRememberChoice preference)&#10;1 = upload to Document Cloud&#10;2 = save the file locally</string>
      <string id="iFavoriteFilesAccessOption_User_opt0">Show dialog (save or upload)</string>
      <string id="iFavoriteFilesAccessOption_User_opt1">Upload to Document Cloud</string>
      <string id="iFavoriteFilesAccessOption_User_opt2">Save the file locally</string>
      <string id="bStoreCredentials_User">Store Credentials</string>
      <string id="bStoreCredentials_User_Explain">Controls whether the user's logon credentials for the Tracker are stored.&#10;&#10;0 = do not store Tracker credentials&#10;1 = store Tracker credentials</string>
      <string id="iAVARMNoAutoUpdateWarning_User">Suppress Update Warning</string>
      <string id="iAVARMNoAutoUpdateWarning_User_Explain">Controls whether the "Updater has not been able to check for updates recently" warning dialog is suppressed.&#10;&#10;0 = show the update warning dialog&#10;1 = suppress the update warning dialog</string>

      <!-- ======================================== -->
      <!--                  Upsell                  -->
      <!-- ======================================== -->

      <string id="bAcrobatAppInstalled_User">Acrobat App Promo</string>
      <string id="bAcrobatAppInstalled_User_Explain">Controls whether the Acrobat mobile app promotion is shown in the Home banner (note: registry value bAcrobatAppInstalled is inverted).&#10;&#10;0 = show Acrobat mobile app promotion in the Home banner&#10;1 = hide Acrobat mobile app promotion</string>
      <string id="bScanAppInstalled_User">Scan App Promo</string>
      <string id="bScanAppInstalled_User_Explain">Controls whether the Adobe Scan mobile app promotion is shown in the Home banner (note: registry value bScanAppInstalled is inverted).&#10;&#10;0 = show Adobe Scan mobile app promotion in the Home banner&#10;1 = hide Adobe Scan mobile app promotion</string>

      <!-- ======================================== -->
      <!--        Web Browser Extension             -->
      <!-- ======================================== -->

      <string id="SupportedBrowserExtension">Adobe Acrobat browser extension (Chrome/Edge)</string>
      <string id="BrowserExtensionCategory">Web Browser Extension</string>
      <string id="ChromeExtensionCategory">Google Chrome</string>
      <string id="EdgeExtensionCategory">Microsoft Edge</string>

      <string id="OpenHelpxChrome">Open Help Tab on Install</string>
      <string id="OpenHelpxChrome_Explain">Controls whether the Acrobat browser extension opens its help/onboarding tab automatically.&#10;&#10;This configures the extension itself via Chrome's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace. It does not control whether the extension is installed -- use Chrome's own ExtensionInstallForcelist/ExtensionInstallBlocklist policies for that.&#10;&#10;Possible values include: true: Open the help tab automatically on install.&#10;false: Do not open the help tab.</string>
      <string id="OpenHelpxEdge">Open Help Tab on Install</string>
      <string id="OpenHelpxEdge_Explain">Controls whether the Acrobat browser extension opens its help/onboarding tab automatically.&#10;&#10;This configures the extension itself via Edge's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace. It does not control whether the extension is installed -- use Edge's own ExtensionInstallForcelist/ExtensionInstallBlocklist policies for that.&#10;&#10;Possible values include: true: Open the help tab automatically on install.&#10;false: Do not open the help tab.</string>

      <string id="UsageMeasurementChrome">Usage Analytics</string>
      <string id="UsageMeasurementChrome_Explain">Controls whether the Acrobat browser extension collects and sends usage analytics.&#10;&#10;This is separate from the desktop application's own bUsageMeasurement preference -- it applies only to the Chrome extension. Configured via Chrome's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Enable usage analytics in the extension.&#10;false: Disable usage analytics in the extension.</string>
      <string id="UsageMeasurementEdge">Usage Analytics</string>
      <string id="UsageMeasurementEdge_Explain">Controls whether the Acrobat browser extension collects and sends usage analytics.&#10;&#10;This is separate from the desktop application's own bUsageMeasurement preference -- it applies only to the Edge extension. Configured via Edge's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Enable usage analytics in the extension.&#10;false: Disable usage analytics in the extension.</string>

      <string id="UninstallPopupChrome">Uninstall Popup for Free Users</string>
      <string id="UninstallPopupChrome_Explain">Controls whether the Acrobat browser extension shows a popup prompting users who have moved to the free plan to uninstall.&#10;&#10;Configured via Chrome's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Show the uninstall popup for free-plan users.&#10;false: Hide the uninstall popup.</string>
      <string id="UninstallPopupEdge">Uninstall Popup for Free Users</string>
      <string id="UninstallPopupEdge_Explain">Controls whether the Acrobat browser extension shows a popup prompting users who have moved to the free plan to uninstall.&#10;&#10;Configured via Edge's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Show the uninstall popup for free-plan users.&#10;false: Hide the uninstall popup.</string>

      <string id="DisableGenAIChrome">Disable GenAI Features</string>
      <string id="DisableGenAIChrome_Explain">Disables generative AI features in the Acrobat browser extension.&#10;&#10;Configured via Chrome's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace. This is independent of the desktop application's generative AI controls.&#10;&#10;Possible values include: true: Disable generative AI features in the extension.&#10;false: Allow generative AI features in the extension.</string>
      <string id="DisableGenAIEdge">Disable GenAI Features</string>
      <string id="DisableGenAIEdge_Explain">Disables generative AI features in the Acrobat browser extension.&#10;&#10;Configured via Edge's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace. This is independent of the desktop application's generative AI controls.&#10;&#10;Possible values include: true: Disable generative AI features in the extension.&#10;false: Allow generative AI features in the extension.</string>

      <string id="DisableWhatsNewAutoOpenChrome">Disable What's New Auto-Open</string>
      <string id="DisableWhatsNewAutoOpenChrome_Explain">Stops the What's New page from automatically opening in the browser when the Acrobat extension updates.&#10;&#10;Configured via Chrome's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Suppress the What's New auto-open.&#10;false: Allow the What's New page to open automatically after updates.</string>
      <string id="DisableWhatsNewAutoOpenEdge">Disable What's New Auto-Open</string>
      <string id="DisableWhatsNewAutoOpenEdge_Explain">Stops the What's New page from automatically opening in the browser when the Acrobat extension updates.&#10;&#10;Configured via Edge's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Suppress the What's New auto-open.&#10;false: Allow the What's New page to open automatically after updates.</string>

      <string id="DisableExpressChrome">Disable Express Features</string>
      <string id="DisableExpressChrome_Explain">Disables Adobe Express features (such as Edit Image) in the Acrobat browser extension.&#10;&#10;Configured via Chrome's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Disable Express features in the extension.&#10;false: Allow Express features in the extension.</string>
      <string id="DisableExpressEdge">Disable Express Features</string>
      <string id="DisableExpressEdge_Explain">Disables Adobe Express features (such as Edit Image) in the Acrobat browser extension.&#10;&#10;Configured via Edge's managed-storage policy mechanism (a 3rdparty extension policy), not Adobe's own FeatureLockDown registry namespace.&#10;&#10;Possible values include: true: Disable Express features in the extension.&#10;false: Allow Express features in the extension.</string>
    </stringTable>
